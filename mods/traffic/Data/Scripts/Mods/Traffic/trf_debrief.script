	return {
		dbjobh = "Report in",
		dbbt = "Charter office",
		dbbox = "FTU clerk: the charter wants a flight log with every job. Finish one more job, a parcel, a posting, a bounty claim, a sweep or an escort, then hand the log in at any trade dock. Our old hands debrief your pilots. Will you do it?",
