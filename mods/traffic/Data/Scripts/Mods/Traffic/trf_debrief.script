		dbpay1e = "Debrief filed: +$2 experience for each pilot. That was the last debrief this chapter.",
		dbpayne = "Debrief filed: $1 jobs, +$2 experience for each pilot. That was the last debrief this chapter.",
		dbnew = "Charter office: a new chapter, new questions. Debriefs this chapter: $1.",
		dbt = "Report in",
		dbd10 = "The charter office wants a flight log. Finish one more job: a parcel, a charter posting, a bounty claim, a sweep or an escort.",
		dbd20k1 = "Job done: the parcel run. Hand the flight log in at any trade dock.",
		dbd20k2 = "Job done: the charter posting. Hand the flight log in at any trade dock.",
		dbd20k3 = "Job done: the bounty claim. Hand the flight log in at any trade dock.",
		dbd20k4 = "Job done: the sweep. Hand the flight log in at any trade dock.",
		dbd20k5 = "Job done: the escort. Hand the flight log in at any trade dock.",
		dbd30 = "The office has your log. Debriefs pay at trade docks after each job, a few per chapter.",
		dbet = "Debriefs",
		dbed = "The charter office has heard enough from your pilots this chapter. Debriefs open again next chapter.",
		dblog = "Charter job added to the Job log.",
		dbk1 = "the parcel run",
		dbk2 = "the charter posting",
		dbk3 = "the bounty claim",
		dbk4 = "the sweep",
		dbk5 = "the escort",
		-- D1 the offer
		db1p1 = "Your posting's paid and filed, captain. One more paragraph, if you have a minute. The charter wants a flight log with every job, and nobody ever brings one.",
		db1awhat = "What does the office do with flight logs?",
		db1p2 = "Reads them. Your pilots tell us where the lanes went bad and why, and our old hands tell them what they know in return. Call it a debrief. Finish one more job, any job, then bring the log to a trade dock.",
