-- sw3-traffic loader (Lua 4.0.1).
-- The DLL hook T2a appends "Mods/Traffic/traffic.script" to sys_IncludeFileList, so ParseSystemScripts
-- runs this file last on every MapInitialization run (location entry, savegame load, menu): next() visits the
-- 1..n keys in order (host Lua 4.0.1 and the game's LOGfile.txt agree), but Lua 4.0 does not guarantee it.
-- TRF_Main runs protected, so an error here cannot stop ParseSystemScripts from loading later includes.
-- Top level only defines functions and guard-installs wrappers. Data globals set here would be cleared
-- (entry) or overwritten by the save restore (load); all state lives in the global table TRF.
-- v0.1 (design/v01-spec.md 10.1): with exp 0 and cfg traffic/enabled not 0, TRF_Main also loads the traffic
-- modules and installs the generator thunks; the callbacks then dispatch to the modules' service functions.
-- v0.2 (design/v02-spec.md 10.3): after the v0.1 core, trf_region, trf_tier, trf_raid, trf_shop and trf_hail load
-- one by one (a failed file only disables its features); cfg enabled 2 loads trf_state, trf_safety and trf_shop
-- only (restore-and-stop). trf_state replaces TRF_Init with the v4 layout; the TRF_Init below is the v1
-- fallback for the exp kits.
-- v1 (design/v1-spec.md 10.3): trf_loc, trf_track, trf_faction, trf_clan, trf_convoy, trf_danger, trf_supply and
-- trf_base load one by one after the v0.2 files; enabled 2 adds trf_base (base removal). Missing service
-- functions are skipped (TRF_P), so a failed v1 file only disables its features.
-- Station voices (design/station-voices-spec.md 12.2): trf_station loads last, after the v1 files, counted in the
-- load line as extra= (modules= keeps the v1 count); TRF_InstallStation runs after TRF_InstallTradeDock.

function TRF_Path(name)
	return "DATA/Scripts/Mods/Traffic/"..name;
end;

-- Config table from config.script; defaults when it is missing or broken.
function TRF_Cfg()
	if type(TRF_Config) == "function" then
		local c = TRF_Config();
		if type(c) == "table" then return c; end;
	end;
	return {exp=0, log=1};
end;

function TRF_ExpId()
	local e = TRF_Cfg().exp or 0;
	if e == 0 and TRF_TrafficOn() then return "v1"; end;
	return "E0."..tostring(e);
end;

-- Traffic modules wanted: exp 0 (kits and traffic never run together), cfg traffic and enabled not 0.
function TRF_TrafficOn()
	local c = TRF_Cfg();
	local e = c.exp or 0;
	return e == 0 and c.traffic ~= 0 and c.enabled ~= 0;
end;

-- Traffic modules loaded (trf_state defines TRF_State_Tick) and wanted by the config.
function TRF_Traffic()
	return type(TRF_State_Tick) == "function" and TRF_TrafficOn();
end;

-- Log through the DLL native (sw3tp.log, "traffic: lua: exp=<id> ..."), else the engine log, else nothing.
-- Lines are logfmt (design/log-format.md); new log sites use TRF_Lf, TRF_L stays for unconverted modules.
function TRF_L(s)
	local c = TRF_Cfg();
	if c.log == 0 then return; end;
	local line = "exp="..TRF_ExpId().." "..tostring(s);
	if type(TRF_Log) == "function" then
		TRF_Log(line);
	elseif type(LOG) == "function" then
		LOG("traffic: lua: "..line);
	end;
end;

-- logfmt value (log-format.md 3): numbers via tostring, nil as nil, tables through TRF_Dump in quotes; a
-- string (or other value) is bare unless it is empty or contains a space, "=" or a double quote, then it is
-- double-quoted with " escaped as \".
function TRF_KvV(v)
	if type(v) == "number" then return tostring(v); end;
	local s;
	if type(v) == "table" then s = TRF_Dump(v, 3); else s = tostring(v); end;
	if type(v) ~= "table" and s ~= "" and not strfind(s, '[ ="]') then return s; end;
	return '"'..gsub(s, '"', '\\"')..'"';
end;

-- logfmt flag: "true" for 1 / TRUE, else "false" (the mod's 1/0 and 1/nil flags, log-format.md 3).
function TRF_KvB(v)
	if v == 1 or (TRUE ~= nil and v == TRUE) then return "true"; end;
	return "false";
end;

-- "k1=v1 k2=v2" from alternating key, value arguments; arg.n keeps nil values in place, an odd trailing key
-- gets =nil. Keys are written with tostring, values through TRF_KvV.
function TRF_Kv(...)
	local s = "";
	local i = 1;
	while i <= arg.n do
		if i > 1 then s = s.." "; end;
		s = s..tostring(arg[i]).."="..TRF_KvV(arg[i + 1]);
		i = i + 2;
	end;
	return s;
end;

-- One logfmt event line: "exp=<id> module=<module> event=<event> k1=v1 ...". Module wrappers fix the module
-- (tinsert(arg, 1, event); tinsert(arg, 1, "<module>"); call(TRF_Lf, arg)). Nothing is built when log is 0.
function TRF_Lf(module, event, ...)
	if TRF_Cfg().log == 0 then return; end;
	local s = "module="..tostring(module).." event="..tostring(event);
	if arg.n > 0 then s = s.." "..call(TRF_Kv, arg); end;
	TRF_L(s);
end;

-- Call a global function by name if it exists; nil otherwise (natives that may be missing).
-- Passes exactly the arguments given (arg.n), so natives that check lua_gettop see no extra nils.
function TRF_N(name, ...)
	local f = getglobal(name);
	if type(f) == "function" then return call(f, arg); end;
	return nil;
end;

-- Player mothership for module code: trf_safety's TRF_Safe_Ms (never GetPlayerMotherShip from a tick,
-- design/mod-research/crash-load-5adc5e.md), else the native (trf_safety not loaded: exp kits, enabled 2).
function TRF_Ms()
	if type(TRF_Safe_Ms) == "function" then return TRF_Safe_Ms(); end;
	return TRF_N("GetPlayerMotherShip");
end;

-- Error handler of TRF_P: a mod log line (event=error) instead of a ScriptErrors.log entry.
function TRF_Err(m)
	TRF_Lf("core", "error", "message", tostring(m));
end;

-- Protected call of a module function by name (nil when missing or on error), so an error in one
-- module cannot stop the others or the engine callback.
function TRF_P(name, ...)
	local f = getglobal(name);
	if type(f) == "function" then return call(f, arg, "x", TRF_Err); end;
	return nil;
end;

-- Callback names of the hit shims (TRF_Cb) -> position of the gen argument in args, chunk local.
local CBH = {TRF_OnAttack=3, TRF_OnRaidHit=3, TRF_OnRespHit=3, TRF_OnBaseHit=2, TRF_CvEscHit=3,
	TRF_FeqAttack=3, TRF_SwHit=3, TRF_CtJoinPart=3, TRF_OnCarrierHit=2};

-- Protected trigger callback (review O1): the string action calls a thin shim, the shim calls
-- TRF_Cb(name, body, {args}). An error in the body stops there (call "x" returns nil) instead of
-- reaching the engine's trigger execution and ScriptErrors.log. The action strings stay unchanged.
-- Combat source hit (design/mod-research/combat-state.md 2.1 a2): the shims of player hits on mod ships
-- mark combat through trf_safety's TRF_CombatMark (debounced there, tune combat_hit_n/combat_hit_win) only
-- when their gen argument is the current TRF.gen: a stale trigger on a ship dropped at load never counts.
-- TRF_OnLowHP (pirates on a trader, possibly far away) is left to the raid source, which tests the distance.
function TRF_Cb(name, f, args)
	if type(f) ~= "function" then return nil; end;
	local gi = %CBH[name];
	if gi and type(TRF_CombatMark) == "function" and type(args) == "table" and type(TRF) == "table"
		and args[gi] ~= nil and args[gi] == TRF.gen then
		call(TRF_CombatMark, {"hit", name}, "x", TRF_Err);
	end;
	return call(f, args, "x", function(m) TRF_CbErr(%name, m); end);
end;

-- Error handler of TRF_Cb: every error is counted (traffic: live.stat err_<name> and err; exp kits:
-- exp.cnt err_<name>), only the first per name and visit is logged (event=error source=<name>).
function TRF_CbErr(name, m)
	local n = nil;
	if type(TRF_Stat) == "function" then
		n = TRF_Stat("err_"..tostring(name));
	elseif type(TRF) == "table" and type(TRF.exp) == "table" then
		n = TRF_Count("err_"..tostring(name));
	end;
	if type(n) == "number" and n > 1 then
		if type(TRF_Stat) == "function" then TRF_Stat("err"); end;
		return;
	end;
	if type(TRF_Stat) == "function" then TRF_Stat("err"); end;
	TRF_Lf("core", "error", "source", tostring(name), "repeats", "counted_not_logged", "message", tostring(m));
end;

-- Game-time period timer in the handle table (never saved; restarts on entry and load): 1 every p seconds.
function TRF_Every(key, dg, p)
	if type(TRF_H) ~= "function" or type(dg) ~= "number" then return nil; end;
	local h = TRF_H();
	if type(h) ~= "table" then return nil; end;
	if type(h.ev) ~= "table" then h.ev = {}; end;
	local v = (h.ev[key] or 0) + dg;
	if v < p then h.ev[key] = v; return nil; end;
	v = v - p;
	if v >= p then v = 0; end;
	h.ev[key] = v;
	return 1;
end;

-- Engine booleans: some natives return 1/0 (TRUE/FALSE), some nil for false.
function TRF_Is(v)
	if v == nil or v == 0 or v == FALSE then return nil; end;
	return 1;
end;

function TRF_F(x)
	if type(x) == "number" then return format("%.3f", x); end;
	return tostring(x);
end;

-- One-line dump of a value; depth limits nesting, tables with more than 20 entries are summarised.
function TRF_Dump(t, depth)
	if type(t) == "string" then return format("%q", t); end;
	if type(t) ~= "table" then return tostring(t); end;
	depth = depth or 3;
	local n = 0;
	for k, v in t do n = n + 1; end;
	if depth <= 0 then return "{..."..n.."}"; end;
	if n > 20 then return "{<"..n.." entries>}"; end;
	local s = "{";
	local first = 1;
	for k, v in t do
		if not first then s = s..", "; end;
		first = nil;
		s = s..tostring(k).."="..TRF_Dump(v, depth - 1);
	end;
	return s.."}";
end;

-- v1 fallback (exp kits; trf_state redefines it): create TRF when missing; repair the fields the loader
-- uses when a restored TRF lacks them or has the wrong type. Phase 0 saves have clock.game, renamed to
-- clock.gt (v01-spec 3.1). Returns 1 when it created a new table.
function TRF_Init()
	if type(TRF) ~= "table" then
		TRF = {version=1, active=1, gen=0, clock={gt=0, real=0}, exp={}};
		return 1;
	end;
	if type(TRF.version) ~= "number" then TRF.version = 1; end;
	if type(TRF.gen) ~= "number" then TRF.gen = 0; end;
	if type(TRF.clock) ~= "table" then TRF.clock = {}; end;
	if type(TRF.clock.gt) ~= "number" then
		if type(TRF.clock.game) == "number" then TRF.clock.gt = TRF.clock.game; else TRF.clock.gt = 0; end;
	end;
	TRF.clock.game = nil;
	if type(TRF.clock.real) ~= "number" then TRF.clock.real = 0; end;
	if type(TRF.exp) ~= "table" then TRF.exp = {}; end;
	return nil;
end;

function TRF_Count(name)
	if type(TRF.exp.cnt) ~= "table" then TRF.exp.cnt = {}; end;
	if type(TRF.exp.cnt[name]) ~= "number" then TRF.exp.cnt[name] = 0; end;
	TRF.exp.cnt[name] = TRF.exp.cnt[name] + 1;
	return TRF.exp.cnt[name];
end;

-- Callbacks the DLL calls ------------------------------------------------------------

-- T2b: after functions.script on location entry. Traffic: TRF_State_OnEnter sets active, gen + 1, the
-- visit table and the entry leg.
function TRF_OnEnter()
	local fresh = TRF_Init();
	if TRF_Traffic() then
		TRF_P("TRF_State_OnEnter", fresh);
		TRF_P("TRF_Safety_OnEnter");
		TRF_P("TRF_Stn_OnEnter");
		TRF.active = 1;
	else
		TRF.active = 1;
		TRF.gen = TRF.gen + 1;
	end;
	local n = TRF_Count("enter");
	if TRF_Cfg().exp == 0 then TRF_Lf("core", "enter", "enter_count", n, "fresh", TRF_KvB(fresh)); end;
	TRF_N("TRF_Exp_OnEnter", fresh);
end;

-- T2c: after activate.script on location entry (the location's own flights exist).
function TRF_OnActivate()
	local fresh = TRF_Init();
	TRF.active = 1;
	TRF_Count("activate");
	if TRF_Traffic() then
		TRF_P("TRF_State_OnActivate");
		TRF_P("TRF_Safety_OnActivate");
		TRF_P("TRF_Base_OnActivate");
		TRF_P("TRF_Tier_OnActivate");
		TRF_P("TRF_Track_OnActivate");
		TRF_P("TRF_Gen_OnActivate");
		TRF_P("TRF_UI_OnActivate");
		TRF_P("TRF_Stn_OnActivate");
		TRF_P("TRF_DumpState", "enter");
	end;
	TRF_N("TRF_Exp_OnActivate", fresh);
	-- Baseline save kit (exp_saves.script, config autosave), independent of the experiment.
	if type(TRF_Saves_OnActivate) == "function" then TRF_Saves_OnActivate(fresh); end;
end;

-- T2d: after functions.script on savegame load (TRF is restored from the save, or nil for a save made without the mod).
-- Traffic: TRF_State_OnLoad migrates and sets gen + 1; TRF_Gen_OnLoad runs the load pass (spec 5.5).
function TRF_OnLoad()
	local fresh = TRF_Init();
	if TRF_Traffic() then
		TRF_P("TRF_State_OnLoad", fresh);
		TRF_P("TRF_Safety_OnLoad");
		TRF_P("TRF_Gen_OnLoad");
		TRF_P("TRF_Tier_OnLoad");
		TRF_P("TRF_Raid_OnLoad");
		TRF_P("TRF_Hail_OnLoad");
		local v1 = {"Base", "Track", "Clan", "Faction", "Convoy", "Danger", "Supply", "Stn"};
		for i = 1, getn(v1) do TRF_P("TRF_"..v1[i].."_OnLoad"); end;
		TRF.active = 1;
		TRF_P("TRF_DumpState", "load");
	else
		TRF.active = 1;
		TRF.gen = TRF.gen + 1;
	end;
	local n = TRF_Count("load");
	if TRF_Cfg().exp == 0 then TRF_Lf("core", "load", "load_count", n, "fresh", TRF_KvB(fresh)); end;
	TRF_N("TRF_Exp_OnLoad", fresh);
end;

-- T4: every tick_ms of real time; dt_game is scaled game time, dt_real QPC seconds.
function TRF_OnTick(dt_game, dt_real)
	if type(TRF) ~= "table" or not TRF.active then return; end;
	if type(dt_game) ~= "number" then dt_game = 0; end;
	if type(dt_real) ~= "number" then dt_real = 0; end;
	if TRF_Traffic() then
		-- H.intick marks the dispatch for TRF_Safe_Ms (no GetPlayerMotherShip from a tick); every call below
		-- is protected, so the flag is always cleared.
		local th = TRF_N("TRF_H");
		if type(th) == "table" then th.intick = 1; end;
		-- Clock, legs and due calls; extortion sampling; manager step and dump on their game-time timers.
		TRF_P("TRF_State_Tick", dt_game, dt_real);
		TRF_P("TRF_Safety_Tick");
		TRF_P("TRF_Raid_Tick", dt_game);
		TRF_P("TRF_Q_Tick", dt_game);
		TRF_P("TRF_CarrierTick", dt_game);
		if TRF_Every("s1", dt_game, 1) then
			TRF_P("TRF_Feq_Step");
			TRF_P("TRF_Dc_Step");
			TRF_P("TRF_Carrier_Step");
		end;
		if TRF_Every("s2", dt_game, 2) then TRF_P("TRF_Sweep_Step"); end;
		if TRF_P("TRF_StepDue", dt_game) then
			TRF_P("TRF_Gen_Step");
			TRF_P("TRF_Events_Step");
			TRF_P("TRF_Raid_Step");
			TRF_P("TRF_Tier_Step");
			TRF_P("TRF_Supply_Step");
			TRF_P("TRF_Base_Step");
		end;
		if TRF_P("TRF_DumpDue", dt_game) then TRF_P("TRF_DumpState", "tick"); end;
		if type(th) == "table" then th.intick = nil; end;
		return;
	end;
	if type(TRF.clock) ~= "table" or type(TRF.clock.gt) ~= "number" or type(TRF.clock.real) ~= "number" then TRF_Init(); end;
	if type(TRF.exp) ~= "table" then TRF.exp = {}; end;
	TRF.clock.gt = TRF.clock.gt + dt_game;
	TRF.clock.real = TRF.clock.real + dt_real;
	TRF_N("TRF_Exp_OnTick", dt_game, dt_real);
end;

-- Called by the jump wrappers before the original native (how "custom" from CustomTeleportate: no pool
-- writes, v1 4.2). Ticks stop until the next OnEnter.
-- CHECK: a cancelled jump leaves TRF.active nil until the next entry; jumps the engine starts
-- without these natives (galaxy map, quest C code) bypass this function.
function TRF_BeforeJump(dest, how)
	if type(TRF) ~= "table" then return; end;
	TRF.active = nil;
	TRF_Init();
	TRF_Count("jump");
	if TRF_Traffic() then
		TRF_P("TRF_Hail_BeforeJump");
		TRF_P("TRF_Track_BeforeJump", dest, how);
		local v1 = {"Faction", "Clan", "Convoy", "Danger", "Supply", "Base", "Stn"};
		for i = 1, getn(v1) do TRF_P("TRF_"..v1[i].."_BeforeJump"); end;
		TRF_P("TRF_Raid_BeforeJump");
		TRF_P("TRF_Gen_BeforeJump", dest);
		TRF_P("TRF_DumpState", "jump");
	end;
	TRF_N("TRF_Exp_BeforeJump", dest);
end;

-- Jump wrappers. arg holds the exact argument count (arg.n), so call() passes the natives what they got.
-- TRF_BeforeJump runs protected ("x"): an error in mod code goes to _ALERT and the jump still happens.
function TRF_Wrap_Teleport(...)
	call(TRF_BeforeJump, {arg[1]}, "x");
	return call(TRF_orig_TeleportToLocation, arg);
end;

function TRF_Wrap_CustomTeleportate(...)
	call(TRF_BeforeJump, {arg[2], "custom"}, "x");
	return call(TRF_orig_CustomTeleportate, arg);
end;

-- Guard-install: the saved originals are function globals (survive ClearGlobals, never saved),
-- so later MapInitialization runs see them and do not wrap twice.
function TRF_InstallWraps()
	local w = {tp_before=type(TeleportToLocation), ct_before=type(CustomTeleportate), tp_new=0, ct_new=0};
	if not TRF_orig_TeleportToLocation and type(TeleportToLocation) == "function" then
		TRF_orig_TeleportToLocation = TeleportToLocation;
		TeleportToLocation = TRF_Wrap_Teleport;
		w.tp_new = 1;
	end;
	if not TRF_orig_CustomTeleportate and type(CustomTeleportate) == "function" then
		TRF_orig_CustomTeleportate = CustomTeleportate;
		CustomTeleportate = TRF_Wrap_CustomTeleportate;
		w.ct_new = 1;
	end;
	w.tp_after = type(TeleportToLocation);
	w.ct_after = type(CustomTeleportate);
	-- A later run redefines TRF_Wrap_*, so test against the saved original. The installed wrapper
	-- looks up TRF_BeforeJump and TRF_orig_* by name and keeps working.
	w.tp_wrapped = (TRF_orig_TeleportToLocation and TeleportToLocation ~= TRF_orig_TeleportToLocation) and 1 or 0;
	w.ct_wrapped = (TRF_orig_CustomTeleportate and CustomTeleportate ~= TRF_orig_CustomTeleportate) and 1 or 0;
	return w;
end;

-- ExecuteScriptFile returns 1 on success and nil when the file is missing or fails.
function TRF_LoadFile(name)
	local ok = ExecuteScriptFile(TRF_Path(name));
	if not ok then TRF_Lf("core", "file_load", "file", name, "result", "failed"); end;
	return ok;
end;

function TRF_Main()
	TRF_LoadFile("config.script");
	local wraps = TRF_InstallWraps();
	local e = TRF_Cfg().exp;
	local files = {"exp_hooks.script", "exp_state.script", "exp_trader.script"};
	if type(e) == "number" and files[e] then TRF_LoadFile(files[e]); end;
	local sv = TRF_Cfg().autosave;
	if sv == 1 or sv == 2 then TRF_LoadFile("exp_saves.script"); end;
	-- map.script is generated and optional; a missing file only logs "cannot load script file" in LOGfile.txt.
	local m = ExecuteScriptFile(TRF_Path("map.script"));
	TRF_N("TRF_Exp_Init", wraps, m);
	-- v0.1 core in the v01 10.1 order, all or nothing: a failed file leaves the later ones unloaded (no
	-- install, TRF_GenReady false, vanilla generator). The v0.2 files load each on its own (v02 10.3). The
	-- installs run on every MapInitialization, after the vanilla includes have redefined the wrapped functions.
	-- cfg enabled 2 (checked before TRF_TrafficOn, which only tests enabled ~= 0): state, safety, shop and the
	-- trade-dock wrapper, so changed station prices are restored at the next trade docking.
	local nm, ne = 0, 0;
	if TRF_TrafficOn() and TRF_Cfg().enabled == 2 then
		local mods = {"trf_state.script", "trf_safety.script", "trf_shop.script", "trf_base.script"};
		for i = 1, getn(mods) do if TRF_LoadFile(mods[i]) then nm = nm + 1; end; end;
		TRF_P("TRF_InstallTradeDock");
	elseif TRF_TrafficOn() then
		local mods = {"trf_state.script", "trf_safety.script", "trf_ui.script", "trf_events.script", "trf_gen.script"};
		local ok = 1;
		for i = 1, getn(mods) do
			if ok then ok = TRF_LoadFile(mods[i]); if ok then nm = nm + 1; end; end;
		end;
		if ok then
			local v2 = {"trf_region.script", "trf_tier.script", "trf_raid.script", "trf_shop.script", "trf_hail.script"};
			for i = 1, getn(v2) do if TRF_LoadFile(v2[i]) then nm = nm + 1; end; end;
			local v1 = {"loc", "track", "faction", "clan", "convoy", "danger", "supply", "base"};
			for i = 1, getn(v1) do if TRF_LoadFile("trf_"..v1[i]..".script") then nm = nm + 1; end; end;
			local ex = {"station"};
			for i = 1, getn(ex) do if TRF_LoadFile("trf_"..ex[i]..".script") then ne = ne + 1; end; end;
			TRF_P("TRF_InstallGen");
			TRF_P("TRF_InstallTradeDock");
			TRF_P("TRF_InstallStation");
			TRF_P("TRF_InstallBoard");
			TRF_P("TRF_InstallPirDock");
			TRF_P("TRF_InstallRelDock");
		end;
	end;
	if e == 0 then
		TRF_Lf("core", "loaded", "map", TRF_KvB(m), "module_count", nm, "extra_count", ne,
			"teleport_wrapped", TRF_KvB(wraps.tp_wrapped), "custom_teleportate_wrapped", TRF_KvB(wraps.ct_wrapped));
	end;
end;

call(TRF_Main, {}, "x");
