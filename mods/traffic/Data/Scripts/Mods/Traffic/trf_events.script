-- sw3-traffic events (v0.1 spec 7.2-7.4, 10.2, 10.3): attack and death triggers of traffic transports,
-- T_deliberate heat, kill effects, the vanilla-equivalent attack response, pirate-kill recovery.
-- Top level only defines functions. Plain state lives in TRF.live (records, counters); handles only in
-- the trf_state handle table TRF_H() (H.tr, H.resp, H.pir), which is empty after every entry and load.
-- Callbacks arrive as string actions "TRF_OnAttack(id,k,g)--" and exit when g is not the current TRF.gen.
-- Functions of other modules are called through type checks, so a missing module disables a feature only.
-- v0.2 (spec 8.1, 9.1, 9.6, 10.2): counted attack -> patk, pro -1, graded response by heat tier; kill ->
-- raid record, clan, shortage, contract, pro; raid flights excluded from the eject watch; clan score and
-- credit on pirate kills; TRF_HeatTier and the heat-reaction poll.
-- v1 (v1-spec 6.3, 7.6, 8.3, 8.7, 10.2): faction-owned traders (r.own, supply convoys): counted attack ->
-- fst -1 once per visit (not on a group seeded hostile), kill without counted player fire -> salvage +1 to
-- the clan (<= 2 per visit, live.fsv), no heat; TT4 (or equipment) convoy killed with counted player fire ->
-- forced Bust; tracked traders -> TRF_TrackGone; response flights at the owner's rung (TRF_FacFlight) with
-- died/attack triggers for the same salvage rule; salvaged pirate flights (H.svf) -> TRF_SalvUse on death.
-- Base and carrier triggers have their own shims (TRF_OnBaseHit/TRF_OnBaseDied in trf_base, TRF_OnCarrierDied
-- in trf_clan); on-screen sweep and equipment convoy flights give salvage only through their outcome.

-- Constants without a tune key.
function TRF_Ev_K()
	return {arm_max=200, rec_max=2, pir_max=32, exit_r=60, sign_max=12, heat_d=1, kill_dis=2};
end;

-- Logging -----------------------------------------------------------------------------

-- logfmt event line, module=events (design/log-format.md).
function TRF_EvE(event, ...)
	tinsert(arg, 1, event); tinsert(arg, 1, "events"); call(TRF_Lf, arg);
end;

-- Debug event lines only at cfg log 2.
function TRF_EvDE(event, ...)
	local v = TRF_Ev_Opt("log", 1);
	if type(v) ~= "number" or v < 2 then return; end;
	tinsert(arg, 1, event); call(TRF_EvE, arg);
end;

-- Config and state helpers --------------------------------------------------------------

-- cfg value or default (TRF_Opt from trf_state when loaded, else the raw config table).
function TRF_Ev_Opt(key, def)
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil then v = TRF_Cfg()[key]; end;
	if v == nil then return def; end;
	return v;
end;

function TRF_Ev_Tune(key, def)
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" and type(t[key]) == "number" then return t[key]; end;
	end;
	return def;
end;

function TRF_Ev_Gt()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.gt) == "number" then return TRF.clock.gt; end;
	return 0;
end;

-- TRF.live when it is usable, else nil.
function TRF_Ev_Live()
	if type(TRF) ~= "table" or type(TRF.live) ~= "table" then return nil; end;
	if type(TRF.live.tr) ~= "table" then TRF.live.tr = {}; end;
	return TRF.live;
end;

function TRF_Ev_Stat(key)
	local L = TRF_Ev_Live();
	if not L then return; end;
	if type(L.stat) ~= "table" then L.stat = {}; end;
	L.stat[key] = (L.stat[key] or 0) + 1;
end;

function TRF_Ev_H()
	if type(TRF_H) ~= "function" then return nil; end;
	local H = TRF_H();
	if type(H) ~= "table" then return nil; end;
	return H;
end;

-- Handle entry H.tr[id] = {fl, sh, tp, ent, ext} written by trf_gen, or nil.
function TRF_Ev_HTr(id)
	local H = TRF_Ev_H();
	if not H or type(H.tr) ~= "table" then return nil; end;
	local h = H.tr[id];
	if type(h) ~= "table" then return nil; end;
	return h;
end;

-- Record of a live trader (st ~= "gone") without the generation check.
function TRF_Ev_RecAny(id)
	if type(TRF_Rec) == "function" then return TRF_Rec(id); end;
	local L = TRF_Ev_Live();
	if not L then return nil; end;
	local r = L.tr[id];
	if type(r) ~= "table" or r.st == "gone" then return nil; end;
	return r;
end;

-- Callback entry check: current generation and a live record.
function TRF_Ev_Rec(id, g, what)
	if not TRF_Ev_Live() then return nil; end;
	if g ~= TRF.gen then
		TRF_EvDE("stale_callback", "source", what, "trader_id", id, "generation", g, "current_generation", TRF.gen);
		return nil;
	end;
	local r = TRF_Ev_RecAny(id);
	if not r then TRF_EvDE("no_record", "source", what, "trader_id", id); end;
	return r;
end;

-- 1 while __disableAction is set or trf_safety reports pause or wind-down (R2, R3). Vanilla parity: the
-- attack response (Call_SOS_command) reads neither __sys_SOS nor combat; only its lines go through TRF_Quiet.
function TRF_Ev_Supp()
	if __disableAction == TRUE then return 1; end;
	if type(TRF_Supp) == "function" then
		local s = TRF_Supp();
		if type(s) == "number" and s ~= 0 then return 1; end;
	end;
	return nil;
end;

function TRF_Ev_Due(dt, fname, a, b)
	if type(TRF_Due) ~= "function" then
		TRF_EvE("missing_function", "function", "TRF_Due", "source", fname, "result", "dropped");
		return nil;
	end;
	return TRF_Due(dt, fname, a, b);
end;

function TRF_Ev_Dist(a, b)
	if type(a) ~= "table" and type(a) ~= "userdata" then return nil; end;
	if type(b) ~= "table" and type(b) ~= "userdata" then return nil; end;
	local dx = a.x - b.x;
	local dy = a.y - b.y;
	local dz = a.z - b.z;
	return sqrt(dx*dx + dy*dy + dz*dz);
end;

function TRF_Ev_Off(p, x, y, z)
	return Vector3(p.x + x, p.y + y, p.z + z);
end;

-- Native accessors (one per native; every handle is nil-checked first) ------------------------

-- IsAlive pushes 1 or nil.
function TRF_Ev_Alive(o)
	if not o then return nil; end;
	return TRF_Is(o:IsAlive());
end;

function TRF_Ev_Pos(o)
	if not TRF_Ev_Alive(o) then return nil; end;
	return o:GetPosition();
end;

-- Static map objects (portals) are not tested with IsAlive.
function TRF_Ev_ObjPos(o)
	if not o then return nil; end;
	return o:GetPosition();
end;

function TRF_Ev_Del(fl)
	if TRF_Ev_Alive(fl) then fl:Delete(); return 1; end;
	return nil;
end;

function TRF_Ev_Start(portal, a, b)
	if portal then portal:Start(a, b); end;
end;

-- Radio line with portrait (Pilot:Message), used for the vanilla loc keys of the response.
function TRF_Ev_Msg(pilot, text, secs)
	if not pilot then return nil; end;
	pilot:Message(text, secs);
	return 1;
end;

-- Leader pilot of a traffic trader: Flight:GetLeader(), else the pilot of a live transport.
function TRF_Ev_Leader(id)
	local h = TRF_Ev_HTr(id);
	if not h then return nil; end;
	if TRF_Ev_Alive(h.fl) then
		local p = h.fl:GetLeader();
		if p then return p; end;
	end;
	if type(h.tp) == "table" then
		for i = 1, getn(h.tp) do
			if TRF_Ev_Alive(h.tp[i]) then return h.tp[i]:GetPilot(); end;
		end;
	end;
	return nil;
end;

-- First pilot of a flight (Flight:GetPilotByNumber, 1-based).
function TRF_Ev_Pilot1(fl)
	if not TRF_Ev_Alive(fl) then return nil; end;
	return fl:GetPilotByNumber(1);
end;

-- include/NewTriggers.script NewTrigger with the default condition and a string action.
function TRF_Ev_Trig(kind, cb, a, b)
	if type(NewTrigger) ~= "function" then return nil; end;
	return NewTrigger(kind, nil, cb, a, b);
end;

function TRF_Ev_Rand(n)
	if type(RAND) ~= "function" then return n; end;
	local r = RAND(n);
	if type(r) ~= "number" then return n; end;
	return r;
end;

function TRF_Ev_MShip()
	return TRF_Ms();
end;

-- Response team as vanilla Call_SOS_command2: the location team, "Neutral" -> "Patrol".
function TRF_Ev_RespTeam()
	local t = GetLocationTeam(GetCurrentLocation());
	if type(t) ~= "string" or t == "" or t == "Neutral" then t = "Patrol"; end;
	return t;
end;

function TRF_Ev_Group(team, name)
	local tm = CreateTeam(team);
	if not tm then return nil; end;
	return tm:CreateGroup(name);
end;

function TRF_Ev_Glow(pos, dir)
	CreatePortalGlow(pos, dir, 4);
end;

-- CreateChoiceFlight (include/Create_flight_2.script) returns FALSE (0) on failure.
function TRF_Ev_Choice(team, gname, sign, pos, ty, pw, dir)
	local fl = CreateChoiceFlight(team, gname, sign, pos, ty, pw, dir);
	if not fl or type(fl) == "number" then return nil; end;
	return fl;
end;

function TRF_Ev_AddHeat(d, why)
	if TRF_Ev_Opt("heat", 1) == 0 then return; end;
	if type(TRF_AddHeat) == "function" then TRF_AddHeat(d, why); else TRF_EvE("missing_function", "function", "TRF_AddHeat", "reason", why); end;
end;

function TRF_Ev_AddDis(idx, d, why)
	if TRF_Ev_Opt("dis", 1) == 0 or not idx then return; end;
	if type(TRF_AddDis) == "function" then TRF_AddDis(idx, d, why); else TRF_EvE("missing_function", "function", "TRF_AddDis", "reason", why); end;
end;

function TRF_Ev_DisOf(idx)
	if not idx or type(TRF_Dis) ~= "function" then return 0; end;
	local d = TRF_Dis(idx);
	if type(d) ~= "number" then return 0; end;
	return d;
end;

function TRF_Ev_CurIdx()
	if type(TRF_CurIdx) ~= "function" then return nil; end;
	return TRF_CurIdx();
end;

-- v1 helpers ------------------------------------------------------------------------------------

-- Faction index 1..5 (Vks, Kfni, Triada, Uss, Inoco) of a team name: trf_faction's TRF_FacIdx, else this list.
function TRF_Ev_FacIdx(team)
	local f = TRF_N("TRF_FacIdx", team);
	if type(f) == "number" then
		if f >= 1 and f <= 5 then return f; end;
		return nil;
	end;
	local t = {vks=1, kfni=2, triada=3, uss=4, inoco=5};
	if type(team) == "string" then return t[strlower(team)]; end;
	return nil;
end;

-- Team name of faction f: trf_faction's TRF_FacTeam, else this list.
function TRF_Ev_FacTeam(f)
	local t = TRF_N("TRF_FacTeam", f);
	if type(t) == "string" and t ~= "" then return t; end;
	local l = {"Vks", "Kfni", "Triada", "Uss", "Inoco"};
	return l[f];
end;

-- Bit b of a bit field (v1-spec 3.1 rule), 0 or 1.
function TRF_Ev_Bit(v, b)
	if type(v) ~= "number" then return 0; end;
	return mod(floor(v / b), 2);
end;

-- Owner faction of a trader record (supply convoys set own = 1..5), else nil (FTU).
function TRF_Ev_Own(rec)
	if type(rec) == "table" and type(rec.own) == "number" and rec.own >= 1 and rec.own <= 5 then return rec.own; end;
	return nil;
end;

-- 1 when f's groups toward the player were seeded hostile: team war or fst <= 2 (TRF_FstRel, 7.6).
function TRF_Ev_Hostile(f)
	if RELATION_WAR == nil then return nil; end;
	if TRF_N("TRF_FstRel", f) == RELATION_WAR then return 1; end;
	local t = TRF_Ev_FacTeam(f);
	if t and TRF_N("GetTeamRelation", t, PLAYER_TEAM) == RELATION_WAR then return 1; end;
	return nil;
end;

-- Counted attack on an f group: fst -1 once per visit (live.fstv[f]), nothing for a group seeded hostile.
function TRF_Ev_FstHit(f, why)
	if type(TRF_FstHit) == "function" then
		if call(TRF_FstHit, {f, TRF_Ev_Hostile(f), why}, "x", TRF_PErr) then TRF_EvE("faction_standing", "faction", f, "reason", tostring(why), "change", -1); end;
		return;
	end;
	local L = TRF_Ev_Live();
	if not L or not f or TRF_Ev_Hostile(f) then return; end;
	if type(L.fstv) ~= "table" then L.fstv = {}; end;
	if L.fstv[f] == 1 then return; end;
	L.fstv[f] = 1;
	TRF_N("TRF_FstAdd", f, -1, why);
	TRF_EvE("faction_standing", "faction", f, "reason", tostring(why), "change", -1);
end;

-- Faction flight of f destroyed without counted player fire in a region system: clan salvage +1, at most
-- 2 per visit (live.fsv, 6.3).
function TRF_Ev_Salv(f, why)
	local L = TRF_Ev_Live();
	local idx = TRF_Ev_CurIdx();
	if not L or not f or not idx or TRF_Ev_Opt("salvage", 1) == 0 then return; end;
	local slot = TRF_N("TRF_RgOf", idx);
	if type(slot) ~= "number" then return; end;
	-- The per-visit cap (live.fsv, salv_visit_max) is applied once, inside TRF_SalvAdd (trf_clan).
	local a = TRF_N("TRF_SalvAdd", slot, 1, f, why);
	TRF_EvE("salvage", "slot", slot, "faction", f, "reason", tostring(why), "amount", a, "visit_salvage", L.fsv);
end;

-- Text from trf_ui, else the 8.2 literal.
function TRF_Ev_Txt(key, lit)
	if type(TRF_Txt) == "function" then
		local s = TRF_Txt(key);
		if type(s) == "string" and s ~= "" and s ~= key then return s; end;
	end;
	return lit;
end;

-- Trigger arming (10.2) ------------------------------------------------------------------------

function TRF_Ev_CbAttack(id, k)
	return "TRF_OnAttack("..id..","..k..","..TRF.gen..")--";
end;

function TRF_Ev_CbDied(id, k)
	return "TRF_OnShipDied("..id..","..k..","..TRF.gen..")--";
end;

-- Attack and died triggers on every live transport of trader id. Returns the number armed.
function TRF_ArmShips(id)
	local L = TRF_Ev_Live();
	local h = TRF_Ev_HTr(id);
	if not L or not h or type(h.tp) ~= "table" then
		TRF_EvE("arm", "trader_id", id, "result", "no_handles");
		return 0;
	end;
	local rec = L.tr[id];
	if type(rec) == "table" then
		if type(rec.arm) ~= "number" then rec.arm = 0; end;
		if type(rec.fs) ~= "table" then rec.fs = {}; end;
	end;
	local n = 0;
	for k = 1, getn(h.tp) do
		local ship = h.tp[k];
		if TRF_Ev_Alive(ship) then
			local ta = TRF_Ev_Trig("attack", TRF_Ev_CbAttack(id, k), PLAYER_GROUP, ship);
			local td = TRF_Ev_Trig("died", TRF_Ev_CbDied(id, k), ship);
			if ta and td then
				n = n + 1;
			else
				TRF_EvE("arm", "trader_id", id, "ship", k, "attack_trigger", TRF_KvB(ta and 1), "died_trigger", TRF_KvB(td and 1),
					"result", "failed");
			end;
		end;
	end;
	TRF_EvDE("arm", "trader_id", id, "transport_count", getn(h.tp), "armed_count", n);
	return n;
end;

-- Attack (7.3, 10.3) ---------------------------------------------------------------------------

-- T_deliberate: distinct whole-second stamps of attack events within T_win; T_del of them count once.
function TRF_Ev_Deliberate(id, rec, gt)
	if rec.cnt then return; end;
	local win = TRF_Ev_Tune("T_win", 20);
	local need = TRF_Ev_Tune("T_del", 5);
	local s = floor(gt);
	local keep = {};
	local have = nil;
	if type(rec.fs) == "table" then
		for i = 1, getn(rec.fs) do
			local v = rec.fs[i];
			if type(v) == "number" and s - v < win then
				tinsert(keep, v);
				if v == s then have = 1; end;
			end;
		end;
	end;
	if not have then tinsert(keep, s); end;
	rec.fs = keep;
	if getn(keep) < need then return; end;
	rec.cnt = 1;
	rec.fs = {};
	TRF_Ev_AddHeat(TRF_Ev_K().heat_d, "attack "..id);
	TRF_Ev_Stat("attack_counted");
	local shown = nil;
	if type(TRF_Say) == "function" then
		shown = TRF_Say(TRF_Ev_Txt("cease", "Cease fire! This is a civilian freighter."), 6, TRF_Ev_Leader(id));
	end;
	TRF_EvE("counted_attack", "trader_id", id, "game_time", TRF_F(gt), "line_shown", TRF_KvB(shown));
	TRF_Ev_Counted(id, rec);
end;

-- v0.2 counted attack (8.1, 9.1): live.patk (tier cap TT2 for the visit), pro -1 once per visit, then the
-- graded response (8.1 "response after a counted attack").
function TRF_Ev_Counted(id, rec)
	local L = TRF_Ev_Live();
	if L and L.patk ~= 1 then
		L.patk = 1;
		TRF_Ev_ProAdd(TRF_Ev_CurIdx(), -1, "attack "..id);
	end;
	if not rec.resp then TRF_RespStart(id); end;
	-- v1: fst -1 once per visit for an f group (7.6); a counted attack tracks an FTU trader (4.2).
	local f = TRF_Ev_Own(rec);
	if f then
		TRF_Ev_FstHit(f, "attack "..id);
	elseif rec.feq ~= 1 then
		TRF_N("TRF_TrackMark", id, "attack");
	end;
end;

-- Re-arm the one-shot attack trigger on transport k, at most arm_max times per trader.
-- CHECK: how often _EVENT_ATTACKCARCASS fires under sustained fire (design 13.2); the log shows arm.
function TRF_Ev_Rearm(id, k, rec)
	local h = TRF_Ev_HTr(id);
	if not h or type(h.tp) ~= "table" then return; end;
	local ship = h.tp[k];
	if not TRF_Ev_Alive(ship) then return; end;
	if type(rec.arm) ~= "number" then rec.arm = 0; end;
	local mx = TRF_Ev_K().arm_max;
	if rec.arm >= mx then
		if rec.arm == mx then rec.arm = mx + 1; TRF_EvE("attack", "trader_id", id, "rearm_max", mx, "result", "rearm_cap"); end;
		return;
	end;
	rec.arm = rec.arm + 1;
	TRF_Ev_Trig("attack", TRF_Ev_CbAttack(id, k), PLAYER_GROUP, ship);
end;

-- Trigger callback: attack event of PLAYER_GROUP on transport k of trader id.
-- Trigger entry point (review O1): runs TRF_OnAttack_Body protected.
function TRF_OnAttack(id, k, g) TRF_Cb("TRF_OnAttack", TRF_OnAttack_Body, {id, k, g}); end;

-- v1: attacks on a pirate base arrive through trf_base's own shim TRF_OnBaseHit (one trigger per station).
function TRF_OnAttack_Body(id, k, g)
	local rec = TRF_Ev_Rec(id, g, "attack");
	if not rec then return; end;
	local gt = TRF_Ev_Gt();
	rec.pa = gt;
	TRF_EvDE("attack", "trader_id", id, "ship", k, "game_time", TRF_F(gt), "arm_count", rec.arm);
	TRF_Ev_Deliberate(id, rec, gt);
	TRF_Ev_Rearm(id, k, rec);
end;

-- Death and kill (7.2, 7.3) --------------------------------------------------------------------

-- Close a record without deleting its flight: escorts of a killed trader keep flying (Events_Step).
-- v0.2 (3.2): the gone record keeps only id, nm, cls, st, why and gg (gt of removal).
function TRF_Ev_Close(id, rec, why)
	rec.st = "gone";
	-- Handle globals kept for the save go with the record (trf_gen, v01 3.3).
	if type(TRF_GnClearSign) == "function" then call(TRF_GnClearSign, {"trf_"..tostring(id)}, "x", TRF_PErr); end;
	local L = TRF_Ev_Live();
	if L and rec.k then
		if type(L.grp) ~= "table" then L.grp = {}; end;
		if L.grp[rec.k] == id then L.grp[rec.k] = 0; end;
	end;
	TRF_Ev_Stat("remove_"..why);
	rec.why = why;
	rec.gg = TRF_Ev_Gt();
	local keep = {id=1, nm=1, cls=1, st=1, why=1, gg=1, tb=1, pi=1, cv=1, xt=1};
	if type(TRF_GoneKeep) == "function" then keep = TRF_GoneKeep(); end;
	local ks = {};
	for k, v in rec do
		if not keep[k] then tinsert(ks, k); end;
	end;
	for i = 1, getn(ks) do rec[ks[i]] = nil; end;
end;

function TRF_Ev_ProAdd(idx, d, why)
	if type(idx) == "number" and type(TRF_ProAdd) == "function" then call(TRF_ProAdd, {idx, d, why}, "x", TRF_PErr); end;
end;

-- Shortage of class cls at system idx for L_short legs (7.2), through trf_shop.
function TRF_Ev_Short(idx, cls)
	if type(idx) ~= "number" or type(TRF_ShortAdd) ~= "function" then return; end;
	local c = cls;
	if type(c) ~= "number" or c < 1 or c > 6 then c = 6; end;
	local legs = 0;
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then legs = TRF.clock.legs; end;
	call(TRF_ShortAdd, {idx, c, legs + TRF_Ev_Tune("L_short", 6)}, "x", TRF_PErr);
end;

-- v0.2 kill effects (5.2, 5.4, 5.6, 7.2, 9.1, 9.6): the trader's raid record (no pay), clan +1 when an open
-- raid killed it (the visit cap is TRF_ClanAdd's), path A shortage (killed before docking), contract lost,
-- pro -1 (others) or -3 (player).
function TRF_Ev_KillV2(id, rec, by, idx)
	local L = TRF_Ev_Live();
	local rd = nil;
	if type(rec.rdn) == "number" and type(L.rd) == "table" then rd = L.rd[rec.rdn]; end;
	if type(rd) == "table" then
		rd.tk = 1;
		if rd.st ~= "end" and by ~= "player" and type(idx) == "number" then
			local slot = TRF_N("TRF_RgOf", idx);
			if type(slot) == "number" then TRF_N("TRF_ClanAdd", slot, 1, "raid kill "..id); end;
		end;
	end;
	if rec.path == "A" then TRF_Ev_Short(idx, rec.cls); end;
	if type(L.ct) == "table" and L.ct.id == id then TRF_N("TRF_CtLost", id); end;
	local d = -1;
	if by == "player" and not TRF_Ev_Own(rec) then d = -3; end;
	TRF_Ev_ProAdd(idx, d, "kill "..id);
end;

function TRF_Ev_Kill(id, rec, h)
	local L = TRF_Ev_Live();
	local gt = TRF_Ev_Gt();
	local idx = TRF_Ev_CurIdx();
	local by = "other";
	-- CHECK: the engine reports no killer; a player attack event within pk_win is the proxy (design 13.2).
	if type(rec.pa) == "number" and gt - rec.pa <= TRF_Ev_Tune("pk_win", 10) then by = "player"; end;
	-- v1 5.1: a faction-owned trader (supply convoy) gives no heat; taken by pirates it gives dis +1.
	local own = TRF_Ev_Own(rec);
	local kd = TRF_Ev_K().kill_dis;
	if own and by ~= "player" then kd = 1; end;
	TRF_Ev_AddDis(idx, kd, "kill "..id);
	if by == "player" then
		L.kills = (L.kills or 0) + 1;
		if not own then
			TRF_Ev_AddHeat(TRF_Ev_K().heat_d, "kill "..id);
			-- Equipment convoy heat top-up (v1 8.4, TRF_FeqEnd) counts this kill heat.
			TRF_N("TRF_FeqKillMark", id);
		end;
	end;
	if h then
		h.kl = 1; h.kt = gt;
		-- Escort flight (esc_flight): its Escort target is dead, so it takes the trader's exit route.
		if TRF_Ev_Alive(h.ef) and h.ext then
			call(function(f, o) f:Patrol({o:GetEntryPoint(50), o:GetEntryPoint(1)}, FALSE); end, {h.ef, h.ext}, "x", TRF_PErr);
		end;
	end;
	TRF_EvE("kill", "trader_id", id, "system_index", idx, "by", by, "last_attack_time", TRF_F(rec.pa), "game_time", TRF_F(gt),
		"kill_count", L.kills, "ship_count", rec.np);
	call(TRF_Ev_KillV2, {id, rec, by, idx}, "x", TRF_PErr);
	call(TRF_Ev_KillV1, {id, rec, by, idx}, "x", TRF_PErr);
	TRF_Ev_Close(id, rec, "kill");
end;

-- v1 kill effects (5.1, 6.3, 8.3, 4.3), before the record is closed. Counted player fire: the kill proxy
-- (by "player") or a counted attack (T_deliberate) on the trader in this visit.
-- Equipment convoy transports count here only if trf_convoy keeps them as trader records with feq = 1
-- (TRF_FeqEnd applies the same forced Bust; TRF_ForcedBust only sets a bit, so a repeat is harmless).
function TRF_Ev_KillV1(id, rec, by, idx)
	local pf = by == "player" or rec.cnt == 1;
	local own = TRF_Ev_Own(rec);
	if own and not pf then TRF_Ev_Salv(own, "conv"); end;
	if pf and not rec.cv and (rec.tier == 4 or rec.feq == 1) and type(idx) == "number"
		and TRF_Ev_Opt("forced_bust", 1) ~= 0 then
		local why = "tt4";
		if rec.feq == 1 then why = "feq"; end;
		TRF_N("TRF_ForcedBust", idx, why.." "..id);
		TRF_EvE("forced_bust", "system_index", idx, "trader_id", id, "reason", why);
	end;
	if TRF_Ev_Bit(rec.tb, 1) == 1 or rec.pi then TRF_N("TRF_TrackGone", id, "kill"); end;
	-- Paid raid (7.5): the tip-off trader (tb bit 2) killed with player fire.
	if pf then TRF_N("TRF_PoDone", id, "kill"); end;
end;

-- Trigger callback: transport k of trader id died. nt is recounted from the handles (dead mask plus
-- IsAlive), so a repeated or late event cannot count twice.
-- Trigger entry point (review O1): runs TRF_OnShipDied_Body protected.
function TRF_OnShipDied(id, k, g) TRF_Cb("TRF_OnShipDied", TRF_OnShipDied_Body, {id, k, g}); end;

function TRF_OnShipDied_Body(id, k, g)
	local rec = TRF_Ev_Rec(id, g, "died");
	if not rec then return; end;
	local h = TRF_Ev_HTr(id);
	local nt = 0;
	if h and type(h.tp) == "table" then
		if type(h.dk) ~= "table" then h.dk = {}; end;
		h.dk[k] = 1;
		local dead = h.tp[k];
		for i = 1, getn(h.tp) do
			if not h.dk[i] and TRF_Ev_Alive(h.tp[i]) then nt = nt + 1; end;
		end;
		if type(h.sh) == "table" then
			local np = 0;
			for i = 1, getn(h.sh) do
				local s = h.sh[i];
				if s ~= dead and TRF_Ev_Alive(s) then np = np + 1; end;
			end;
			rec.np = np;
		end;
	else
		nt = (rec.nt or 1) - 1;
		if nt < 0 then nt = 0; end;
	end;
	rec.nt = nt;
	TRF_EvDE("died", "trader_id", id, "ship", k, "transport_count", nt, "ship_count", rec.np);
	-- Escort flight (esc_flight): Escort moves to the next live transport.
	if nt > 0 then TRF_N("TRF_GnEscOrder", id); return; end;
	TRF_Ev_Kill(id, rec, h);
end;

-- Attack response, vanilla Call_SOS_command / Call_SOS_command2 equivalent (1.3, 10.3) ---------

-- Offsets from the mothership, glow direction, flight type and power (RandomContacts.script 469-496).
function TRF_Ev_RespRows()
	return {
		{g={0, -130, 0}, f={0, -120, 0}, d={0, 1, 0}, ty=1, pw=19},
		{g={-110, 75, 0}, f={-100, 70, 0}, d={1, -0.5, 0}, ty=2, pw=19},
		{g={85, 75, 85}, f={80, 70, 80}, d={-0.5, -0.5, -0.5}, ty=3, pw=18},
		{g={85, 75, -85}, f={80, 70, -80}, d={-0.5, -0.5, 0.5}, ty=3, pw=20}
	};
end;

-- Once per trader, not under suppression: leader line, flights 8 s later.
function TRF_RespStart(id)
	local L = TRF_Ev_Live();
	local rec = TRF_Ev_RecAny(id);
	if not L or not rec or rec.resp then return; end;
	if TRF_Ev_Opt("response", 1) == 0 then rec.resp = 2; return; end;
	if TRF_Ev_Supp() then
		TRF_Ev_Stat("skip_supp");
		TRF_EvDE("response", "trader_id", id, "result", "suppressed");
		return;
	end;
	local n = (L.rn or 0) + 1;
	L.rn = n;
	rec.resp = 1;
	local p = TRF_Ev_Leader(id);
	call(TRF_Ev_Msg, {p, "#L_SOS_Replica_00", 6}, "x", TRF_PErr);
	-- v1 (5.1, 8.7): a supply convoy's response comes from its owner; else the location owner's faction.
	local f = TRF_Ev_Own(rec);
	if not f then f = TRF_Ev_FacIdx(TRF_Ev_RespTeam()); end;
	TRF_Ev_Due(8, "TRF_RespSpawn", n, f or 0);
	TRF_EvE("response_start", "trader_id", id, "response_id", n, "faction", f, "speaker", TRF_KvB(p and 1));
end;

-- Heat tier (8.1): 0 heat 0-2, 1 heat 3-4, 2 heat 5-6, 3 heat 7-9 or the Trade team at war with the player.
function TRF_HeatTier()
	local h = 0;
	if type(TRF) == "table" and type(TRF.std) == "table" and type(TRF.std.heat) == "number" then h = TRF.std.heat; end;
	if h >= 7 then return 3; end;
	if RELATION_WAR ~= nil and type(GetTeamRelation) == "function" and GetTeamRelation("Trade", PLAYER_TEAM) == RELATION_WAR then
		return 3;
	end;
	if h >= 5 then return 2; end;
	if h >= 3 then return 1; end;
	return 0;
end;

-- L_w (TDR 8.4) of the current system: trf_region's TRF_LPay, else 8.
function TRF_Ev_LPay()
	local v = TRF_N("TRF_LPay");
	if type(v) == "number" then return v; end;
	return 8;
end;

-- Response rows by heat tier (8.1): tier 0 one owner flight (type 1) at 50 %, tiers 1-2 types 1 and 2,
-- both at power L_w, the current system's world level (TDR 8.4); tier 3 the vanilla set. Returns rows
-- (nil: no help), tier.
-- v1 (7.2): with an owner faction f and trf_faction loaded, rows of tiers 0-2 carry the owner's rung
-- (TRF_Rung of the current region slot, rung 1 outside regions), which replaces the L_w power.
function TRF_Ev_RespPick(f)
	local t = TRF_HeatTier();
	local all = TRF_Ev_RespRows();
	if t >= 3 then return all, t; end;
	local lp = TRF_Ev_LPay();
	local rung = nil;
	if type(f) == "number" and f >= 1 and f <= 5 and type(TRF_FacFlight) == "function" then
		local slot = TRF_N("TRF_RgOf", TRF_Ev_CurIdx());
		rung = 1;
		if type(slot) == "number" then rung = TRF_N("TRF_Rung", slot, f) or 1; end;
	end;
	local r1 = all[1];
	r1.ty = 1;
	r1.pw = lp;
	r1.rung = rung;
	if t == 0 then
		if TRF_Ev_Rand(100) >= 50 then return nil, t; end;
		return {r1}, t;
	end;
	local r2 = all[2];
	r2.ty = 2;
	r2.pw = lp;
	r2.rung = rung;
	return {r1, r2}, t;
end;

-- Builds response n from rows (default: the vanilla set); runs protected. Returns the number of flights.
function TRF_Ev_RespBuild(n, rows, f)
	local H = TRF_Ev_H();
	local ms = TRF_Ev_MShip();
	if not H or not ms then return 0; end;
	local x = ms:GetPosition();
	local team = TRF_Ev_RespTeam();
	if type(f) == "number" and f >= 1 and f <= 5 and TRF_Ev_FacTeam(f) then team = TRF_Ev_FacTeam(f); end;
	local gname = "TRF_GResp_"..n;
	local grp = TRF_Ev_Group(team, "TRF_Resp_"..n);
	if not grp then TRF_EvE("response_spawn", "response_id", n, "team", team, "result", "no_group"); return 0; end;
	setglobal(gname, grp);
	if type(rows) ~= "table" then rows = TRF_Ev_RespRows(); end;
	for j = 1, getn(rows) do
		local r = rows[j];
		TRF_Ev_Glow(TRF_Ev_Off(x, r.g[1], r.g[2], r.g[3]), Vector3(r.d[1], r.d[2], r.d[3]));
	end;
	if type(H.resp) ~= "table" then H.resp = {}; end;
	H.resp[n] = {};
	for j = 1, getn(rows) do
		local r = rows[j];
		local sign = "trf_sos_"..n.."_"..j;
		local pos, dir = TRF_Ev_Off(x, r.f[1], r.f[2], r.f[3]), Vector3(r.d[1], r.d[2], r.d[3]);
		local fl = nil;
		if r.rung and type(TRF_FacFlight) == "function" then
			fl = call(TRF_FacFlight, {f, r.rung, r.ty, gname, sign, pos, dir, 6}, "x", TRF_PErr);
			if not fl or type(fl) == "number" then fl = nil; end;
		end;
		if not fl then fl = TRF_Ev_Choice(team, gname, sign, pos, r.ty, r.pw, dir); end;
		if fl then
			fl:Attack(ms);
			tinsert(H.resp[n], fl);
		end;
	end;
	return getn(H.resp[n]);
end;

-- No handle globals stay behind for the save: group global and CreateChoiceFlight's flight_/ship_/pilot_.
function TRF_Ev_RespClear(n)
	setglobal("TRF_GResp_"..n, nil);
	local m = TRF_Ev_K().sign_max;
	for j = 1, 4 do
		local s = "trf_sos_"..n.."_"..j;
		setglobal("flight_"..s, nil);
		for i = 1, m do
			setglobal("ship_"..s.."_"..i, nil);
			setglobal("pilot_"..s.."_"..i, nil);
		end;
	end;
end;

-- Due call 8 s after the start: the vanilla __sys_SOS_3 roll, then four flights.
function TRF_RespSpawn(n, b)
	if not TRF_Ev_Live() or type(n) ~= "number" then return; end;
	if TRF_Ev_Supp() then
		TRF_Ev_Stat("skip_supp");
		TRF_EvE("response_spawn", "response_id", n, "result", "suppressed");
		return;
	end;
	local s3 = __sys_SOS_3;
	if type(s3) ~= "number" then s3 = 0; end;
	local roll = TRF_Ev_Rand(100);
	if not (s3 > roll) then
		TRF_EvE("response_spawn", "response_id", n, "sos_chance", s3, "roll", roll, "result", "no_help");
		return;
	end;
	local f = nil;
	if type(b) == "number" and b >= 1 and b <= 5 then f = b; end;
	local rows, tier = TRF_Ev_RespPick(f);
	if not rows then
		TRF_EvE("response_spawn", "response_id", n, "reason", "heat_tier_0", "result", "no_help");
		return;
	end;
	local c = call(TRF_Ev_RespBuild, {n, rows, f}, "x", TRF_PErr);
	TRF_Ev_RespClear(n);
	TRF_EvE("response_spawn", "response_id", n, "faction", f, "tier", tier, "sos_chance", s3, "roll", roll, "flight_count", c,
		"result", "spawned");
	if type(c) == "number" and c > 0 then
		if f then call(TRF_Ev_RespArm, {n, f}, "x", TRF_PErr); end;
		TRF_Ev_Stat("resp");
		TRF_Ev_Due(5, "TRF_RespLine", n);
	end;
end;

-- Due call 5 s after the flights: flight 3's leader says the second vanilla line.
function TRF_RespLine(n, b)
	if TRF_Ev_Supp() or TRF_N("TRF_Quiet") then return; end;
	local H = TRF_Ev_H();
	if not H or type(H.resp) ~= "table" or type(H.resp[n]) ~= "table" then return; end;
	local t = H.resp[n];
	local p = nil;
	if t[3] then p = TRF_Ev_Pilot1(t[3]); end;
	local i = 1;
	while not p and i <= getn(t) do
		p = TRF_Ev_Pilot1(t[i]);
		i = i + 1;
	end;
	TRF_Ev_Msg(p, "#L_SOS_Replica_01", 6);
end;

-- v1 6.3: died and attack (PLAYER_GROUP) triggers on every ship of response n of faction f. Per flight j
-- H.rsv[n][j] = {f, ns ships, dk dead, pf player fire, done}. Handles and counters stay in H (visit only).
function TRF_Ev_RespArm(n, f)
	local H = TRF_Ev_H();
	if not H or type(H.resp) ~= "table" or type(H.resp[n]) ~= "table" then return; end;
	if type(H.rsv) ~= "table" then H.rsv = {}; end;
	H.rsv[n] = {};
	for j = 1, getn(H.resp[n]) do
		local fl = H.resp[n][j];
		local e = {f=f, ns=0, dk=0};
		H.rsv[n][j] = e;
		if TRF_Ev_Alive(fl) then
			local c = fl:GetPilotCount();
			if type(c) ~= "number" then c = 0; end;
			for i = 1, min(c, 8) do
				local p = fl:GetPilotByNumber(i);
				local sh = nil;
				if p then sh = p:GetShip(); end;
				if TRF_Ev_Alive(sh) then
					e.ns = e.ns + 1;
					TRF_Ev_Trig("attack", "TRF_OnRespHit("..n..","..j..","..TRF.gen..")--", PLAYER_GROUP, sh);
					TRF_Ev_Trig("died", "TRF_OnRespDied("..n..","..j..","..TRF.gen..")--", sh);
				end;
			end;
		end;
	end;
end;

function TRF_Ev_RespE(n, j, g)
	if type(TRF) ~= "table" or g ~= TRF.gen then return nil; end;
	local H = TRF_Ev_H();
	if not H or type(H.rsv) ~= "table" or type(H.rsv[n]) ~= "table" then return nil; end;
	local e = H.rsv[n][j];
	if type(e) ~= "table" then return nil; end;
	return e;
end;

-- Player fire on a ship of response flight j: no salvage for that flight. No fst change: response flights
-- are sent at the player (decision 19).
function TRF_OnRespHit(n, j, g) TRF_Cb("TRF_OnRespHit", TRF_Ev_RespHitBody, {n, j, g}); end;

function TRF_Ev_RespHitBody(n, j, g)
	local e = TRF_Ev_RespE(n, j, g);
	if e then e.pf = 1; end;
end;

-- Last ship of response flight j dead without player fire: salvage +1 for its faction (6.3).
function TRF_OnRespDied(n, j, g) TRF_Cb("TRF_OnRespDied", TRF_Ev_RespDiedBody, {n, j, g}); end;

function TRF_Ev_RespDiedBody(n, j, g)
	local e = TRF_Ev_RespE(n, j, g);
	if not e or e.done then return; end;
	e.dk = e.dk + 1;
	if e.dk < e.ns then return; end;
	e.done = 1;
	if e.pf then
		TRF_EvDE("response_flight", "response_id", n, "flight", j, "reason", "player_fire", "result", "destroyed");
		return;
	end;
	TRF_Ev_Salv(e.f, "resp");
end;

-- Pirate kills (7.4, 7.10) --------------------------------------------------------------------

-- Watches the flight of an ejecting pirate pilot. CHECK: GetSide() team name "Pirates"
-- (CreateChoiceFlight also accepts "Pirate").
function TRF_Ev_PirEject(pilot)
	if not pilot or type(TRF) ~= "table" or not TRF.active then return; end;
	local H = TRF_Ev_H();
	if not H then return; end;
	local side = pilot:GetSide();
	if side ~= "Pirates" and side ~= "Pirate" then return; end;
	local fl = pilot:GetFlight();
	if not fl then return; end;
	-- v0.2: raid flights count once through their raid record (trf_raid TRF_Rd_End).
	if type(H.rd) == "table" then
		for n, hr in H.rd do
			if type(hr) == "table" and hr.fl == fl then return; end;
		end;
	end;
	if type(H.rdx) == "table" then
		for n, f in H.rdx do
			if f == fl then return; end;
		end;
	end;
	if type(H.pir) ~= "table" then H.pir = {}; end;
	if type(H.pirb) ~= "table" then H.pirb = {}; end;
	if type(H.pirs) ~= "table" then H.pirs = {}; end;
	local b = TRF_Ev_Butcher(pilot);
	-- v1 6.3: a flight registered in H.svf carries salvaged gear (consumed when it dies).
	local sv = nil;
	if type(H.svf) == "table" then
		for i = 1, getn(H.svf) do if H.svf[i] == fl then sv = 1; end; end;
	end;
	for i = 1, getn(H.pir) do
		if H.pir[i] == fl then
			if b then H.pirb[i] = 1; end;
			return;
		end;
	end;
	if getn(H.pir) >= TRF_Ev_K().pir_max then return; end;
	tinsert(H.pir, fl);
	H.pirb[getn(H.pir)] = b;
	H.pirs[getn(H.pir)] = sv;
	TRF_EvDE("pirate_watch", "side", side, "flight_count", getn(H.pir), "butcher", TRF_KvB(b));
end;

-- 1 when the pilot's ship is a Butcher_* corvette (9.6: score -4). Carcass:GetName() is the template name.
function TRF_Ev_Butcher(pilot)
	local s = pilot:GetShip();
	if not s or type(s) == "number" or type(s.GetName) ~= "function" then return nil; end;
	local nm = call(function(x) return x:GetName(); end, {s}, "x", TRF_PErr);
	if type(nm) == "string" and strfind(nm, "^Butcher") then return 1; end;
	return nil;
end;

-- Case_Eject thunk target: the vanilla result is returned unchanged.
function TRF_CaseEject(pilot)
	local r = 2;
	if type(TRF_orig_Case_Eject) == "function" then r = TRF_orig_Case_Eject(pilot); end;
	call(TRF_Ev_PirEject, {pilot}, "x", TRF_PErr);
	return r;
end;

-- One killed pirate flight: dis - 1 in the current system, at most rec_max per visit. kind: "pirate"
-- (watched vanilla flight), "butcher" (one with a Butcher_* hull), "raid" (from trf_raid).
-- v0.2 (4.5, 9.1, 9.6): clan score -2 (-4 for a Butcher; the visit cap is TRF_ClanAdd's); +1 visit credit
-- when the system's dis is 0. v1 (6.3): sv 1 = the flight carried salvaged gear -> TRF_SalvUse.
function TRF_Ev_Recover(kind, sv)
	local L = TRF_Ev_Live();
	local idx = TRF_Ev_CurIdx();
	if not L or not idx then return; end;
	TRF_Ev_Stat("pirate_kill");
	local slot = TRF_N("TRF_RgOf", idx);
	if sv == 1 and type(slot) == "number" then TRF_N("TRF_SalvUse", slot, "kill"); end;
	if type(slot) == "number" then
		local d = -2;
		if kind == "butcher" then d = -4; end;
		TRF_N("TRF_ClanAdd", slot, d, "pirate kill "..tostring(kind or "pirate"));
	end;
	if TRF_Ev_DisOf(idx) <= 0 then TRF_N("TRF_ProCredit", 1, "pirate kill"); end;
	if TRF_Ev_Opt("dis", 1) == 0 then return; end;
	L.rec = L.rec or 0;
	if L.rec >= TRF_Ev_K().rec_max then TRF_EvDE("recovery", "recovery_count", L.rec, "result", "cap"); return; end;
	if TRF_Ev_DisOf(idx) <= 0 then return; end;
	L.rec = L.rec + 1;
	TRF_Ev_AddDis(idx, -1, "pirate kill");
	TRF_EvE("recovery", "system_index", idx, "recovery_count", L.rec);
end;

-- Escorts of a killed trader: removed at their exit portal (as the vanilla exit) or out of view. With an
-- escort flight (h.ef, esc_flight) its position counts and both flights are deleted.
function TRF_Ev_Escorts(H)
	if type(H.tr) ~= "table" then return; end;
	local ms = TRF_Ev_Pos(TRF_Ev_MShip());
	local ovd = TRF_Ev_Tune("ovd", 600);
	local er = TRF_Ev_K().exit_r;
	for id, h in H.tr do
		if type(h) == "table" and h.kl then
			local r = TRF_Ev_RecAny(id);
			local p = nil;
			if TRF_Ev_Alive(h.ef) then p = TRF_Ev_Pos(h.ef); else p = TRF_Ev_Pos(h.fl); end;
			if r or not p then
				h.kl = nil;
			else
				local dx = TRF_Ev_Dist(p, TRF_Ev_ObjPos(h.ext));
				local dm = TRF_Ev_Dist(p, ms);
				if dx and dx < er then
					TRF_Ev_Start(h.ext, 5, 0);
					TRF_Ev_Del(h.fl);
					TRF_Ev_Del(h.ef);
					h.kl = nil;
					TRF_Ev_Stat("remove_esc");
					TRF_EvE("escorts_removed", "trader_id", id, "reason", "exit");
				elseif dm and dm > ovd then
					TRF_Ev_Del(h.fl);
					TRF_Ev_Del(h.ef);
					h.kl = nil;
					TRF_Ev_Stat("remove_esc");
					TRF_EvE("escorts_removed", "trader_id", id, "reason", "out_of_view", "distance", TRF_F(dm));
				end;
			end;
		end;
	end;
end;

-- Heat reaction poll (8.1): at heat >= 3 every live trader not fleeing goes through trf_raid's
-- TRF_HeatReact (proximity trigger armed once, flee when the mothership is within range). At most 8.
function TRF_Ev_HeatStep()
	if type(TRF_HeatReact) ~= "function" or TRF_HeatTier() < 1 then return; end;
	local L = TRF_Ev_Live();
	local ids = {};
	for id, r in L.tr do
		if type(r) == "table" and r.st ~= "gone" and r.st ~= "flee" and r.st ~= "dock" and not r.fl then tinsert(ids, id); end;
	end;
	for i = 1, min(getn(ids), 8) do TRF_HeatReact(ids[i]); end;
end;

-- Manager step (every tune step seconds, from the loader): pirate recovery, escort cleanup, heat reaction.
function TRF_Events_Step()
	if type(TRF) ~= "table" or not TRF.active or not TRF_Ev_Live() then return; end;
	local H = TRF_Ev_H();
	if not H then return; end;
	if type(H.pir) == "table" and getn(H.pir) > 0 then
		local keep, kb, ks = {}, {}, {};
		if type(H.pirb) ~= "table" then H.pirb = {}; end;
		if type(H.pirs) ~= "table" then H.pirs = {}; end;
		for i = 1, getn(H.pir) do
			local f = H.pir[i];
			if TRF_Ev_Alive(f) then
				tinsert(keep, f);
				kb[getn(keep)] = H.pirb[i];
				ks[getn(keep)] = H.pirs[i];
			elseif H.pirb[i] then
				TRF_Ev_Recover("butcher", H.pirs[i]);
			else
				TRF_Ev_Recover("pirate", H.pirs[i]);
			end;
		end;
		H.pir = keep;
		H.pirb = kb;
		H.pirs = ks;
	end;
	TRF_Ev_Escorts(H);
	call(TRF_Ev_HeatStep, {}, "x", TRF_PErr);
end;
