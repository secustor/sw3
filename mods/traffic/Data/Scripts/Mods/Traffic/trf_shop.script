-- sw3-traffic v0.2 shop module (Lua 4.0.1). Spec: design/v02-spec.md 7.1, 7.2, 10.1 (S9, S10, M14).
-- Trader shops trf_shop_<k> per trader group slot (wiped and filled before every open), shortages at the named station (TRF.short) with the
-- restore list of changed station coefficients (TRF.shops), the trade-dock wrapper and enabled 2.
-- Layout: helpers, accessors (one native or engine global each, protected), static tables, pure
-- functions (*Of, explicit inputs, host-testable), contract functions.
-- Saved fields written here: short[i] = {s=idx, c=cls, t=till leg}, shops[i] = {s=idx, sh=shop, c=cls},
-- tsh[k] = 2 (slot shop created; 1 was the class shop of saves before 2026-10-22, dropped by trf_state's
-- repair). Trader record field: trd (1 once the trader's shop was opened).
-- v1 (design/v1-spec.md 8.2, 10.2): faction equipment lists in TRF_ShopItems, item costs and hold value.
-- Top level defines functions and the chunk local SH (per MapInitialization caches, never saved).

local SH = {mk={}};

-- Helpers --------------------------------------------------------------------------

-- One logfmt event line of module shop (design/log-format.md 5).
function TRF_ShopE(event, ...) tinsert(arg, 1, event); tinsert(arg, 1, "shop"); call(TRF_Lf, arg); end;

-- Error handler for protected calls: event=error, counted in stat err.
function TRF_ShopErr(m)
	TRF_ShopE("error", "message", tostring(m));
	if type(TRF_Stat) == "function" then TRF_Stat("err"); end;
end;

-- Config value: TRF_Opt (merges TRF_<M>_OptDef), else the raw config, else TRF_Shop_OptDef, else def.
-- Enumerations outside their range read as the default (shop_mode, short_price 0..1, restore 1..2).
function TRF_ShopOpt(key, def)
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil and type(TRF_CfgGet) == "function" then v = TRF_CfgGet(key, nil); end;
	local d = TRF_Shop_OptDef()[key];
	if d == nil then d = def; end;
	if v == nil or (d ~= nil and type(v) ~= type(d)) then v = d; end;
	if key == "shop_mode" or key == "short_price" then
		if v ~= 0 and v ~= 1 then v = d; end;
	elseif key == "restore" then
		if v ~= 1 and v ~= 2 then v = d; end;
	end;
	return v;
end;

-- Numeric tune constant: TRF_Tune(), else cfg tune, else TRF_Shop_TuneDef, else def.
function TRF_ShopTune(key, def)
	local v = nil;
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" then v = t[key]; end;
	end;
	if type(v) ~= "number" and type(TRF_CfgGet) == "function" then
		local t = TRF_CfgGet("tune", nil);
		if type(t) == "table" then v = t[key]; end;
	end;
	if type(v) ~= "number" then v = TRF_Shop_TuneDef()[key]; end;
	if type(v) ~= "number" then v = def; end;
	return v;
end;

function TRF_ShopStat(k)
	if type(TRF_Stat) == "function" then TRF_Stat(k); end;
end;

function TRF_ShopLegs()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then return TRF.clock.legs; end;
	return 0;
end;

-- Saved lists, created on first use (trf_state's fresh/migrate also creates them).
function TRF_ShopT(key)
	if type(TRF) ~= "table" then return {}; end;
	if type(TRF[key]) ~= "table" then TRF[key] = {}; end;
	return TRF[key];
end;

function TRF_ShopShort() return TRF_ShopT("short"); end;
function TRF_ShopList() return TRF_ShopT("shops"); end;
function TRF_ShopTsh() return TRF_ShopT("tsh"); end;

function TRF_ShopSysName(idx)
	if type(TRF_SysName) == "function" then return TRF_SysName(idx); end;
	return tostring(idx);
end;

function TRF_ShopCur()
	if type(TRF_CurIdx) == "function" then return TRF_CurIdx(); end;
	return nil;
end;

function TRF_ShopF(x)
	if type(x) == "number" then return format("%.2f", x); end;
	return tostring(x);
end;

-- Accessors: one native or engine global each -------------------------------------

-- Difficulty 1 EASY, 2 NORMAL, 3 HARD (as InitTradeSystem.script 483-641: anything else is HARD).
function TRF_Shop_Diff()
	local d = TRF_N("GetLevelDifficult");
	if d ~= nil and d == EASY then return 1; end;
	if d ~= nil and d == NORMAL then return 2; end;
	return 3;
end;

function TRF_Shop_MarketRaw(name)
	return GetWhiteMarket(name);
end;

-- White market of a shop or nil. CHECK E0.4: GetWhiteMarket on a shop never created (nil, a dead object
-- or an error); an error is caught here.
function TRF_Shop_Market(name)
	if type(name) ~= "string" or name == "" or type(GetWhiteMarket) ~= "function" then return nil; end;
	local m = call(TRF_Shop_MarketRaw, {name}, "x", TRF_ShopErr);
	if m == nil or type(m) == "number" or type(m) == "string" or type(m) == "function" then return nil; end;
	return m;
end;

function TRF_Shop_PutRaw(m, item, n, s, b)
	m:ModuleGoodsState(item, n, s, b);
	return 1;
end;

-- Market:ModuleGoodsState(item, count, sellK, buyK) (sell before buy, FloodTradeStations.script 290-296).
-- CHECK O3: whether count sets or adds, and a count-0 entry on an unstocked container. 1 on success.
function TRF_Shop_Put(m, item, n, s, b)
	if not m or type(item) ~= "string" then return nil; end;
	return call(TRF_Shop_PutRaw, {m, item, n, s, b}, "x", TRF_ShopErr);
end;

function TRF_Shop_ClearRaw(m, item)
	m:ClearGoodsState(item);
	return 1;
end;

-- Market:ClearGoodsState(item): never used in vanilla (cfg restore 2 only). CHECK.
function TRF_Shop_Clear(m, item)
	if not m or type(item) ~= "string" then return nil; end;
	return call(TRF_Shop_ClearRaw, {m, item}, "x", TRF_ShopErr);
end;

-- FALSE sets every market's stock to its target, as On_FTrader_Start (RandomContacts.script 409) does before the
-- trader window. TRUE would move stock only 35% toward the target, so count 1-2 rows show 0 (mod-research/ships/shop-save.md 2.3).
function TRF_Shop_Update()
	TRF_N("UpdateTradeSystem", FALSE);
end;

function TRF_Shop_Create(name)
	if type(CreateShop) ~= "function" then return nil; end;
	call(CreateShop, {name}, "x", TRF_ShopErr);
	return 1;
end;

-- Owner team of a location (GetLocationTeam, FloodTradeStations.script 256-262), raw then lowercase name.
function TRF_Shop_Team(loc)
	if type(loc) ~= "string" then return nil; end;
	local t = TRF_N("GetLocationTeam", loc);
	if type(t) ~= "string" or t == "" then t = TRF_N("GetLocationTeam", strlower(loc)); end;
	if type(t) ~= "string" or t == "" then return nil; end;
	return t;
end;

function TRF_Shop_Rand(n)
	if type(RAND) ~= "function" or type(n) ~= "number" or n < 1 then return 0; end;
	return RAND(n);
end;

-- Shop name of the docking: the vanilla data global _param (set by __TradeStation_Action, DockStation.script
-- 174-181), else the current location as vanilla falls back to.
function TRF_Shop_Param()
	local p = _param;
	if type(p) == "string" and p ~= "" then return p; end;
	return TRF_N("GetCurrentLocation");
end;

function TRF_Shop_Help()
	if type(TRF) == "table" and type(TRF.std) == "table" and type(TRF.std.help) == "number" then return TRF.std.help; end;
	return 0;
end;

-- Prosperity of a system: trf_region's TRF_Pro, else the saved field.
function TRF_Shop_Pro(idx)
	if type(idx) ~= "number" then return 0; end;
	if type(TRF_Pro) == "function" then
		local p = TRF_Pro(idx);
		if type(p) == "number" then return p; end;
	end;
	if type(TRF) == "table" and type(TRF.sys) == "table" and type(TRF.sys[idx]) == "table" and type(TRF.sys[idx].pro) == "number" then
		return TRF.sys[idx].pro;
	end;
	return 0;
end;

-- Static tables --------------------------------------------------------------------

-- Trader shop slot of a record (spec 7.1): its group slot k 1..4, else 5 (records without a trade group
-- slot: supply convoys, load orphans).
function TRF_ShopSlot(r)
	local k = nil;
	if type(r) == "table" then k = r.k; end;
	if type(k) == "number" and k >= 1 and k <= 4 then return floor(k); end;
	return 5;
end;

-- Trader shop name of slot k: lower case like the vanilla shops (the engine lowercases market rows).
function TRF_ShopName(k)
	return "trf_shop_"..k;
end;

-- Container items by class (v01 4.1; same map as trf_gen's TRF_GnCls).
function TRF_ShopClsItems()
	return {{"Cargo_01", "Cargo_05", "Cargo_10"}, {"Cargo_06", "Cargo_09"}, {"Uranium"}, {"Barrel_02"},
		{"Cargo_04", "Cargo_08"}, {"Cargo_02", "Cargo_03", "Cargo_07"}};
end;

-- Class of a container item, nil for other items.
function TRF_ShopItemCls(item)
	local t = TRF_ShopClsItems();
	for c = 1, getn(t) do
		for j = 1, getn(t[c]) do
			if t[c][j] == item then return c; end;
		end;
	end;
	return nil;
end;

-- Vanilla station shop lists (include/FloodTradeStations.script 102-125) by coefficient group, and the
-- Rare-coefficient shops vulcan, simeiz (InitTradeSystem.script 483-641). Lowercase shop names.
function TRF_ShopLists()
	return {
		std = {"ahilles", "gefest", "dionis", "llanovar1", "llanovar2", "nk", "proserpina", "kassilia",
			"solpuga", "torr", "elinor", "elio", "valensia", "avalon", "gideon", "angarsk", "eridan",
			"aurora", "argon", "callipso", "corrino", "kron", "poseidon", "gredos", "kruger", "endoria1",
			"endoria2", "escaflon", "fort_russ", "moscowia", "solncevka", "nd", "altair", "altrabon", "kadi",
			"nj1", "nj2", "nj3", "prien", "taira", "shula", "hanoi", "xk16", "xt41", "xt81", "xt86",
			"debris3", "debris6", "golkonda", "xt05", "b_leftera1", "b_leftera2", "b_leftera3", "xt93",
			"xt39", "xt45", "xt52", "dosis", "kondel", "kitaro", "ule", "fronn", "kadenoa_tri",
			"debris4", "xb13", "xb15", "xt11", "ergelan", "sunji", "vuadil", "el_ariash", "dalled", "deosis",
			"kadenoa", "fiasar", "hafa", "ashelon", "xk10", "areko", "gaeon", "gaoba", "danstag", "lasad",
			"lidau", "farles", "heos", "egleon"},
		neutral = {"pegas", "debris1", "debris2", "pandora", "xb19", "alzed", "xt17", "xt23", "xt24", "xt26",
			"xt27", "xt54", "x220", "x213", "x244", "x297"},
		rare = {"tarrot", "x203", "xb17", "xt20", "vulcan", "simeiz"}
	};
end;

-- White coefficients {sell, buy} by group and difficulty EASY, NORMAL, HARD (InitTradeSystem.script
-- 483-641; AddAllToShops takes buy before sell).
function TRF_ShopCoefTab()
	return {
		std = {{1.2, 0.8}, {1.35, 0.6}, {1.5, 0.4}},
		neutral = {{1.5, 0.6}, {1.75, 0.4}, {2.0, 0.2}},
		rare = {{1.4, 0.6}, {1.6, 0.4}, {1.8, 0.2}}
	};
end;

-- Equipment list global by owner team (as FillTraderSimple, FloodTradeStations.script 996-1040; Neutral
-- uses the Patrol list, spec 7.1).
function TRF_ShopGunListOf(owner)
	local m = {Vks="Gun_List_Vks", Kfni="Gun_List_Kfni", Triada="Gun_List_Triada", Uss="Gun_List_Uss",
		Inoco="Gun_List_InoCo", Uft="Gun_List_Uft", Patrol="Gun_List_Patrol", Neutral="Gun_List_Patrol"};
	if type(owner) == "string" and m[owner] then return m[owner]; end;
	return "Gun_List_Unknown";
end;

-- Pure functions -------------------------------------------------------------------

-- Station coefficients s0, b0 of a shop name for difficulty d (1..3), or nil when the shop is in no list.
function TRF_DefCoefOf(shop, d)
	if type(shop) ~= "string" then return nil; end;
	shop = strlower(shop);
	if type(d) ~= "number" or d < 1 or d > 3 then d = 3; end;
	local L, C = TRF_ShopLists(), TRF_ShopCoefTab();
	for g, list in L do
		for i = 1, getn(list) do
			if list[i] == shop then return C[g][d][1], C[g][d][2]; end;
		end;
	end;
	return nil;
end;

-- Trader shop coefficients (spec 7.1): white values of difficulty d; help >= 5: sell -0.15, buy +0.1;
-- pro >= 6: sell -0.1 more; sell >= buy + 0.2 always.
function TRF_ShopCoefOf(d, help, pro)
	local t = TRF_ShopCoefTab().std;
	if type(d) ~= "number" or d < 1 or d > 3 then d = 3; end;
	local s, b = t[d][1], t[d][2];
	if type(help) == "number" and help >= 5 then s = s - 0.15; b = b + 0.1; end;
	if type(pro) == "number" and pro >= 6 then s = s - 0.1; end;
	if s < b + 0.2 then s = b + 0.2; end;
	return s, b;
end;

-- Active shortages of system idx at leg L: set {[cls] = till}.
function TRF_ShortActiveOf(list, idx, L)
	local out = {};
	if type(list) ~= "table" or type(idx) ~= "number" then return out; end;
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" and e.s == idx and type(e.c) == "number" and type(e.t) == "number" and e.t > L then
			if not out[e.c] or out[e.c] < e.t then out[e.c] = e.t; end;
		end;
	end;
	return out;
end;

-- Adds e = {s, c, t[, pk]} to list (7.2): same (s, c) keeps the later t, and pk once either entry has it;
-- more than cap entries drops the one ending first (lowest list position on a tie). Returns "merge", "new" or
-- "drop" (with the dropped entry).
function TRF_ShortAddOf(list, e, cap)
	for i = 1, getn(list) do
		local o = list[i];
		if type(o) == "table" and o.s == e.s and o.c == e.c then
			if e.t > o.t then o.t = e.t; end;
			if e.pk == 1 then o.pk = 1; end;
			return "merge";
		end;
	end;
	tinsert(list, e);
	if getn(list) <= cap then return "new"; end;
	local k = 1;
	for i = 2, getn(list) do
		if list[i].t < list[k].t then k = i; end;
	end;
	local d = tremove(list, k);
	return "drop", d;
end;

-- Shortage class by owner team and a roll 0..99 (Bust entry, 7.2): Uss/Inoco machinery or spare parts,
-- Neutral ore, else uniform 1..6.
function TRF_ShortClsOf(owner, roll)
	if owner == "Uss" or owner == "Inoco" then
		if roll < 50 then return 1; end;
		return 2;
	end;
	if owner == "Neutral" then return 3; end;
	return min(6, floor(roll * 6 / 100) + 1);
end;

-- Hold mirror {{i=item, n=count, s=ship}, ...} (or v01 {item, count}) -> items in first-seen order, totals.
function TRF_ShopHoldOf(hold)
	local order, tot = {}, {};
	if type(hold) ~= "table" then return order, tot; end;
	for i = 1, getn(hold) do
		local h = hold[i];
		if type(h) == "table" then
			local it, n = h.i, h.n;
			if it == nil then it = h[1]; n = h[2]; end;
			if type(it) == "string" and type(n) == "number" and n > 0 then
				if not tot[it] then tinsert(order, it); tot[it] = 0; end;
				tot[it] = tot[it] + floor(n);
			end;
		end;
	end;
	return order, tot;
end;

-- Contract: items and coefficients (7.1) -------------------------------------------

-- Every item a trader shop may hold, each once: the 12 containers, then [1] and [2] of every Gun_List_*
-- table and Syst_List (FloodTradeStations.script 587-650), because a trader shop serves every owner;
-- v1 (8.2): the five faction _CargoType lists and Rec_CargoType (equipment in TT4 holds, Create_flight_2
-- 356-1012). Cached per MapInitialization; missing vanilla tables are skipped.
function TRF_ShopItems()
	local c = %SH;
	if c.items then return c.items; end;
	local out, seen = {}, {};
	local add = function(it)
		if type(it) == "string" and not %seen[it] then %seen[it] = 1; tinsert(%out, it); end;
	end;
	local ci = TRF_ShopClsItems();
	for k = 1, getn(ci) do
		for j = 1, getn(ci[k]) do add(ci[k][j]); end;
	end;
	local gl = {"Gun_List_Unknown", "Gun_List_Uss", "Gun_List_Triada", "Gun_List_InoCo", "Gun_List_Vks",
		"Gun_List_Kfni", "Gun_List_Uft", "Gun_List_Patrol"};
	for k = 1, getn(gl) do
		local t = getglobal(gl[k]);
		if type(t) == "table" then
			for g = 1, 2 do
				if type(t[g]) == "table" then
					for j = 1, getn(t[g]) do add(t[g][j]); end;
				end;
			end;
		end;
	end;
	if type(Syst_List) == "table" then
		for j = 1, getn(Syst_List) do add(Syst_List[j]); end;
	end;
	local ct = TRF_ShopCargoLists();
	for k = 1, getn(ct) do
		local t = getglobal(ct[k]);
		if type(t) == "table" then
			for j = 1, getn(t) do add(t[j]); end;
		end;
	end;
	c.items = out;
	return out;
end;

-- Equipment cargo lists of the faction builders and the recruits (Create_flight_2.script 356, 463, 565,
-- 775, 905, 1012), in v1 faction order Vks, Kfni, Triada, Uss, Inoco, then Rec.
function TRF_ShopCargoLists()
	return {"Vks_CargoType", "Kfni_CargoType", "Tri_CargoType", "USS_CargoType", "Ino_CargoType", "Rec_CargoType"};
end;

-- Base cost of an item from the generated map field it (Modules.xml prices, v1 8.2), else nil.
function TRF_ShopItemCost(item)
	local m = nil;
	if type(TRF_Map) == "function" then m = TRF_Map(); elseif type(TRF_MapData) == "function" then m = TRF_MapData(); end;
	if type(m) ~= "table" or type(m.it) ~= "table" or type(item) ~= "string" then return nil; end;
	local v = m.it[item];
	if type(v) == "number" then return v; end;
	return nil;
end;

-- Base value of a hold mirror ({i, n} stacks or v01 {item, count}) for the TT4 and equipment convoy
-- windows (v1 8.2, 8.4). Returns the value and the number of stacks without a known cost.
function TRF_ShopHoldValue(hold)
	local order, tot = TRF_ShopHoldOf(hold);
	local v, miss = 0, 0;
	for i = 1, getn(order) do
		local c = TRF_ShopItemCost(order[i]);
		if c then v = v + c * tot[order[i]]; else miss = miss + 1; end;
	end;
	return v, miss;
end;

-- Equipment pool of an owner: Gun_List_<owner>[1], [2] and Syst_List.
function TRF_ShopEquipPool(owner)
	local out = {};
	local t = getglobal(TRF_ShopGunListOf(owner));
	if type(t) ~= "table" then t = Gun_List_Unknown; end;
	if type(t) == "table" then
		for g = 1, 2 do
			if type(t[g]) == "table" then
				for j = 1, getn(t[g]) do tinsert(out, t[g][j]); end;
			end;
		end;
	end;
	if type(Syst_List) == "table" then
		for j = 1, getn(Syst_List) do tinsert(out, Syst_List[j]); end;
	end;
	return out;
end;

-- Trader shop coefficients s, b for the current system.
function TRF_ShopCoef()
	return TRF_ShopCoefOf(TRF_Shop_Diff(), TRF_Shop_Help(), TRF_Shop_Pro(TRF_ShopCur()));
end;

-- Station coefficients s0, b0 of a shop for the current difficulty, or nil (no market write).
function TRF_DefCoef(shop)
	return TRF_DefCoefOf(shop, TRF_Shop_Diff());
end;

-- Contract: shortages (7.2) --------------------------------------------------------

-- Shortage of class cls at system idx until leg till (default legs + L_short). cls nil: class by owner.
-- pk = 1: caused by the player (counted player fire on the lost trader, a robbery) or by the player's own
-- freighter (#8); such an entry is never a relief target (TRF_ShortRelief, 00 section 6). Returns 1 when added
-- or merged.
function TRF_ShortAdd(idx, cls, till, pk)
	if type(TRF) ~= "table" or type(idx) ~= "number" then return nil; end;
	local L = TRF_ShopLegs();
	if type(cls) ~= "number" then
		cls = TRF_ShortClsOf(TRF_Shop_Team(TRF_ShopSysName(idx)), TRF_Shop_Rand(100));
	end;
	cls = floor(cls);
	if cls < 1 or cls > 6 then return nil; end;
	if type(till) ~= "number" then till = L + TRF_ShopTune("L_short", 6); end;
	till = floor(till);
	if till <= L then return nil; end;
	local list = TRF_ShopShort();
	local was = getn(list);
	local e = {s=idx, c=cls, t=till};
	if pk == 1 then e.pk = 1; end;
	local how, d = TRF_ShortAddOf(list, e, 8);
	if d then
		TRF_ShopE("shortage", "system", TRF_ShopSysName(idx), "system_index", idx, "cargo_class", cls, "until_legs", till,
			"shortage_count", getn(list), "dropped_system", TRF_ShopSysName(d.s), "dropped_class", d.c, "dropped_until_legs", d.t,
			"result", how);
	else
		TRF_ShopE("shortage", "system", TRF_ShopSysName(idx), "system_index", idx, "cargo_class", cls, "until_legs", till,
			"shortage_count", getn(list), "player_caused", TRF_KvB(pk), "result", how);
	end;
	TRF_ShopStat("short_"..how);
	if was == 0 or how == "new" then TRF_N("TRF_NewsCheck", "short"); end;
	if how == "drop" and d and d.s == idx and d.c == cls then return nil; end;
	return 1;
end;

-- Ends the shortages of system idx (class cls, or every class when cls is nil), e.g. a path A trader of
-- that class docked there. Returns the number removed; the coefficient is restored at the next dock.
function TRF_ShortClear(idx, cls)
	if type(TRF) ~= "table" or type(idx) ~= "number" then return 0; end;
	local list = TRF_ShopShort();
	local keep, n = {}, 0;
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" and e.s == idx and (cls == nil or e.c == cls) then
			n = n + 1;
		elseif type(e) == "table" then
			tinsert(keep, e);
		end;
	end;
	TRF.short = keep;
	if n > 0 then
		TRF_ShopE("shortage", "system", TRF_ShopSysName(idx), "system_index", idx, "cargo_class", cls, "removed_count", n,
			"result", "cleared");
	end;
	return n;
end;

-- Relief targets (00 section 6, 01 section 6): active shortages without pk = 1 and without an attached job
-- (job = 1), as {s, c, t} copies in list order.
function TRF_ShortRelief()
	local out = {};
	local L = TRF_ShopLegs();
	local list = TRF_ShopShort();
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" and type(e.s) == "number" and type(e.t) == "number" and e.t > L and e.pk ~= 1 and e.job ~= 1 then
			tinsert(out, {s=e.s, c=e.c, t=e.t});
		end;
	end;
	return out;
end;

-- Relief job flag (00 section 6, 01 section 6): job = 1 on the active entry (idx, cls) while a #1 relief parcel targets it
-- (v = 1), cleared with v = nil. The entry keeps its till. Returns 1 when an entry was found.
function TRF_ShortJob(idx, cls, v)
	if type(TRF) ~= "table" or type(idx) ~= "number" or type(cls) ~= "number" then return nil; end;
	local list = TRF_ShopShort();
	local hit = nil;
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" and e.s == idx and e.c == cls then
			if v == 1 then e.job = 1; else e.job = nil; end;
			hit = 1;
		end;
	end;
	if hit then TRF_ShopE("shortage", "system", TRF_ShopSysName(idx), "cargo_class", cls, "job", TRF_KvB(v == 1), "result", "job"); end;
	return hit;
end;

-- A #1 relief delivery (01 section 4): the active entry (idx, cls) ends at the next cleanup (till = now, so it is no
-- longer active; TRF_ShortExpire drops it, the next dock restores the price), its job flag cleared. 1 when it was active.
function TRF_ShortEnd(idx, cls)
	if type(TRF) ~= "table" or type(idx) ~= "number" or type(cls) ~= "number" then return nil; end;
	local list = TRF_ShopShort();
	local L = TRF_ShopLegs();
	local hit = nil;
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" and e.s == idx and e.c == cls and type(e.t) == "number" then
			if e.t > L then hit = 1; e.t = L; end;
			e.job = nil;
		end;
	end;
	if hit then TRF_ShopE("shortage", "system", TRF_ShopSysName(idx), "cargo_class", cls, "until_legs", L, "result", "relieved"); end;
	return hit;
end;

-- Active shortage classes of system idx, ascending (empty list when none).
function TRF_ShortOf(idx)
	local a = TRF_ShortActiveOf(TRF_ShopShort(), idx, TRF_ShopLegs());
	local out = {};
	for c = 1, 6 do
		if a[c] then tinsert(out, c); end;
	end;
	return out;
end;

-- Drops shortages with t <= legs and malformed entries (TRF_Decay, region tick). Returns the number removed.
function TRF_ShortExpire()
	if type(TRF) ~= "table" then return 0; end;
	local list = TRF_ShopShort();
	local L = TRF_ShopLegs();
	local keep, n = {}, 0;
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" and type(e.s) == "number" and type(e.c) == "number" and type(e.t) == "number" and e.t > L then
			tinsert(keep, e);
		else
			n = n + 1;
		end;
	end;
	if n > 0 then
		TRF.short = keep;
		TRF_ShopE("shortage", "removed_count", n, "left_count", getn(keep), "legs", L, "result", "expired");
	end;
	return n;
end;

-- Contract: station writes (7.2) ---------------------------------------------------

-- 1 when a shortage price may be written now: cfg short_price 1, no __disableAction, system mode "mod"
-- (a mission system in vanilla mode keeps its prices; the shortage applies at a later dock).
function TRF_ShopWriteOk()
	if TRF_ShopOpt("short_price", 1) == 0 then return nil, "short_price"; end;
	if __disableAction == TRUE then return nil, "flag"; end;
	local m = nil;
	if type(TRF_SysModeQuiet) == "function" then m = TRF_SysModeQuiet(); end;
	if m ~= "mod" then return nil, "mode"; end;
	return 1;
end;

-- Restore-list entry (s, sh, c): found or added (at most 8). 1, or nil when the list is full.
function TRF_ShopRecord(idx, shop, c)
	local list = TRF_ShopList();
	local sh = strlower(shop);
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" and e.sh == sh and e.c == c then return 1; end;
	end;
	if getn(list) >= 8 then return nil; end;
	tinsert(list, {s=idx, sh=sh, c=c});
	return 1;
end;

-- Shortage prices at shop (system idx): for each active class, count-0 entries of its containers with
-- buy b0 x short_coef, recorded in TRF.shops before the write (M14). Returns the number of writes.
function TRF_ShopApply(shop, idx)
	if type(shop) ~= "string" or type(idx) ~= "number" then return 0; end;
	local act = TRF_ShortActiveOf(TRF_ShopShort(), idx, TRF_ShopLegs());
	local any = nil;
	for c, t in act do any = 1; end;
	if not any then return 0; end;
	local s0, b0 = TRF_DefCoef(shop);
	if not s0 then
		TRF_ShopStat("short_nolist");
		TRF_ShopE("apply", "shop", shop, "result", "skipped", "reason", "no_vanilla_list");
		return 0;
	end;
	local m = TRF_Shop_Market(shop);
	if not m then TRF_ShopStat("short_nomarket"); TRF_ShopE("apply", "shop", shop, "result", "skipped", "reason", "no_market"); return 0; end;
	local b = b0 * TRF_ShopTune("short_coef", 1.5);
	local s = max(s0, b + 0.2);
	local items = TRF_ShopClsItems();
	local n = 0;
	for c, t in act do
		if TRF_ShopRecord(idx, shop, c) then
			local k = 0;
			for j = 1, getn(items[c]) do
				if TRF_Shop_Put(m, items[c][j], 0, s, b) then k = k + 1; end;
			end;
			n = n + k;
			TRF_ShopE("apply", "shop", shop, "cargo_class", c, "sell_coef", TRF_ShopF(s), "buy_coef", TRF_ShopF(b), "item_count", k,
				"until_legs", t);
		else
			TRF_ShopStat("short_full");
			TRF_ShopE("apply", "shop", shop, "cargo_class", c, "result", "skipped", "reason", "restore_list_full");
		end;
	end;
	return n;
end;

-- Restores the restore-list entries of shop: those without an active shortage, or all (enabled 2).
-- cfg restore 1 writes s0, b0 on count-0 entries, 2 uses ClearGoodsState. An entry stays when a write
-- failed (retried at the next dock). Returns the number of entries restored.
function TRF_ShopRestore(shop, all)
	if type(TRF) ~= "table" or type(shop) ~= "string" then return 0; end;
	local list = TRF_ShopList();
	local sh = strlower(shop);
	local L = TRF_ShopLegs();
	local mode = TRF_ShopOpt("restore", 1);
	local items = TRF_ShopClsItems();
	local keep, n = {}, 0;
	local m, s0, b0 = nil, nil, nil;
	for i = 1, getn(list) do
		local e = list[i];
		local drop = nil;
		if type(e) ~= "table" or type(e.c) ~= "number" or e.c < 1 or e.c > 6 then
			drop = 1;
		elseif e.sh == sh and (all or not TRF_ShortActiveOf(TRF_ShopShort(), e.s, L)[e.c]) then
			if not m then m = TRF_Shop_Market(shop); s0, b0 = TRF_DefCoef(shop); end;
			if not s0 then
				drop = 1;
				TRF_ShopE("restore", "shop", sh, "cargo_class", e.c, "result", "dropped", "reason", "no_vanilla_list");
			elseif m then
				local ok, k = 1, 0;
				for j = 1, getn(items[e.c]) do
					local w = nil;
					if mode == 2 then w = TRF_Shop_Clear(m, items[e.c][j]); else w = TRF_Shop_Put(m, items[e.c][j], 0, s0, b0); end;
					if w then k = k + 1; else ok = nil; end;
				end;
				if ok then
					drop = 1;
					n = n + 1;
					TRF_ShopE("restore", "shop", sh, "cargo_class", e.c, "sell_coef", TRF_ShopF(s0), "buy_coef", TRF_ShopF(b0),
						"item_count", k, "mode", mode);
				else
					TRF_ShopStat("restore_fail");
				end;
			end;
		end;
		if not drop then tinsert(keep, e); end;
	end;
	TRF.shops = keep;
	return n;
end;

-- Wrapper body (protected): restore first, then the shortage prices, then player priority (trf_gen).
function TRF_ShopDock()
	if type(TRF) ~= "table" then return; end;
	local shop = TRF_Shop_Param();
	if type(shop) ~= "string" or shop == "" then return; end;
	local all = TRF_ShopOpt("enabled", 1) == 2;
	local r = 0;
	if all then r = TRF_ShopRestore(shop, 1); else r = TRF_ShopRestore(shop, nil); end;
	local w = 0;
	if not all then
		local ok, why = TRF_ShopWriteOk();
		if ok then
			w = TRF_ShopApply(shop, TRF_ShopCur());
		elseif getn(TRF_ShortOf(TRF_ShopCur())) > 0 then
			TRF_ShopE("apply", "shop", shop, "result", "deferred", "reason", why);
		end;
	end;
	if r + w > 0 then TRF_Shop_Update(); end;
	if all then
		local left = getn(TRF_ShopList());
		local res = "pending";
		if left == 0 then res = "done"; end;
		TRF_ShopE("restore", "pending_count", left, "result", res);
	end;
	if not all and type(TRF_P) == "function" then TRF_P("TRF_QPlayer"); end;
end;

-- Installed over __TradeStationDock_Ok (box OK of the trade docking). With trf_plumb the dock dispatcher runs
-- (kind trade: this module's restore line first, design/wb-plumbing-spec.md 4); without it, and always with
-- cfg enabled 2 (a TRF_PlDock left from an earlier MapInitialization is a function global and stays defined),
-- the restore and the station's docked line. The mod part is protected; the original always runs afterwards,
-- unprotected by a mod handler so vanilla errors keep their path.
function TRF_TradeDockOk()
	if type(TRF_PlDock) == "function" and TRF_ShopOpt("enabled", 1) ~= 2 then return TRF_PlDock("trade", "TRF_orig_TradeOk", {}); end;
	call(TRF_ShopDock, {}, "x", TRF_ShopErr);
	TRF_P("TRF_Stn_Docked");
	local f = TRF_orig_TradeOk;
	if type(f) == "function" then call(f, {}, "x"); end;
end;

-- Dock line of kind trade, order 10 (shortage restore, 00 section 6), also under the flags: the restore undoes
-- mod prices. Shows no line.
function TRF_ShopDockLine(kind)
	call(TRF_ShopDock, {}, "x", TRF_ShopErr);
	return nil;
end;

-- Registrations (trf_plumb TRF_InstallPlumb).
function TRF_Shop_Plumb()
	TRF_DockLine("trade", 10, "TRF_ShopDockLine", 1);
end;

-- 1 when f is this module's wrapper (thunk identity of an earlier run, or a Mods/Traffic chunk name).
function TRF_ShopIsMine(f)
	if type(f) ~= "function" then return nil; end;
	if type(TRF_TradeThunk) == "function" and f == TRF_TradeThunk() then return 1; end;
	if type(TRF_IsMine) == "function" and TRF_IsMine(f) then return 1; end;
	return nil;
end;

-- Called on every MapInitialization after the includes (DockStation.script has just redefined the vanilla
-- function). The OK function is read by __TradeStation_Action at the box call, so the wrapper is used from
-- the next docking on. Returns 1 when wrapped in this run, 0 when already wrapped or missing.
function TRF_InstallTradeDock()
	local done = 0;
	if type(__TradeStationDock_Ok) == "function" and not TRF_ShopIsMine(__TradeStationDock_Ok) then
		TRF_orig_TradeOk = __TradeStationDock_Ok;
		local w = function()
			if type(TRF_TradeDockOk) == "function" then return TRF_TradeDockOk(); end;
			if type(TRF_orig_TradeOk) == "function" then return TRF_orig_TradeOk(); end;
		end;
		__TradeStationDock_Ok = w;
		TRF_TradeThunk = function() return %w; end;
		done = 1;
	end;
	local left = nil;
	if TRF_ShopOpt("enabled", 1) == 2 and type(TRF) == "table" then left = getn(TRF_ShopList()); end;
	TRF_ShopE("install", "trade_dock", TRF_KvB(done), "wrapped", TRF_KvB(TRF_ShopIsMine(__TradeStationDock_Ok)),
		"restore_pending_count", left);
	return done;
end;

-- Contract: trader shop (7.1) ------------------------------------------------------

-- Vanilla trader shop (cfg shop_mode 0 and fallback): On_FTrader_Start (RandomContacts.script 405-412).
function TRF_ShopVanilla(id, why)
	TRF_ShopE("open", "trader_id", id, "via", "vanilla", "reason", why);
	TRF_ShopStat("shop_vanilla");
	if type(On_FTrader_Start) ~= "function" then return nil, "nofunc"; end;
	call(On_FTrader_Start, {}, "x");
	return 1, "vanilla";
end;

-- Market of trf_shop_<k>: CreateShop on first use per game (TRF.tsh[k] = 2), per MapInitialization with
-- tune tsh_visit 1, and once more when the market is missing. CHECK E0.4: a runtime shop persists through
-- save/load and a repeated CreateShop is safe.
function TRF_ShopEnsure(k, name)
	local tsh = TRF_ShopTsh();
	local mk = %SH.mk;
	if tsh[k] ~= 2 or (TRF_ShopTune("tsh_visit", 0) == 1 and mk[k] ~= 1) then
		TRF_Shop_Create(name);
		tsh[k] = 2;
		mk[k] = 1;
		TRF_ShopE("create", "shop", name);
	end;
	local m = TRF_Shop_Market(name);
	if not m and mk[k] ~= 1 then
		TRF_Shop_Create(name);
		mk[k] = 1;
		TRF_ShopE("create", "shop", name, "reason", "market_missing");
		m = TRF_Shop_Market(name);
	end;
	return m;
end;

-- Wipe list of a trader shop: every item a fill can ever write, each once. TRF_ShopItems() (containers, every
-- Gun_List_* [1] and [2], Syst_List, the cargo lists), again every class's TRF_ShopClsItems() and every
-- owner's TRF_ShopEquipPool, so a stale TRF_ShopItems cache still covers the equipment draw. Markets are
-- write-only (no market read): an item outside these lists (a player sale of another item) cannot be
-- enumerated and may stay in the shop.
function TRF_ShopWipeList()
	local out, seen = {}, {};
	local add = function(t)
		for j = 1, getn(t) do
			local it = t[j];
			if type(it) == "string" and not %seen[it] then %seen[it] = 1; tinsert(%out, it); end;
		end;
	end;
	add(TRF_ShopItems());
	local ci = TRF_ShopClsItems();
	for c = 1, getn(ci) do add(ci[c]); end;
	local ow = {"Unknown", "Uss", "Triada", "Inoco", "Vks", "Kfni", "Uft", "Patrol"};
	for i = 1, getn(ow) do add(TRF_ShopEquipPool(ow[i])); end;
	return out;
end;

-- Destination system of a trader record for the short-class bonus: r.to 0 = this system's station.
function TRF_ShopDest(r)
	if type(r.to) ~= "number" then return nil; end;
	if r.to == 0 then return TRF_ShopCur(); end;
	if r.to > 0 then return r.to; end;
	return nil;
end;

-- Opens the trader's shop trf_shop_<k> (k = TRF_ShopSlot(r); once per trader, r.trd): wiped first (count 0
-- with the coefficients for every item of TRF_ShopWipeList, so the previous trader's stock and the player's
-- sales of those items do not carry over), then the hold mirror with its totals, 3..6 equipment items (count 2) of the
-- owner, then the dialog. Cfg log 2 adds a line with the item names put. Items of a class
-- short at the trader's destination get buy x short_bonus (sell kept >= buy + 0.2).
-- Called from a due call (trf_hail), never inside a box callback. Returns 1 or nil, reason.
function TRF_ShopOpen(id)
	local r = nil;
	if type(TRF_Rec) == "function" then r = TRF_Rec(id); end;
	if type(r) ~= "table" then return nil, "rec"; end;
	if r.trd == 1 then return nil, "used"; end;
	r.trd = 1;
	if TRF_ShopOpt("shop_mode", 1) == 0 then return TRF_ShopVanilla(id, "shop_mode 0"); end;
	local k = TRF_ShopSlot(r);
	local name = TRF_ShopName(k);
	local m = TRF_ShopEnsure(k, name);
	if not m then return TRF_ShopVanilla(id, "no market "..name); end;
	local s, b = TRF_ShopCoef();
	local act = {};
	local dest = TRF_ShopDest(r);
	if dest then act = TRF_ShortActiveOf(TRF_ShopShort(), dest, TRF_ShopLegs()); end;
	local kb = TRF_ShopTune("short_bonus", 1.2);
	local coef = function(item)
		local c = TRF_ShopItemCls(item);
		local bi = %b;
		if c and %act[c] then bi = %b * %kb; end;
		return max(%s, bi + 0.2), bi;
	end;
	local items = TRF_ShopWipeList();
	local nz = 0;
	for i = 1, getn(items) do
		local si, bi = coef(items[i]);
		if TRF_Shop_Put(m, items[i], 0, si, bi) then nz = nz + 1; end;
	end;
	local order, tot = TRF_ShopHoldOf(r.hold);
	local nh = 0;
	local ph, pe = "", "";
	for i = 1, getn(order) do
		local si, bi = coef(order[i]);
		if TRF_Shop_Put(m, order[i], tot[order[i]], si, bi) then
			nh = nh + tot[order[i]];
			ph = ph..","..order[i]..":"..tot[order[i]];
		end;
	end;
	local owner = TRF_Shop_Team(TRF_N("GetCurrentLocation"));
	-- Corporation carriers (design/corp-carriers-spec.md 5.2): a carrier stocks its corporation's gun list and Syst_List,
	-- its lore-named item first at count 1 (counted in the 3-6 items), Triada one item more; coefficients unchanged.
	local cs = TRF_N("TRF_Crp_Shop", r);
	if type(cs) ~= "table" then cs = nil; end;
	if cs and type(cs.own) == "string" then owner = cs.own; end;
	local pool = TRF_ShopEquipPool(owner);
	local ne = 0;
	local want = 3 + TRF_Shop_Rand(4);
	local sig = nil;
	if cs then
		want = want + (cs.add or 0);
		if type(cs.sig) == "string" then
			for i = getn(pool), 1, -1 do if pool[i] == cs.sig then tremove(pool, i); end; end;
			if TRF_Shop_Put(m, cs.sig, 1, s, b) then ne = ne + 1; pe = pe..","..cs.sig; sig = cs.sig; end;
		end;
	end;
	while ne < want and getn(pool) > 0 do
		local it = tremove(pool, TRF_Shop_Rand(getn(pool)) + 1);
		if TRF_Shop_Put(m, it, 2, s, b) then ne = ne + 1; pe = pe..","..it; end;
	end;
	TRF_Shop_Update();
	TRF_N("SetTraderFlag", TRUE);
	TRF_N("TradeStationDlg", name);
	local sc = "";
	for c, t in act do sc = sc..","..c; end;
	TRF_ShopE("open", "trader_id", id, "shop", name, "sell_coef", TRF_ShopF(s), "buy_coef", TRF_ShopF(b), "zero_count", nz,
		"hold_count", nh, "equip_count", ne, "owner", owner, "destination", dest, "shortage_classes", strsub(sc, 2),
		"corp", cs and cs.own, "signature", sig);
	local lv = TRF_ShopOpt("log", 1);
	if type(lv) == "number" and lv >= 2 then
		TRF_ShopE("items", "trader_id", id, "shop", name, "hold", strsub(ph, 2), "equip", strsub(pe, 2));
	end;
	TRF_ShopStat("shop_open");
	return 1;
end;

-- Defaults and dump (10.4) ---------------------------------------------------------

function TRF_Shop_OptDef()
	return {shop_mode=1, short_price=1, restore=1};
end;

-- tsh_visit: 1 creates trf_shop_<k> once per MapInitialization (fallback if E0.4 shows no persistence).
function TRF_Shop_TuneDef()
	return {L_short=6, short_coef=1.5, short_bonus=1.2, tsh_visit=0};
end;

function TRF_Shop_Dump()
	if type(TRF) ~= "table" then return; end;
	local s = "";
	local list = TRF_ShopShort();
	for i = 1, getn(list) do
		local e = list[i];
		if type(e) == "table" then s = s..","..TRF_ShopSysName(e.s)..":"..tostring(e.c).."@"..tostring(e.t); end;
	end;
	if s == "" then s = ",none"; end;
	local r = "";
	local sl = TRF_ShopList();
	for i = 1, getn(sl) do
		local e = sl[i];
		if type(e) == "table" then r = r..","..tostring(e.sh)..":"..tostring(e.c); end;
	end;
	if r == "" then r = ",none"; end;
	local t = "";
	local tsh = TRF_ShopTsh();
	for k = 1, 5 do
		if tsh[k] == 2 then t = t..","..k; end;
	end;
	if t == "" then t = ",none"; end;
	TRF_ShopE("dump", "shortages", strsub(s, 2), "restore_list", strsub(r, 2), "trader_shops", strsub(t, 2),
		"shop_mode", TRF_ShopOpt("shop_mode", 1), "short_price", TRF_ShopOpt("short_price", 1), "restore", TRF_ShopOpt("restore", 1));
end;
