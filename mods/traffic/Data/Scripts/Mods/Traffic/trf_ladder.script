		ladrank27 = "Commended by the Empress",
		ladrank31 = "Marked by the families", ladrank32 = "Unwelcome", ladrank33 = "Outsider", ladrank34 = "Known face",
		ladrank35 = "Trusted associate", ladrank36 = "Friend of the family", ladrank37 = "Under the Triumvirate's protection",
		ladrank41 = "Blacklisted shipper", ladrank42 = "Under review", ladrank43 = "Freelancer", ladrank44 = "Listed escort",
		ladrank45 = "Preferred escort", ladrank46 = "Convoy partner", ladrank47 = "Honorary director",
		ladrank51 = "Barred from InoCo space", ladrank52 = "Under review", ladrank53 = "Visitor", ladrank54 = "Listed vendor",
		ladrank55 = "Approved vendor", ladrank56 = "Partner", ladrank57 = "Board guest",
		ladfac1 = "MSF", ladfac2 = "NESF", ladfac3 = "Triada", ladfac4 = "USS", ladfac5 = "InoCo",
		ladline = "$1 standing: $2 ($3).",                                                 -- faction, title, fst
		ladnoperm = "No permit on file.",
		ladperm = "Permit valid $1 more legs.",                                            -- legs left
		ladrival = "You fly under $1 papers. The $2 has nothing for you.",                 -- other empire, faction
		ladvoid1 = "NESF papers? This is MSF space now.",
		ladvoid2 = "MSF papers? This is New Empire space now.",
