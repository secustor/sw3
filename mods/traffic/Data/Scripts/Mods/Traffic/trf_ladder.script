		ladissued = "Permit issued. $1 sector, valid $2 legs.",                            -- sector, legs
		ladcapped = "$1 standing capped at $2 while you carry $3 papers.",                 -- other empire, cap, faction
		ladpoor = "Not enough credits. Come back when you can pay.",
