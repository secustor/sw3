		ted10s5 = "The patrol wants a file on the Red Knives. Answer two of their raids in the Cadi region.",
		ted10s6 = "The patrol wants a file on the Cold Suns. Answer two of their raids in the Muscovy region.",
		ted10s7 = "The patrol wants a file on the Bone Hounds. Answer two of their raids in the Torr region.",
		ted10s8 = "The patrol wants a file on the Night Kites. Answer two of their raids in the XT-27 region.",
