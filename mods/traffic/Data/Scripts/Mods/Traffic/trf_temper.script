		teok = "Patrol officer: 'Two raids, then come back. Over and out.'",
		tecnt = "Clan file: $1 of $2 raids of the $3 answered.",
		tecnt2 = "Clan file: two raids of the $1 answered. Report to any $2 patrol station.",
		terep1 = "Patrol officer: 'No talk, they just open fire? Into the file it goes. Our board marks each clan by how it fights now.'",
		terep2 = "Patrol officer: 'They talk first and let you go for a few crates? Into the file it goes. Our board marks each clan by how it fights now.'",
		terep3 = "Patrol officer: 'Fat targets, and they pull back when the odds turn? Into the file it goes. Our board marks each clan by how it fights now.'",
