-- sw3-traffic v0.2 hail menu, escort contract, trouble/boom answers and patrol work board (Lua 4.0.1).
-- Spec: design/v02-spec.md 5.6, 6.1-6.4, 10.1. The 70-unit announce and the hail arm are in trf_ui
-- (TRF_OnMeet_Body, cfg meet 2); this file owns the focus request, the ShowMsgBox chain, the answers and
-- the __PatrolStationDock_Ok wrapper. Top level defines functions only. State: TRF.live.hl (open box
-- chain), live.ct (contract), live.board / live.bkd (board: last full report, declined offer kinds); per trader record ha, hn,
-- hlt, hr (focus arms), trd, hd, nw, tu, bm (options used; tu was tb in v0.2, tb is v1 tracking bits), ct,
-- hds (heat distress shown), hx (v1 options used, ",key,"). Log prefix "hl:".
-- v1 (v1-spec 7.4, 8.4, 8.5, 10.2): option providers, the refusal box with demand cargo, the sweep
-- offers in the hail (cfg board 2), v1 rumours, carrier and base words in the trouble answer, the
-- equipment convoy line in the booming answer, faction offer boxes after the patrol board.
-- Worldbuilding plumbing (design/wb-plumbing-spec.md 4): the patrol board runs in trf_plumb's dock dispatcher
-- (kind patrol): the S19 answers as lines, one 8.10 offer box per docking; the hail boxes take the message
-- box lock (owner "hail", freed when the chain closes).
-- v1 option providers TRF_Supply_HailOpts, TRF_Feq_HailOpts, TRF_Dc_HailOpts are called as f(id, r) and
-- return nil or a list of items. An item is an option key, label TRF_Txt("opt"..key), run on OK by the
-- provider's TRF_<M>_HailDo(key, id) (TRF_Supply_HailDo, TRF_Feq_HailDo, TRF_Dc_HailDo) with the menu
-- still open: a HailDo that opens its own box sets hl.w, otherwise the menu is closed after it. Without a
-- HailDo: "demand" runs TRF_DemandDo(id); "feq" is the offer box TRF_FeqOffer(id) whose OK calls
-- TRF_FeqAccept(id). An item can also be a table {k=key, t=label, s=answer, q=offer, ok=accept, f=action,
-- a=arg, x=1}: s: OK shows the answer s. q: OK shows the offer box q (OK/Cancel), its OK calls ok(id, a);
-- label "Need an escort" unless t is given. f: OK closes the menu and calls f(id, a); a string result is
-- said. x = 1: only provider options are offered (no trade, news, escort). The lead of an equipment convoy
-- (TRF_FeqId(id) gives its identity line) gets only the provider options and "Who are you" (8.4). f and ok
-- are global function names or functions; items stay in the handle table (TRF_H().hlx), never in TRF.
-- Faction offers (TRF_Faction_BoardOffers(), board and hail) are lists of {text (or q, t), title, ok, no,
-- a}: one OK/Cancel box each, chained by due calls; OK calls ok(a) (a string result is said), Cancel no(a).
-- Box callbacks and trigger actions are shims through TRF_Cb. Callbacks only record the choice; the next
-- box and every action run from the due call TRF_HailStep, never inside a box callback (6.1, decision 25).
-- Other modules are called by name after a type check, so a missing one only disables its part.
-- Tune hail_box 2 (design/mod-research/hail-dialog.md stage A): the menu is one trade dialog
-- (Data/Scripts/Trade/TRF_Hail.xml, TRF_HlDlgOpen) whose answers record the pick as a box OK would; every
-- follow-up (answer, offer and contract boxes) is the box chain's. cfg hail_xml 1 (set by the installers when
-- they copied the file) is required; otherwise, and when the native or an idle UI is missing, the boxes run.
-- Demand result page (design/demand-page-spec.md): TRF_HlPage, called by trf_supply after a demand from the hail due
-- call, shows the answer on the open chain (hl.w "dlg" with the dialog TRF_HailPg, else "pg" and "pgq" boxes; hl.pn
-- = 1 offers No witnesses, whose pick calls TRF_DemandNoWit(id) from a due call).
-- Stage B (design/hail-spec.md 2, tune hail_box 2): every follow-up of a dialog menu is a page of the dialog TRF_HailPg
-- opened from the due call TRF_HailStep with its text set in the init (TRF_HlPgShow, the TRF_HlPage pattern): an
-- answer with Back (the menu dialog again, the used option hidden: TRF_HlBack) and Close; an offer (escort contract,
-- sweep and provider offers) with Accept and Decline (Decline: back to the menu). hl.bx = 1 once the chain fell back to
-- the boxes (TRF_HlDlgWhy, the box lock); then the box chain runs as with hail_box 1.
-- Combat hail (hail-spec 3, cfg hail_fight 1): a trader in a fight (TRF_HlFight: a raid record past armed, hostile
-- ships within hail_fight_r of its lead through trf_plumb's TRF_Near, its escort flight fighting) answers with one
-- page and no menu: while the fight goes against it the help offer (Accept/Decline, pay help_k x N_eff, once per
-- trader: r.hlp 1 offered, 2 accepted, 3 settled), else "busy". An accepted offer on a raid is paid by trf_raid's raid
-- help (TRF_Rd_Pay, any player fire on the raid counts, then TRF_HlHelpEnd); any other fight by the watch H.hlw[id]
-- (TRF_HlHelpStep) through TRF_Pay when no hostile is left near the trader.

-- Helpers --------------------------------------------------------------------------

-- One logfmt event line of module hail (design/log-format.md 5).
function TRF_HlE(event, ...) tinsert(arg, 1, event); tinsert(arg, 1, "hail"); call(TRF_Lf, arg); end;

-- Debug event line (cfg log 2).
function TRF_HlDE(event, ...)
	local v = TRF_HlOpt("log", 1);
	if type(v) ~= "number" or v < 2 then return; end;
	tinsert(arg, 1, event);
	call(TRF_HlE, arg);
end;

-- Error handler of the protected calls: event=error, counted in stat err.
function TRF_HlErr(m)
	TRF_HlE("error", "message", tostring(m));
	if type(TRF_Stat) == "function" then TRF_Stat("err"); end;
end;

-- Protected call; nil on error or when f is not a function.
function TRF_HlP(f, args)
	if type(f) ~= "function" then return nil; end;
	return call(f, args, "x", TRF_HlErr);
end;

-- Defaults of the cfg keys this module owns (10.4).
function TRF_Hail_OptDef()
	return {contracts=1, esc_speed=0, hail_start=2, board=1, hail_xml=0, hail_fight=1};
end;

-- Tune keys read here (10.4). hail_rearm, hail_stale and hail_box are not in the spec table: focus re-arms
-- per trader, age of an open box chain that counts as stale (6.1 "older than 120 s"), hail_box 0 = answers
-- as lines, 1 = the ShowMsgBox chain, 2 = the menu as the trade dialog TRF_Hail (needs cfg hail_xml 1).
-- ct_off_* shape the escort offer chance of TRF_CtOfferP. Combat hail (hail-spec 6): hail_fight_r radius around the
-- trader lead for hostile ships (and around a hostile for the player's ships of the help watch), hail_help_ratio the
-- strength ratio (trader side / raid side) below which a raided trader asks for help, help_k the help pay factor of
-- N_eff (also trf_raid's raid-help pay, v02 5.5 0.5), help_engage 1: the help watch pays when the player engaged (a
-- player ship within hail_fight_r of a hostile), 0: only with a counted kill (hail-spec 5.4).
function TRF_Hail_TuneDef()
	return {hail_r=150, hail_arm=60, hail_cd=60, hail_max=2, hail_rearm=20, hail_stale=120, hail_box=1,
		trouble_range=3, boom_min_pro=6, ct_dist=400, pay_cap=30000,
		ct_off_dis=0.5, ct_off_br=1.3, ct_off_min=5, ct_off_max=95,
		hail_fight_r=600, hail_help_ratio=1, help_k=0.5, help_engage=1};
end;

-- Tune help_engage clamped to 0/1 (hail-spec 5.4): 1 = the watch pays on engagement, 0 = on a counted kill.
function TRF_HlEngage()
	local v = TRF_HlT("help_engage");
	if type(v) == "number" and v < 0.5 then return 0; end;
	return 1;
end;

-- Constants without a tune key: help watch step and its time-out (game s, hail-spec 5.4).
function TRF_HlK()
	return {hstep=2, hmax=300};
end;

-- cfg value: TRF_Opt, raw config, this module's default; enumerations outside their range read as default.
function TRF_HlOpt(key, def)
	local d = TRF_Hail_OptDef()[key];
	if d == nil then d = def; end;
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil and type(TRF_Cfg) == "function" then v = TRF_Cfg()[key]; end;
	if v == nil or (d ~= nil and type(v) ~= type(d)) then return d; end;
	if key == "contracts" and v ~= 0 and v ~= 1 then return d; end;
	if key == "hail_start" and v ~= 1 and v ~= 2 then return d; end;
	if key == "board" and v ~= 0 and v ~= 1 and v ~= 2 then return d; end;
	if key == "hail_xml" and v ~= 0 and v ~= 1 then return d; end;
	if key == "hail_fight" and v ~= 0 and v ~= 1 then return d; end;
	if key == "esc_speed" and v < 0 then return 0; end;
	return v;
end;

-- Tune value: TRF_Tune, this module's table, then the v1 table (trf_loc).
function TRF_HlT(key)
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" and type(t[key]) == "number" then return t[key]; end;
	end;
	local v = TRF_Hail_TuneDef()[key];
	if v == nil and type(TRF_V1_TuneDef) == "function" then v = TRF_V1_TuneDef()[key]; end;
	return v;
end;

function TRF_HlLive()
	if type(TRF) == "table" and type(TRF.live) == "table" then return TRF.live; end;
	return nil;
end;

function TRF_HlGt()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.gt) == "number" then return TRF.clock.gt; end;
	return 0;
end;

function TRF_HlRec(id)
	if type(TRF_Rec) == "function" and type(id) == "number" then return TRF_Rec(id); end;
	return nil;
end;

-- Trader record id, also a gone one (st gone, stripped to TRF_GoneKeep: nm and why stay), or nil.
function TRF_HlRecAny(id)
	local L = TRF_HlLive();
	if L and type(L.tr) == "table" and type(id) == "number" and type(L.tr[id]) == "table" then return L.tr[id]; end;
	return nil;
end;

function TRF_HlStat(k)
	if type(TRF_Stat) == "function" then TRF_Stat(k); end;
end;

function TRF_HlCur()
	if type(TRF_CurIdx) == "function" then return TRF_CurIdx(); end;
	return nil;
end;

function TRF_HlMap()
	if type(TRF_Map) == "function" then return TRF_Map(); end;
	return nil;
end;

function TRF_HlHeat()
	if type(TRF) == "table" and type(TRF.std) == "table" and type(TRF.std.heat) == "number" then return TRF.std.heat; end;
	return 0;
end;

function TRF_HlDis(idx)
	if type(TRF_Dis) == "function" then return TRF_Dis(idx) or 0; end;
	return 0;
end;

-- Prosperity of a system: trf_region's TRF_Pro, else the saved field, else 0.
function TRF_HlPro(idx)
	local p = nil;
	if type(TRF_Pro) == "function" then
		p = TRF_HlP(TRF_Pro, {idx});
	elseif type(TRF) == "table" and type(TRF.sys) == "table" and type(TRF.sys[idx]) == "table" then
		p = TRF.sys[idx].pro;
	end;
	if type(p) ~= "number" then return 0; end;
	return p;
end;

-- Effective clan tier 1..4 (1 without trf_region).
function TRF_HlTier(idx)
	local t = nil;
	if type(TRF_EffTier) == "function" then t = TRF_HlP(TRF_EffTier, {idx}); end;
	if type(t) ~= "number" then return 1; end;
	if t < 1 then return 1; end;
	if t > 4 then return 4; end;
	return floor(t);
end;

-- Strict gate (8.3); 1 when trf_safety has no TRF_StrictOk, nil on an error (deny side).
function TRF_HlStrict(idx, feature)
	if type(TRF_StrictOk) ~= "function" then return 1; end;
	return TRF_HlP(TRF_StrictOk, {idx, feature});
end;

-- Why the hail on focus is held back, or nil: "flag" (__disableAction, TRF_Supp level 1 or 2), "quiet"
-- (TRF_QuietHail: a scene is visible; also __sys_SOS with cfg hail_quiet 1), "combat" (TRF_Combat). A missing trf_safety
-- function counts as clear.
function TRF_HlSupp()
	if __disableAction == TRUE then return "flag"; end;
	if type(TRF_Supp) == "function" then
		local s = TRF_HlP(TRF_Supp, {});
		if type(s) == "number" and s ~= 0 then return "flag"; end;
	end;
	if TRF_N("TRF_QuietHail") then return "quiet"; end;
	if TRF_N("TRF_Combat") then return "combat"; end;
	return nil;
end;

function TRF_HlMs()
	if type(TRF_GnMs) == "function" then return TRF_HlP(TRF_GnMs, {}); end;
	return TRF_Ms();
end;

-- Leader ship of trader id (first live ship of its convoy).
function TRF_HlLead(id)
	if type(TRF_GnLead) == "function" then return TRF_HlP(TRF_GnLead, {id}); end;
	return nil;
end;

function TRF_HlDistOf(a, b)
	local p, q = a:GetPosition(), b:GetPosition();
	local dx, dy, dz = p.x - q.x, p.y - q.y, p.z - q.z;
	return sqrt(dx * dx + dy * dy + dz * dz);
end;

-- Distance of the mothership to the leader of trader id, or nil.
function TRF_HlDistMs(id)
	local s = TRF_HlLead(id);
	local ms = TRF_HlMs();
	if not s or not ms then return nil; end;
	local d = TRF_HlP(TRF_HlDistOf, {s, ms});
	if type(d) ~= "number" then return nil; end;
	return d;
end;

-- One line through TRF_Say; the trader's leader pilot speaks with cfg ui_out 2. hq 1: an answer to the
-- player's hail (TRF_Say hq, muted only as the hail is); contract outcomes and the board stay plain lines.
function TRF_HlSay(text, id, secs, hq)
	if type(TRF_Say) ~= "function" or type(text) ~= "string" then return nil; end;
	local p = nil;
	if id and type(TRF_UI_Leader) == "function" and TRF_UI_Opt("ui_out", 1) == 2 then p = TRF_UI_Leader(id); end;
	return TRF_Say(text, secs or 8, p, hq);
end;

function TRF_HlName(r)
	local n = nil;
	if type(r) == "table" and r.wq and type(TRF_Wq_Name) == "function" then return TRF_Wq_Name(); end;
	if type(r) == "table" and type(TRF_UI_Name) == "function" then n = TRF_UI_Name(r.nm); end;
	return n or TRF_Txt("hull1");
end;

function TRF_HlWho(r, id)
	if type(TRF_UI_Who) == "function" then return TRF_UI_Who(r, id); end;
	return TRF_HlName(r);
end;

function TRF_HlBoxCall(title, text, ok, cancel)
	if cancel then ShowMsgBox(title, text, ok, cancel); else ShowMsgBox(title, text, ok); end;
	return 1;
end;

-- ShowMsgBox protected; 1 when it was called without an error. tune hail_box 0 or no native -> nil.
-- CHECK (O1, E0.6): plain text in the text argument (precedent: CombineStr results); line breaks through TRF_Br() ("\n" draws the font atlas, D-UI.1).
function TRF_HlBox(title, text, ok, cancel)
	if TRF_HlT("hail_box") == 0 or type(ShowMsgBox) ~= "function" then return nil; end;
	-- Message box lock (trf_plumb, 00 section 6): one mod box at a time.
	if type(TRF_BoxTake) == "function" and not TRF_BoxTake("hail") then TRF_HlStat("hl_boxlock"); return nil; end;
	if TRF_HlP(TRF_HlBoxCall, {title, text, ok, cancel}) == 1 then return 1; end;
	TRF_HlStat("hl_boxfail");
	return nil;
end;

-- Hail request and menu (6.1) ------------------------------------------------------

-- Focus trigger on the leader (re-armed after each firing while hails are left, at most hail_rearm).
-- CHECK (O2, E0.5): _EVENT_ONFOCUS fires on NPC ships; stat hl_focus counts it. Fallback cfg hail_start 2.
function TRF_HailArm(id)
	local r = TRF_HlRec(id);
	if not r or type(NewTrigger) ~= "function" or type(TRF) ~= "table" then return nil; end;
	if (r.hn or 0) >= TRF_HlT("hail_max") then return nil; end;
	r.hr = (r.hr or 0) + 1;
	if r.hr > TRF_HlT("hail_rearm") then return nil; end;
	local lead = TRF_HlLead(id);
	if not lead then return nil; end;
	TRF_HlP(NewTrigger, {"focus", nil, "TRF_OnHail("..id..","..TRF.gen..")--", lead});
	return 1;
end;

-- Trigger entry point: runs TRF_OnHail_Body protected.
function TRF_OnHail(id, g) TRF_Cb("TRF_OnHail", TRF_OnHail_Body, {id, g}); end;

function TRF_OnHail_Body(id, g)
	if type(TRF) ~= "table" or g ~= TRF.gen then return; end;
	local r = TRF_HlRec(id);
	if not r then return; end;
	TRF_HlStat("hl_focus");
	local gt = TRF_HlGt();
	if type(r.ha) ~= "number" or gt > r.ha then
		TRF_HlE("focus", "trader_id", id, "hail_armed_at", r.ha, "result", "not_armed");
		return;
	end;
	local d = TRF_HlDistMs(id);
	if not d or d > TRF_HlT("hail_r") then
		TRF_HlE("focus", "trader_id", id, "distance", TRF_F(d), "result", "too_far");
	else
		TRF_HailOpen(id, "focus");
	end;
	TRF_HailArm(id);
end;

-- A raid record on this trader that has not ended.
function TRF_HlRaided(r)
	if type(r.rdn) ~= "number" then return nil; end;
	local L = TRF_HlLive();
	if L and type(L.rd) == "table" and type(L.rd[r.rdn]) == "table" and L.rd[r.rdn].st ~= "end" then return 1; end;
	return nil;
end;

-- Combat hail (design/hail-spec.md 3) ----------------------------------------------------------------------

-- 1 when team name t fights FTU traders: the Pirates team (haunt, raid and vanilla pirate groups) or a team at war
-- with Trade.
function TRF_HlFoe(t)
	if type(t) ~= "string" or t == "" or t == "Trade" then return nil; end;
	if t == "Pirates" or t == "Pirate" then return 1; end;
	if type(GetTeamRelation) ~= "function" or RELATION_WAR == nil then return nil; end;
	local v = TRF_HlP(GetTeamRelation, {t, "Trade"});
	if v ~= nil and v == RELATION_WAR then return 1; end;
	return nil;
end;

function TRF_HlPosOf(s)
	local p = s:GetPosition();
	return {x=p.x, y=p.y, z=p.z};
end;

-- Distance of two records or positions with x, y, z; 1e9 without a position.
function TRF_HlD3(a, b)
	if type(a.x) ~= "number" or type(a.y) ~= "number" or type(a.z) ~= "number" or type(b.x) ~= "number"
		or type(b.y) ~= "number" or type(b.z) ~= "number" then return 1e9; end;
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z;
	return sqrt(dx * dx + dy * dy + dz * dz);
end;

-- Ships near the lead of trader id through trf_plumb's TRF_Near (cls 3..7, alive, within 2 x hail_fight_r): the
-- hostile records (TRF_HlFoe team) within hail_fight_r of the lead and the player-team records. nil, nil, why
-- without a lead ("lead") or a typed list ("count": no DLL list, no trf_plumb).
function TRF_HlNearShips(id)
	local lead = TRF_HlLead(id);
	if not lead then return nil, nil, "lead"; end;
	local p = TRF_HlP(TRF_HlPosOf, {lead});
	if type(p) ~= "table" then return nil, nil, "lead"; end;
	local R = TRF_HlT("hail_fight_r");
	local l = nil;
	if type(TRF_Near) == "function" then l = TRF_HlP(TRF_Near, {p, 2 * R, {cls={3, 4, 5, 6, 7}, alive=1}}); end;
	if type(l) ~= "table" then return nil, nil, "count"; end;
	local fo, pl = {}, {};
	for i = 1, getn(l) do
		local c = l[i];
		if c.pl == 1 then tinsert(pl, c);
		elseif TRF_HlFoe(c.team) and TRF_HlD3(c, p) <= R then tinsert(fo, c); end;
	end;
	return fo, pl;
end;

-- Handle record of trader id (trf_state handle table), or nil.
function TRF_HlHnd(id)
	if type(TRF_H) ~= "function" then return nil; end;
	local H = TRF_H();
	if type(H) == "table" and type(H.tr) == "table" and type(H.tr[id]) == "table" then return H.tr[id]; end;
	return nil;
end;

-- 1 when the escort flight of handle record h fights (h.ef alive, the Escort order taken by a fight: h.eo not 1).
function TRF_HlEscFight(h)
	if type(h) ~= "table" or not h.ef or h.eo == 1 then return nil; end;
	if TRF_N("TRF_GnAlive", h.ef) then return 1; end;
	return nil;
end;

-- Fight of trader id (record r), or nil when it is in none (also cfg hail_fight 0, and Trade at war with the player:
-- the refusal stays). {n = raid id (a record past armed, not ended), nh = hostiles near (nil without a typed list),
-- ne = live escorts, eo = 1 the escort flight fights, st, sr = trader and raid side (raid, TRF_Rd_HailRatio), lose =
-- 1 when the fight goes against the trader, why = "comply", "flee", "ratio" (st / sr below hail_help_ratio) or
-- "outnumbered" (no raid record: more hostiles than escorts)}. A flight ordered by the raid decision itself (r.fl
-- "raid" after a refuse, "staged") is no loss: the ratio decides.
function TRF_HlFight(id, r)
	if TRF_HlOpt("hail_fight") ~= 1 or TRF_HlTradeWar() then return nil; end;
	local f = {};
	local L = TRF_HlLive();
	local rd = nil;
	if type(r.rdn) == "number" and L and type(L.rd) == "table" then rd = L.rd[r.rdn]; end;
	-- An armed raid has not spawned: no fight yet (the hail stays skipped with reason raid).
	if type(rd) == "table" and rd.st ~= "end" and rd.st ~= "armed" then f.n = r.rdn; end;
	local fo = TRF_HlNearShips(id);
	if type(fo) == "table" then f.nh = getn(fo); end;
	local h = TRF_HlHnd(id);
	f.ne = TRF_N("TRF_Rd_EscAlive", r, h);
	if type(f.ne) ~= "number" then f.ne = max(0, (r.np or 0) - (r.nt or 0)); end;
	f.eo = TRF_HlEscFight(h);
	if not f.n and (f.nh or 0) == 0 and not f.eo then return nil; end;
	if f.n then
		if rd.dc == "comply" then f.why = "comply";
		elseif (r.st == "flee" or r.fl) and r.fl ~= "raid" and r.fl ~= "staged" then f.why = "flee";
		else
			local st, sr = TRF_N("TRF_Rd_HailRatio", f.n);
			if type(st) == "number" and type(sr) == "number" then
				f.st = st;
				f.sr = sr;
				if sr > 0 and st / sr < TRF_HlT("hail_help_ratio") then f.why = "ratio"; end;
			end;
		end;
	elseif type(f.nh) == "number" and f.nh > f.ne then
		f.why = "outnumbered";
	end;
	if f.why then f.lose = 1; end;
	return f;
end;

-- Help pay: floor(help_k x N_eff) of the current system (TRF_HlPayN), capped by pay_cap.
function TRF_HlHelpPay()
	return floor(min(TRF_HlT("help_k") * TRF_HlPayN(TRF_HlCur()), TRF_HlT("pay_cap")));
end;

-- Pay of the help offer for trader record r in fight f, or nil, reason: offered before in this visit ("once"), heat
-- 3 and up ("heat"), the player's freighter, a station event ship or the Kestrel of trf_wq ("own": the 8.5 raid help
-- pays them), the strict gate ("strict"), the shared
-- combat prize gap open ("gap", only without a raid record: a raid pays through trf_raid's raid help), no pay
-- ("pay").
function TRF_HlHelpWhy(r, f)
	if r.hlp then return nil, "once"; end;
	if TRF_HlHeat() >= 3 then return nil, "heat"; end;
	if r.fw or r.sev or r.wq then return nil, "own"; end;
	local idx = TRF_HlCur();
	if type(idx) == "number" and not TRF_HlStrict(idx, "contract") then return nil, "strict"; end;
	if not f.n then
		local w = TRF_N("TRF_PrizeWait");
		if type(w) == "number" and w > 0 then return nil, "gap"; end;
	end;
	local p = TRF_HlHelpPay();
	if p <= 0 then return nil, "pay"; end;
	return p;
end;

-- The combat hail of trader id in fight f (TRF_HlFight): the help offer when the fight goes against it and
-- TRF_HlHelpWhy allows it, else the busy answer; one page of a chain of its own (no menu), the boxes as fallback, a
-- line with hail_box 0. Returns "fight".
function TRF_HlFightOpen(id, r, f, via)
	local L = TRF_HlLive();
	local p, no = nil, nil;
	local box = TRF_HlT("hail_box") ~= 0 and type(ShowMsgBox) == "function";
	if f.lose and not box then no = "no_box"; elseif f.lose then p, no = TRF_HlHelpWhy(r, f); end;
	local ans = "busy";
	if p then ans = "help"; end;
	TRF_HlStat("hl_fight_"..ans);
	TRF_HlE("fight", "trader_id", id, "via", via, "raid_id", f.n, "hostile_count", f.nh, "escort_count", f.ne,
		"escort_fight", TRF_KvB(f.eo), "trader_strength", TRF_F(f.st), "raid_strength", TRF_F(f.sr), "losing", TRF_KvB(f.lose),
		"lose_reason", f.why, "answer", ans, "reason", no);
	local nm = TRF_HlName(r);
	if not box then
		TRF_HlSay(TRF_Txt("hlpbusy", nm), id, nil, 1);
		return "fight";
	end;
	L.hl = {id=id, g=TRF.gen, o={}, k=1, t=TRF_HlGt()};
	if p then
		L.hl.hp = p;
		L.hl.hrd = f.n;
		local how = TRF_HlOffer(TRF_Txt("hlpoffer", nm, format("%d", p)), "hacc", "hdec", "help", "hp", TRF_HlHpOk, TRF_HlHpNo, nil);
		-- No page and no box (the chain is closed): no offer made, the busy line.
		if how then
			r.hlp = 1;
			TRF_HlE("help", "trader_id", id, "raid_id", f.n, "pay", p, "via", how, "result", "offered");
		else
			TRF_HlE("help", "trader_id", id, "raid_id", f.n, "pay", p, "result", "not_shown", "reason", "no_box");
			TRF_HlSay(TRF_Txt("hlpbusy", nm), id, nil, 1);
		end;
	else
		TRF_HlAnswer(TRF_Txt("hlpbusy", nm), "busy");
	end;
	return "fight";
end;

-- Handle-table store of the help watches: trader id -> {p = pay, t0 = gt of the accept, s = uid -> 1 seen, 2 seen
-- with a player ship within hail_fight_r, k = counted kills, e = 1 once a hostile was marked 2}; nil without trf_state.
function TRF_HlHw()
	if type(TRF_H) ~= "function" then return nil; end;
	local h = TRF_H();
	if type(h) ~= "table" then return nil; end;
	if type(h.hlw) ~= "table" then h.hlw = {}; end;
	return h.hlw;
end;

-- Marks the hostiles fo of watch w as seen (2: a player ship of pl within hail_fight_r of it; w.e = 1, engaged).
function TRF_HlHelpMark(w, fo, pl)
	local R = TRF_HlT("hail_fight_r");
	for i = 1, getn(fo) do
		local c = fo[i];
		if c.id ~= nil then
			local v = 1;
			for j = 1, getn(pl) do if TRF_HlD3(c, pl[j]) <= R then v = 2; end; end;
			w.s[c.id] = max(w.s[c.id] or 0, v);
			if v == 2 then w.e = 1; end;
		end;
	end;
end;

-- Due step after Accept of the help offer: the chain closes, r.hlp = 2. A raid pays through trf_raid (TRF_Rd_Pay,
-- settled by TRF_HlHelpEnd); any other fight through the watch TRF_HlHelpStep.
function TRF_HlHelpAcc()
	local L = TRF_HlLive();
	local hl = L.hl;
	local id, p, n = hl.id, hl.hp, hl.hrd;
	TRF_HlClose("help accept");
	local r = TRF_HlRec(id);
	if not r or type(p) ~= "number" then return; end;
	r.hlp = 2;
	local via = "raid";
	if n and (type(L.rd) ~= "table" or type(L.rd[n]) ~= "table" or L.rd[n].st == "end") then n = nil; end;
	if not n then
		via = "watch";
		local W = TRF_HlHw();
		if W then
			W[id] = {p=p, t0=TRF_HlGt(), s={}, k=0};
			local fo, pl = TRF_HlNearShips(id);
			if type(fo) == "table" then TRF_HlHelpMark(W[id], fo, pl); end;
		end;
	end;
	TRF_HlSay(TRF_Txt("hlpok", TRF_HlName(r)), id, nil, 1);
	TRF_HlStat("hl_help_acc");
	TRF_HlE("help", "trader_id", id, "raid_id", n, "pay", p, "via", via, "result", "accepted");
	if via == "watch" and (not TRF_HlHw() or not TRF_Due(TRF_HlK().hstep, "TRF_HlHelpStep", id)) then
		TRF_HlHelpSettle(id, nil, "due");
	end;
end;

-- Due step after Decline: the answer "Then stay out of the line of fire." (page or box).
function TRF_HlHelpDec()
	local hl = TRF_HlLive().hl;
	TRF_HlStat("hl_help_dec");
	TRF_HlE("help", "trader_id", hl.id, "raid_id", hl.hrd, "pay", hl.hp, "result", "declined");
	TRF_HlAnswer(TRF_Txt("hlpno", TRF_HlName(TRF_HlRec(hl.id))), "decline");
end;

-- Due step of the help watch of trader id, every hstep s: a hostile counts as killed with the player's fire when it
-- was seen with a player ship within hail_fight_r and is later gone from the location's live records (no killer
-- identity: hail-spec DV5; kept as a diagnostic, D16). The fight ends when no hostile is within hail_fight_r of the
-- lead, or when the trader docked, exited or escaped alive: TRF_HlHelpDone. A killed trader: unpaid lost; hmax s, no
-- typed list, any other removal: settled unpaid.
function TRF_HlHelpStep(id)
	local W = TRF_HlHw();
	local w = nil;
	if W and type(id) == "number" then w = W[id]; end;
	if type(w) ~= "table" then return; end;
	local r = TRF_HlRecAny(id);
	if not r or r.st == "gone" or r.hlp ~= 2 then
		-- The gone record keeps why (TRF_Remove, trf_events TRF_Ev_Close): alive at dock, exit, escape; dead at kill, lost.
		local y = nil;
		if r and r.st == "gone" then y = r.why; end;
		if y == "dock" or y == "exit" or y == "escaped" then TRF_HlHelpDone(id, w, "left");
		elseif y == "kill" or y == "lost" then TRF_HlHelpSettle(id, nil, "lost");
		else TRF_HlHelpSettle(id, nil, "gone"); end;
		return;
	end;
	if TRF_HlGt() - (w.t0 or 0) > TRF_HlK().hmax then TRF_HlHelpSettle(id, nil, "time"); return; end;
	local fo, pl, why = TRF_HlNearShips(id);
	if type(fo) ~= "table" then TRF_HlHelpSettle(id, nil, why); return; end;
	local now = {};
	for i = 1, getn(fo) do if fo[i].id ~= nil then now[fo[i].id] = 1; end; end;
	TRF_HlHelpMark(w, fo, pl);
	local gone = nil;
	for u, v in w.s do if not now[u] then gone = 1; end; end;
	if gone then
		local all = TRF_HlP(TRF_Near, {nil, nil, {alive=1}});
		if type(all) == "table" then
			local live, drop = {}, {};
			for i = 1, getn(all) do if all[i].id ~= nil then live[all[i].id] = 1; end; end;
			for u, v in w.s do
				if not now[u] and not live[u] then
					if v == 2 then w.k = w.k + 1; end;
					tinsert(drop, u);
				end;
			end;
			for i = 1, getn(drop) do w.s[drop[i]] = nil; end;
		end;
	end;
	if getn(fo) == 0 then TRF_HlHelpDone(id, w, "end"); return; end;
	if not TRF_Due(TRF_HlK().hstep, "TRF_HlHelpStep", id) then TRF_HlHelpSettle(id, nil, "due"); end;
end;

-- The fight of watch w on trader id ended alive (how end: no hostile near the lead; left: docked, exited, escaped;
-- logged as reason): paid when the player engaged (help_engage 1, w.e) or, with help_engage 0, scored a counted
-- kill (w.k); else unpaid far (never engaged) or no_fire (help_engage 0, no kill).
function TRF_HlHelpDone(id, w, how)
	if TRF_HlEngage() == 1 then
		if w.e == 1 then return TRF_HlHelpSettle(id, 1, how); end;
		return TRF_HlHelpSettle(id, nil, "far");
	end;
	if (w.k or 0) > 0 then return TRF_HlHelpSettle(id, 1, how); end;
	return TRF_HlHelpSettle(id, nil, "no_fire");
end;

-- Ends the help watch of trader id (r.hlp 3): paid (pay 1) through TRF_Pay with the raid-help effects of v02 5.5
-- (help +1, +2 in Recovery, heat -1, credits +4, r.res, the paid line, the combat prize gap marked), else unpaid.
function TRF_HlHelpSettle(id, pay, why)
	local W = TRF_HlHw();
	local w = nil;
	if W then w = W[id]; W[id] = nil; end;
	-- A gone record too: a trader that docked, exited or escaped during the watch is paid by name.
	local r = TRF_HlRecAny(id);
	if r and r.hlp == 2 then r.hlp = 3; end;
	local p, k, e = nil, nil, nil;
	if type(w) == "table" then p = w.p; k = w.k; e = TRF_KvB(w.e); end;
	if not pay or not r or type(p) ~= "number" then
		TRF_HlE("help", "trader_id", id, "pay", p, "kill_count", k, "engaged", e, "via", "watch", "result", "unpaid", "reason", why);
		-- The line: far, no_fire, time and lost come from TRF_HlHelpStep only (watch and trader record present); the rest
		-- (gone, due, jump, load, count, lead) say nothing.
		local lk = nil;
		if why == "far" then lk = "hlpfar"; elseif why == "no_fire" then lk = "hlpnofire";
		elseif why == "time" then lk = "hlptime"; elseif why == "lost" then lk = "hlplost"; end;
		if lk then TRF_HlSay(TRF_Txt(lk, TRF_HlName(r)), id); end;
		return nil;
	end;
	local n = 0;
	if type(TRF_Pay) == "function" then
		n = TRF_HlP(TRF_Pay, {p, "hail_help"}) or 0;
	elseif type(AddPlayerCredits) == "function" then
		n = floor(p);
		TRF_N("AddPlayerCredits", n);
	end;
	if n > 0 then TRF_N("TRF_PrizeMark", "hail"); end;
	-- Paid mark (also on a gone record, TRF_GoneKeep): a raid of this trader that ends later pays no second time. The
	-- open raid record gets it too (rd.hp), since TRF_LivePrune can drop the gone record before the raid ends.
	r.hpd = 1;
	TRF_N("TRF_Rd_HailPaid", id);
	local d = 1;
	if TRF_HlRecovery() then d = 2; end;
	if type(TRF_AddHelp) == "function" then TRF_HlP(TRF_AddHelp, {d, "hail help"}); end;
	if type(TRF_AddHeat) == "function" then TRF_HlP(TRF_AddHeat, {-1, "hail help"}); end;
	TRF_N("TRF_ProCredit", 4, "hail help");
	TRF_N("TRF_Ch_Note", 2, TRF_HlCur(), n);
	if r.st ~= "gone" then r.res = 1; end;
	TRF_HlSay(TRF_Txt("hlppaid", TRF_HlName(r), format("%d", n)), id);
	TRF_HlStat("hl_help_paid");
	TRF_HlE("help", "trader_id", id, "pay", p, "credits", n, "kill_count", k, "engaged", e, "help", d, "via", "watch", "result", "paid", "reason", why);
	return 1;
end;

-- Raid n on trader id ended (trf_raid TRF_Rd_End, after its raid-help pay): an accepted help offer (r.hlp 2) is
-- settled; paid = the credits of TRF_Rd_Pay (nil: not paid), how = the raid end. 1 when settled. An offer owned by
-- the help watch (accepted without a spawned raid) stays with the watch unless the raid paid it.
function TRF_HlHelpEnd(id, n, paid, how)
	-- A gone record too (docked, exited or escaped before the raid end: hlp stripped): its watch ends here when
	-- the raid paid, or TRF_HlHelpStep would pay it again (left).
	local r = TRF_HlRecAny(id);
	local W = TRF_HlHw();
	local w = nil;
	if W and type(id) == "number" and type(W[id]) == "table" then w = W[id]; end;
	if not r or (r.hlp ~= 2 and not w) then return nil; end;
	if w then
		-- A watch owns the offer (accepted while the raid was armed): it stays with the watch unless the raid paid
		-- (TRF_Rd_Pay counts the player's fire while r.hlp is 2); then the watch ends here, or it would pay again.
		if type(paid) ~= "number" then return nil; end;
		W[id] = nil;
	end;
	if r.hlp == 2 then r.hlp = 3; end;
	if type(paid) == "number" then
		TRF_HlStat("hl_help_paid");
		TRF_HlE("help", "trader_id", id, "raid_id", n, "credits", paid, "via", "raid", "result", "paid");
	else
		TRF_HlE("help", "trader_id", id, "raid_id", n, "via", "raid", "result", "unpaid", "reason", how);
	end;
	return 1;
end;

-- 1 when the help watch of trader id already paid (r.hpd, also on a gone record): trf_raid's TRF_Rd_Pay skips the
-- raid-help pay of a raid on it that ends later.
function TRF_HlHelpPaid(id)
	local r = TRF_HlRecAny(id);
	if r and r.hpd == 1 then return 1; end;
	return nil;
end;

function TRF_HlTradeWar()
	if type(GetTeamRelation) ~= "function" or RELATION_WAR == nil then return nil; end;
	local v = TRF_HlP(GetTeamRelation, {"Trade", PLAYER_TEAM});
	if v ~= nil and v == RELATION_WAR then return 1; end;
	return nil;
end;

-- Vanilla paid rumour available (rolled once per menu, as _FTrader_Action rolls __sys_FTrader_3).
function TRF_HlNewsOk()
	if type(_Trader_Speak) ~= "function" or type(__sys_FTrader_3) ~= "number" or type(RAND) ~= "function" then return nil; end;
	if __sys_FTrader_3 > RAND(100) then return 1; end;
	return nil;
end;

-- v1 option items (see the header) -------------------------------------------------

-- Handle-table store of the open menu: {id, x = {key = item}, of = offer list, oh = trader id of a hail
-- item offer, bof = board offers}. nil without trf_state (no v1 items then).
function TRF_HlStore()
	if type(TRF_H) ~= "function" then return nil; end;
	local h = TRF_H();
	if type(h) ~= "table" then return nil; end;
	if type(h.hlx) ~= "table" then h.hlx = {x={}}; end;
	return h.hlx;
end;

function TRF_HlUsed(r, k)
	if type(r.hx) == "string" and strfind(r.hx, ","..k..",", 1, 1) then return 1; end;
	return nil;
end;

function TRF_HlUse(r, k)
	if not TRF_HlUsed(r, k) then r.hx = (r.hx or ",")..k..","; end;
end;

-- f is a global function name or a function; protected call, nil when missing or on error.
function TRF_HlCall(f, args)
	if type(f) == "string" then f = getglobal(f); end;
	if type(f) ~= "function" then return nil; end;
	return call(f, args, "x", TRF_HlErr);
end;

-- Provider item as a table with an action, or nil (see the header). dn = the provider's HailDo name.
-- A key of a built-in option gets a "v" prefix; ko keeps the provider's key.
function TRF_HlItem(it, dn, id)
	if type(it) == "string" then it = {k=it}; end;
	if type(it) ~= "table" or type(it.k) ~= "string" or it.k == "" then return nil; end;
	it.ko = it.k;
	local res = {trade=1, head=1, news=1, esc=1, trouble=1, boom=1, sweep=1};
	if res[it.k] then it.k = "v"..it.k; end;
	if it.s == nil and it.q == nil and it.f == nil then
		if type(getglobal(dn)) == "function" then
			it.d = dn;
		elseif it.ko == "feq" and type(TRF_FeqOffer) == "function" then
			local q = TRF_HlP(TRF_FeqOffer, {id});
			if type(q) ~= "string" then return nil; end;
			it.q = q;
			it.ok = "TRF_FeqAccept";
		elseif it.ko == "demand" then
			it.f = "TRF_DemandDo";
		else
			return nil;
		end;
	end;
	return it;
end;

-- Items of the v1 providers for trader id: key list, key -> item, only (1 when an item has x = 1).
function TRF_HlV1Opts(id, r)
	local keys, x, only = {}, {}, nil;
	local ps = {"TRF_Supply_HailOpts", "TRF_Feq_HailOpts", "TRF_Dc_HailOpts"};
	local ds = {"TRF_Supply_HailDo", "TRF_Feq_HailDo", "TRF_Dc_HailDo"};
	local l0 = {};
	if type(TRF_FeqId) == "function" then
		local t = TRF_HlP(TRF_FeqId, {id});
		if type(t) == "string" then l0 = {{k="feqinfo", s=t}}; only = 1; end;
	end;
	-- The player's freighter (trf_freight, r.fw): its status line only (no 8.3 trade, 8.4 contract, 8.6 demand or
	-- paid rumour, 08 exploit rule 4).
	if r.fw and type(TRF_Fr_HailId) == "function" then
		local t = TRF_HlP(TRF_Fr_HailId, {id});
		if type(t) == "string" then l0 = {{k="fwinfo", s=t}}; only = 1; end;
	end;
	for i = 0, getn(ps) do
		local l = l0;
		if i > 0 then
			l = nil;
			local f = getglobal(ps[i]);
			if type(f) == "function" then l = TRF_HlP(f, {id, r}); end;
		end;
		if type(l) == "table" then
			for j = 1, getn(l) do
				local it = TRF_HlItem(l[j], ds[i] or "", id);
				if it and not x[it.k] and not TRF_HlUsed(r, it.k) then
					x[it.k] = it;
					tinsert(keys, it.k);
					if it.x == 1 then only = 1; end;
				end;
			end;
		end;
	end;
	return keys, x, only;
end;

-- Item of key in the open menu of trader id, or nil.
function TRF_HlGetItem(id, key)
	local st = TRF_HlStore();
	if st and st.id == id and type(st.x) == "table" then return st.x[key]; end;
	return nil;
end;

-- Faction offers for the hail (cfg board 2, v1-spec 7.4): FTU traders only; nil when there are none.
function TRF_HlSweepOffers(r)
	if TRF_HlOpt("board") ~= 2 or type(TRF_Faction_BoardOffers) ~= "function" then return nil; end;
	if type(r) ~= "table" or type(r.own) == "number" then return nil; end;
	local l = TRF_HlP(TRF_Faction_BoardOffers, {});
	if type(l) ~= "table" or getn(l) == 0 then return nil; end;
	return l;
end;

-- Valid options in menu order; each once per trader. v1 provider items follow the escort option, then the
-- sweep offers (board 2); an item with x = 1 leaves only the provider items.
function TRF_HailOpts(id, r)
	local o = {};
	local keys, x, only = TRF_HlV1Opts(id, r);
	if not only then
		if not r.trd then tinsert(o, "trade"); end;
		if not r.hd then tinsert(o, "head"); end;
		if not r.nw and TRF_HlNewsOk() then tinsert(o, "news"); end;
		if not r.ct and TRF_CtOffer(id) then tinsert(o, "esc"); end;
	end;
	for i = 1, getn(keys) do tinsert(o, keys[i]); end;
	if not only then
		if not TRF_HlUsed(r, "sweep") and TRF_HlSweepOffers(r) then tinsert(o, "sweep"); end;
		if not r.tu then tinsert(o, "trouble"); end;
		if not r.bm then tinsert(o, "boom"); end;
	end;
	local st = TRF_HlStore();
	if st then st.id = id; st.x = x; st.of = nil; st.oh = nil; end;
	return o;
end;

-- Menu label of key.
function TRF_HlLabel(id, key)
	local it = TRF_HlGetItem(id, key);
	if it then
		if type(it.t) == "string" then return it.t; end;
		if it.q ~= nil then return TRF_Txt("optesc"); end;
		return TRF_Txt("opt"..it.k);
	end;
	return TRF_Txt("opt"..tostring(key));
end;

-- Open the hail for trader id (focus request, or the announce with cfg hail_start 2). Returns "menu",
-- "refuse", "line" or nil, reason.
function TRF_HailOpen(id, via)
	local L = TRF_HlLive();
	local r = TRF_HlRec(id);
	if not L or not r then return nil, "norec"; end;
	local gt = TRF_HlGt();
	local why = nil;
	local sq = TRF_HlSupp();
	local fg = nil;
	if (r.hn or 0) >= TRF_HlT("hail_max") then why = "max";
	elseif gt - (r.hlt or -1000) < TRF_HlT("hail_cd") then why = "cd";
	elseif type(L.hl) == "table" and gt - (L.hl.t or 0) < TRF_HlT("hail_stale") then why = "busy";
	elseif sq and sq ~= "combat" then why = sq;
	else
		-- Combat hail (hail-spec 3): a trader in a fight answers with one page, also while TRF_Combat holds (the
		-- player's combat is mostly that fight).
		if r.st ~= "wind" and r.st ~= "gone" then fg = TRF_HlFight(id, r); end;
		if not fg then
			if sq then why = sq;
			elseif TRF_HlRaided(r) then why = "raid";
			elseif r.st == "wind" or r.st == "gone" then why = "st"; end;
		end;
	end;
	if why then
		TRF_HlE("hail", "trader_id", id, "via", via, "result", "skipped", "reason", why);
		TRF_HlStat("hl_skip_"..why);
		return nil, why;
	end;
	L.hl = nil;
	r.hn = (r.hn or 0) + 1;
	r.hlt = gt;
	-- v1-spec 4.2: a hail tracks the trader.
	TRF_P("TRF_TrackMark", id, "hail");
	if fg then return TRF_HlFightOpen(id, r, fg, via); end;
	local heat = TRF_HlHeat();
	local war = TRF_HlTradeWar();
	-- Charter rank 2 perk (design/charter-spec.md 5.8): at heat 3 an FTU trader still offers its escort contracts.
	local c3 = nil;
	if heat == 3 and not war then c3 = TRF_HlCh3Opts(id, r); end;
	if (heat >= 3 and not c3) or war then
		if heat >= 5 and heat <= 6 and not r.hds and type(TRF_Distress) == "function" then
			r.hds = 1;
			TRF_HlP(TRF_Distress, {id, "heat"});
		end;
		TRF_HlStat("hl_refuse");
		-- v1-spec 5.2: at heat 3-6 the refusal is a box that offers demand cargo only.
		if heat <= 6 and not war and TRF_HlT("hail_box") ~= 0 and type(ShowMsgBox) == "function" then
			local keys, x = TRF_HlV1Opts(id, r);
			local st = TRF_HlStore();
			if x.demand and st then
				st.id = id; st.x = {demand=x.demand}; st.of = nil; st.oh = nil;
				L.hl = {id=id, g=TRF.gen, o={"demand"}, k=1, t=gt, rf=1};
				TRF_HailShow();
				local how = "box";
				if type(L.hl) == "table" and L.hl.w == "dlg" then how = "dialog"; end;
				TRF_HlE("hail", "trader_id", id, "heat", heat, "demand_via", how, "result", "refused");
				return "refuse";
			end;
		end;
		TRF_HlSay(TRF_Txt("refuse", TRF_HlName(r)), id, nil, 1);
		TRF_HlE("hail", "trader_id", id, "heat", heat, "result", "refused");
		return "refuse";
	end;
	local o = c3 or TRF_HailOpts(id, r);
	if c3 then TRF_HlSay(TRF_Txt("chheat3"), id, nil, 1); end;
	if getn(o) == 0 then
		TRF_HlE("hail", "trader_id", id, "answer_count", 0, "result", "no_options");
		return nil, "none";
	end;
	if TRF_HlT("hail_box") == 0 or type(ShowMsgBox) ~= "function" then
		r.hd = 1;
		TRF_HlSay(TRF_Headed(id), id, nil, 1);
		TRF_HlE("hail", "trader_id", id, "result", "line", "reason", "no_box");
		return "line";
	end;
	L.hl = {id=id, g=TRF.gen, o=o, k=1, t=gt};
	TRF_HlStat("hl_menu");
	TRF_HailShow();
	local dl = 0;
	if type(L.hl) == "table" and L.hl.w == "dlg" then dl = 1; end;
	TRF_HlE("hail", "trader_id", id, "via", via, "answer_count", getn(o), "hail_count", r.hn, "dialog", TRF_KvB(dl));
	return "menu";
end;

-- Charter rank 2 perk (design/charter-spec.md 5.8): at heat 3 an FTU trader (not a faction-owned one) offers only its
-- escort contracts (8.4 "esc", the danger convoy "dc"). The options, or nil without the perk or without a contract.
function TRF_HlCh3Opts(id, r)
	if r.own or not TRF_N("TRF_Ch_Heat3") then return nil; end;
	local o = {};
	local all = TRF_HailOpts(id, r);
	for i = 1, getn(all) do
		if all[i] == "esc" or all[i] == "dc" then tinsert(o, all[i]); end;
	end;
	if getn(o) == 0 then return nil; end;
	return o;
end;

-- Open chain of this gen whose trader is still there.
function TRF_HlValid(hl)
	if type(hl) ~= "table" or type(TRF) ~= "table" or hl.g ~= TRF.gen then return nil; end;
	if not TRF_HlRec(hl.id) or type(hl.o) ~= "table" or type(hl.k) ~= "number" then return nil; end;
	return 1;
end;

-- Close the chain. A trader with hails left stays hailable hail_cd + hail_arm seconds from now.
function TRF_HlClose(why)
	local L = TRF_HlLive();
	if not L then return; end;
	TRF_N("TRF_BoxFree", "hail");
	local hl = L.hl;
	L.hl = nil;
	if type(hl) ~= "table" then return; end;
	local r = TRF_HlRec(hl.id);
	if r and (r.hn or 0) < TRF_HlT("hail_max") then
		r.ha = max(r.ha or 0, TRF_HlGt() + TRF_HlT("hail_cd") + TRF_HlT("hail_arm"));
	end;
	TRF_HlE("close", "trader_id", hl.id, "reason", why);
end;

-- Box k of the menu: "<who>: <option>?" OK = this option, Cancel = next option.
function TRF_HailShow()
	local L = TRF_HlLive();
	if not L or not TRF_HlValid(L.hl) then TRF_HlClose("stale"); return; end;
	local hl = L.hl;
	local r = TRF_HlRec(hl.id);
	local key = hl.o[hl.k];
	hl.w = "menu";
	hl.t = TRF_HlGt();
	-- hail_box 2: the whole menu as one dialog, tried once per chain; after a fallback the boxes follow (hl.bx).
	if hl.k == 1 and not hl.dt and TRF_HlT("hail_box") == 2 then
		hl.dt = 1;
		if TRF_HlDlgOpen(hl, r) then return; end;
		hl.bx = 1;
	end;
	local text = TRF_Txt("hailq", TRF_HlWho(r, hl.id), TRF_HlLabel(hl.id, key));
	if hl.rf == 1 then text = TRF_Txt("refuse", TRF_HlName(r))..TRF_Br()..text; end;
	if not TRF_HlBox("#UI_FTrader_confirm", text, TRF_HailOk, TRF_HailNext) then
		local id, rf = hl.id, hl.rf;
		TRF_HlClose("nobox");
		if rf == 1 then
			TRF_HlSay(TRF_Txt("refuse", TRF_HlName(r)), id, nil, 1);
		else
			r.hd = 1;
			TRF_HlSay(TRF_Headed(id), id, nil, 1);
		end;
	end;
end;

-- Answer of the open chain (kind "answer"; "busy" and "decline" of the combat hail): in page mode (TRF_HlPgMode) the
-- page with Close and, while the menu has another option, Back; else the one-button box (OK closes the chain);
-- without a box the text is a line.
function TRF_HlAnswer(text, kind)
	local L = TRF_HlLive();
	local hl = L.hl;
	hl.t = TRF_HlGt();
	-- A second result of the text function (TRF_Boom, TRF_Trouble) is no kind.
	if type(kind) ~= "string" then kind = "answer"; end;
	local key = hl.o[hl.k];
	if TRF_HlPgMode(hl) then
		local on = {close=1};
		if getn(hl.o) > 1 then on.back = 1; end;
		if TRF_HlPgShow(hl, kind, text, on, nil, nil, key) then return; end;
	end;
	hl.w = "ans";
	if not TRF_HlBox("#UI_FTrader_confirm", text, TRF_HailClose) then
		local id = hl.id;
		TRF_HlClose("nobox");
		TRF_HlSay(text, id, nil, 1);
	elseif TRF_HlT("hail_box") == 2 then
		TRF_HlPgLog(hl, kind, "box", key, nil);
	end;
end;

-- Offer of the open chain: in page mode the page with Accept (choice ac) and Decline (choice dc), else the OK/Cancel
-- box with the callbacks okf and nof (hl.w = w). key: the menu option (log). Returns "dialog", "box" or nil (no box:
-- the chain is closed).
function TRF_HlOffer(text, ac, dc, kind, w, okf, nof, key)
	local hl = TRF_HlLive().hl;
	hl.t = TRF_HlGt();
	if TRF_HlPgMode(hl) and TRF_HlPgShow(hl, kind, text, {acc=1, dec=1}, ac, dc, key) then return "dialog"; end;
	hl.w = w;
	if TRF_HlBox("#UI_FTrader_confirm", text, okf, nof) then
		if TRF_HlT("hail_box") == 2 then TRF_HlPgLog(hl, kind, "box", key, nil); end;
		return "box";
	end;
	TRF_HlClose("nobox");
	return nil;
end;

-- Stage B (hail-spec 2) ------------------------------------------------------------------------------------

-- 1 while the follow-ups of chain hl are dialog pages: tune hail_box 2 and no box fallback on this chain (hl.bx).
function TRF_HlPgMode(hl)
	if TRF_HlT("hail_box") == 2 and hl.bx ~= 1 then return 1; end;
	return nil;
end;

-- Log line of a stage B page (kind answer, offer, help, busy, decline) and stat hl_page.
function TRF_HlPgLog(hl, kind, via, key, back)
	TRF_HlStat("hl_page");
	TRF_HlE("page", "trader_id", hl.id, "via", via, "kind", kind, "key", key, "back", TRF_KvB(back));
end;

-- Answer keys of the page dialog TRF_HailPg (msg10) in file order and the text keys of their #l<key># labels.
function TRF_HlPgKeys() return {"acc", "dec", "back", "leave", "nowit", "close"}; end;
function TRF_HlPgLabels()
	return {acc="hlpacc", dec="hlpdec", back="hlpback", leave="dmpleave", nowit="dmpnowit", close="hlpclose"};
end;

-- Due check of the dialog just opened for chain hl: hl.dn numbers the dialogs of the chain, so the check of an
-- earlier dialog (the menu before its page) ends without closing.
function TRF_HlDlgDue(hl)
	hl.dn = (hl.dn or 0) + 1;
	TRF_Due(1, "TRF_HlDlgCheck", hl.dn);
end;

-- Page of chain hl as the dialog TRF_HailPg (from a due call): kind (log), text (its "FTU <name>: " prefix cut, the
-- message is "FTU #who#: #m1#"), on = visible answers (answer key -> 1), ac, dc = the choice of Accept and Decline
-- (TRF_HailStep), key = the menu option. Record st.dlg = {id, g, on, dk = {}, pg = 1, who, m1, ac, dc, kd}; pick
-- and Esc as the menu dialog (TRF_HlDlgPick, TRF_HlDlgCheck). 1 when StartTradeDialog ran; nil after a fallback
-- (TRF_HlDlgWhy, the box lock, an error: hl.bx = 1, the caller shows a box).
function TRF_HlPgShow(hl, kind, text, on, ac, dc, key)
	local why = TRF_HlDlgWhy();
	if not why and type(TRF_BoxTake) == "function" and not TRF_BoxTake("hail") then why = "lock"; end;
	if why then TRF_HlDlgFb(why); hl.bx = 1; return nil; end;
	local st = TRF_HlStore();
	-- The prefix is cut by pattern: trf_supply names the trader with its own fallback (TRF_SpName), not TRF_HlName;
	-- loc_mode 1 texts carry "FTU: " (loc/trf_en.loc has no $n placeholders).
	local m1 = text;
	local s0, e0 = strfind(text, "^FTU[^:\n|]*: ");
	if e0 then m1 = strsub(text, e0 + 1); end;
	st.dlg = {id=hl.id, g=hl.g, on=on, dk={}, pg=1, who=TRF_HlName(TRF_HlRec(hl.id)), m1=m1, ac=ac, dc=dc, kd=kind};
	local w0 = hl.w;
	hl.w = "dlg";
	hl.t = TRF_HlGt();
	if TRF_HlP(TRF_HlPgCall, {}) ~= 1 then
		st.dlg = nil;
		hl.w = w0;
		hl.bx = 1;
		TRF_HlDlgFb("error");
		return nil;
	end;
	TRF_HlStat("hl_dlg");
	TRF_HlDlgDue(hl);
	if kind ~= "demand" then TRF_HlPgLog(hl, kind, "dialog", key, on.back); end;
	return 1;
end;

-- Offer page of a provider HailDo (trf_danger "dc", trf_supply "sesc") on the open chain in page mode: Accept runs the
-- global function accf() from the due call TRF_HailStep (the provider reads L.hl and closes the chain), Decline goes
-- back to the menu. "dialog" when the page opened, else nil: the provider shows its own box as with hail_box 1.
function TRF_HlProvPage(text, accf, key)
	local L = TRF_HlLive();
	if not L or not TRF_HlValid(L.hl) or type(text) ~= "string" or type(accf) ~= "string" then return nil; end;
	local hl = L.hl;
	if not TRF_HlPgMode(hl) then return nil; end;
	hl.xf = accf;
	if TRF_HlPgShow(hl, "offer", text, {acc=1, dec=1}, "xacc", "xdec", key or hl.o[hl.k]) then return "dialog"; end;
	hl.xf = nil;
	return nil;
end;

-- Due step of Accept on a provider page: the provider's accept function; a chain it leaves open is closed.
function TRF_HlProvAcc()
	local L = TRF_HlLive();
	local hl = L.hl;
	local f, key = hl.xf, hl.o[hl.k];
	hl.xf = nil;
	TRF_HlStat("hl_offer_acc");
	TRF_HlE("offer", "trader_id", hl.id, "key", key, "handler", f, "result", "accepted");
	TRF_HlCall(f, {});
	if L.hl == hl then TRF_HlClose("accept"); end;
end;

-- Due step of Back: the used option leaves the menu (hl.o), the menu dialog opens again with the rest (the hidden
-- answers stay hidden, CHECK D11); none left: the chain closes; a dialog that cannot open: the box chain.
function TRF_HlBack()
	local L = TRF_HlLive();
	local hl = L.hl;
	local key = hl.o[hl.k];
	if key then tremove(hl.o, hl.k); end;
	hl.k = 1;
	hl.oq = nil;
	TRF_HlStat("hl_back");
	if getn(hl.o) == 0 then
		TRF_HlE("back", "trader_id", hl.id, "key", key, "answer_count", 0, "result", "closed");
		TRF_HlClose("last");
		return;
	end;
	hl.w = "menu";
	hl.t = TRF_HlGt();
	if TRF_HlDlgOpen(hl, TRF_HlRec(hl.id)) then
		TRF_HlE("back", "trader_id", hl.id, "key", key, "answer_count", getn(hl.o), "via", "dialog", "result", "menu");
		return;
	end;
	hl.bx = 1;
	TRF_HlE("back", "trader_id", hl.id, "key", key, "answer_count", getn(hl.o), "via", "box", "result", "menu");
	TRF_HailShow();
end;

-- Hail dialog (tune hail_box 2, design/mod-research/hail-dialog.md 5 stage A) -------------------------------

-- Data/Scripts/Trade/TRF_Hail.xml has one node msg00 ("FTU #who#: #head#") with one answer a_<key> per entry
-- of TRF_HlDlgKeys (provider items in the slots p1..p5 as "- #p<i>#"). Every answer ends the dialog and calls
-- TRF_HlDlgA_<key>, which records the pick like the box OK of that option (TRF_HlDlgPick -> TRF_HailStep).
-- StartTradeDialog runs the init TRF_HlDlgInit after loading the file and before the window opens; it shows
-- the answers of the option list, hides the rest and sets the #tokens# (SetReplaceValue and HideAnswer act on
-- the loaded dialog only, so nothing can be set before StartTradeDialog). Handle store st.dlg = {id, g, on
-- (answer key -> 1), dk (slot -> option key), who, head}: one dialog at a time, cleared by the pick.

-- Answer keys of msg00 in file order.
function TRF_HlDlgKeys()
	return {"trade", "head", "news", "esc", "demand", "p1", "p2", "p3", "p4", "p5", "sweep", "trouble", "boom", "close"};
end;

-- Option keys with an answer of their own; every other key (provider items) takes the next p slot.
function TRF_HlDlgFixed() return {trade=1, head=1, news=1, esc=1, demand=1, sweep=1, trouble=1, boom=1}; end;

-- Number of p slots: TRF_HlV1Opts gives at most 5 items (feqinfo, demand, sesc, feq, dc); demand has its own
-- answer, so one slot is spare for a new provider key.
function TRF_HlDlgNp() return 5; end;

-- Answer callbacks named in TRF_Hail.xml (<lua_function>, called without arguments).
function TRF_HlDlgA_trade() TRF_HlDlgPick("trade"); end;
function TRF_HlDlgA_head() TRF_HlDlgPick("head"); end;
function TRF_HlDlgA_news() TRF_HlDlgPick("news"); end;
function TRF_HlDlgA_esc() TRF_HlDlgPick("esc"); end;
function TRF_HlDlgA_demand() TRF_HlDlgPick("demand"); end;
function TRF_HlDlgA_p1() TRF_HlDlgPick("p1"); end;
function TRF_HlDlgA_p2() TRF_HlDlgPick("p2"); end;
function TRF_HlDlgA_p3() TRF_HlDlgPick("p3"); end;
function TRF_HlDlgA_p4() TRF_HlDlgPick("p4"); end;
function TRF_HlDlgA_p5() TRF_HlDlgPick("p5"); end;
function TRF_HlDlgA_sweep() TRF_HlDlgPick("sweep"); end;
function TRF_HlDlgA_trouble() TRF_HlDlgPick("trouble"); end;
function TRF_HlDlgA_boom() TRF_HlDlgPick("boom"); end;
function TRF_HlDlgA_close() TRF_HlDlgPick("close"); end;
-- Answers of the stage B pages (TRF_HailPg; a_close there is TRF_HlDlgA_close).
function TRF_HlDlgA_back() TRF_HlDlgPick("back"); end;
function TRF_HlDlgA_acc() TRF_HlDlgPick("acc"); end;
function TRF_HlDlgA_dec() TRF_HlDlgPick("dec"); end;
-- Answers of the result page Data/Scripts/Trade/TRF_HailPg.xml (msg10).
function TRF_HlDlgA_leave() TRF_HlDlgPick("leave"); end;
function TRF_HlDlgA_nowit() TRF_HlDlgPick("nowit"); end;

-- Why the dialog cannot open now, or nil: "xml" (cfg hail_xml not 1: file not installed), "native" (no
-- StartTradeDialog), "uistate" (no TRF_UiState), "ui=<v>" (a movie, modal window or dialog is up, or -1
-- unknown: a dialog started then would be queued, hail-dialog.md 1.7), "movie", "store" (no handle table).
function TRF_HlDlgWhy()
	if TRF_HlOpt("hail_xml") ~= 1 then return "xml"; end;
	if type(StartTradeDialog) ~= "function" then return "native"; end;
	if type(TRF_UiState) ~= "function" then return "uistate"; end;
	local u = TRF_HlP(TRF_UiState, {});
	if u ~= 0 then return "ui="..tostring(u); end;
	if type(TRF_InMovie) == "function" and TRF_HlP(TRF_InMovie, {}) == 1 then return "movie"; end;
	if not TRF_HlStore() then return "store"; end;
	return nil;
end;

-- Fallback to the box chain: stat hl_dlgfb, one log line per reason and visit (handle table).
function TRF_HlDlgFb(why)
	TRF_HlStat("hl_dlgfb");
	local h = nil;
	if type(TRF_H) == "function" then h = TRF_H(); end;
	if type(h) == "table" then
		if type(h.hldf) ~= "table" then h.hldf = {}; end;
		if h.hldf[why] then return; end;
		h.hldf[why] = 1;
	end;
	TRF_HlE("dialog_fallback", "reason", why);
end;

-- Visible answers of chain hl (answer key -> 1, close always) and the p slots (slot -> option key); nil when
-- the provider items need more than TRF_HlDlgNp() slots.
function TRF_HlDlgMap(hl)
	local fx, on, dk, np = TRF_HlDlgFixed(), {close=1}, {}, 0;
	for i = 1, getn(hl.o) do
		local k = hl.o[i];
		if fx[k] then
			on[k] = 1;
		else
			np = np + 1;
			if np > TRF_HlDlgNp() then return nil; end;
			on["p"..np] = 1;
			dk["p"..np] = k;
		end;
	end;
	return on, dk;
end;

function TRF_HlDlgCall()
	StartTradeDialog("TRF_Hail", "TRF_HlDlgInit");
	return 1;
end;

-- Open the menu of chain hl (trader record r) as the dialog: 1 when StartTradeDialog ran, nil after a
-- fallback (the caller shows the box chain).
function TRF_HlDlgOpen(hl, r)
	local why = TRF_HlDlgWhy();
	local on, dk = nil, nil;
	if not why then
		on, dk = TRF_HlDlgMap(hl);
		if not on then why = "slots"; end;
	end;
	if why then TRF_HlDlgFb(why); return nil; end;
	-- Message box lock (00 section 6): owner "hail" for the whole conversation, dialogs included.
	if type(TRF_BoxTake) == "function" and not TRF_BoxTake("hail") then TRF_HlDlgFb("lock"); return nil; end;
	-- Corporation carriers (design/corp-carriers-spec.md 5.2): a contract carrier's head names its corporation.
	local head = nil;
	if hl.rf == 1 then head = TRF_Txt("dlgrefuse"); else head = TRF_N("TRF_Crp_Head", r) or TRF_Txt("dlghead"); end;
	local st = TRF_HlStore();
	st.dlg = {id=hl.id, g=hl.g, on=on, dk=dk, who=TRF_HlName(r), head=head};
	hl.w = "dlg";
	if TRF_HlP(TRF_HlDlgCall, {}) ~= 1 then
		st.dlg = nil;
		hl.w = "menu";
		TRF_HlDlgFb("error");
		return nil;
	end;
	TRF_HlStat("hl_dlg");
	TRF_HlDlgDue(hl);
	return 1;
end;

-- Dialog record of the open chain, or nil when the chain is gone, of another gen or not waiting for it.
function TRF_HlDlgCur()
	local L = TRF_HlLive();
	local st = TRF_HlStore();
	if not L or not st or type(st.dlg) ~= "table" then return nil; end;
	local hl, d = L.hl, st.dlg;
	if not TRF_HlValid(hl) or hl.w ~= "dlg" or d.id ~= hl.id or d.g ~= hl.g then return nil; end;
	return d;
end;

-- Init of StartTradeDialog (shim). A stale record leaves only the close answer.
function TRF_HlDlgInit() TRF_Cb("TRF_HlDlgInit", TRF_HlDlgInit_Body, {}); end;

function TRF_HlDlgInit_Body()
	local d = TRF_HlDlgCur();
	local on, dk, who, head, id = {close=1}, {}, TRF_Txt("hull1"), "", nil;
	if d then
		on = d.on; dk = d.dk; who = d.who; head = d.head; id = d.id;
	else
		TRF_HlE("dialog_init", "result", "stale");
	end;
	local ks = TRF_HlDlgKeys();
	local vis, lab = "", "";
	for i = 1, getn(ks) do
		if on[ks[i]] then
			TRF_N("ShowAnswer", "a_"..ks[i]);
			vis = vis..","..ks[i];
		else
			TRF_N("HideAnswer", "a_"..ks[i]);
		end;
	end;
	TRF_N("SetReplaceValue", "who", who);
	TRF_N("SetReplaceValue", "head", head);
	for i = 1, TRF_HlDlgNp() do
		local t = "";
		if id and dk["p"..i] then t = TRF_HlLabel(id, dk["p"..i]); lab = lab..",p"..i.."_"..dk["p"..i]; end;
		TRF_N("SetReplaceValue", "p"..i, t);
	end;
	TRF_HlDE("dialog_answers", "trader_id", id, "answers", strsub(vis, 2), "labels", strsub(lab, 2));
end;

-- Answer callback (shim): the pick of answer key. A pick that does not belong to the open dialog chain is
-- ignored (an invalid chain is dropped as TRF_HailCb does); close ends the chain; any other answer is the box
-- OK of its option: hl.k, hl.c = "ok", then TRF_HailStep from a due call.
function TRF_HlDlgPick(key) TRF_Cb("TRF_HlDlgPick", TRF_HlDlgPick_Body, {key}); end;

function TRF_HlDlgPick_Body(key)
	local L = TRF_HlLive();
	local d = TRF_HlDlgCur();
	local st = TRF_HlStore();
	if st then st.dlg = nil; end;
	local hl = nil;
	if L then hl = L.hl; end;
	local id = nil;
	if type(hl) == "table" then id = hl.id; end;
	if not d then
		TRF_HlStat("hl_dlg_stale");
		TRF_HlE("dialog_pick", "trader_id", id, "key", key, "result", "ignored", "reason", "stale");
		if L and type(hl) == "table" and not TRF_HlValid(hl) then L.hl = nil; TRF_N("TRF_BoxFree", "hail"); end;
		return;
	end;
	TRF_HlE("dialog_pick", "trader_id", id, "key", key);
	if TRF_HlGt() - (hl.t or 0) >= TRF_HlT("hail_stale") then TRF_HlClose("stale"); return; end;
	if key == "close" then TRF_HlClose("close"); return; end;
	-- Pages: No witnesses, Back, Accept and Decline run from the due call; any other answer is Leave.
	if d.pg == 1 then
		local c = nil;
		if key == "nowit" and d.on.nowit then c = "pnw";
		elseif key == "back" and d.on.back then c = "back";
		elseif key == "acc" and d.on.acc then c = d.ac;
		elseif key == "dec" and d.on.dec then c = d.dc; end;
		if c then
			hl.c = c;
			hl.w = "wait";
			if not TRF_Due(0.1, "TRF_HailStep") then TRF_HlClose("due refused"); end;
			return;
		end;
		TRF_HlClose("leave");
		return;
	end;
	local ok = d.dk[key] or key;
	local k = nil;
	for i = 1, getn(hl.o) do if hl.o[i] == ok then k = i; end; end;
	if not k or not d.on[key] then TRF_HlClose("unexpected "..tostring(key)); return; end;
	hl.k = k;
	hl.c = "ok";
	hl.w = "wait";
	if not TRF_Due(0.1, "TRF_HailStep") then TRF_HlClose("due refused"); end;
end;

-- Due call after the dialog opened (the game clock stands while it is up): a chain still waiting for the
-- dialog while TRF_UiState has no dialog flag (4) was closed without an answer (Esc) or never shown, and is
-- closed (the box lock freed). Unknown state (-1) re-checks until the chain is hail_stale old. dn: the dialog
-- number of TRF_HlDlgDue; the check of an earlier dialog of the chain ends here.
function TRF_HlDlgCheck(dn)
	local L = TRF_HlLive();
	if not L or type(L.hl) ~= "table" or L.hl.w ~= "dlg" then return; end;
	local hl = L.hl;
	if not TRF_HlValid(hl) then L.hl = nil; TRF_N("TRF_BoxFree", "hail"); return; end;
	if type(dn) == "number" and type(hl.dn) == "number" and dn ~= hl.dn then return; end;
	local u = TRF_HlP(TRF_UiState, {});
	local up = nil;
	if type(u) ~= "number" or u < 0 or floor(u / 4) - floor(u / 8) * 2 == 1 then up = 1; end;
	if up and TRF_HlGt() - (hl.t or 0) < TRF_HlT("hail_stale") and TRF_Due(1, "TRF_HlDlgCheck", dn) then return; end;
	local st = TRF_HlStore();
	if st then st.dlg = nil; end;
	TRF_HlClose("dialog closed");
end;

-- Box callbacks (shims). They only record the choice and schedule TRF_HailStep.
function TRF_HailOk() TRF_Cb("TRF_HailOk", TRF_HailCb, {"ok"}); end;
function TRF_HailNext() TRF_Cb("TRF_HailNext", TRF_HailCb, {"next"}); end;
function TRF_HailClose() TRF_Cb("TRF_HailClose", TRF_HailCb, {"close"}); end;
function TRF_CtAccept() TRF_Cb("TRF_CtAccept", TRF_HailCb, {"acc"}); end;
function TRF_HlOfOk() TRF_Cb("TRF_HlOfOk", TRF_HailCb, {"oacc"}); end;
function TRF_HlOfNo() TRF_Cb("TRF_HlOfNo", TRF_HailCb, {"onext"}); end;
function TRF_HlPgOk() TRF_Cb("TRF_HlPgOk", TRF_HailCb, {"pok"}); end;
function TRF_HlPgNw() TRF_Cb("TRF_HlPgNw", TRF_HailCb, {"pnw"}); end;
function TRF_HlPgLv() TRF_Cb("TRF_HlPgLv", TRF_HailCb, {"plv"}); end;
function TRF_HlHpOk() TRF_Cb("TRF_HlHpOk", TRF_HailCb, {"hacc"}); end;
function TRF_HlHpNo() TRF_Cb("TRF_HlHpNo", TRF_HailCb, {"hdec"}); end;

-- c: "ok", "next" (menu box), "close" (answer OK, contract Cancel), "acc" (contract OK), "oacc", "onext"
-- (v1 offer box OK, Cancel), "pok" (result page answer OK), "pnw", "plv" (No witnesses box OK, Cancel), "hacc",
-- "hdec" (help offer box OK, Cancel). Page picks (TRF_HlDlgPick) also give "back", "cdec" (contract Decline), "xacc",
-- "xdec" (provider offer page, TRF_HlProvPage).
function TRF_HailCb(c)
	local L = TRF_HlLive();
	if not L then return; end;
	local hl = L.hl;
	if not TRF_HlValid(hl) then
		L.hl = nil; TRF_N("TRF_BoxFree", "hail");
		TRF_HlE("box", "button", c, "result", "stale");
		return;
	end;
	if c == "close" then TRF_HlClose("ok"); return; end;
	local want = "menu";
	if c == "acc" then want = "ct"; end;
	if c == "oacc" or c == "onext" then want = "of"; end;
	if c == "pok" then want = "pg"; end;
	if c == "pnw" or c == "plv" then want = "pgq"; end;
	if c == "hacc" or c == "hdec" then want = "hp"; end;
	if hl.w ~= want then TRF_HlClose("unexpected "..tostring(c).." in "..tostring(hl.w)); return; end;
	hl.c = c;
	hl.w = "wait";
	if not TRF_Due(0.1, "TRF_HailStep") then TRF_HlClose("due refused"); end;
end;

-- Due call after a box callback: next box, answer or action.
function TRF_HailStep()
	local L = TRF_HlLive();
	if not L then return; end;
	local hl = L.hl;
	if not TRF_HlValid(hl) then L.hl = nil; TRF_N("TRF_BoxFree", "hail"); return; end;
	local c = hl.c;
	hl.c = nil;
	if c == "next" then
		hl.k = hl.k + 1;
		if hl.k > getn(hl.o) then TRF_HlClose("last"); else TRF_HailShow(); end;
	elseif c == "ok" then
		TRF_HailDo(hl.o[hl.k]);
	elseif c == "acc" then
		TRF_CtDo();
	elseif c == "oacc" then
		TRF_HlOfStep(1);
	elseif c == "onext" then
		TRF_HlOfStep(nil);
	elseif c == "pok" then
		TRF_HlPgNext();
	elseif c == "pnw" then
		TRF_HlPgNoWit();
	elseif c == "plv" then
		TRF_HlClose("leave");
	elseif c == "back" then
		TRF_HlBack();
	elseif c == "cdec" then
		TRF_HlE("contract", "trader_id", hl.id, "result", "declined");
		TRF_HlBack();
	elseif c == "xacc" then
		TRF_HlProvAcc();
	elseif c == "xdec" then
		TRF_HlE("offer", "trader_id", hl.id, "key", hl.o[hl.k], "result", "declined");
		hl.xf = nil;
		TRF_HlBack();
	elseif c == "hacc" then
		TRF_HlHelpAcc();
	elseif c == "hdec" then
		TRF_HlHelpDec();
	else
		TRF_HlClose("no choice");
	end;
end;

-- Action of menu option key.
function TRF_HailDo(key)
	local L = TRF_HlLive();
	local hl = L.hl;
	local id = hl.id;
	local r = TRF_HlRec(id);
	TRF_HlStat("hl_opt_"..tostring(key));
	TRF_HlE("option", "trader_id", id, "key", key);
	if key == "trade" then
		-- r.trd after the call: TRF_ShopOpen refuses a trader whose trd is already set.
		TRF_HlClose("trade");
		TRF_HlTrade(id);
		r.trd = 1;
	elseif key == "head" then
		r.hd = 1;
		TRF_HlAnswer(TRF_Headed(id));
	elseif key == "news" then
		r.nw = 1;
		TRF_HlClose("news");
		TRF_HlRumour(r);
	elseif key == "esc" then
		local text, n = TRF_CtOffer(id);
		if not text then TRF_HlClose("offer gone"); return; end;
		hl.n = n;
		TRF_HlOffer(text, "acc", "cdec", "offer", "ct", TRF_CtAccept, TRF_HailClose, key);
	elseif key == "trouble" then
		r.tu = 1;
		TRF_HlAnswer(TRF_Trouble(TRF_HlCur(), 1));
	elseif key == "boom" then
		r.bm = 1;
		TRF_HlAnswer(TRF_Boom(TRF_HlCur()));
	elseif key == "sweep" then
		TRF_HlUse(r, "sweep");
		local l = TRF_HlSweepOffers(r);
		if not l then TRF_HlClose("offer gone"); return; end;
		TRF_HlOfStart(l, nil);
	else
		TRF_HailDoV1(id, r, key);
	end;
end;

-- v1 provider item of key: answer, offer box, or action after the menu closes.
function TRF_HailDoV1(id, r, key)
	local it = TRF_HlGetItem(id, key);
	if not it or not r then TRF_HlClose("unknown option"); return; end;
	TRF_HlUse(r, it.k);
	if type(it.s) == "string" then
		TRF_HlAnswer(it.s);
	elseif it.d then
		-- Provider's HailDo with the menu open; it keeps the chain when it opened its own box (hl.w set).
		local L = TRF_HlLive();
		local v = TRF_HlCall(it.d, {it.ko, id});
		TRF_HlE("option_result", "trader_id", id, "key", key, "handler", it.d, "result", v);
		if L and type(L.hl) == "table" and L.hl.w == "wait" then TRF_HlClose(key); end;
	elseif it.q ~= nil then
		TRF_HlOfStart({{q=it.q, ok=it.ok, a=it.a}}, id);
	else
		TRF_HlClose(key);
		local v = TRF_HlCall(it.f, {id, it.a});
		TRF_HlE("option_result", "trader_id", id, "key", key, "result", v);
		if type(v) == "string" then TRF_HlSay(v, id, nil, 1); end;
	end;
end;

-- Demand result page (design/demand-page-spec.md) ------------------------------------------------

-- Page of trader id after a demand (trf_supply TRF_SpAnswer, from the hail due call, never inside a callback):
-- text = the trader's answer (and the moved items), nw 1 offers No witnesses. Tune hail_box 2 with a usable
-- dialog (TRF_HlDlgWhy): the dialog TRF_HailPg, node msg10 ("FTU #who#: #m1#", m1 = text without its "FTU
-- <name>: " prefix, set in the init: D6 is unchecked, and a message starting with # is D10);
-- otherwise the boxes, the answer (OK), then with nw "No witnesses?" (OK = No witnesses, Cancel = Leave). The
-- open chain of id carries the page (hl.pn = 1 with nw); without a chain one of its own starts. Returns
-- "dialog", "box" or nil (no page: hail_box 0, another trader's chain, no box).
function TRF_HlPage(id, text, nw)
	local L = TRF_HlLive();
	if not L or type(TRF) ~= "table" or type(text) ~= "string" or TRF_HlT("hail_box") == 0 then return nil; end;
	local hl = L.hl;
	if not TRF_HlValid(hl) or hl.id ~= id then
		if TRF_HlValid(hl) then TRF_HlE("page", "trader_id", id, "reason", "busy", "result", "skipped"); return nil; end;
		hl = {id=id, g=TRF.gen, o={}, k=1, t=TRF_HlGt()};
		L.hl = hl;
	end;
	local pn = nil;
	if nw == 1 then pn = 1; end;
	hl.pn = pn;
	hl.t = TRF_HlGt();
	local how = nil;
	if TRF_HlT("hail_box") == 2 and TRF_HlPgDlg(hl, text) then
		how = "dialog";
	else
		hl.w = "pg";
		if TRF_HlBox("#UI_FTrader_confirm", text, TRF_HlPgOk) then how = "box"; else TRF_HlClose("nobox"); end;
	end;
	if not how then
		TRF_HlE("page", "trader_id", id, "reason", "no_box", "result", "skipped");
		return nil;
	end;
	TRF_HlStat("hl_page");
	TRF_HlE("page", "trader_id", id, "via", how, "no_witness_offered", TRF_KvB(pn));
	return how;
end;

function TRF_HlPgCall()
	StartTradeDialog("TRF_HailPg", "TRF_HlPgInit");
	return 1;
end;

-- The demand page as the dialog (TRF_HlPgShow kind "demand", answers Leave and, with hl.pn, No witnesses): 1 when
-- StartTradeDialog ran, nil after a fallback (the caller shows the boxes).
function TRF_HlPgDlg(hl, text)
	local on = {leave=1};
	if hl.pn == 1 then on.nowit = 1; end;
	return TRF_HlPgShow(hl, "demand", text, on);
end;

-- Init of the page dialog (shim): #who#, #m1#, the labels of TRF_HlPgLabels, the answers of the record's on
-- shown, the rest hidden. A stale record leaves Leave only and an empty message.
function TRF_HlPgInit() TRF_Cb("TRF_HlPgInit", TRF_HlPgInit_Body, {}); end;

function TRF_HlPgInit_Body()
	local d = TRF_HlDlgCur();
	local who, m1, on, id, kd = TRF_Txt("hull1"), "", {leave=1}, nil, nil;
	if d and d.pg == 1 then
		who = d.who or who; m1 = d.m1 or ""; on = d.on; id = d.id; kd = d.kd;
	else
		TRF_HlE("dialog_init", "dialog", "page", "result", "stale");
	end;
	local ks = TRF_HlPgKeys();
	local vis = "";
	for i = 1, getn(ks) do
		if on[ks[i]] then
			TRF_N("ShowAnswer", "a_"..ks[i]);
			vis = vis..","..ks[i];
		else
			TRF_N("HideAnswer", "a_"..ks[i]);
		end;
	end;
	TRF_N("SetReplaceValue", "who", who);
	TRF_N("SetReplaceValue", "m1", m1);
	for k, v in TRF_HlPgLabels() do TRF_N("SetReplaceValue", "l"..k, TRF_Txt(v)); end;
	TRF_HlDE("dialog_answers", "trader_id", id, "dialog", "page", "answers", strsub(vis, 2), "kind", kd);
end;

-- Due step after the page answer box: with No witnesses the question box, else Leave.
function TRF_HlPgNext()
	local hl = TRF_HlLive().hl;
	if hl.pn ~= 1 then TRF_HlClose("leave"); return; end;
	hl.w = "pgq";
	hl.t = TRF_HlGt();
	if not TRF_HlBox("#UI_FTrader_confirm", TRF_Txt("dmpq"), TRF_HlPgNw, TRF_HlPgLv) then TRF_HlClose("nobox"); end;
end;

-- Due step of No witnesses: the chain closes, then trf_supply marks the flight.
function TRF_HlPgNoWit()
	local hl = TRF_HlLive().hl;
	local id = hl.id;
	TRF_HlClose("nowit");
	local v = TRF_HlCall("TRF_DemandNoWit", {id});
	TRF_HlE("option_result", "trader_id", id, "key", "nowit", "result", v);
end;

-- Offer chain (v1): list l of {q or t, ok, a}; hid = trader id for a hail item offer (ok(hid, a)), nil for
-- faction offers (ok(a)). One OK/Cancel box per offer; the next box comes from TRF_HailStep.
function TRF_HlOfStart(l, hid)
	local st = TRF_HlStore();
	local L = TRF_HlLive();
	if not st or not L or type(L.hl) ~= "table" then TRF_HlClose("no store"); return; end;
	st.of = l;
	st.oh = hid;
	L.hl.oq = 1;
	TRF_HlOfShow();
end;

function TRF_HlOfText(e)
	if type(e) ~= "table" then return nil; end;
	if type(e.q) == "string" then return e.q; end;
	if type(e.t) == "string" then return e.t; end;
	if type(e.text) == "string" then return e.text; end;
	return nil;
end;

-- Box of the first offer from hl.oq that has a text; none left -> chain closed.
function TRF_HlOfShow()
	local L = TRF_HlLive();
	local hl = L.hl;
	local st = TRF_HlStore();
	local l = nil;
	if st then l = st.of; end;
	if type(l) ~= "table" or type(hl.oq) ~= "number" then TRF_HlClose("no offers"); return; end;
	local text = nil;
	while hl.oq <= getn(l) do
		text = TRF_HlOfText(l[hl.oq]);
		if text then break; end;
		hl.oq = hl.oq + 1;
	end;
	if not text then TRF_HlClose("offers done"); return; end;
	TRF_HlOffer(text, "oacc", "onext", "offer", "of", TRF_HlOfOk, TRF_HlOfNo, hl.o[hl.k]);
end;

-- Due step after an offer box: accept (acc = 1) calls ok, then the next offer.
function TRF_HlOfStep(acc)
	local L = TRF_HlLive();
	local hl = L.hl;
	local st = TRF_HlStore();
	local l = nil;
	if st then l = st.of; end;
	if type(l) ~= "table" or type(hl.oq) ~= "number" then TRF_HlClose("no offers"); return; end;
	local e = l[hl.oq];
	if type(e) == "table" then
		local args = {e.a};
		if st.oh then args = {st.oh, e.a}; end;
		if acc then
			local v = TRF_HlCall(e.ok, args);
			TRF_HlStat("hl_offer_acc");
			TRF_HlE("offer", "offer_index", hl.oq, "result", "accepted", "reply", v);
			if type(v) == "string" then TRF_HlSay(v, st.oh, nil, 1); end;
		elseif e.no then
			TRF_HlCall(e.no, args);
		end;
		if not acc and TRF_HlPgMode(hl) then TRF_HlE("offer", "offer_index", hl.oq, "result", "declined"); end;
	end;
	hl.oq = hl.oq + 1;
	if hl.oq > getn(l) then
		-- Stage B: Decline of the last offer on a page goes back to the menu.
		if not acc and TRF_HlPgMode(hl) then TRF_HlBack(); return; end;
		TRF_HlClose("offers done");
		return;
	end;
	TRF_HlOfShow();
end;

-- Trade: trf_shop's trader shop (cfg shop_mode 1), else the vanilla trader shop (On_FTrader_Start).
-- Vanilla functions run with call(f, {}, "x"): no mod handler, so their errors keep the default path.
function TRF_HlTrade(id)
	local m = 1;
	if type(TRF_UI_Opt) == "function" then m = TRF_UI_Opt("shop_mode", 1); end;
	if m == 1 and type(TRF_ShopOpen) == "function" then
		local v = TRF_HlP(TRF_ShopOpen, {id});
		TRF_HlE("trade", "trader_id", id, "via", "shop", "result", v);
		return;
	end;
	if type(On_FTrader_Start) == "function" then
		call(On_FTrader_Start, {}, "x");
		TRF_HlE("trade", "trader_id", id, "via", "vanilla");
	end;
end;

-- "Any news?": the vanilla rumour (paid at >= 5000 cr). A rescued trader gives it free, as _Trader_Speak
-- does below 5000 cr; Rnd_speak is the vanilla global DialogTrader1_fin2 reads.
function TRF_HlRumour(r)
	if r.res == 1 and type(SpeakList_TraderDialog) == "table" and type(SpeakList_TraderDialog_nocost) == "table"
		and type(StartTradeDialog) == "function" and type(RAND) == "function" then
		Rnd_speak = RAND(getn(SpeakList_TraderDialog)) + 1;
		call(StartTradeDialog, {SpeakList_TraderDialog_nocost[Rnd_speak]}, "x");
		return;
	end;
	if type(_Trader_Speak) == "function" then call(_Trader_Speak, {}, "x"); end;
end;

-- Escort contract (5.6) ------------------------------------------------------------

-- Contract record whose trader is still there; a stale one is voided.
function TRF_CtLive()
	local L = TRF_HlLive();
	if not L or type(L.ct) ~= "table" then return nil; end;
	if not TRF_HlRec(L.ct.id) then TRF_CtVoid("gone"); return nil; end;
	return L.ct;
end;

-- L_w (TDR 8.4) of system idx (default current): trf_region's TRF_LPay, else 8.
function TRF_HlLPay(idx)
	if type(TRF_LPay) == "function" then
		local v = TRF_HlP(TRF_LPay, {idx});
		if type(v) == "number" then return v; end;
	end;
	return 8;
end;

-- Contract pay N_eff: trf_region's TRF_PayN, else 900 x L_w x lk x 0.75 (T1, pro 0, d_k 1), capped.
function TRF_HlPayN(idx)
	local n = nil;
	if type(TRF_PayN) == "function" then n = TRF_HlP(TRF_PayN, {idx}); end;
	if type(n) ~= "number" then
		local L = TRF_HlLPay(idx);
		n = 900 * L * min(1, L / 8) * 0.75;
	end;
	return floor(min(n, TRF_HlT("pay_cap")));
end;

-- Effective danger dE of system idx (map entry s) for the contract gate (v02 5.6), the raid roll's rule:
-- trf_raid's TRF_Rd_DangerEff, else trf_region's TRF_DangerEff, else the map dg with the clan floor in a
-- region, else 1 (map without dg).
function TRF_HlDanger(idx, s)
	local d = TRF_N("TRF_Rd_DangerEff", idx);
	if type(d) ~= "number" then d = TRF_N("TRF_DangerEff", idx); end;
	if type(d) ~= "number" then
		d = 1;
		if type(s) == "table" and type(s.dg) == "number" then
			d = s.dg;
			if TRF_N("TRF_RgOf", idx) then d = max(d, 1); end;
		end;
	end;
	return d;
end;

-- Pure: escort offer chance % = clamp(100 x t x (ct_off_br - br), ct_off_min, ct_off_max) with
-- t = min(1, (dE + ct_off_dis x dis) / 3): dE effective danger 0..3, dis disruption 0..9, br braveness.
function TRF_CtOfferP(dE, dis, br)
	local t = min(1, (dE + TRF_HlT("ct_off_dis") * dis) / 3);
	return max(TRF_HlT("ct_off_min"), min(TRF_HlT("ct_off_max"), 100 * t * (TRF_HlT("ct_off_br") - br)));
end;

-- Braveness of trader record r: trf_raid's TRF_Rd_Brave, else one roll uniform in [0.2, 1] kept as r.br
-- (the key trf_raid reads, so one value serves the offer and the raid decision).
function TRF_HlBrave(r)
	local b = TRF_N("TRF_Rd_Brave", r);
	if type(b) == "number" then return b; end;
	if type(r.br) ~= "number" then r.br = 0.2 + 0.8 * (TRF_HlDraw(1001) or 500) / 1000; end;
	return r.br;
end;

-- Offer decision of trader record r, made once and kept as r.co (1 offers, 0 declines); 1 or nil.
function TRF_CtOfferRoll(id, r, idx, s)
	if type(r.co) == "number" then
		if r.co == 1 then return 1; end;
		return nil;
	end;
	local dE, dis = TRF_HlDanger(idx, s), TRF_HlDis(idx);
	local br = TRF_HlBrave(r);
	local p = TRF_CtOfferP(dE, dis, br);
	-- Corporation carriers (design/corp-carriers-spec.md 5.7): the offer floor while a supply run of its corporation is open.
	local pm = TRF_N("TRF_Crp_OfferMin", r);
	if type(pm) == "number" and pm > p then p = pm; end;
	local roll = TRF_HlDraw(100);
	local res = "declined";
	r.co = 0;
	if type(roll) == "number" and roll < p then r.co = 1; res = "offered"; end;
	TRF_HlE("contract_offer", "trader_id", id, "danger_eff", dE, "disruption", dis, "braveness", format("%.2f", br),
		"chance", format("%.1f", p), "roll", roll, "result", res);
	if r.co == 1 then return 1; end;
	return nil;
end;

-- Offer text and pay for trader id, or nil, reason.
function TRF_CtOffer(id)
	if TRF_HlOpt("contracts") ~= 1 then return nil, "off"; end;
	local r = TRF_HlRec(id);
	if not r then return nil, "norec"; end;
	if r.path ~= "A" and r.path ~= "B" then return nil, "path"; end;
	if r.st ~= "in" and r.st ~= "out" then return nil, "st"; end;
	-- r.sev: a station event ship (trf_station) pays through its event, never a contract.
	if r.ct or r.sev or type(r.rdn) == "number" then return nil, "used"; end;
	-- r.fw: the player's own freighter (trf_freight) is never an 8.4 contract.
	if r.fw then return nil, "freight"; end;
	-- r.wq: the Kestrel of the freight unlock quest (trf_wq), also after her raid (r.rdn covers the raid).
	if r.wq then return nil, "wq"; end;
	local idx = TRF_HlCur();
	local m = TRF_HlMap();
	if type(idx) ~= "number" or type(m) ~= "table" or type(m.sys[idx]) ~= "table" then return nil, "nomap"; end;
	-- One roll per trader on effective danger (clan floor included, as the raid roll), disruption, braveness.
	if not TRF_CtOfferRoll(id, r, idx, m.sys[idx]) then return nil, "roll"; end;
	if TRF_HlHeat() > 2 and not (TRF_HlHeat() == 3 and TRF_N("TRF_Ch_Heat3")) then return nil, "heat"; end;
	if TRF_CtLive() then return nil, "busy"; end;
	if not TRF_HlStrict(idx, "contract") then return nil, "strict"; end;
	local n = TRF_HlPayN(idx);
	local dest = TRF_Txt("station");
	if type(TRF_UI_SysName) == "function" then dest = TRF_UI_SysName(r.to); end;
	return TRF_Txt("ctoffer", dest, format("%d", n)), n;
end;

-- Accept (due call after the contract box OK). Pay is the offered value (fixed at accept).
function TRF_CtDo()
	local L = TRF_HlLive();
	local hl = L.hl;
	local id, n = hl.id, hl.n;
	TRF_HlClose("accept");
	local r = TRF_HlRec(id);
	local ok, why = TRF_CtOffer(id);
	if not r or not ok or type(n) ~= "number" then
		TRF_HlE("contract", "trader_id", id, "result", "not_accepted", "reason", why);
		return;
	end;
	L.ct = {id=id, n=n, t=TRF_HlGt()};
	r.ct = 1;
	local v = TRF_HlOpt("esc_speed");
	if v > 0 then
		-- CHECK (O4): SetMaxSpeed on an NPC carcass (vanilla uses it on the mothership only).
		local lead = TRF_HlLead(id);
		if lead then TRF_HlP(function(s) s:SetMaxSpeed(%v); end, {lead}); end;
	end;
	if type(TRF_RaidRoll) == "function" then TRF_HlP(TRF_RaidRoll, {id, "contract"}); end;
	TRF_P("TRF_TrackMark", id, "contract");
	TRF_HlSay(TRF_Txt("ctok"), id, nil, 1);
	TRF_HlStat("ct_accept");
	TRF_HlE("contract", "trader_id", id, "pay", n, "result", "accepted");
end;

function TRF_HlRecovery()
	if type(TRF_RgOf) ~= "function" or type(TRF_Phase) ~= "function" then return nil; end;
	local s = TRF_HlP(TRF_RgOf, {TRF_HlCur()});
	if type(s) ~= "number" then return nil; end;
	if TRF_HlP(TRF_Phase, {s}) == 5 then return 1; end;
	return nil;
end;

-- Trader id docked or left by its exit (trf_gen, before TRF_Remove), or fled and reached its refuge alive, a portal
-- or a station (how escaped, trf_raid TRF_Rd_Safe, before TRF_Remove; v02 5.6, user decision 2026-11-01): a fleeing
-- trader counts as any arrival, whichever trigger fires first. Pays when the mothership is within ct_dist of its
-- leader, else voids (far). Returns 1 when paid.
function TRF_CtArrive(id, how)
	local L = TRF_HlLive();
	if not L or type(L.ct) ~= "table" or L.ct.id ~= id then return nil; end;
	local ct = L.ct;
	L.ct = nil;
	local d = TRF_HlDistMs(id);
	if not d or d > TRF_HlT("ct_dist") then
		TRF_HlSay(TRF_Txt("ctfar"), id);
		TRF_HlStat("ct_far");
		TRF_HlE("contract", "trader_id", id, "via", how, "distance", TRF_F(d), "result", "void", "reason", "far");
		return nil;
	end;
	local n = floor(ct.n or 0);
	TRF_N("AddPlayerCredits", n);
	local h = 1;
	if TRF_HlRecovery() then h = 2; end;
	if type(TRF_AddHelp) == "function" then TRF_HlP(TRF_AddHelp, {h, "contract"}); end;
	if type(TRF_AddHeat) == "function" then TRF_HlP(TRF_AddHeat, {-1, "contract"}); end;
	if type(TRF_ProCredit) == "function" then TRF_HlP(TRF_ProCredit, {4, "contract"}); end;
	TRF_HlSay(TRF_Txt("ctpaid", format("%d", n)), id);
	-- Corporation carriers (design/corp-carriers-spec.md 5.7): a deed of an open supply run is not also an escort deed.
	if TRF_N("TRF_Crp_Escort", id, TRF_HlRec(id), n, TRF_HlCur()) ~= 1 then TRF_N("TRF_Ch_Note", 1, TRF_HlCur(), n); end;
	TRF_HlStat("ct_paid");
	TRF_HlE("contract", "trader_id", id, "via", how, "pay", n, "distance", TRF_F(d), "help", h, "result", "paid");
	return 1;
end;

-- Contracted trader killed (trf_events): no pay, dis +1.
function TRF_CtLost(id)
	local L = TRF_HlLive();
	if not L or type(L.ct) ~= "table" or L.ct.id ~= id then return nil; end;
	L.ct = nil;
	local idx = TRF_HlCur();
	if type(TRF_AddDis) == "function" and type(idx) == "number" then TRF_HlP(TRF_AddDis, {idx, 1, "ctlost"}); end;
	TRF_HlSay(TRF_Txt("ctlost", TRF_HlName(TRF_HlRecAny(id))));
	TRF_HlStat("ct_lost");
	TRF_HlE("contract", "trader_id", id, "result", "lost");
	return 1;
end;

-- Jump, load, any other removal: contract ends without pay or penalty, no line (an escape is an arrival,
-- TRF_CtArrive).
function TRF_CtVoid(why)
	local L = TRF_HlLive();
	if not L or type(L.ct) ~= "table" then return nil; end;
	TRF_HlE("contract", "trader_id", L.ct.id, "result", "void", "reason", why);
	TRF_HlStat("ct_void");
	L.ct = nil;
	return 1;
end;

-- Answers (6.3, 6.4) ---------------------------------------------------------------

-- Systems within depth jumps of idx on the static portal graph, current excluded: {{i=idx, d=jumps}}.
function TRF_HlBfs(idx, depth)
	local out = {};
	local m = TRF_HlMap();
	if type(m) ~= "table" or type(idx) ~= "number" or type(m.sys[idx]) ~= "table" then return out; end;
	local seen = {};
	seen[idx] = 0;
	local fr = {idx};
	for d = 1, depth do
		local nx = {};
		for i = 1, getn(fr) do
			local ps = m.sys[fr[i]].portals;
			if type(ps) ~= "table" then ps = {}; end;
			for j = 1, getn(ps) do
				local t = nil;
				if type(ps[j]) == "table" and type(ps[j].to) == "string" then t = m.by[strlower(ps[j].to)]; end;
				if t and seen[t] == nil and type(m.sys[t]) == "table" then
					seen[t] = d;
					tinsert(nx, t);
					tinsert(out, {i=t, d=d});
				end;
			end;
		end;
		fr = nx;
	end;
	return out;
end;

-- Order: value desc, jumps asc, idx asc.
function TRF_HlCmp(a, b)
	if a.v ~= b.v then return a.v > b.v; end;
	if a.d ~= b.d then return a.d < b.d; end;
	return a.i < b.i;
end;

function TRF_HlSysName(idx)
	if type(TRF_UI_SysName) == "function" then return TRF_UI_SysName(idx); end;
	return tostring(idx);
end;

-- Up to 3 entries of the BFS with value f(idx) (nil = skip), ordered by TRF_HlCmp.
function TRF_HlPick(idx, depth, f)
	local l = TRF_HlBfs(idx, depth);
	local o = {};
	for i = 1, getn(l) do
		local v = f(l[i].i);
		if v then l[i].v = v; tinsert(o, l[i]); end;
	end;
	sort(o, TRF_HlCmp);
	while getn(o) > 3 do tremove(o); end;
	return o;
end;

function TRF_HlTroubleV(i)
	local d = TRF_HlDis(i);
	if d >= 3 then return d; end;
	return nil;
end;

function TRF_HlBoomV(i)
	local p = TRF_HlPro(i);
	if p >= TRF_HlT("boom_min_pro") and TRF_HlDis(i) < 3 then return p; end;
	return nil;
end;

-- "Raids reported: Gredos (some), Aurora (light)" (S19): dis >= 3 within trouble_range jumps. tw 1: each item also
-- names the clan's temperament (trf_temper, design/temperament-spec.md 5.3: "Gredos (some, talk first)").
function TRF_Trouble(idx, tw)
	local o = TRF_HlPick(idx, TRF_HlT("trouble_range"), TRF_HlTroubleV);
	if getn(o) == 0 then return TRF_Txt("trnone"), 0; end;
	local s = "";
	for i = 1, getn(o) do
		if i > 1 then s = s..", "; end;
		s = s..TRF_Txt("tritem", TRF_HlSysName(o[i].i), TRF_HlSevWord(o[i].i, tw));
	end;
	return TRF_Txt("trhead", s), getn(o);
end;

-- Severity word of a system: tier word; "carrier" for a carrier target, ", pirate base" with an active base
-- (v1-spec 6.2, 9.5); tw 1 adds the temperament word of the system's clan (trf_temper TRF_Te_Word).
function TRF_HlSevWord(i, tw)
	local w = TRF_Txt("sev"..min(TRF_HlTier(i), 4));
	if type(TRF_UI_CarAt) == "function" and TRF_UI_CarAt(i) then w = TRF_Txt("sev5"); end;
	if type(TRF_UI_BaseAt) == "function" and TRF_UI_BaseAt(i) == 2 then w = TRF_Txt("sevbase", w); end;
	if tw == 1 then
		local tx = TRF_P("TRF_Te_Word", i);
		if type(tx) == "string" then w = TRF_Txt("tews", w, tx); end;
	end;
	return w;
end;

-- "Trade is good in: Gredos (booming), ..." (S26): pro >= boom_min_pro and dis < 3. v1-spec 8.4: a
-- scheduled equipment convoy within range adds a line (feq_announce_chance).
function TRF_Boom(idx)
	local o = TRF_HlPick(idx, TRF_HlT("trouble_range"), TRF_HlBoomV);
	local fq = TRF_HlFeqLine(idx, "bmfeq");
	if getn(o) == 0 then
		if fq then return TRF_Txt("bmnone").." "..fq, 0; end;
		return TRF_Txt("bmnone"), 0;
	end;
	local s = "";
	for i = 1, getn(o) do
		if i > 1 then s = s..", "; end;
		local w = "bm1";
		if o[i].v >= 8 then w = "bm2"; end;
		s = s..TRF_Txt("tritem", TRF_HlSysName(o[i].i), TRF_Txt(w));
	end;
	if fq then return TRF_Txt("bmhead", s)..". "..fq, getn(o); end;
	return TRF_Txt("bmhead", s), getn(o);
end;

-- Systems within depth jumps of idx: idx -> jumps (idx itself 0).
function TRF_HlNear(idx, depth)
	local near = {};
	if type(idx) ~= "number" then return near; end;
	near[idx] = 0;
	local l = TRF_HlBfs(idx, depth);
	for i = 1, getn(l) do near[l[i].i] = l[i].d; end;
	return near;
end;

-- Random draw 0..n-1 (TRF_Rand, else RAND), or nil without either.
function TRF_HlDraw(n)
	if type(TRF_Rand) == "function" then return TRF_Rand(n); elseif type(RAND) == "function" then return RAND(n); end;
	return nil;
end;

function TRF_HlRoll(pct)
	if type(pct) ~= "number" then return nil; end;
	local r = TRF_HlDraw(100);
	if type(r) == "number" and r < pct then return 1; end;
	return nil;
end;

-- Line key ("rfeq" rumour, "bmfeq" booming answer) for a scheduled equipment convoy within
-- feq_announce_range jumps, rolled with feq_announce_chance (v1-spec 8.4); nil otherwise.
function TRF_HlFeqLine(idx, key)
	-- trf_convoy's announce (stable roll per record and system) when loaded.
	if type(TRF_FeqDue) == "function" then
		local d = TRF_HlP(TRF_FeqDue, {idx});
		if type(d) ~= "table" or type(d.s) ~= "number" then return nil; end;
		if key == "rfeq" and type(d.txt) == "string" then return d.txt; end;
		local fn = "";
		if type(TRF_UI_FacOf) == "function" then fn = TRF_UI_FacOf(d.f); end;
		return TRF_Txt(key, fn, TRF_HlSysName(d.s));
	end;
	if type(TRF_UI_Feq) ~= "function" then return nil; end;
	local q = TRF_UI_Feq();
	if not q or type(idx) ~= "number" then return nil; end;
	local near = TRF_HlNear(idx, TRF_HlT("feq_announce_range") or 3);
	if near[q.s] == nil or not TRF_HlRoll(TRF_HlT("feq_announce_chance") or 50) then return nil; end;
	return TRF_Txt(key, TRF_UI_FacOf(q.f), TRF_HlSysName(q.s));
end;

-- Nearest entry of list l by jumps in near, ties by idx; f(e) -> idx or nil.
function TRF_HlNearest(l, near, f)
	local best, bd, bi = nil, 99, 0;
	if type(l) ~= "table" then return nil; end;
	for i = 1, getn(l) do
		local e = l[i];
		local x = nil;
		if type(e) == "table" then x = f(e); end;
		if type(x) == "number" and near[x] and (near[x] < bd or (near[x] == bd and x < bi)) then
			best = e; bd = near[x]; bi = x;
		end;
	end;
	return best;
end;

function TRF_HlBaseIdx(e) if e.k == 1 or e.k == 2 then return e.s; end; return nil; end;

function TRF_HlCarIdx(e)
	if type(e.e) == "number" and type(TRF.clock) == "table" and TRF.clock.legs < e.e then return e.t; end;
	return nil;
end;

-- v1 rumours within rumour_range jumps (v1-spec 6.2, 6.3, 9.2): pirate base (active, then gathering),
-- carrier raid, salvage stage 2-3 of a clan whose home is near; nil when none.
function TRF_HlRumourV1(idx)
	if type(TRF) ~= "table" then return nil; end;
	local near = TRF_HlNear(idx, TRF_HlT("rumour_range") or 3);
	local b = TRF_HlNearest(TRF.base, near, TRF_HlBaseIdx);
	if b then
		if b.k == 2 then return TRF_Txt("rbase", TRF_HlSysName(b.s)); end;
		return TRF_Txt("rgather", TRF_HlSysName(b.s));
	end;
	local c = TRF_HlNearest(TRF.lr, near, TRF_HlCarIdx);
	if c and type(TRF_UI_ClanName) == "function" then
		return TRF_Txt("rcar", TRF_UI_ClanName(c.s), TRF_HlSysName(c.t));
	end;
	if type(TRF_UI_Salv) == "function" and type(TRF_UI_RgN) == "function" then
		for s = 1, TRF_UI_RgN() do
			local st, f = TRF_UI_Salv(s);
			local h = TRF_HlHome(s);
			if st >= 2 and type(f) == "number" and f >= 1 and f <= 5 and h and near[h] then
				local w = "rsalvf";
				if st >= 3 then w = "rsalvc"; end;
				return TRF_Txt("rsalv", TRF_UI_FacOf(f), TRF_Txt(w), TRF_HlSysName(h));
			end;
		end;
	end;
	return nil;
end;

-- Home idx of region slot (TRF_RgMap home: idx or system name), or nil.
function TRF_HlHome(slot)
	if type(TRF_UI_HomeIdx) == "function" then return TRF_UI_HomeIdx(slot); end;
	return nil;
end;

-- First true rumour (6.3): raided neighbour, v1 base / carrier / salvage rumour, shortage within 2 jumps,
-- equipment convoy due (rolled), busy neighbour, scheduled sweep with its home within 3 jumps, else
-- "quiet". Reads saved state only.
function TRF_HlRumourText(idx)
	local n1 = TRF_HlPick(idx, 1, TRF_HlTroubleV);
	if getn(n1) > 0 then return TRF_Txt("rdis", TRF_HlSysName(n1[1].i)); end;
	local v1 = TRF_HlRumourV1(idx);
	if v1 then return v1; end;
	-- Survivors (design/survivors-spec.md): a crew taken by slavers or rescued nearby (chapter 5 on).
	local sr = TRF_N("TRF_Sv_Rumour", idx, "rec");
	if type(sr) == "string" then return sr; end;
	if type(TRF) == "table" and type(TRF.short) == "table" and type(TRF.clock) == "table" then
		local near = {};
		near[idx] = 0;
		local l = TRF_HlBfs(idx, 2);
		for i = 1, getn(l) do near[l[i].i] = l[i].d; end;
		local best = nil;
		-- Relief targets only (trf_shop TRF_ShortRelief: active, not player-caused, no job; 00 section 6).
		local rl = TRF_N("TRF_ShortRelief");
		if type(rl) ~= "table" then rl = {}; end;
		for i = 1, getn(rl) do
			local e = rl[i];
			if near[e.s] then
				local c = {i=e.s, d=near[e.s], c=e.c};
				if not best or c.d < best.d or (c.d == best.d and c.i < best.i) then best = c; end;
			end;
		end;
		if best then return TRF_Txt("rshort", TRF_HlSysName(best.i), TRF_Txt("cls"..tostring(best.c))); end;
	end;
	local fq = TRF_HlFeqLine(idx, "rfeq");
	if fq then return fq; end;
	local b1 = TRF_HlPick(idx, 1, TRF_HlBoomV);
	if getn(b1) > 0 then return TRF_Txt("rpro", TRF_HlSysName(b1[1].i)); end;
	if type(TRF_RgMap) == "function" and type(TRF_SweepInfo) == "function" then
		local rm = TRF_HlP(TRF_RgMap, {});
		local near = {};
		near[idx] = 0;
		local l = TRF_HlBfs(idx, 3);
		for i = 1, getn(l) do near[l[i].i] = l[i].d; end;
		if type(rm) == "table" and type(rm.n) == "number" then
			for s = 1, rm.n do
				local h = TRF_HlHome(s);
				local w = TRF_HlP(TRF_SweepInfo, {s});
				if h and near[h] and type(w) == "table" and type(w.sl) == "number" and w.sl > 0 then
					return TRF_Txt("rsweep", TRF_UI_FacName(w.fac), TRF_HlSysName(h));
				end;
			end;
		end;
	end;
	-- Survivors before chapter 5: a transport lost near a disrupted system, after the rest of the pool.
	local sl = TRF_N("TRF_Sv_Rumour", idx);
	if type(sl) == "string" then return sl; end;
	return TRF_Txt("rnone");
end;

-- "Where are you headed?" (S11): direction as the focus line, then one true rumour.
function TRF_Headed(id)
	local r = TRF_HlRec(id);
	local dir = "";
	if r and type(TRF_UI_DirText) == "function" then dir = TRF_UI_DirText(r); end;
	-- Corporation carriers (design/corp-carriers-spec.md 5.2): "InoCo cargo, <direction>".
	if r then dir = TRF_N("TRF_Crp_Dir", r, dir) or dir; end;
	local idx = TRF_HlCur();
	local rum = TRF_Txt("rnone");
	if type(idx) == "number" then rum = TRF_HlRumourText(idx); end;
	return TRF_Txt("headed", dir, rum);
end;

-- Patrol-station work board (6.4) --------------------------------------------------

-- 1 when f is this module's board wrapper: identity with the thunk of an earlier run, or trf_gen's
-- chunk-name test (TRF_IsMine).
function TRF_HailIsMine(f)
	if type(f) ~= "function" then return nil; end;
	if type(TRF_BoardThunk) == "function" and f == TRF_BoardThunk() then return 1; end;
	if type(TRF_IsMine) == "function" and TRF_IsMine(f) then return 1; end;
	return nil;
end;

-- Called from TRF_Main on every MapInitialization run, after DockStation.script redefined the vanilla
-- function. TRF_orig_PatrolOk and TRF_BoardThunk are function globals (survive ClearGlobals, never saved).
-- Returns 1 when wrapped in this run, 0 when already wrapped or missing.
function TRF_InstallBoard()
	local n = 0;
	if type(__PatrolStationDock_Ok) == "function" and not TRF_HailIsMine(__PatrolStationDock_Ok) then
		TRF_orig_PatrolOk = __PatrolStationDock_Ok;
		local w = function()
			if type(TRF_BoardDockOk) == "function" then
				TRF_BoardDockOk();
			elseif type(TRF_orig_PatrolOk) == "function" then
				TRF_orig_PatrolOk();
			end;
		end;
		__PatrolStationDock_Ok = w;
		TRF_BoardThunk = function() return %w; end;
		n = 1;
	end;
	TRF_HlE("install", "board_installed", TRF_KvB(n), "wrapped", TRF_KvB(TRF_HailIsMine(__PatrolStationDock_Ok)));
	return n;
end;

-- The vanilla patrol dialog without trf_plumb.
function TRF_BoardOrig(why)
	if type(TRF_orig_PatrolOk) == "function" then
		call(TRF_orig_PatrolOk, {}, "x");
	else
		TRF_HlE("board_original", "source", why, "result", "missing");
	end;
end;

-- Installed over __PatrolStationDock_Ok: the dock dispatcher of trf_plumb (kind patrol, design/wb-plumbing-spec.md
-- 4): the S19 board line first, the owed payers, then at most one box (8.10 contract offer first) and the
-- original once (after the answer when a box opened). Without trf_plumb the original only.
function TRF_BoardDockOk()
	if type(TRF_PlDock) == "function" then return TRF_PlDock("patrol", "TRF_orig_PatrolOk", {}); end;
	TRF_BoardOrig("no_plumb");
end;

-- Registrations (trf_plumb TRF_InstallPlumb): S19 answers at line order 10, the 8.10 offer box at prio 400.
function TRF_Hail_Plumb()
	TRF_DockLine("patrol", 10, "TRF_BoardLine");
	TRF_DockBox("patrol", 400, "TRF_BoardOfBox");
end;

-- Board text: trouble line, boom line. Returns text, short form (one line), boom line. The raid rows carry the clan's
-- temperament word when trf_temper's TRF_Te_BoardOn allows it (the Clan file reward of the docked faction, cfg te_gate).
function TRF_BoardText(idx)
	local t = TRF_Trouble(idx, TRF_P("TRF_Te_BoardOn"));
	local b = TRF_Boom(idx);
	return t..TRF_Br()..b, TRF_Txt("brdline", TRF_Txt("brdhead"), t), b;
end;

-- 1 when the board may show its full report and offers here: cfg board 1, system mode "mod", strict gate.
function TRF_BoardFull(idx)
	if TRF_HlOpt("board") ~= 1 then return nil; end;
	local mode = "mod";
	if type(TRF_SysModeQuiet) == "function" then mode = TRF_HlP(TRF_SysModeQuiet, {}); end;
	if mode ~= "mod" or not TRF_HlStrict(idx, "board") then return nil, mode; end;
	return 1, mode;
end;

-- Dock line of kind patrol (S19, 00 section 6 order 10): "Patrol report: <trouble>" on every docking; while the
-- report changed since the last full one, also the boom line and the next news bulletin (cfg news_mode 1).
-- Mission conditions (vanilla system mode, strict gate) and cfg board 2: the trouble line only. TRF_Quiet (a
-- visible scene; the dispatcher skips __sys_SOS itself): no board, so no report or bulletin counts as shown.
function TRF_BoardLine(kind)
	local L = TRF_HlLive();
	if not L or type(TRF) ~= "table" or TRF_N("TRF_Quiet") then return nil; end;
	local b = TRF_HlOpt("board");
	if b == 0 then return nil; end;
	local idx = TRF_HlCur();
	if type(idx) ~= "number" then return nil; end;
	local text, short, bm = TRF_BoardText(idx);
	local full, mode = TRF_BoardFull(idx);
	if not full then
		TRF_HlE("board", "board_mode", b, "mode", mode or "mod", "result", "line");
		return short;
	end;
	local out = {short};
	if L.board ~= text then
		L.board = text;
		TRF_HlStat("hl_board");
		tinsert(out, bm);
		if type(TRF_NewsNext) == "function" and TRF_UI_Opt("news_mode", 1) == 1 then
			local bt, be = TRF_NewsNext();
			if bt then
				tinsert(out, TRF_Txt("nbull", bt));
				if type(be) == "table" then be.n = 0; end;
			end;
		end;
	end;
	TRF_HlE("board", "system_index", idx, "line_count", getn(out), "result", "lines");
	return out;
end;

-- Faction offers of the patrol board (v1-spec 7.4, TRF_Faction_BoardOffers), kept in the handle table;
-- entries without a text are dropped. {} without trf_faction or the handle table.
function TRF_BoardOffers()
	local st = TRF_HlStore();
	if not st then return {}; end;
	st.bof = nil;
	if type(TRF_Faction_BoardOffers) ~= "function" then return {}; end;
	local l = TRF_HlP(TRF_Faction_BoardOffers, {});
	local o = {};
	if type(l) == "table" then
		for i = 1, getn(l) do
			if TRF_HlOfText(l[i]) then tinsert(o, l[i]); end;
		end;
	end;
	st.bof = o;
	return o;
end;

-- Box candidate of kind patrol (8.10, prio 400): the first board offer not declined in this visit (live.bkd,
-- ",<k>," entries), as a box spec; one offer per docking. None under TRF_Quiet (a visible scene).
function TRF_BoardOfBox(kind)
	local L = TRF_HlLive();
	if not L or type(TRF) ~= "table" or TRF_N("TRF_Quiet") then return nil; end;
	local idx = TRF_HlCur();
	if type(idx) ~= "number" or not TRF_BoardFull(idx) then return nil; end;
	local of = TRF_BoardOffers();
	local dl = L.bkd;
	if type(dl) ~= "string" then dl = ","; end;
	for i = 1, getn(of) do
		local e = of[i];
		if not strfind(dl, ","..tostring(e.k)..",", 1, 1) then
			local cap = "#UI_PatrolStationWndCaption";
			if type(e.title) == "string" then cap = e.title; end;
			TRF_HlStat("hl_boardoffer");
			TRF_HlE("board_offer", "offer_index", i, "offer_count", getn(of));
			return {title=cap, text=TRF_HlOfText(e), ok="TRF_BoardOfAcc", no="TRF_BoardOfDec", a=i, own="board_offer"};
		end;
	end;
	return nil;
end;

-- Offer box OK: ok(a) of offer i; its reply is the returned line.
function TRF_BoardOfAcc(i)
	local st = TRF_HlStore();
	local e = nil;
	if st and type(st.bof) == "table" and type(i) == "number" then e = st.bof[i]; end;
	if type(e) ~= "table" then return nil; end;
	local v = TRF_HlCall(e.ok, {e.a});
	TRF_HlStat("hl_offer_acc");
	TRF_HlE("board_offer", "offer_index", i, "result", "accepted", "reply", v);
	if type(v) == "string" then return v; end;
	return nil;
end;

-- Offer box Cancel: no(a) of offer i, and the offer is not shown again in this visit.
function TRF_BoardOfDec(i)
	local L = TRF_HlLive();
	local st = TRF_HlStore();
	local e = nil;
	if st and type(st.bof) == "table" and type(i) == "number" then e = st.bof[i]; end;
	if type(e) ~= "table" then return nil; end;
	if L then
		local dl = L.bkd;
		if type(dl) ~= "string" then dl = ","; end;
		L.bkd = dl..tostring(e.k)..",";
	end;
	if e.no then TRF_HlCall(e.no, {e.a}); end;
	TRF_HlE("board_offer", "offer_index", i, "result", "declined");
	return nil;
end;

-- Loader callbacks and dump ----------------------------------------------------------

-- Open help watches end unpaid (the trader stays behind; the handle table is cleared with the jump or load).
function TRF_HlHelpDrop(why)
	local W = TRF_HlHw();
	if not W then return; end;
	local ids = {};
	for id, w in W do tinsert(ids, id); end;
	for i = 1, getn(ids) do TRF_HlHelpSettle(ids[i], nil, why); end;
end;

function TRF_Hail_BeforeJump()
	TRF_CtVoid("jump");
	TRF_HlHelpDrop("jump");
	local L = TRF_HlLive();
	if L then L.hl = nil; L.bkd = nil; end;
end;

-- After a load the help watches are gone (handle table): an accepted offer without a live raid record is settled
-- unpaid (r.hlp 3); one on a live raid stays with trf_raid's raid end.
function TRF_Hail_OnLoad()
	TRF_CtVoid("load");
	local L = TRF_HlLive();
	if L then L.hl = nil; L.bkd = nil; end;
	if not L or type(L.tr) ~= "table" then return; end;
	for id, r in L.tr do
		if type(r) == "table" and r.hlp == 2 then
			local rd = nil;
			if type(r.rdn) == "number" and type(L.rd) == "table" then rd = L.rd[r.rdn]; end;
			if type(rd) ~= "table" or rd.st == "end" then
				r.hlp = 3;
				TRF_HlE("help", "trader_id", id, "via", "watch", "result", "unpaid", "reason", "load");
			end;
		end;
	end;
end;

function TRF_Hail_Dump()
	local L = TRF_HlLive() or {};
	local hl, ct, nopt = {}, {}, nil;
	if type(L.hl) == "table" then hl = L.hl; nopt = getn(L.hl.o or {}); end;
	if type(L.ct) == "table" then ct = L.ct; end;
	local b = 0;
	if type(L.board) == "string" then b = 1; end;
	local st = TRF_HlStore();
	local nx, nb, nw = 0, 0, 0;
	if st then
		if type(st.x) == "table" then for k, v in st.x do nx = nx + 1; end; end;
		if type(st.bof) == "table" then nb = getn(st.bof); end;
	end;
	local W = TRF_HlHw();
	if W then for k, v in W do nw = nw + 1; end; end;
	TRF_HlE("dump", "hail_trader_id", hl.id, "hail_step", hl.k, "hail_option_count", nopt, "hail_wait", hl.w,
		"contract_trader_id", ct.id, "contract_pay", ct.n, "board", TRF_KvB(b), "v1_option_count", nx,
		"board_offer_count", nb, "board_declined", L.bkd, "help_watch_count", nw,
		"wrapped", TRF_KvB(TRF_HailIsMine(__PatrolStationDock_Ok)));
end;

-- Strings (6.2). Looked up by TRF_Txt after TRF_UI_Text; keys in TRF_UI_Key form (lowercase, letters and
-- digits). Raid lines (sos, demand, comply, flee, thanks) are in trf_raid's TRF_Raid_Text.
function TRF_Hail_Text()
	return {
		open = "FTU $1, open for trade",                -- name
		rem1 = "Slow trade around here.",
		rem2 = "Business is picking up.",
		rem3 = "Best market in the sector.",
		hailq = "$1: $2?",                              -- who, option
		opttrade = "Trade",
		opthead = "Where are you headed",
		optnews = "Any news",
		optesc = "Need an escort",
		opttrouble = "Where is traffic in trouble",
		optboom = "Where is trade booming",
		refuse = "FTU $1: We have nothing to say to the Wolves. Keep your distance.",
		headed = "$1. $2",                              -- direction, rumour
		rdis = "Raids on the lane to $1.",
		rshort = "The station in $1 pays well for $2.",
		rpro = "Good trade in $1.",
		rsweep = "$1 fleet gathering near $2.",         -- faction, home
		rnone = "Lanes are quiet, captain.",
		trhead = "Raids reported: $1",
		trnone = "Lanes are quiet within three jumps.",
		tritem = "$1 ($2)",                             -- system, word
		sev1 = "light",
		sev2 = "some",
		sev3 = "heavy",
		sev4 = "severe",
		sev5 = "carrier",
		bmhead = "Trade is good in: $1",
		bmnone = "No busy lanes within three jumps.",
		bm1 = "busy",
		bm2 = "booming",
		ctoffer = "Escort us to $1 for $2 cr?",         -- destination, pay
		ctok = "Stay close, Wolves.",
		ctpaid = "Safe arrival. $1 cr transferred.",
		ctfar = "We made it, but you were not with us. No pay.",
		ctlost = "Contract lost: FTU $1 destroyed.",
		brdhead = "Patrol report",
		brdline = "$1: $2",
		-- v1 (v1-spec 5.2, 6.2, 6.3, 7.4, 8.4, 9.2)
		optdemand = "Drop some of your cargo",
		optsweep = "Any work against the pirates",
		sevbase = "$1, pirate base",                    -- severity word
		rgather = "Pirates are gathering in $1.",       -- system
		rbase = "Pirates have a base in $1.",           -- system
		rcar = "$1 carriers raid as far as $2.",        -- clan, system
		rsalv = "Pirates seen flying $1 $2 near $3.",   -- faction, rsalvf / rsalvc, system
		rsalvf = "fighters",
		rsalvc = "navy corvettes",
		rfeq = "$1 equipment convoy due in $2 soon.",   -- faction, system
		bmfeq = "$1 equipment convoy due in $2",        -- faction, system
		optfeqinfo = "Who are you",
		-- hail dialog (hail_box 2): text after "FTU <name>: "
		dlghead = "What do you need, Wolves?",
		dlgrefuse = "We have nothing to say to the Wolves. Keep your distance.",
		-- demand result page (design/demand-page-spec.md)
		dmpleave = "Leave",
		dmpnowit = "No witnesses",
		dmpq = "No witnesses? OK: no witnesses. Cancel: leave.",
		-- stage B page labels and the combat hail (design/hail-spec.md 7)
		hlpback = "Back",
		hlpclose = "Close",
		hlpacc = "Accept",
		hlpdec = "Decline",
		hlpbusy = "FTU $1: Not now, we're busy.",                                          -- name
		hlpoffer = "FTU $1: We're outgunned. Clear them off and there's $2 cr in it for you.", -- name, pay
		hlpno = "FTU $1: Then stay out of the line of fire.",                              -- name
		hlpok = "FTU $1: Deal. Make it quick, Wolves.",                                     -- name
		hlppaid = "FTU $1: They're gone. $2 cr transferred.",                              -- name, credits
		hlpnofire = "FTU $1: They broke off before we scored a kill. No pay.",                -- name
		hlptime = "FTU $1: That took too long. The offer is off.",                        -- name
		hlpfar = "FTU $1: You never closed with them. No pay.",                           -- name
		hlplost = "FTU $1 is gone. No pay.",                                              -- name
	};
end;
