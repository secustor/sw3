-- sw3-traffic generator module (v0.1 spec 2, 4, 5, 6, 10.2). Lua 4.0.1.
-- Wraps the vanilla random-contact generator action (trigger_generator_Action, include/RandomContacts.script)
-- and Case_Eject with thunks reinstalled on every MapInitialization run. Declined ticks run the vanilla
-- original; the mod path builds a traffic trader with the vanilla builder primitives (NewAllFlight,
-- FillCargoFlight copy), routes it (paths A/B/C), docks by removal, exits through a portal, and the
-- manager step handles lifetime, watchdog, station loss and wind-down. Load pass and orphan scan in
-- TRF_Gen_OnLoad. Top level only defines functions. Plain data in TRF.live, handles in TRF_H() only.
-- Needs trf_state and trf_safety (TRF_GenReady checks their functions); trf_ui and trf_events are optional.
-- v0.2 (v02 spec 9.1-9.5): band spawn factor, tiers through trf_tier (TRF_TierPlan, TRF_BuildTier,
-- TRF_FillHold; without trf_tier every spawn is the v0.1 TT1 path), hold mirror, hp0, docking queue
-- (TRF_Q_*), entry plan and arrival seed, visit credits, gone-record strip. Calls into trf_raid, trf_hail,
-- trf_shop and trf_region go through TRF_GnX, so a missing module only disables its part.
-- v1 (v1 spec 8.5, 8.6, 10.2): supply roll and danger convoys in TRF_GenTrader, builder hook p.bld and
-- group slot p.k in TRF_Spawn, forced-portal plans (TRF_Plan fx), the 8.6 entry precedence with the v1
-- providers, track / convoy-slot / danger hooks in TRF_OnExit, TRF_Remove and the watchdog, TRF_QPoints,
-- v1 wind-downs and escort deletes on a jump. Every v1 call is guarded: without the v1 files the draws
-- and orders are the v0.2 ones.

-- Helpers --------------------------------------------------------------------------

function TRF_GnL(s)
	TRF_L("gen: "..tostring(s));
end;

-- Debug line (cfg log 2).
function TRF_GnD(s)
	local v = TRF_GnOpt("log", 1);
	if type(v) == "number" and v >= 2 then TRF_L("gen: "..tostring(s)); end;
end;

-- Error handler for protected mod calls: the message goes to the mod log, not ScriptErrors.log.
function TRF_GnErr(m)
	TRF_L("gen: ERROR "..tostring(m));
	if type(TRF) == "table" and type(TRF.live) == "table" and type(TRF.live.stat) == "table" then
		TRF.live.stat.err_gen = (TRF.live.stat.err_gen or 0) + 1;
	end;
end;

-- Protected call; nil on error.
function TRF_GnP(f, args)
	return call(f, args, "x", TRF_GnErr);
end;

function TRF_GnOpt(key, def)
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil then v = TRF_Cfg()[key]; end;
	if v == nil then v = def; end;
	return v;
end;

-- Tune constants (trf_state TRF_Tune merges cfg tune); defaults when trf_state is missing.
function TRF_GnT()
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" then return t; end;
	end;
	return {spacing=20, T_dock=20, lifetime=720, ovd=600, wd_move=20, wd_t=60, step=10, dis_k=0.12,
		info_r=200, np_max=300, np_r=30, dock_to=90, p_max=0.95};
end;

-- v0.2 tune key: TRF_Tune, else trf_tier's TRF_Tier_TuneDef, else def.
function TRF_GnTv(key, def)
	local t = TRF_GnT();
	if type(t[key]) == "number" then return t[key]; end;
	if type(TRF_Tier_TuneDef) == "function" then
		local d = TRF_Tier_TuneDef()[key];
		if type(d) == "number" then return d; end;
	end;
	return def;
end;

-- Protected call of a global function by name when it exists (other v0.2 modules, optional natives).
function TRF_GnX(name, ...)
	local f = getglobal(name);
	if type(f) ~= "function" then return nil; end;
	return call(f, arg, "x", TRF_GnErr);
end;

function TRF_GnHeat()
	if type(TRF) == "table" and type(TRF.std) == "table" and type(TRF.std.heat) == "number" then return TRF.std.heat; end;
	return 0;
end;

-- Strict gate (v02 8.3): 1 or nil. Without TRF_StrictOk every system is denied while a mission runs.
function TRF_GnGate(idx, f)
	if type(TRF_StrictOk) == "function" then
		if TRF_GnX("TRF_StrictOk", idx, f) then return 1; end;
		return nil;
	end;
	if TRF_GnX("GetPlayerQuestState") == TRUE then return nil; end;
	return 1;
end;

-- Spawn factor of the band (v02 9.1); 1 without trf_tier, at band 0 or when the band gate fails.
function TRF_GnBandSf(idx)
	if type(TRF_BandCaps) ~= "function" or type(idx) ~= "number" then return 1; end;
	local c = TRF_GnX("TRF_BandCaps", idx);
	if type(c) ~= "table" or type(c.sf) ~= "number" or c.sf == 1 then return 1; end;
	if not TRF_GnGate(idx, "band") then return 1; end;
	return c.sf;
end;

-- System mode without the van_<reason> counters (trf_safety TRF_SysModeQuiet), else TRF_SysMode.
function TRF_GnModeQ()
	if type(TRF_SysModeQuiet) == "function" then return TRF_SysModeQuiet(); end;
	return TRF_SysMode();
end;

-- Effective danger (v02 5.1): trf_region TRF_DangerEff, else the map dg, else 0.
function TRF_GnDangerEff(idx)
	local v = TRF_GnX("TRF_DangerEff", idx);
	if type(v) == "number" then return v; end;
	local m = TRF_N("TRF_Map");
	if type(m) == "table" and type(idx) == "number" and type(m.sys[idx]) == "table" and type(m.sys[idx].dg) == "number" then
		return m.sys[idx].dg;
	end;
	return 0;
end;

function TRF_GnStat(k)
	if type(TRF_Stat) == "function" then TRF_Stat(k); return; end;
	local L = TRF_GnLive();
	if L then L.stat[k] = (L.stat[k] or 0) + 1; end;
end;

function TRF_GnGt()
	if type(TRF) ~= "table" or type(TRF.clock) ~= "table" then return 0; end;
	if type(TRF.clock.gt) == "number" then return TRF.clock.gt; end;
	if type(TRF.clock.game) == "number" then return TRF.clock.game; end;
	return 0;
end;

-- RAND as the game defines it (0..n-1).
function TRF_GnRand(n)
	if type(RAND) ~= "function" or type(n) ~= "number" or n < 1 then return 0; end;
	return RAND(n);
end;

-- Visit table with the sub-tables this module writes, or nil.
function TRF_GnLive()
	if type(TRF) ~= "table" or type(TRF.live) ~= "table" then return nil; end;
	local L = TRF.live;
	if type(L.tr) ~= "table" then L.tr = {}; end;
	if type(L.grp) ~= "table" then L.grp = {0, 0, 0, 0}; end;
	if type(L.port) ~= "table" then L.port = {}; end;
	if type(L.stat) ~= "table" then L.stat = {}; end;
	if type(L.cv) ~= "table" then L.cv = {}; end;
	return L;
end;

-- Handle table with its sub-tables, or nil.
function TRF_GnH()
	if type(TRF_H) ~= "function" then return nil; end;
	local H = TRF_H();
	if type(H) ~= "table" then return nil; end;
	if type(H.tr) ~= "table" then H.tr = {}; end;
	if type(H.grp) ~= "table" then H.grp = {}; end;
	if type(H.resp) ~= "table" then H.resp = {}; end;
	if type(H.van) ~= "table" then H.van = {}; end;
	return H;
end;

-- 1 for a live engine object (userdata in the game, table in the host harness).
function TRF_GnAlive(o)
	if o == nil or type(o) == "number" or type(o) == "string" or type(o) == "function" then return nil; end;
	return TRF_Is(o:IsAlive());
end;

function TRF_GnPos(o)
	if TRF_GnAlive(o) then return o:GetPosition(); end;
	return nil;
end;

-- Distance of two positions with x, y, z fields (Vector3 or plain table), or nil.
function TRF_GnDist(a, b)
	if a == nil or b == nil or type(a.x) ~= "number" or type(b.x) ~= "number" then return nil; end;
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z;
	return sqrt(dx * dx + dy * dy + dz * dz);
end;

-- Player mothership (cached in H.ms).
function TRF_GnMs()
	local H = TRF_GnH();
	if H and TRF_GnAlive(H.ms) then return H.ms; end;
	local m = TRF_Ms();
	if H then H.ms = m; end;
	return m;
end;

-- First live ship of trader id (its flight leader in convoy order).
function TRF_GnLead(id)
	local H = TRF_GnH();
	if not H or type(H.tr[id]) ~= "table" or type(H.tr[id].sh) ~= "table" then return nil; end;
	local sh = H.tr[id].sh;
	for i = 1, getn(sh) do
		if TRF_GnAlive(sh[i]) then return sh[i]; end;
	end;
	return nil;
end;

function TRF_GnTrig(kind, cb, a, b, c)
	if type(NewTrigger) ~= "function" then return nil; end;
	return NewTrigger(kind, nil, cb, a, b, c);
end;

-- Callback string with the current gen: TRF_GnCb("TRF_OnArrive", 17, 0) -> "TRF_OnArrive(17,0,4)--".
function TRF_GnCb(name, id, how)
	if how then return name.."("..id..","..how..","..TRF.gen..")--"; end;
	return name.."("..id..","..TRF.gen..")--";
end;

-- Map entry and idx of the current system, or nil.
function TRF_GnSys()
	local m = TRF_N("TRF_Map");
	local idx = TRF_N("TRF_CurIdx");
	if type(m) ~= "table" or type(idx) ~= "number" or type(m.sys[idx]) ~= "table" then return nil, nil; end;
	return m.sys[idx], idx;
end;

function TRF_GnSysIdx(name)
	local m = TRF_N("TRF_Map");
	if type(m) ~= "table" or type(name) ~= "string" then return -1; end;
	return m.by[strlower(name)] or -1;
end;

function TRF_GnDis(idx)
	if type(TRF_Dis) == "function" and type(idx) == "number" then return TRF_Dis(idx); end;
	return 0;
end;

-- Map portal (within 25 units) of the current system at position p, or nil.
function TRF_GnMatch(sy, p)
	if type(sy) ~= "table" or type(sy.portals) ~= "table" or p == nil then return nil; end;
	local best, bd = nil, 25;
	for i = 1, getn(sy.portals) do
		local q = sy.portals[i];
		local d = TRF_GnDist(p, q);
		if d and d <= bd then best = q; bd = d; end;
	end;
	return best;
end;

-- Portal object of a map portal name: label "PORTAL L", label "PORTAL_L", then the global.
function TRF_GnPortalObj(name)
	if type(name) ~= "string" then return nil; end;
	local o = TRF_N("GetObjectByLabel", gsub(name, "_", " "));
	if not o then o = TRF_N("GetObjectByLabel", name); end;
	if not o then
		o = getglobal(name);
		if type(o) == "number" or type(o) == "string" or type(o) == "function" then o = nil; end;
	end;
	return o;
end;

function TRF_GnContacts()
	local l = __sys_LevelRegisteredContacts;
	if type(l) ~= "table" then return {}; end;
	return l;
end;

function TRF_GnIsTrader(c)
	local tf = TRADER_FLIGHT;
	if type(tf) ~= "string" then tf = "R_CreateTraderFlight"; end;
	return type(c) == "table" and c[1] == tf;
end;

-- Install (spec 2.2) -----------------------------------------------------------------

-- Chunk name of a function, "" when unknown (no debug library or no source).
function TRF_GnSrc(f)
	if type(getinfo) ~= "function" or type(f) ~= "function" then return ""; end;
	local i = getinfo(f, "S");
	if type(i) == "table" and type(i.source) == "string" then return i.source; end;
	return "";
end;

-- 1 when f is one of this module's thunks: identity with the thunk of an earlier run (kept as an upvalue
-- of TRF_GenThunkGA/CE, not as a global, so AttachAction's global-name lookup still finds only the
-- vanilla name), or a chunk name under Mods/Traffic.
-- CHECK: the chunk name ExecuteScriptFile gives lua_dobuffer is unknown; the install line logs it.
function TRF_IsMine(f)
	if type(f) ~= "function" then return nil; end;
	if type(TRF_GenThunkGA) == "function" and f == TRF_GenThunkGA() then return 1; end;
	if type(TRF_GenThunkCE) == "function" and f == TRF_GenThunkCE() then return 1; end;
	local s = strlower(TRF_GnSrc(f));
	if strfind(s, "mods/traffic", 1, 1) or strfind(s, "mods\\traffic", 1, 1) then return 1; end;
	return nil;
end;

-- Called from TRF_Main on every MapInitialization run. The vanilla includes have just redefined both
-- functions, so the originals saved here are this run's. TRF_orig_* are function globals: they survive
-- ClearGlobals and are never saved. Returns {ga, ce} = 1 when wrapped in this run.
function TRF_InstallGen()
	local w = {ga=0, ce=0};
	local src = TRF_GnSrc(trigger_generator_Action);
	if type(trigger_generator_Action) == "function" and not TRF_IsMine(trigger_generator_Action) then
		TRF_orig_GenAction = trigger_generator_Action;
		local ga = function()
			if type(TRF_GenAction) == "function" then return TRF_GenAction(); end;
			if type(TRF_orig_GenAction) == "function" then return TRF_orig_GenAction(); end;
		end;
		trigger_generator_Action = ga;
		TRF_GenThunkGA = function() return %ga; end;
		w.ga = 1;
	end;
	if type(Case_Eject) == "function" and not TRF_IsMine(Case_Eject) then
		TRF_orig_Case_Eject = Case_Eject;
		local ce = function(p)
			if type(TRF_CaseEject) == "function" then return TRF_CaseEject(p); end;
			if type(TRF_orig_Case_Eject) == "function" then return TRF_orig_Case_Eject(p); end;
			return 2;
		end;
		Case_Eject = ce;
		TRF_GenThunkCE = function() return %ce; end;
		w.ce = 1;
	end;
	TRF_GnL("install generator="..w.ga.." case_eject="..w.ce.." src="..src
		.." mine="..tostring(TRF_IsMine(trigger_generator_Action)).."/"..tostring(TRF_IsMine(Case_Eject)));
	return w;
end;

-- Name of the computed workflow task; same as TRF_InstallGen.
function TRF_Gen_Install()
	return TRF_InstallGen();
end;

-- Decision (spec 2.3) ----------------------------------------------------------------

-- 1 when the mod may act on this generator tick: TRF and the visit table of this gen, cfg enabled,
-- the original saved, and the trf_state / trf_safety functions present.
function TRF_GenReady()
	if type(TRF) ~= "table" or not TRF.active or type(TRF.live) ~= "table" then return nil; end;
	if type(TRF_LiveOk) == "function" and not TRF_LiveOk() then return nil; end;
	if type(TRF_orig_GenAction) ~= "function" then return nil; end;
	local need = {"TRF_H", "TRF_Opt", "TRF_Tune", "TRF_Rec", "TRF_Due", "TRF_NewId", "TRF_Row", "TRF_Map",
		"TRF_CurIdx", "TRF_SysMode", "TRF_CanSpawn"};
	for i = 1, getn(need) do
		if type(getglobal(need[i])) ~= "function" then return nil; end;
	end;
	if TRF_Opt("enabled") == 0 then return nil; end;
	return 1;
end;

function TRF_GenRearm()
	local t = GetTriggerContext();
	local iv = _sys_RandomContactsInterval;
	if type(iv) ~= "number" then iv = 100; end;
	if t then
		t:SetTime(iv);
		t:Activate();
	end;
end;

-- Runs the vanilla original with the contact table reduced to c: it re-arms, re-checks __disableAction,
-- picks c (RAND(1)), rolls c[5] and runs every vanilla step. Errors reach _ERRORMESSAGE as in vanilla.
-- override 2: a vanilla trader that was built is kept in H.van for the M11 count (5.4).
function TRF_GenVanillaOne(c, ci)
	local s = __sys_LevelRegisteredContacts;
	local f0 = __formation_number;
	__sys_LevelRegisteredContacts = {c};
	call(TRF_orig_GenAction, {}, "x");
	__sys_LevelRegisteredContacts = s;
	if TRF_GnOpt("override", 1) == 2 and TRF_GnIsTrader(c) and type(f0) == "number"
		and type(__formation_number) == "number" and __formation_number > f0 then
		local f = getglobal("flight_randomformation_"..(__formation_number - 1));
		local H = TRF_GnH();
		if H and f and type(f) ~= "number" then
			tinsert(H.van, f);
			TRF_GnStat("van_spawn");
		end;
	end;
end;

-- Returns nil (untouched original), {how="one", c, ci} (vanilla for this contact) or {how="mod", c, ci}.
function TRF_GnDecide()
	if not TRF_GenReady() or __disableAction == TRUE then return nil; end;
	local ov = TRF_Opt("override");
	if ov == 0 then return nil; end;
	local list = __sys_LevelRegisteredContacts;
	if type(list) ~= "table" or getn(list) < 1 then return nil; end;
	local mode = TRF_SysMode();
	if mode ~= "mod" and ov ~= 2 then return nil; end;
	-- Same draw as GetRandomContact (RandomContacts.script 136-142).
	local ci = TRF_GnRand(getn(list)) + 1;
	local c = list[ci];
	if type(c) ~= "table" then return nil; end;
	if mode ~= "mod" or not TRF_GnIsTrader(c) then return {how="one", c=c, ci=ci}; end;
	if not TRF_GnValidate() then return {how="one", c=c, ci=ci}; end;
	return {how="mod", c=c, ci=ci};
end;

-- Thunk target. The decision runs protected: an error there falls back to the untouched original.
function TRF_GenAction()
	local d = TRF_GnP(TRF_GnDecide, {});
	if type(d) ~= "table" then return TRF_orig_GenAction(); end;
	if d.how == "one" then return TRF_GenVanillaOne(d.c, d.ci); end;
	TRF_GenRearm();
	TRF_GnP(TRF_GenTrader, {d.c, d.ci});
end;

-- Contact validation (spec 4.2) --------------------------------------------------------

-- Checks every trader contact once per visit; caches portal names and destinations in live.cv[ci].
-- Failure sets live.inval (TRF_SysMode then returns "vanilla" for the visit, M13). Returns 1 if valid.
function TRF_GnValidate()
	local L = TRF_GnLive();
	if not L then return nil; end;
	if L.inval then return nil; end;
	if L.vd == 1 then return 1; end;
	local why = TRF_GnP(TRF_GnValidateAll, {});
	L.vd = 1;
	if why ~= "ok" then
		L.inval = tostring(why or "error");
		TRF_GnStat("van_inval");
		TRF_GnL("contacts invalid ("..L.inval.."): vanilla for this visit");
		return nil;
	end;
	return 1;
end;

-- "ok" or the reason of the first failure.
function TRF_GnValidateAll()
	local L = TRF_GnLive();
	local sy = TRF_GnSys();
	if not sy then return "nomap"; end;
	local list = TRF_GnContacts();
	local n = 0;
	for ci = 1, getn(list) do
		local c = list[ci];
		if TRF_GnIsTrader(c) then
			if type(c[3]) ~= "table" or getn(c[3]) < 1 then return "portals ci="..ci; end;
			if type(c[4]) ~= "table" or getn(c[4]) < 1 then return "navpoints ci="..ci; end;
			local cv = {pn={}, pt={}};
			for i = 1, getn(c[3]) do
				local p = c[3][i];
				if p == nil or type(p) == "number" or type(p) == "string" then return "portal "..i.." ci="..ci; end;
				local e = p:GetEntryPoint(10);
				if e == nil or type(e.x) ~= "number" then return "entry "..i.." ci="..ci; end;
				local q = TRF_GnMatch(sy, p:GetPosition());
				if not q then return "nomatch "..i.." ci="..ci; end;
				cv.pn[i] = q.name;
				cv.pt[i] = TRF_GnSysIdx(q.to);
			end;
			L.cv[ci] = cv;
			n = n + 1;
		end;
	end;
	TRF_GnD("contacts valid traders="..n);
	return "ok";
end;

-- Station, approach point, portals (spec 4.2-4.4) ---------------------------------------

-- Usable trade station handle or nil (trf_safety TRF_Station: map st label, IsAlive, loss for the visit).
function TRF_GnStation()
	if type(TRF_Station) ~= "function" then return nil; end;
	local s = TRF_Station();
	if TRF_GnAlive(s) then return s; end;
	return nil;
end;

-- Registered nav point of contact c nearest the station, within np_max (R6), or nil.
function TRF_GnApproach(c, st, T)
	local sp = TRF_GnPos(st);
	if not sp or type(c[4]) ~= "table" then return nil; end;
	local best, bd = nil, T.np_max;
	for i = 1, getn(c[4]) do
		local d = TRF_GnDist(c[4][i], sp);
		if d and d <= bd then best = c[4][i]; bd = d; end;
	end;
	return best;
end;

-- Vanilla GetRandomPortalIndexes (RandomContacts.script 118-134): {start, end}, end ~= start for 2+.
function TRF_GnPortalIdx(n)
	if n <= 1 then return {1, 1}; end;
	local a = TRF_GnRand(n) + 1;
	local b = a;
	while b == a do b = TRF_GnRand(n) + 1; end;
	return {b, a};
end;

-- Vanilla GetRandomWayPointList (145-167): getn(list) draws with repetition.
function TRF_GnWay(list)
	local r = {};
	if type(list) ~= "table" then return r; end;
	local n = getn(list);
	for i = 1, n do r[i] = list[TRF_GnRand(n) + 1]; end;
	return r;
end;

-- Carcass count in the 20-unit spot sphere at pos, or nil. The native counts every BaseCarcass (ships,
-- stations, portals, wrecks, rockets) whose bounding sphere touches the query sphere, with no type or HP
-- filter (design/mod-research/carcass-count.md), so a portal or station next to the spot is counted.
function TRF_GnCount(pos)
	if pos == nil or type(pos.x) ~= "number" then return nil; end;
	return TRF_N("GetCarcassCountInSphere", pos, 20);
end;

-- Baseline count of spot key at pos for this visit (R12): the first count n seen there is stored in
-- live.base[key] as {x, y, z, n} (one entry per position: "station" serves the approach point of each
-- contact) and returned from then on. Ships standing at the spot when it is taken count as scenery for the
-- visit. nil while no count is known.
function TRF_GnBase(key, pos, n)
	local L = TRF_GnLive();
	if type(L.base) ~= "table" then L.base = {}; end;
	local k = tostring(key);
	local l = L.base[k];
	if type(l) ~= "table" then l = {}; L.base[k] = l; end;
	for i = 1, getn(l) do
		local d = TRF_GnDist(l[i], pos);
		if d and d < 1 and type(l[i].n) == "number" then return l[i].n; end;
	end;
	if type(n) ~= "number" or pos == nil or type(pos.x) ~= "number" then return nil; end;
	tinsert(l, {x=pos.x, y=pos.y, z=pos.z, n=n});
	TRF_GnD("spot "..k.." base="..n);
	return n;
end;

-- Baselines at every trader portal entry point and station approach point, from TRF_Gen_OnActivate
-- before this visit's mod spawns (later spots are taken on first use in TRF_GnFree).
function TRF_GnBaseAll()
	local L = TRF_GnLive();
	if not L or not TRF_GenReady() or TRF_GnModeQ() ~= "mod" or not TRF_GnValidate() then return; end;
	local T = TRF_GnT();
	local st = TRF_GnStation();
	local list = TRF_GnContacts();
	for ci = 1, getn(list) do
		local c, cv = list[ci], L.cv[ci];
		if TRF_GnIsTrader(c) and type(cv) == "table" then
			for i = 1, getn(c[3]) do
				local e = c[3][i]:GetEntryPoint(10);
				TRF_GnBase(cv.pn[i], e, TRF_GnCount(e));
			end;
			local np = nil;
			if st then np = TRF_GnApproach(c, st, T); end;
			if np then TRF_GnBase("station", np, TRF_GnCount(np)); end;
		end;
	end;
end;

-- Spawn spot free (R12): no arrival at key within spacing, and the carcass count at pos not above the
-- spot's baseline (TRF_GnBase), so the portal or station that is always in the sphere never blocks it.
-- A nil count counts as free. A refusal is logged once per key per minute (live.bzt).
function TRF_GnFree(key, pos, T)
	local L = TRF_GnLive();
	local t = L.port[key];
	local gt = TRF_GnGt();
	if type(t) == "number" and gt - t < T.spacing then return nil; end;
	local n = TRF_GnCount(pos);
	local b = TRF_GnBase(key, pos, n);
	TRF_GnD("spot "..tostring(key).." count="..tostring(n).." base="..tostring(b));
	if type(n) == "number" and type(b) == "number" and n > b then
		if type(L.bzt) ~= "table" then L.bzt = {}; end;
		local k = tostring(key);
		local lt = L.bzt[k];
		if type(lt) ~= "number" or gt - lt >= 60 then
			L.bzt[k] = gt;
			TRF_GnL("spot "..k.." busy n="..n.." base="..b);
		end;
		return nil;
	end;
	return 1;
end;

-- Nearest registered portal to position p: portals of the trader's contact, else of any trader contact,
-- else the map portals of the system. Returns portal, map name.
function TRF_GnNearPortal(ci, p)
	local L = TRF_GnLive();
	local cand = {};
	local list = TRF_GnContacts();
	local add = function(c, ci2)
		local cv = %L.cv[ci2];
		if type(c) == "table" and type(c[3]) == "table" then
			for i = 1, getn(c[3]) do
				local nm = nil;
				if type(cv) == "table" then nm = cv.pn[i]; end;
				tinsert(%cand, {o=c[3][i], n=nm});
			end;
		end;
	end;
	if type(ci) == "number" and TRF_GnIsTrader(list[ci]) then add(list[ci], ci); end;
	if getn(cand) == 0 then
		for i = 1, getn(list) do
			if TRF_GnIsTrader(list[i]) then add(list[i], i); end;
		end;
	end;
	if getn(cand) == 0 then
		local sy = TRF_GnSys();
		if sy then
			for i = 1, getn(sy.portals) do
				local o = TRF_GnPortalObj(sy.portals[i].name);
				if o then tinsert(cand, {o=o, n=sy.portals[i].name}); end;
			end;
		end;
	end;
	local best, bn, bd = nil, nil, nil;
	for i = 1, getn(cand) do
		local o = cand[i].o;
		if o and type(o) ~= "number" and type(o) ~= "string" then
			local d = TRF_GnDist(o:GetPosition(), p);
			if not best or (d and (not bd or d < bd)) then best = o; bn = cand[i].n; bd = d; end;
		end;
	end;
	return best, bn;
end;

-- Plan and roll (spec 4.3-4.5, 5.1, 7.2) ----------------------------------------------

-- Fallback row when TRF_Row returns no table (trf_state shape: {row, tp, esc, fam, cheap, p2}).
function TRF_GnRow(strength)
	local r = TRF_Row(strength);
	if type(r) == "table" and type(r.tp) == "number" and type(r.esc) == "number" then return r; end;
	return {row=1, tp=1, esc=1, fam=1, cheap="Hatchet_merc1", p2=2};
end;

-- Mod path of one generator tick: p_eff roll, gates, plan, spawn.
function TRF_GenTrader(c, ci)
	local T = TRF_GnT();
	local cur = TRF_CurIdx();
	local fd = 1;
	if TRF_GnOpt("dis", 1) ~= 0 then fd = max(0, 1 - T.dis_k * TRF_GnDis(cur)); end;
	local sc = TRF_GnOpt("spawn_scale", 1);
	if type(sc) ~= "number" then sc = 1; end;
	sc = max(0, min(1.5, sc));
	local pr = c[5];
	if type(pr) ~= "number" then pr = 100; end;
	-- Band spawn factor (v02 9.1); 1 at band 0, so the pro 0-2 roll is the v0.1 one.
	local p = min(T.p_max, pr / 100 * sc * fd * TRF_GnBandSf(cur));
	local roll = TRF_GnRand(10000);
	if not (roll < p * 10000) then
		TRF_GnStat("skip_roll");
		TRF_GnD("roll ci="..tostring(ci).." p="..TRF_F(p).." roll="..roll.." -> no");
		return nil;
	end;
	-- why: the reason on refusal, else the free ships (the v02 9.2 tier fit test).
	local ok, why = TRF_CanSpawn(0, "trader");
	if not ok then TRF_GnStat("skip_"..tostring(why)); return nil; end;
	local plan, pw = TRF_Plan(c, ci, nil, why);
	if not plan then TRF_GnStat("skip_"..tostring(pw)); TRF_GnD("plan ci="..tostring(ci).." -> "..tostring(pw)); return nil; end;
	-- v1 convoy forms in rank order (8.6): TT4 came from the tier pick, then supply (5.1), then danger (8.5).
	-- A failed supply build spawns the plain trader (5.1 fallback). TRF_DcPlan leaves plan.dcp: "none" =
	-- nothing spawns this tick (chance / N), "convoy", "single"; unset (error) = single.
	local sup = nil;
	if (plan.tier or 1) < 4 and type(TRF_SupplyRoll) == "function" and TRF_GnX("TRF_SupplyRoll", plan) == 1 then
		sup = 1;
		local sid = TRF_GnX("TRF_SupplySpawn", plan);
		if sid then return sid; end;
		TRF_GnStat("skip_supply_build");
	end;
	if not sup and type(TRF_DcPlan) == "function" then
		plan.dcp = nil;
		TRF_GnX("TRF_DcPlan", plan);
		if plan.dcp == "none" then TRF_GnStat("skip_dc_none"); return nil; end;
		if plan.dcp == "convoy" then
			local did = TRF_GnX("TRF_DcStart", plan);
			if not did then TRF_GnStat("skip_dc_start"); end;
			return did;
		end;
	end;
	local spare;
	ok, spare = TRF_CanSpawn(plan.n, "trader");
	if not ok then TRF_GnStat("skip_"..tostring(spare)); return nil; end;
	if type(spare) == "number" and plan.esc > spare then plan.esc = max(0, spare); end;
	local id = TRF_Spawn(plan);
	-- Lane raid roll (v02 5.1) after a path A or C spawn.
	if id and plan.path ~= "B" then TRF_GnX("TRF_RaidRoll", id, "lane"); end;
	return id;
end;

-- Plan for contact c: {path, ent, ext (portal handles), entn, extn (map names), pos, dir, np, st,
-- strength, row, n (base ships), esc (added), from, to (system idx, 0 = station, -1 unknown), ci}
-- plus the v02 tier fields (TRF_TierPlan: tier, pw, tpn, tesc, ne) or nil, reason.
-- force: path "B" for the arrival seed (no path draw); free: free ships for the tier fit test.
-- fx (v1 convoy members, trf_danger): si entry portal index (path C unless forced), nf no spot test,
-- off spawn point offset along the portal axis, s strength (no draw). Also sets lv (contact level).
function TRF_Plan(c, ci, force, free, fx)
	local L = TRF_GnLive();
	local T = TRF_GnT();
	if type(ci) ~= "number" then
		local list = TRF_GnContacts();
		for i = 1, getn(list) do if list[i] == c then ci = i; end; end;
	end;
	local cv = L.cv[ci];
	if type(cv) ~= "table" then return nil, "valid"; end;
	local ps = c[3];
	local n = getn(ps);
	local st = TRF_GnStation();
	local np = nil;
	if st then np = TRF_GnApproach(c, st, T); end;
	-- Path (design 6.3): A/B need a usable station and an approach point.
	local path = "C";
	if force then
		if not st or not np then return nil, "seed_station"; end;
		path = force;
	elseif fx and fx.si then
		path = "C";
	elseif st and np then
		local r = TRF_GnRand(100);
		if n >= 2 then
			if r < 40 then path = "A"; elseif r < 70 then path = "B"; end;
		else
			if r < 55 then path = "A"; else path = "B"; end;
		end;
	end;
	local ix = TRF_GnPortalIdx(n);
	local si, ei = ix[1], ix[2];
	if fx and type(fx.si) == "number" and ps[fx.si] then
		si = fx.si;
		if n >= 2 and ei == si then ei = si + 1; if ei > n then ei = 1; end; end;
	end;
	local pos, dir;
	if path == "B" then
		pos = np;
		if not TRF_GnFree("station", pos, T) then return nil, "space"; end;
		dir = Vector3(0, 0, 1);
	else
		local off = 0;
		if fx and type(fx.off) == "number" then off = fx.off; end;
		if fx and fx.si and not fx.nf and not TRF_GnFree(cv.pn[si], ps[si]:GetEntryPoint(10 + off), T) then return nil, "space"; end;
		if not (fx and fx.si) and not TRF_GnFree(cv.pn[si], ps[si]:GetEntryPoint(10), T) then
			local free = {};
			for i = 1, n do
				if i ~= si and TRF_GnFree(cv.pn[i], ps[i]:GetEntryPoint(10), T) then tinsert(free, i); end;
			end;
			if getn(free) == 0 then return nil, "space"; end;
			si = free[TRF_GnRand(getn(free)) + 1];
			if n >= 2 and ei == si then
				local o = {};
				for i = 1, n do if i ~= si then tinsert(o, i); end; end;
				ei = o[TRF_GnRand(getn(o)) + 1];
			end;
		end;
		pos = ps[si]:GetEntryPoint(10 + off);
		dir = ps[si]:GetOrientation();
	end;
	-- Strength as vanilla (RandomContacts.script 235-238): level-4 .. level+3, clamped 1..20.
	local lv = c[6];
	if type(lv) ~= "number" then lv = 1; end;
	local strength;
	if fx and type(fx.s) == "number" then strength = fx.s; else strength = lv - 4 + TRF_GnRand(8); end;
	if strength > 20 then strength = 20; end;
	if strength < 1 then strength = 1; end;
	local row = TRF_GnRow(strength);
	local p = {path=path, pos=pos, dir=dir, np=np, st=st, strength=strength, row=row, n=row.tp + row.esc, ci=ci, esc=0, lv=lv};
	local cur = TRF_CurIdx();
	if path ~= "B" then p.ent = ps[si]; p.entn = cv.pn[si]; end;
	if path ~= "A" then p.ext = ps[ei]; p.extn = cv.pn[ei]; end;
	if path == "A" then p.from = cv.pt[si]; p.to = 0;
	elseif path == "B" then p.from = 0; p.to = cv.pt[ei];
	else p.from = cv.pt[si]; p.to = cv.pt[ei]; end;
	-- Added escorts (7.2): dmax over current and destination system; at most 4 escorts in total.
	if TRF_GnOpt("dis", 1) ~= 0 then
		local dest = cur;
		if path ~= "A" and type(p.to) == "number" and p.to > 0 then dest = p.to; end;
		local dm = max(TRF_GnDis(cur), TRF_GnDis(dest));
		if dm >= 6 then p.esc = 2; elseif dm >= 3 then p.esc = 1; end;
		p.esc = max(0, min(p.esc, 4 - row.esc));
	end;
	-- Heat escort (v02 8.1, 9.3): one more cheap escort at heat >= 5.
	if TRF_GnHeat() >= 5 then p.esc = max(0, min(p.esc + 1, 4 - row.esc)); end;
	-- Tier (v02 9.2, 9.3); TRF_TierPlan sets the tier fields together, so an error before them keeps TT1.
	p.free = free;
	p.tier = 1;
	if type(TRF_TierPlan) == "function" then TRF_GnP(TRF_TierPlan, {p}); end;
	return p;
end;

-- Spawn (spec 4.5) -----------------------------------------------------------------

-- First group slot k (1..4) that no open record uses (wound-down records after a load included).
function TRF_GnSlot()
	local L = TRF_GnLive();
	local used = {};
	for id, r in L.tr do
		if type(r) == "table" and r.st ~= "gone" and type(r.k) == "number" then used[r.k] = 1; end;
	end;
	-- Escorts of a killed trader (trf_events h.kl) still fly in their group: re-seeding its relation for a
	-- new trader would make escorts that fight the player peaceful again.
	local H = TRF_GnH();
	if H then
		for id, h in H.tr do
			if type(h) == "table" and h.kl and type(h.k) == "number" and TRF_GnAlive(h.fl) then used[h.k] = 1; end;
		end;
	end;
	for k = 1, 4 do
		if not used[k] then return k; end;
	end;
	return nil;
end;

-- Group TRF_Trade_<k> (created on first use in a visit), relation re-seeded from the Trade team (R8, M6).
-- CHECK: CreateGroup on a name that already exists in the scene (after a load) returns a usable group.
function TRF_GnGroup(k)
	local H = TRF_GnH();
	local g = H.grp[k];
	if not g then
		local team = CreateTeam("Trade");
		if not team then return nil; end;
		g = team:CreateGroup("TRF_Trade_"..k);
		H.grp[k] = g;
	end;
	if g then
		-- Heat war (v02 8.1): cfg heat_war 1 seeds war toward the player at heat 7-9.
		local rel = GetTeamRelation("Trade", PLAYER_TEAM);
		if TRF_GnOpt("heat_war", 0) == 1 and TRF_GnHeat() >= 7 and type(RELATION_WAR) == "number" then rel = RELATION_WAR; end;
		SetGroupRelation(g, PLAYER_GROUP, rel);
	end;
	return g;
end;

-- Random name index not used by an open record of this visit.
function TRF_GnName()
	local L = TRF_GnLive();
	local names = {};
	if type(TRF_Names) == "function" then names = TRF_Names(); end;
	local n = getn(names);
	if n == 0 then return 0; end;
	local used = {};
	for id, r in L.tr do
		if type(r) == "table" and r.st ~= "gone" and type(r.nm) == "number" then used[r.nm] = 1; end;
	end;
	local free = {};
	for i = 1, n do if not used[i] then tinsert(free, i); end; end;
	if getn(free) == 0 then return TRF_GnRand(n) + 1; end;
	return free[TRF_GnRand(getn(free)) + 1];
end;

-- Ships that NewAllFlight left in ship_<sign>_<i> (convoy order: transports first).
function TRF_GnShips(sign)
	local r = {};
	for i = 1, 8 do
		local s = getglobal("ship_"..sign.."_"..i);
		if s == nil or type(s) == "number" then return r; end;
		r[i] = s;
	end;
	return r;
end;

-- No handle globals stay for the save (flight_/ship_/pilot_ of NewAllFlight).
function TRF_GnClearSign(sign)
	setglobal("flight_"..sign, nil);
	for i = 1, 8 do
		setglobal("ship_"..sign.."_"..i, nil);
		setglobal("pilot_"..sign.."_"..i, nil);
	end;
end;

-- One added escort j (spec 4.5 step 6): cheap carcass of the row family, rank-2 pilot as NewAllFlight
-- maps it, ROLE_ATTACK. Returns the ship or nil.
function TRF_GnEscort(fl, plan, j)
	local p = plan.pos;
	local q = Vector3(p.x, p.y, p.z + 15 * (plan.n + j));
	local s = CreateCarcass(plan.row.cheap or "Hatchet_merc1", q, plan.dir);
	if not s then return nil; end;
	s:AssignPilot(CreatePilot(Trad_merc_Pilots[plan.row.p2 or 2]));
	fl:AddShip(s);
	s:SetRole(ROLE_ATTACK);
	return s;
end;

-- Cargo class of an item (spec 4.1, provisional): 1 machinery, 2 spare parts, 3 ore, 4 fuel,
-- 5 perishables, 6 general freight.
function TRF_GnCls(item)
	local m = {Cargo_01=1, Cargo_05=1, Cargo_10=1, Cargo_06=2, Cargo_09=2, Uranium=3, Barrel_02=4,
		Cargo_04=5, Cargo_08=5, Cargo_02=6, Cargo_03=6, Cargo_07=6};
	return m[item] or 6;
end;

-- FillCargoFlight(flight, Trad_CargoType, power, 100, 6) (Create_flight_2.script 141-159), copied line
-- for line with the same RAND draws, returning the stacks {{item, count, pilot index}, ...}.
function TRF_FillCargo(fl, strength)
	local out = {};
	local CType = Trad_CargoType;
	if type(CType) ~= "table" or not fl then return out; end;
	local V = 100;
	local X = 6;
	local P = strength or 10;
	local numcargo = getn(CType);
	if (V > TRF_GnRand(100)) and (X > 0) and (numcargo > 10) then
		P = floor(P / 4);
		for i = 1, fl:GetPilotCount() do
			local _ship = fl:GetPilotByNumber(i):GetShip();
			-- Bare test as vanilla (same ships get cargo, same draws).
			if (_ship:ImBigShip()) then
				if X > 2 then
					local it = CType[TRF_GnRand(numcargo - 5) + P + 1];
					local k = TRF_GnRand(2) + 1;
					_ship:AddModuleToInventory(it, k);
					tinsert(out, {it, k, i});
				end;
				local it = CType[TRF_GnRand(numcargo - 5) + P + 1];
				local k = TRF_GnRand(X) + 1;
				_ship:AddModuleToInventory(it, k);
				tinsert(out, {it, k, i});
			end;
		end;
	end;
	return out;
end;

-- Class of the largest stack (first on a tie); 6 when nothing was loaded.
function TRF_GnHoldCls(st)
	local best, bn = 6, 0;
	if type(st) ~= "table" then return best; end;
	for i = 1, getn(st) do
		if type(st[i][2]) == "number" and st[i][2] > bn then best = TRF_GnCls(st[i][1]); bn = st[i][2]; end;
	end;
	return best;
end;

-- Delete what a failed build left behind.
function TRF_GnBuildFail(sign, sh)
	local f = getglobal("flight_"..sign);
	if TRF_GnAlive(f) then f:Delete(); end;
	for i = 1, getn(sh) do
		if TRF_GnAlive(sh[i]) then sh[i]:Delete(); end;
	end;
end;

-- Builds plan p. Returns the trader id or nil.
function TRF_Spawn(p)
	local L = TRF_GnLive();
	local H = TRF_GnH();
	local gt = TRF_GnGt();
	local id = TRF_NewId();
	if not id then TRF_GnStat("skip_id"); return nil; end;
	-- p.k: a convoy member uses the group slot of its convoy (trf_danger).
	local k = p.k or TRF_GnSlot();
	if not k then TRF_GnStat("skip_grp"); return nil; end;
	local grp = TRF_GnP(TRF_GnGroup, {k});
	if not grp then TRF_GnStat("skip_grp"); return nil; end;
	if p.ent then p.ent:Start(8, 0); end;
	local sign = "trf_"..id;
	-- NewAllFlight looks the group up by global name; the global is cleared right after (no handle in the save).
	-- TT2/TT3 (v02 9.3) build through trf_tier, which returns the ships in p.sh.
	setglobal("TRF_GTrade_"..k, grp);
	local fl;
	-- p.bld: name of a v1 builder f(p, id, k) returning the flight and setting p.sh / p.tpn (trf_danger).
	if type(p.bld) == "string" and type(getglobal(p.bld)) == "function" then
		fl = TRF_GnP(getglobal(p.bld), {p, id, k});
	elseif (p.tier or 1) >= 2 and type(TRF_BuildTier) == "function" then
		fl = TRF_GnP(TRF_BuildTier, {p, id, k});
	else
		fl = TRF_GnP(NewAllFlight, {Trad_merc_Pilots, Trad_merc_Ships, "TRF_GTrade_"..k, sign, p.pos, p.strength, p.dir, "shipFormationConvoy"});
	end;
	setglobal("TRF_GTrade_"..k, nil);
	local sh = p.sh or TRF_GnShips(sign);
	p.sh = nil;
	-- NewAllFlight returns FALSE (0, truthy) on failure; a nil carcass raises an error (nil result here).
	if not fl or type(fl) == "number" or fl == FALSE then
		TRF_GnP(TRF_GnBuildFail, {sign, sh});
		TRF_GnClearSign(sign);
		TRF_GnStat("skip_build");
		TRF_GnL("build failed id="..id.." strength="..p.strength);
		return nil;
	end;
	TRF_GnClearSign(sign);
	local tp = {};
	for i = 1, min(p.tpn or p.row.tp, getn(sh)) do tp[i] = sh[i]; end;
	local added = 0;
	for j = 1, p.esc do
		local s = TRF_GnP(TRF_GnEscort, {fl, p, j});
		if s then tinsert(sh, s); added = added + 1; end;
	end;
	-- Hold mirror (v02 3.2, 9.3): trf_tier TRF_FillHold; TT1 and the fallback are the v0.1 TRF_FillCargo draws.
	local hold, cls;
	if type(TRF_FillHold) == "function" then
		hold, cls = TRF_GnP(TRF_FillHold, {fl, p.tier or 1, p.pw or p.strength, p.path});
	else
		local st = TRF_GnP(TRF_FillCargo, {fl, p.strength});
		cls = TRF_GnHoldCls(st);
		hold = {};
		if type(st) == "table" then
			for i = 1, getn(st) do tinsert(hold, {i=st[i][1], n=st[i][2], s=st[i][3] or 1}); end;
		end;
	end;
	if type(hold) ~= "table" then hold = {}; end;
	if type(cls) ~= "number" then cls = 6; end;
	-- Leader HP at spawn (v02 5.2, 9.1). CHECK: GetCurHP on an NPC carcass returns a number (O4).
	local hp0 = TRF_GnX("GetCurHP", sh[1]);
	if type(hp0) ~= "number" then hp0 = nil; end;
	-- CHECK: labels on carcasses survive save/load (load pass and orphan scan depend on it).
	for i = 1, getn(sh) do TRF_GnP(SetObjectLabel, {sh[i], sign.."_"..i}); end;
	local lp = TRF_GnPos(sh[1]) or p.pos;
	local st = "out";
	if p.path == "A" then st = "in"; end;
	local r = {id=id, nm=TRF_GnName(), cls=cls, from=p.from, to=p.to, path=p.path, st=st,
		ci=p.ci, k=k, ent=p.entn, ext=p.extn, np=getn(sh), nt=getn(tp), esc=added, born=gt,
		lx=lp.x, ly=lp.y, lz=lp.z, lt=gt, wd=0, tier=p.tier or 1, hold=hold, hp0=hp0};
	L.tr[id] = r;
	if not p.k or L.grp[k] == 0 then L.grp[k] = id; end;
	H.tr[id] = {fl=fl, sh=sh, tp=tp, ent=p.ent, ext=p.ext, np=p.np, st=p.st, k=k};
	if p.np then H.np = p.np; end;
	TRF.seq = id;
	if p.path == "B" then L.port.station = gt; elseif p.entn then L.port[p.entn] = gt; end;
	TRF_GnStat("spawn");
	if type(TRF_ArmShips) == "function" then TRF_GnP(TRF_ArmShips, {id}); end;
	TRF_GnP(TRF_GnArmUI, {id});
	-- p.noord: the v1 caller gives the orders (danger convoy members).
	if not p.noord then TRF_GnP(TRF_Orders, {id}); end;
	-- Low-HP flee trigger; trf_raid arms the heat reaction from there too (v02 5.2, 8.1).
	TRF_GnX("TRF_RaidArmLowHP", id);
	TRF_GnL("spawn id="..id.." path="..p.path.." from="..tostring(p.from).." to="..tostring(p.to)
		.." ent="..tostring(p.entn).." ext="..tostring(p.extn).." str="..p.strength.." row="..tostring(p.row.row)
		.." ships="..r.np.."/"..r.nt.." esc+"..added.." k="..k.." nm="..r.nm.." cls="..r.cls
		.." tier="..r.tier.." hold="..getn(hold));
	return id;
end;

-- Focus, proximity and meeting triggers (spec 8.3); only when trf_ui defines the callbacks.
function TRF_GnArmUI(id)
	local H = TRF_GnH();
	local h = H.tr[id];
	local ms = TRF_GnMs();
	if TRF_GnOpt("ui", 1) ~= 0 then
		local m = TRF_GnOpt("ui_focus", 3);
		local lead = TRF_GnLead(id);
		if (m == 1 or m == 3) and lead and type(TRF_OnFocus) == "function" then
			TRF_GnTrig("focus", TRF_GnCb("TRF_OnFocus", id), lead);
		end;
		if (m == 2 or m == 3) and ms and type(TRF_OnNear) == "function" then
			TRF_GnTrig("f_object_inside", TRF_GnCb("TRF_OnNear", id), h.fl, ms, TRF_GnT().info_r);
		end;
	end;
	if TRF_GnOpt("meet", 1) ~= 0 and ms and type(TRF_OnMeet) == "function" then
		TRF_GnTrig("f_object_inside", TRF_GnCb("TRF_OnMeet", id), h.fl, ms, 70);
	end;
end;

-- Orders, arrival, docking, exit (spec 4.6) ----------------------------------------------

-- Registered nav points of the trader's contact, drawn as vanilla.
function TRF_GnNav(ci)
	local c = TRF_GnContacts()[ci];
	if type(c) ~= "table" then return {}; end;
	return TRF_GnWay(c[4]);
end;

function TRF_GnExitTrig(id)
	local H = TRF_GnH();
	local r = TRF_Rec(id);
	local h = H.tr[id];
	if not r or not h or not h.ext then return nil; end;
	r.xa = 1;
	return TRF_GnTrig("f_object_inside", TRF_GnCb("TRF_OnExit", id), h.fl, h.ext, 20);
end;

-- Route of trader id from its spawn point. Path C is the vanilla route (R1, R6).
function TRF_Orders(id)
	local H = TRF_GnH();
	local r = TRF_Rec(id);
	local h = H.tr[id];
	if not r or not h or not TRF_GnAlive(h.fl) then return nil; end;
	local T = TRF_GnT();
	if r.path == "A" then
		h.fl:Patrol({h.ent:GetEntryPoint(70), h.np}, FALSE);
		TRF_GnTrig("f_inside", TRF_GnCb("TRF_OnArrive", id, 0), h.fl, h.np, T.np_r);
		return 1;
	end;
	local pts = {};
	if r.path == "C" then pts[1] = h.ent:GetEntryPoint(70); end;
	local w = TRF_GnNav(r.ci);
	for i = 1, getn(w) do tinsert(pts, w[i]); end;
	tinsert(pts, h.ext:GetEntryPoint(50));
	tinsert(pts, h.ext:GetEntryPoint(1));
	h.fl:Patrol(pts, FALSE);
	if r.path == "B" then
		TRF_GnExitTrig(id);
	else
		-- As vanilla (RandomContacts.script 270-287): the exit volume is armed at the first patrol point,
		-- since the trader spawns at GetEntryPoint(10), inside the exit volume of a single-portal system.
		TRF_GnTrig("f_inside", TRF_GnCb("TRF_ArmExit", id), h.fl, pts[1], 5);
	end;
	return 1;
end;

-- Trigger entry point (review O1): runs TRF_ArmExit_Body protected.
function TRF_ArmExit(id, g) TRF_Cb("TRF_ArmExit", TRF_ArmExit_Body, {id, g}); end;

function TRF_ArmExit_Body(id, g)
	if g ~= TRF.gen then return; end;
	local r = TRF_Rec(id);
	if not r or r.xa == 1 then return; end;
	TRF_GnExitTrig(id);
	TRF_GnD("exit armed id="..id);
end;

-- how 0: approach point (f_inside np, np_r); 1: near the station; 2: docking position (dock_mode 1/2).
-- Trigger entry point (review O1): runs TRF_OnArrive_Body protected.
function TRF_OnArrive(id, how, g) TRF_Cb("TRF_OnArrive", TRF_OnArrive_Body, {id, how, g}); end;

function TRF_OnArrive_Body(id, how, g)
	if g ~= TRF.gen then return; end;
	local r = TRF_Rec(id);
	local H = TRF_GnH();
	if not r or not H or not H.tr[id] then return; end;
	local h = H.tr[id];
	local T = TRF_GnT();
	if how == 3 then
		-- Released from a hold point (v02 9.5): takes the docking slot, then docks as how 0 without the queue test.
		if r.st ~= "queue" then return; end;
		TRF_GnQ().dk = id;
		r.qgo = nil;
		r.st = "in";
	elseif how ~= 0 then
		if r.st ~= "dock" or r.dkd == 1 then return; end;
		r.dkd = 1;
		TRF_Due(T.T_dock, "TRF_OnDocked", id);
		TRF_GnD("docked id="..id.." how="..tostring(how));
		return;
	end;
	if r.st ~= "in" then return; end;
	if how == 0 and TRF_GnQueue(id, r, h) then return; end;
	r.st = "dock";
	local mode = TRF_GnOpt("dock_mode", 0);
	local st = h.st;
	if not TRF_GnAlive(st) then st = TRF_GnStation(); end;
	if mode == 0 or not st then
		TRF_Due(T.T_dock, "TRF_OnDocked", id);
		TRF_GnD("approach id="..id.." removal in "..T.T_dock);
		return;
	end;
	local dock = st:GetDockingPosition();
	if mode == 1 then
		-- CHECK: ComeToTradeStation on an NPC carcass (E0.3; shipped scripts use it on the mothership only).
		local lead = TRF_GnP(function(f) return f:GetLeader():GetShip(); end, {h.fl}) or TRF_GnLead(id);
		if lead then lead:ComeToTradeStation(st); end;
		TRF_GnTrig("f_object_inside", TRF_GnCb("TRF_OnArrive", id, 1), h.fl, st, 150);
	else
		h.fl:Move(dock);
	end;
	TRF_GnTrig("f_inside", TRF_GnCb("TRF_OnArrive", id, 2), h.fl, dock, 75);
	TRF_Due(T.dock_to, "TRF_OnDocked", id);
	TRF_GnD("approach id="..id.." dock_mode="..mode);
end;

-- Due call: docking by removal (M3), no portal effect.
function TRF_OnDocked(id, b)
	local r = TRF_Rec(id);
	if r and r.st == "dock" then
		TRF_GnP(TRF_GnSafeArrive, {id, r, "dock"});
		TRF_Remove(id, "dock");
	end;
end;

-- Safe arrival (v02 9.1, 5.6, 7.2), before TRF_Remove deletes the flight: contract check, visit credits
-- (+1 with leader HP >= 50 % of hp0, +2 more for a path A delivery; none for a fleeing trader or a
-- wind-down exit), shortage cleared by a path A delivery.
function TRF_GnSafeArrive(id, r, how)
	TRF_GnX("TRF_CtArrive", id, how);
	if how == "dock" and r.path == "A" then TRF_GnX("TRF_ShortClear", TRF_CurIdx(), r.cls); end;
	if r.fl or r.st == "wind" then return; end;
	if type(r.hp0) == "number" and r.hp0 > 0 then
		local hp = TRF_GnX("GetCurHP", TRF_GnLead(id));
		if type(hp) == "number" and hp < 0.5 * r.hp0 then return; end;
	end;
	local n = 1;
	if how == "dock" and r.path == "A" then n = 3; end;
	TRF_GnX("TRF_ProCredit", n, how);
end;

-- Trigger entry point (review O1): runs TRF_OnExit_Body protected.
function TRF_OnExit(id, g) TRF_Cb("TRF_OnExit", TRF_OnExit_Body, {id, g}); end;

function TRF_OnExit_Body(id, g)
	if g ~= TRF.gen then return; end;
	local r = TRF_Rec(id);
	if not r then return; end;
	local H = TRF_GnH();
	local fx = nil;
	if H and H.tr[id] then fx = H.tr[id].ext; end;
	TRF_GnP(TRF_GnSafeArrive, {id, r, "exit"});
	-- v1: a tracked trader's pool record is written before the delete (trf_track, spec 4.2).
	TRF_GnX("TRF_TrackExit", id, r.to);
	TRF_Remove(id, "exit", fx);
end;

-- Closes record id (st = "gone" before Delete, so died triggers fired by Delete are ignored), deletes
-- its flight, frees its group slot. fx: portal that plays the exit effect. Returns 1 if it was open.
-- CHECK (E0.3): whether Flight:Delete fires died / f_died.
function TRF_Remove(id, why, fx)
	local L = TRF_GnLive();
	local H = TRF_GnH();
	if not L then return nil; end;
	local r = L.tr[id];
	local born = nil;
	if type(r) == "table" then
		if r.st == "gone" then return nil; end;
		-- v1: danger convoy member (contract count, inbound members dock together) before the state changes.
		if type(r.cv) == "number" then TRF_GnX("TRF_DcGone", id, r, why); end;
		-- v1 4.2: a tracked trader fleeing out through a portal is written while its flight still exists.
		if why == "escaped" then TRF_GnX("TRF_TrackGone", id, why); end;
		r.st = "gone";
		born = r.born;
		if type(r.k) == "number" and L.grp[r.k] == id then L.grp[r.k] = 0; end;
	end;
	local h = nil;
	if H then h = H.tr[id]; end;
	if fx and type(fx) ~= "number" then TRF_GnP(function(o) o:Start(5, 0); end, {fx}); end;
	if type(h) == "table" then
		if TRF_GnAlive(h.fl) then TRF_GnP(function(f) f:Delete(); end, {h.fl}); end;
		H.tr[id] = nil;
	end;
	if type(r) == "table" then r.why = tostring(why); TRF_GnStrip(r); end;
	TRF_GnP(TRF_GnQFree, {id});
	-- v1: a tracked identity ends with a docking or an unreported death (trf_track); the convoy slot of
	-- this trader id is released (trf_convoy).
	if why == "dock" or why == "lost" then TRF_GnX("TRF_TrackGone", id, why); end;
	TRF_GnX("TRF_ConvFree", id);
	TRF_GnStat("remove_"..tostring(why));
	TRF_GnL("remove id="..tostring(id).." why="..tostring(why).." age="..TRF_F(TRF_GnGt() - (born or TRF_GnGt())));
	return 1;
end;

-- Gone record (v02 3.2): only id, nm, cls, st, why and gg (gt of removal) stay.
function TRF_GnStrip(r)
	if type(r) ~= "table" then return; end;
	if type(r.gg) ~= "number" then r.gg = TRF_GnGt(); end;
	-- v1 3.2: tracking fields stay too (TRF_GoneKeep in trf_state).
	local keep = {id=1, nm=1, cls=1, st=1, why=1, gg=1, tb=1, pi=1, cv=1, xt=1};
	if type(TRF_GoneKeep) == "function" then keep = TRF_GoneKeep(); end;
	local ks = {};
	for k, v in r do if not keep[k] then tinsert(ks, k); end; end;
	for i = 1, getn(ks) do r[ks[i]] = nil; end;
end;

-- Leader ship to the nearest registered portal with a new exit trigger (wind-down, watchdog, station
-- lost, load pass). st: the record's new state. Returns 1 if ordered.
function TRF_GnToPortal(id, st)
	local L = TRF_GnLive();
	local H = TRF_GnH();
	local r = L.tr[id];
	local h = H.tr[id];
	local lead = TRF_GnLead(id);
	if type(r) ~= "table" or not h or not lead then return nil; end;
	local o, nm = TRF_GnNearPortal(r.ci, lead:GetPosition());
	if not o then return nil; end;
	-- CHECK (E0.3): whether ComeToPortal removes the ship by itself or only flies there.
	lead:ComeToPortal(o);
	h.ext = o;
	if nm then r.ext = nm; end;
	r.st = st;
	r.xa = 1;
	TRF_GnTrig("f_object_inside", TRF_GnCb("TRF_OnExit", id), h.fl, o, 20);
	return 1;
end;

-- Wind-down (spec 6, R3): once per suppression onset. Near traders leave by portal (path A near the
-- station docks), far ones are deleted.
function TRF_WindDown()
	local L = TRF_GnLive();
	if not L then return; end;
	L.wind = 1;
	-- v02: the queue dissolves (queued traders take the choice below), raids leave, parked ships near
	-- the player stay.
	TRF_GnQClear();
	TRF_GnX("TRF_Raid_WindDown");
	TRF_GnX("TRF_Parked_Clear", "wind");
	-- v1 wind-downs (spec 10.2): their flights and convoy members first, so the loop below skips members
	-- they already sent to dock ("dock") or to a portal ("wind").
	local v1 = {"TRF_Danger_WindDown", "TRF_Convoy_WindDown", "TRF_Clan_WindDown", "TRF_Faction_WindDown"};
	for i = 1, getn(v1) do TRF_GnX(v1[i]); end;
	local T = TRF_GnT();
	local mp = TRF_GnPos(TRF_GnMs());
	local sp = TRF_GnPos(TRF_GnStation());
	local ids = {};
	for id, r in L.tr do
		if type(r) == "table" and r.st ~= "gone" and r.st ~= "dock" and r.st ~= "wind" then tinsert(ids, id); end;
	end;
	for i = 1, getn(ids) do
		local id = ids[i];
		local r = L.tr[id];
		local lp = TRF_GnPos(TRF_GnLead(id));
		local dm, ds = TRF_GnDist(lp, mp), TRF_GnDist(lp, sp);
		local ch = "delete";
		if type(TRF_WindChoice) == "function" then
			ch = TRF_WindChoice(r.path, dm, ds);
		elseif dm and dm <= T.ovd then
			ch = "portal";
		end;
		if ch == "dock" then
			r.st = "dock";
			TRF_Due(T.T_dock, "TRF_OnDocked", id);
		elseif ch == "portal" and TRF_GnP(TRF_GnToPortal, {id, "wind"}) then
			TRF_GnStat("wind_portal");
		else
			TRF_Remove(id, "wind");
		end;
		TRF_GnL("wind id="..id.." -> "..ch.." d="..TRF_F(dm));
	end;
end;

-- Manager step (spec 5.3, 4.2, 6) ----------------------------------------------------------

-- Remaining route of trader id from its current position (watchdog stage 1).
function TRF_GnReissue(id)
	local H = TRF_GnH();
	local r = TRF_Rec(id);
	local h = H.tr[id];
	if not r or not h then return; end;
	if r.st == "wind" then
		local lead = TRF_GnLead(id);
		if lead and h.ext then lead:ComeToPortal(h.ext); end;
	elseif r.path == "A" and r.st == "in" then
		if h.np then h.fl:Patrol({h.np}, FALSE); end;
	elseif h.ext then
		h.fl:Patrol({h.ext:GetEntryPoint(50), h.ext:GetEntryPoint(1)}, FALSE);
		if r.xa ~= 1 then TRF_GnExitTrig(id); end;
	end;
end;

-- One record: ship count, station loss, lifetime, watchdog.
function TRF_GnStepOne(id, st, T, gt)
	local L = TRF_GnLive();
	local H = TRF_GnH();
	local r = L.tr[id];
	local h = H.tr[id];
	if type(h) ~= "table" then TRF_Remove(id, "lost"); return; end;
	local np, nt, dead = 0, 0, nil;
	for i = 1, getn(h.sh) do if TRF_GnAlive(h.sh[i]) then np = np + 1; end; end;
	for i = 1, getn(h.tp) do
		if TRF_GnAlive(h.tp[i]) then nt = nt + 1; elseif not dead then dead = i; end;
	end;
	r.np = np;
	if np == 0 then TRF_Remove(id, "lost"); return; end;
	if nt == 0 and getn(h.tp) > 0 then
		-- All transports dead but no died event closed the record: report it as the trigger would.
		if type(TRF_OnShipDied) == "function" and dead then TRF_OnShipDied(id, dead, TRF.gen); end;
		if TRF_Rec(id) then r.nt = 0; TRF_Remove(id, "lost"); end;
		return;
	end;
	r.nt = nt;
	local lp = TRF_GnPos(TRF_GnLead(id));
	local d = TRF_GnDist(lp, TRF_GnPos(TRF_GnMs()));
	-- Station lost (4.2): inbound path A traders leave by the nearest portal.
	if r.path == "A" and r.st == "in" and not st then
		if not TRF_GnToPortal(id, "out") then TRF_Remove(id, "station"); end;
		TRF_GnL("station lost: id="..id.." to portal");
		return;
	end;
	if gt - (r.born or gt) > T.lifetime and d and d > T.ovd then TRF_Remove(id, "life"); return; end;
	-- Queued traders hold still on purpose; TRF_Q_Tick times them out (v02 9.5).
	if r.st == "dock" or r.st == "queue" or r.st == "form" or not lp then return; end;
	-- v1: inbound danger convoy followers wait for their lead (trf_danger).
	if type(r.cv) == "number" and TRF_GnX("TRF_DcHold", id, r) then r.lt = gt; return; end;
	-- A trader in an open raid (demand stop, staged fight) holds still on purpose; the raid step ends that.
	local rd = nil;
	if type(r.rdn) == "number" and type(L.rd) == "table" then rd = L.rd[r.rdn]; end;
	if type(rd) == "table" and rd.st ~= "end" and rd.st ~= "armed" then r.lt = gt; return; end;
	if r.wd == 3 and d and d > T.ovd then TRF_Remove(id, "stuck"); return; end;
	local mv = TRF_GnDist(lp, {x=r.lx or 0, y=r.ly or 0, z=r.lz or 0});
	if not r.lt or not mv or mv >= T.wd_move then
		r.lx = lp.x; r.ly = lp.y; r.lz = lp.z; r.lt = gt; r.wd = 0;
		return;
	end;
	if gt - r.lt < T.wd_t then return; end;
	if type(r.pa) == "number" and gt - r.pa < 30 then return; end;
	if r.wd == 0 or r.wd == nil then
		TRF_GnReissue(id);
		r.wd = 1;
		TRF_GnStat("wd_1");
		TRF_GnL("watchdog id="..id.." stage 1 (re-route)");
	elseif r.wd == 1 then
		if not d or d > T.ovd then
			TRF_Remove(id, "stuck");
			return;
		end;
		local ns = r.st;
		if ns == "in" then ns = "out"; end;
		if not TRF_GnToPortal(id, ns) then TRF_Remove(id, "stuck"); return; end;
		r.wd = 3;
		TRF_GnStat("wd_2");
		TRF_GnL("watchdog id="..id.." stage 2 (portal) d="..TRF_F(d));
	end;
	r.lt = gt;
end;

-- Called by the loader every step (10 s of game time). Runs at most once per half step, so a per-tick
-- call is harmless.
function TRF_Gen_Step()
	if type(TRF) ~= "table" or not TRF.active then return; end;
	local L = TRF_GnLive();
	local H = TRF_GnH();
	if not L or not H then return; end;
	if type(TRF_LiveOk) == "function" and not TRF_LiveOk() then return; end;
	local T = TRF_GnT();
	local gt = TRF_GnGt();
	if type(L.gs) == "number" and gt >= L.gs and gt - L.gs < T.step * 0.5 then return; end;
	L.gs = gt;
	TRF_GnMs();
	local st = TRF_GnP(TRF_GnStation, {});
	if type(TRF_SafeWindOnset) == "function" then
		if TRF_SafeWindOnset() then TRF_GnP(TRF_WindDown, {}); end;
	elseif type(TRF_Supp) == "function" and TRF_Supp() == 2 and L.wind ~= 1 then
		TRF_GnP(TRF_WindDown, {});
	end;
	local ids = {};
	for id, r in L.tr do tinsert(ids, id); end;
	for i = 1, getn(ids) do
		local id = ids[i];
		local r = L.tr[id];
		if type(r) ~= "table" or r.st == "gone" then
			-- v02 3.2: gone records are stripped and pruned to the 8 newest by trf_state TRF_LivePrune;
			-- without it they go at once (v0.1).
			if type(r) == "table" and type(TRF_LivePrune) == "function" then TRF_GnStrip(r); else L.tr[id] = nil; end;
			-- Escorts of a killed trader (h.kl) stay with trf_events until they leave.
			if type(H.tr[id]) == "table" and not H.tr[id].kl then H.tr[id] = nil; end;
		else
			TRF_GnP(TRF_GnStepOne, {id, st, T, gt});
		end;
	end;
	if type(TRF_LivePrune) == "function" then TRF_GnP(TRF_LivePrune, {}); end;
	local keep = {};
	for i = 1, getn(H.van) do
		if TRF_GnAlive(H.van[i]) then tinsert(keep, H.van[i]); end;
	end;
	H.van = keep;
end;

-- Loader callbacks (spec 10.1) ----------------------------------------------------------

-- After activate.script: mothership, group slots, stamp of the player's arrival portal (4.4).
function TRF_Gen_OnActivate()
	local L = TRF_GnLive();
	local H = TRF_GnH();
	if not L or not H then return; end;
	for k = 1, 4 do if type(L.grp[k]) ~= "number" then L.grp[k] = 0; end; end;
	local mp = TRF_GnPos(TRF_GnMs());
	local sy = TRF_GnSys();
	if mp and sy then
		local best, bd = nil, 600;
		for i = 1, getn(sy.portals) do
			local d = TRF_GnDist(mp, sy.portals[i]);
			if d and d < bd then best = sy.portals[i].name; bd = d; end;
		end;
		if best then L.port[best] = TRF_GnGt(); end;
		TRF_GnD("activate arrival portal="..tostring(best).." d="..TRF_F(bd));
	end;
	TRF_GnP(TRF_GnBaseAll, {});
	TRF_GnP(TRF_EntryPlan, {});
end;

-- Entry plan and arrival seed (v02 9.5, design 6.5) --------------------------------------

-- Once per entry from TRF_Gen_OnActivate, after decay, region catch-up and base reconciliation. v1
-- precedence (spec 8.6), highest first: 1 chased tracked arrival (suppresses the staged raid), 2a on-screen
-- sweep (staged raid and seed), 2b carrier raid (staged raid), 3 equipment convoy when 2a does not play
-- (staged raid, takes the seed's place, reserves the slot itself), 4 staged raid (seed's place), 5 seed
-- with an identity (a pirate tip-off, b tracked record treated as docked), 6 plain seed. Tracked portal
-- arrivals run beside it (handoff_max with item 1). Each provider is nil without its module, so the v0.2
-- draws stay the same. Sets live.ent ("staged", "seed", "sweep", "feq", "po", "none") and returns it.
function TRF_EntryPlan()
	local L = TRF_GnLive();
	if not L then return nil; end;
	if L.ent then return L.ent; end;
	L.ent = "none";
	if not TRF_GenReady() or TRF_GnModeQ() ~= "mod" then return L.ent; end;
	local nost, noseed = nil, nil;
	local tk = TRF_GnX("TRF_TrackEntry");
	if type(tk) ~= "table" then tk = {}; end;
	local nh, hm = 0, TRF_GnTv("handoff_max", 2);
	if type(tk.chase) == "number" then
		local a, b = TRF_GnTv("track_chase_min", 5), TRF_GnTv("track_chase_max", 15);
		if TRF_Due(a + TRF_GnRand(max(1, b - a + 1)), "TRF_TrackSpawn", tk.chase, "chase") then nh = 1; nost = 1; end;
	end;
	if type(tk.port) == "table" then
		local a, b = TRF_GnTv("track_port_min", 60), TRF_GnTv("track_port_max", 120);
		for i = 1, getn(tk.port) do
			if nh < hm and type(tk.port[i]) == "number" and TRF_Due(a + TRF_GnRand(max(1, b - a + 1)), "TRF_TrackSpawn", tk.port[i], "port") then nh = nh + 1; end;
		end;
	end;
	if TRF_GnX("TRF_SweepEntry") then nost = 1; noseed = "sweep"; end;
	if TRF_GnX("TRF_CarrierEntry") then nost = 1; end;
	if not noseed and TRF_GnX("TRF_FeqEntry") then nost = 1; noseed = "feq"; end;
	if not nost and TRF_GnX("TRF_StagedRoll") then
		L.ent = "staged";
		TRF_GnL("entry plan: staged raid, no seed");
		noseed = "staged";
	end;
	local idn = nil;
	if type(tk.dock) == "table" and type(tk.dock[1]) == "number" then idn = tk.dock[1]; end;
	if noseed then
		if L.ent == "none" then L.ent = noseed; end;
		-- A displaced identity seed undocks when that event ends (TRF_SeedResume).
		if idn or type(TRF_PoEntry) == "function" then L.sdq = {i=idn, p=1}; end;
		if noseed ~= "staged" then TRF_GnL("entry plan: "..noseed..", no seed"); end;
		return L.ent;
	end;
	if TRF_GnX("TRF_PoEntry") then return TRF_GnPoSeed(L); end;
	return TRF_GnSeedPlan(L, idn);
end;

-- Pirate tip-off seed (7.5 fulfil, 8.6 item 5a): the seed without the chance roll; TRF_SeedSpawn marks the
-- trader (tb bit 2, tracked) and reports it with TRF_PoDone(id, "spawn"). Deviation: the tier comes from the
-- normal pick, not "the highest tier pro allows" (TT4 for intel). Returns live.ent.
function TRF_GnPoSeed(L)
	local a, b = TRF_GnTv("seed_min", 15), TRF_GnTv("seed_max", 30);
	local dt = a + TRF_GnRand(max(1, b - a + 1));
	L.spo = 1;
	if TRF_Due(dt, "TRF_SeedSpawn") then L.ent = "po"; else L.spo = nil; end;
	TRF_GnL("entry plan: pirate tip-off seed in "..dt.." s");
	return L.ent;
end;

-- Seed of this entry (items 5b, 6): a tracked dock record (pool index idn) undocks without the chance
-- roll, the plain seed with it (v02 9.5). Returns live.ent.
function TRF_GnSeedPlan(L, idn)
	local ch, why = TRF_GnSeedChance();
	if not ch then TRF_GnD("entry plan: no seed ("..tostring(why)..")"); return L.ent; end;
	local roll = -1;
	if idn then
		L.sdk = idn;
	else
		roll = TRF_GnRand(100);
		if not (roll < ch) then TRF_GnD("entry plan: seed chance="..ch.." roll="..roll.." -> no"); return L.ent; end;
	end;
	local a, b = TRF_GnTv("seed_min", 15), TRF_GnTv("seed_max", 30);
	local dt = a + TRF_GnRand(max(1, b - a + 1));
	if TRF_Due(dt, "TRF_SeedSpawn") then L.ent = "seed"; else L.sdk = nil; end;
	if idn then
		TRF_GnL("entry plan: tracked seed pool="..idn.." in "..dt.." s");
	else
		TRF_GnL("entry plan: seed chance="..ch.." roll="..roll.." in "..dt.." s");
	end;
	return L.ent;
end;

-- v1: the identity seed a sweep, an equipment convoy or a staged raid displaced (8.6 item 5) undocks now,
-- if caps allow; called by those modules when their event ends. Returns "po", "seed" or nil.
function TRF_SeedResume()
	local L = TRF_GnLive();
	if not L or type(L.sdq) ~= "table" then return nil; end;
	local q = L.sdq;
	L.sdq = nil;
	if not TRF_GenReady() or TRF_GnModeQ() ~= "mod" then return nil; end;
	if q.p == 1 and TRF_GnX("TRF_PoEntry") and TRF_GnPoSeed(L) == "po" then return "po"; end;
	if type(q.i) == "number" then
		local e = L.ent;
		if TRF_GnSeedPlan(L, q.i) == "seed" and e ~= "seed" then return "seed"; end;
	end;
	return nil;
end;

-- Trader contact indices with an approach point at the usable trade station, or nil.
function TRF_GnSeedContacts()
	local st = TRF_GnStation();
	if not st then return nil; end;
	local T = TRF_GnT();
	local list = TRF_GnContacts();
	local ok = {};
	for ci = 1, getn(list) do
		if TRF_GnIsTrader(list[ci]) and TRF_GnApproach(list[ci], st, T) then tinsert(ok, ci); end;
	end;
	if getn(ok) == 0 then return nil; end;
	return ok;
end;

-- Seed chance in percent (v02 9.5): 60 at effective danger 0, 30 at 1-2, none at 3 or dis >= 5, plus the
-- band bonus (band gate). nil, reason when no seed may run.
function TRF_GnSeedChance()
	if TRF_GnOpt("seed", 1) == 0 then return nil, "cfg"; end;
	local cur = TRF_CurIdx();
	if type(TRF_Supp) == "function" and TRF_Supp() ~= 0 then return nil, "supp"; end;
	if not TRF_GnGate(cur, "seed") then return nil, "gate"; end;
	local dE, dis = TRF_GnDangerEff(cur), TRF_GnDis(cur);
	if dE >= 3 or dis >= 5 then return nil, "danger"; end;
	local base = 60;
	if dE >= 1 then base = 30; end;
	if not TRF_GnSeedContacts() then return nil, "station"; end;
	local ok, why = TRF_CanSpawn(0, "seed");
	if not ok then return nil, why; end;
	local c = TRF_GnX("TRF_BandCaps", cur);
	if type(c) == "table" and type(c.sb) == "number" and c.sb > 0 and TRF_GnGate(cur, "band") then base = base + c.sb; end;
	return base;
end;

-- Due call: one path B trader undocking from the trade station, tier by TRF_TierPlan, r.seed = 1.
-- Conditions are checked again, since 15-30 s passed. Returns the trader id or nil.
function TRF_SeedSpawn()
	if not TRF_GenReady() or TRF_GnModeQ() ~= "mod" then return nil; end;
	if type(TRF_Supp) == "function" and TRF_Supp() ~= 0 then TRF_GnStat("skip_seed_supp"); return nil; end;
	-- v1 (8.6 item 5b): a tracked record treated as docked undocks with its identity (trf_track).
	local L = TRF_GnLive();
	if L and type(L.sdk) == "number" then
		local i = L.sdk;
		L.sdk = nil;
		local tid = TRF_GnX("TRF_TrackSpawn", i, "dock");
		if tid then TRF_GnStat("seed_track"); else TRF_GnStat("skip_seed_track"); end;
		return tid;
	end;
	if not TRF_GnValidate() then return nil; end;
	local cis = TRF_GnSeedContacts();
	if not cis then TRF_GnStat("skip_seed_station"); return nil; end;
	local ci = cis[TRF_GnRand(getn(cis)) + 1];
	local ok, free = TRF_CanSpawn(0, "seed");
	if not ok then TRF_GnStat("skip_seed_"..tostring(free)); return nil; end;
	local plan, why = TRF_Plan(TRF_GnContacts()[ci], ci, "B", free);
	if not plan then TRF_GnStat("skip_seed_"..tostring(why)); return nil; end;
	local spare;
	ok, spare = TRF_CanSpawn(plan.n, "seed");
	if not ok then TRF_GnStat("skip_seed_"..tostring(spare)); return nil; end;
	if type(spare) == "number" and plan.esc > spare then plan.esc = max(0, spare); end;
	local id = TRF_Spawn(plan);
	local r = TRF_Rec(id);
	if r then
		r.seed = 1;
		TRF_GnStat("seed");
		TRF_GnL("seed id="..id.." tier="..tostring(r.tier));
		if L and L.spo then
			L.spo = nil;
			if type(TRF_BitSet) == "function" then r.tb = TRF_BitSet(r.tb, 2); end;
			TRF_GnX("TRF_TrackMark", id, "po");
			TRF_GnX("TRF_PoDone", id, "spawn");
		end;
	end;
	return id;
end;

-- Docking queue (v02 9.5, design 6.4) ---------------------------------------------------------

-- Visit queue state live.q = {dk (docking id, 0 free), pdk (gt of the last player dock), hp (3 hold-point
-- holders, 0 free), tk (gt of the last queue tick)}, created on first use.
function TRF_GnQ()
	local L = TRF_GnLive();
	if type(L.q) ~= "table" then L.q = {}; end;
	local q = L.q;
	if type(q.dk) ~= "number" then q.dk = 0; end;
	if type(q.pdk) ~= "number" then q.pdk = -1000; end;
	if type(q.hp) ~= "table" then q.hp = {0, 0, 0}; end;
	for j = 1, 3 do if type(q.hp[j]) ~= "number" then q.hp[j] = 0; end; end;
	return q;
end;

-- Hold points of trader h's station (TRF_QPoints with its station and approach point).
function TRF_GnQPts(h)
	local st = h.st;
	if not TRF_GnAlive(st) then st = TRF_GnStation(); end;
	if not st or not h.np then return nil; end;
	return TRF_QPoints(st, h.np);
end;

-- Hold points of station st: hp1 = dock + d * q_hp1, hp2/3 = dock + d * q_hp2 +- p * q_hpw, with d toward
-- approach point np and p across it. CHECK (O9): distances unmeasured. v1 (forming danger convoy): st
-- defaults to the usable station, np to the approach point of the first seed contact, else the last
-- spawn's. nil without a station or approach point.
function TRF_QPoints(st, np)
	if not TRF_GnAlive(st) then st = TRF_GnStation(); end;
	if not st then return nil; end;
	if not np then
		local cis = TRF_GnSeedContacts();
		if cis then np = TRF_GnApproach(TRF_GnContacts()[cis[1]], st, TRF_GnT()); end;
		local H = TRF_GnH();
		if not np and H then np = H.np; end;
	end;
	if not np then return nil; end;
	local dock = st:GetDockingPosition();
	local dx, dy, dz = np.x - dock.x, np.y - dock.y, np.z - dock.z;
	local l = sqrt(dx * dx + dy * dy + dz * dz);
	if l < 0.001 then dx, dy, dz, l = 0, 0, 1, 1; end;
	dx, dy, dz = dx / l, dy / l, dz / l;
	local px, pz = -dz, dx;
	local pl = sqrt(px * px + pz * pz);
	if pl < 0.001 then px, pz, pl = 1, 0, 1; end;
	px, pz = px / pl, pz / pl;
	local a, b, w = TRF_GnTv("q_hp1", 180), TRF_GnTv("q_hp2", 220), TRF_GnTv("q_hpw", 60);
	return {Vector3(dock.x + dx * a, dock.y + dy * a, dock.z + dz * a),
		Vector3(dock.x + dx * b + px * w, dock.y + dy * b, dock.z + dz * b + pz * w),
		Vector3(dock.x + dx * b - px * w, dock.y + dy * b, dock.z + dz * b - pz * w)};
end;

-- Queue test of a path A trader at the approach point (how 0). nil: dock now (slot taken); 1: it holds
-- at a free hold point or, with all three taken, diverts to the nearest registered portal.
function TRF_GnQueue(id, r, h)
	if TRF_GnOpt("queue", 1) == 0 then return nil; end;
	local q = TRF_GnQ();
	local gt = TRF_GnGt();
	if (q.dk == 0 or q.dk == id) and gt - q.pdk >= TRF_GnTv("q_prio", 30) then q.dk = id; return nil; end;
	local pts = TRF_GnQPts(h);
	if not pts then return nil; end;
	local j = nil;
	for i = 1, 3 do if not j and q.hp[i] == 0 then j = i; end; end;
	if not j then TRF_GnQDivert(id, "full"); return 1; end;
	q.hp[j] = id;
	r.st = "queue";
	r.qt = gt;
	h.fl:Move(pts[j]);
	TRF_GnStat("q_hold");
	TRF_GnL("queue id="..id.." hold="..j.." dk="..q.dk.." pdk="..TRF_F(gt - q.pdk));
	return 1;
end;

-- Queued trader to the nearest registered portal (path C exit, st "out"); removed when none.
function TRF_GnQDivert(id, why)
	local r = TRF_Rec(id);
	if not r then return; end;
	r.qgo = nil;
	TRF_GnStat("q_divert_"..tostring(why));
	TRF_GnL("queue id="..id.." diverted ("..tostring(why)..")");
	if not TRF_GnP(TRF_GnToPortal, {id, "out"}) then TRF_Remove(id, "queue"); end;
end;

-- Trader id leaves the queue state (TRF_Remove); a freed docking slot goes to the next queued trader.
function TRF_GnQFree(id)
	local L = TRF_GnLive();
	if not L or type(L.q) ~= "table" then return; end;
	local q = TRF_GnQ();
	for j = 1, 3 do if q.hp[j] == id then q.hp[j] = 0; end; end;
	if q.dk == id then q.dk = 0; TRF_QRelease(); end;
end;

-- Queue dissolved (wind-down, jump): slot and hold points free, the player stamp kept.
function TRF_GnQClear()
	local L = TRF_GnLive();
	if not L or type(L.q) ~= "table" then return; end;
	local q = TRF_GnQ();
	q.dk = 0;
	q.hp = {0, 0, 0};
end;

-- The queued trader waiting longest flies to its approach point (f_inside np_r -> TRF_OnArrive how 3) and
-- holds the docking slot meanwhile. Not while the slot is taken or within q_prio of a player dock.
-- Returns the released id or nil.
function TRF_QRelease()
	local L = TRF_GnLive();
	if not L or type(L.q) ~= "table" then return nil; end;
	local q = TRF_GnQ();
	local gt = TRF_GnGt();
	if q.dk ~= 0 or gt - q.pdk < TRF_GnTv("q_prio", 30) then return nil; end;
	local best, bj, bt = nil, nil, nil;
	for j = 1, 3 do
		local r = TRF_Rec(q.hp[j]);
		if r and r.st == "queue" and (not bt or (r.qt or 0) < bt) then best = q.hp[j]; bj = j; bt = r.qt or 0; end;
	end;
	if not best then return nil; end;
	q.hp[bj] = 0;
	local H = TRF_GnH();
	local h = H and H.tr[best];
	if not h or not TRF_GnAlive(h.fl) or not h.np then TRF_GnQDivert(best, "lost"); return nil; end;
	local r = TRF_Rec(best);
	q.dk = best;
	r.qgo = 1;
	r.qgt = gt;
	h.fl:Move(h.np);
	TRF_GnTrig("f_inside", TRF_GnCb("TRF_OnArrive", best, 3), h.fl, h.np, TRF_GnT().np_r);
	TRF_GnL("queue release id="..best.." waited="..TRF_F(gt - bt));
	return best;
end;

-- Player priority (v02 9.5): the trade-dock wrapper (trf_shop) and TRF_Q_Tick stamp the player's dock.
function TRF_QPlayer()
	local L = TRF_GnLive();
	if not L then return; end;
	TRF_GnQ().pdk = TRF_GnGt();
end;

-- Loader tick; acts once per second of gt: player priority (mothership within q_r of the docking position),
-- slot holder still valid, hold-point holders gone or waiting longer than q_wait, station lost, release.
function TRF_Q_Tick(dg)
	if type(TRF) ~= "table" or not TRF.active then return; end;
	local L = TRF_GnLive();
	if not L or (type(TRF_LiveOk) == "function" and not TRF_LiveOk()) then return; end;
	if TRF_GnOpt("queue", 1) == 0 then return; end;
	local q = TRF_GnQ();
	local gt = TRF_GnGt();
	if type(q.tk) == "number" and gt >= q.tk and gt - q.tk < 1 then return; end;
	q.tk = gt;
	local st = TRF_GnStation();
	if not st then
		-- Station lost (design 6.8): every queued trader diverts, the slot clears.
		for j = 1, 3 do
			local id = q.hp[j];
			q.hp[j] = 0;
			-- Forming danger convoy members are moved by trf_danger, not diverted.
			if id ~= 0 and TRF_Rec(id) and TRF_Rec(id).st ~= "form" then TRF_GnQDivert(id, "station"); end;
		end;
		q.dk = 0;
		return;
	end;
	local d = TRF_GnDist(TRF_GnPos(TRF_GnMs()), st:GetDockingPosition());
	if d and d <= TRF_GnTv("q_r", 150) then q.pdk = gt; end;
	if q.dk ~= 0 then
		local r = TRF_Rec(q.dk);
		if not r or (r.st ~= "dock" and not (r.st == "queue" and r.qgo == 1)) then
			q.dk = 0;
		elseif r.st == "queue" and gt - (r.qgt or gt) > 60 then
			-- Released but the approach trigger never fired: dock from here.
			TRF_OnArrive_Body(q.dk, 3, TRF.gen);
		end;
	end;
	local wait = TRF_GnTv("q_wait", 180);
	for j = 1, 3 do
		local id = q.hp[j];
		if id ~= 0 then
			local r = TRF_Rec(id);
			-- A forming danger convoy member keeps its hold point (trf_danger frees it at departure).
			if not r or (r.st ~= "queue" and r.st ~= "form") then
				q.hp[j] = 0;
			elseif r.st == "queue" and gt - (r.qt or gt) > wait then
				q.hp[j] = 0;
				TRF_GnQDivert(id, "wait");
			end;
		end;
	end;
	TRF_QRelease();
end;

-- Live ships labelled trf_<id>_<i> (i <= 8), in label order.
function TRF_GnFind(id)
	local sh = {};
	for i = 1, 8 do
		local o = TRF_N("GetObjectByLabel", "trf_"..id.."_"..i);
		if TRF_GnAlive(o) then tinsert(sh, o); end;
	end;
	return sh;
end;

-- Load pass for one trader found by label: minimal handles and wind-down (portal within ovd, else
-- delete). No attack, died, focus or meeting trigger is re-armed. Returns "wind" (sent to a portal),
-- "gone" (deleted), "none" (no live ship found) or nil (error).
function TRF_GnLoadOne(id, r, T)
	local H = TRF_GnH();
	local sh = TRF_GnFind(id);
	if getn(sh) == 0 then r.st = "gone"; return "none"; end;
	local fl = sh[1]:GetPilot():GetFlight();
	local tp = {};
	local n = r.nt;
	if type(n) ~= "number" or n < 1 then n = 1; end;
	for i = 1, min(n, getn(sh)) do tp[i] = sh[i]; end;
	H.tr[id] = {fl=fl, sh=sh, tp=tp};
	r.np = getn(sh);
	r.nt = getn(tp);
	local lp = sh[1]:GetPosition();
	r.lx = lp.x; r.ly = lp.y; r.lz = lp.z; r.lt = TRF_GnGt(); r.wd = 0;
	if type(r.born) ~= "number" then r.born = TRF_GnGt(); end;
	local d = TRF_GnDist(lp, TRF_GnPos(TRF_GnMs()));
	r.st = "wind";
	if d and d <= T.ovd and TRF_GnToPortal(id, "wind") then return "wind"; end;
	if TRF_GnAlive(fl) then fl:Delete(); end;
	for i = 1, getn(sh) do if TRF_GnAlive(sh[i]) then sh[i]:Delete(); end; end;
	H.tr[id] = nil;
	r.st = "gone";
	return "gone";
end;

-- Load (spec 5.5), after migration and gen + 1: traders of the saved visit table and orphans found by
-- label wind down; live is then reset keeping only those records (st "wind") and rn.
function TRF_Gen_OnLoad()
	if type(TRF) ~= "table" then return; end;
	local H = TRF_GnH();
	if not H then return; end;
	TRF_GnMs();
	local T = TRF_GnT();
	local old = TRF.live;
	if type(old) ~= "table" then old = {}; TRF.live = old; end;
	if type(old.tr) ~= "table" then old.tr = {}; end;
	local cnt = {};
	local note = function(why, res)
		local k = why.."_"..tostring(res);
		%cnt[k] = (%cnt[k] or 0) + 1;
	end;
	local ids = {};
	for id, r in old.tr do tinsert(ids, id); end;
	for i = 1, getn(ids) do
		local id = ids[i];
		local r = old.tr[id];
		if type(id) == "number" and type(r) == "table" and r.st ~= "gone" then
			local res = TRF_GnP(TRF_GnLoadOne, {id, r, T});
			if not res then r.st = "gone"; end;
			note("load", res);
		end;
	end;
	-- Orphan scan: the 16 ids up to seq (wrapping below 1 to 9999) without an open record.
	local seq = TRF.seq;
	if type(seq) ~= "number" then seq = 0; end;
	for j = 0, 15 do
		local id = seq - j;
		if id < 1 then id = id + 9999; end;
		local r = old.tr[id];
		if (type(r) ~= "table" or r.st == "gone") and TRF_GnAlive(TRF_N("GetObjectByLabel", "trf_"..id.."_1")) then
			r = {id=id, st="wind", path="C", nm=0, cls=6, from=-1, to=-1, k=0, np=0, nt=1, esc=0, born=TRF_GnGt(), wd=0};
			old.tr[id] = r;
			local res = TRF_GnP(TRF_GnLoadOne, {id, r, T});
			if not res then r.st = "gone"; end;
			note("orphan", res);
		end;
	end;
	if type(TRF_LiveReset) == "function" then
		TRF_LiveReset(1);
	else
		local tr = {};
		for id, r in old.tr do if type(r) == "table" and r.st == "wind" then tr[id] = r; end; end;
		TRF.live = {g=TRF.gen, tr=tr, grp={0, 0, 0, 0}, port={}, kills=0, rec=0, rn=old.rn or 0, stat={}};
	end;
	local st = TRF_GnLive().stat;
	-- remove_load: deleted (out of view or no flight); remove_orphan: every orphan found; wind_load: sent to a portal.
	st.remove_load = cnt.load_gone;
	st.wind_load = cnt.load_wind;
	st.remove_orphan = (cnt.orphan_gone or 0) + (cnt.orphan_wind or 0);
	if st.remove_orphan == 0 then st.remove_orphan = nil; end;
	TRF_GnL("load pass"..TRF_Kv2(cnt).." seq="..seq);
end;

-- " k=v" pairs of a table (log helper; trf_state's TRF_Kv when present).
function TRF_Kv2(t)
	if type(TRF_Kv) == "function" then return TRF_Kv(t); end;
	local s = "";
	for k, v in t do s = s.." "..tostring(k).."="..tostring(v); end;
	return s;
end;

-- Before a jump: delete every traffic trader and response flight (M3), st = "gone". v1: also the danger
-- convoy escort flights (the other v1 modules delete their flights in their own BeforeJump, which the
-- loader runs first; spec 10.3).
function TRF_Gen_BeforeJump(dest)
	local L = TRF_GnLive();
	local H = TRF_GnH();
	if not L or not H then return; end;
	-- v02: parked ships go (9.4); the queue is cleared first, so no removal below releases a queued trader.
	TRF_GnX("TRF_Parked_Clear", "jump");
	TRF_GnQClear();
	local n = 0;
	local ids = {};
	for id, r in L.tr do tinsert(ids, id); end;
	for i = 1, getn(ids) do
		local r = L.tr[ids[i]];
		if type(r) == "table" and r.st ~= "gone" then
			if TRF_Remove(ids[i], "jump") then n = n + 1; end;
		end;
	end;
	local del = function(f) if TRF_GnAlive(f) then f:Delete(); end; end;
	for id, h in H.tr do
		if type(h) == "table" then TRF_GnP(del, {h.fl}); end;
	end;
	H.tr = {};
	local nr = 0;
	for k, v in H.resp do
		if type(v) == "table" and not v.__obj then
			for j = 1, getn(v) do TRF_GnP(del, {v[j]}); nr = nr + 1; end;
		else
			TRF_GnP(del, {v});
			nr = nr + 1;
		end;
	end;
	H.resp = {};
	local nv = TRF_GnX("TRF_DcDelAll", H);
	for k = 1, 4 do L.grp[k] = 0; end;
	local sv = "";
	if type(nv) == "number" and nv > 0 then sv = " v1="..nv; end;
	TRF_GnL("jump: traders deleted="..n.." response flights="..nr..sv);
end;
