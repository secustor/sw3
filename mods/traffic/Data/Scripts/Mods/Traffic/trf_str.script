-- sw3-traffic strength scale (design/strength-spec.md). Lua 4.0.1.
-- One score 0..99 per side (clan score, trade prosperity x 11, mercenary fortune), the tier 1..4 of a score with
-- hysteresis, the one tier table (raid rows, nest power step, captain row, stash class) and the one chance curve for a
-- level step. Pure helpers: the callers supply the roll (trf_tier TRF_TrRand(100) for traders; a fixed hash later for
-- pirates). The only saved field is the clan tier digit TRF.clan[slot].tr: trf_region creates and repairs it and reads it
-- in TRF_ClanTier, TRF_Str_RegionTick and TRF_StrClanSet write it. Loads after trf_region and before trf_tier
-- (counted as extra=). Top level only defines functions. Log lines module=str through TRF_StrE / TRF_StrDE.

-- Event line, module=str (design/log-format.md): TRF_StrE(event, k1, v1, ...); TRF_StrDE only at log 2.
function TRF_StrE(event, ...) tinsert(arg, 1, event); tinsert(arg, 1, "str"); call(TRF_Lf, arg); end;

function TRF_StrDE(event, ...)
	if type(TRF_Opt) == "function" and TRF_Opt("log") >= 2 then tinsert(arg, 1, event); call(TRF_StrE, arg); end;
end;

function TRF_StrCl(x, lo, hi)
	if x < lo then return lo; end;
	if x > hi then return hi; end;
	return x;
end;

-- Tune keys (spec 6): str_up / str_dn the most % of a step up / down at the far end of a band, str_up_t the scores
-- where tier 2, 3, 4 start, str_dn_t the scores below which tier 2, 3, 4 fall back (hysteresis).
function TRF_Str_TuneDef()
	return {str_up=60, str_dn=20, str_up_t={25, 50, 75}, str_dn_t={20, 45, 70}};
end;

-- Number key k of tune table s, else d; floor, within lo..hi.
function TRF_StrNum(s, k, d, lo, hi)
	local x = nil;
	if type(s) == "table" then x = s[k]; end;
	if type(x) ~= "number" then x = d; end;
	return TRF_StrCl(floor(x), lo, hi);
end;

-- Three-entry list key k of tune table s, else d; every entry floor, within 1..99 (a missing entry from d).
function TRF_StrList(s, k, d)
	local x = nil;
	if type(s) == "table" then x = s[k]; end;
	local w = {};
	for i = 1, 3 do
		local e = nil;
		if type(x) == "table" then e = x[i]; end;
		if type(e) ~= "number" then e = d[i]; end;
		w[i] = TRF_StrCl(floor(e), 1, 99);
	end;
	return w;
end;

-- 1 when the up thresholds u and the down thresholds w rise strictly and w[i] <= u[i] (no tier flips at one score).
function TRF_StrThOk(u, w)
	for i = 1, 3 do
		if w[i] > u[i] then return nil; end;
		if i > 1 and (u[i] <= u[i - 1] or w[i] <= w[i - 1]) then return nil; end;
	end;
	return 1;
end;

-- Tune values of this module, clamped; a threshold pair that fails TRF_StrThOk reads as the defaults. Cached in the
-- handle table (strt) while TRF_Tune returns the same table; callers must not write into it.
function TRF_StrTune()
	local s, h = nil, nil;
	if type(TRF_Tune) == "function" then s = TRF_Tune(); end;
	if type(s) ~= "table" then s = nil; end;
	if s and type(TRF_H) == "function" then h = TRF_H(); end;
	if type(h) == "table" and type(h.strt) == "table" and h.strt.s == s then return h.strt.t; end;
	local d = TRF_Str_TuneDef();
	local t = {str_up=TRF_StrNum(s, "str_up", d.str_up, 0, 100), str_dn=TRF_StrNum(s, "str_dn", d.str_dn, 0, 100)};
	local u, w = TRF_StrList(s, "str_up_t", d.str_up_t), TRF_StrList(s, "str_dn_t", d.str_dn_t);
	if not TRF_StrThOk(u, w) then u = d.str_up_t; w = d.str_dn_t; end;
	t.str_up_t = u;
	t.str_dn_t = w;
	if type(h) == "table" then h.strt = {s=s, t=t}; end;
	return t;
end;

-- Score ---------------------------------------------------------------------------------

-- A score value: floor, within 0..99; 0 when not a number.
function TRF_StrSc(v)
	if type(v) ~= "number" then return 0; end;
	return TRF_StrCl(floor(v), 0, 99);
end;

-- Score 0..99 of one side (spec 4.1): kind "clan" the clan score of region slot id (TRF_ClanScore), "trade" the
-- prosperity 0..9 of system id times 11 (TRF_Pro, else the saved TRF.sys[id].pro as trf_tier's TRF_TrPro reads it),
-- "merc" the fortune of mercenary clan id (TRF_McDig, read only). Unknown kind or a missing module: 0.
function TRF_StrScore(kind, id)
	if kind == "clan" then return TRF_StrSc(TRF_N("TRF_ClanScore", id)); end;
	if kind == "trade" then
		local p = TRF_N("TRF_Pro", id);
		if p == nil and type(TRF) == "table" and type(TRF.sys) == "table" and type(id) == "number" and type(TRF.sys[id]) == "table" then
			p = TRF.sys[id].pro;
		end;
		if type(p) ~= "number" then return 0; end;
		return TRF_StrSc(TRF_StrCl(floor(p), 0, 9) * 11);
	end;
	if kind == "merc" then return TRF_StrSc(TRF_N("TRF_McDig", id, "fo")); end;
	return 0;
end;

-- Tier ----------------------------------------------------------------------------------

-- Plain band of score sc: 1 + the number of up thresholds U at or below sc (defaults: floor(sc / 25) + 1).
function TRF_StrBand(sc, U)
	local t = 1;
	while t < 4 and sc >= U[t] do t = t + 1; end;
	return t;
end;

-- Tier 1..4 of score with hysteresis (spec 4.2): from prev up while score >= str_up_t[t], down while score <
-- str_dn_t[t - 1]; prev nil (or not a number): the plain band.
function TRF_StrTier(score, prev)
	local T = TRF_StrTune();
	local sc = TRF_StrSc(score);
	if type(prev) ~= "number" then return TRF_StrBand(sc, T.str_up_t); end;
	local t = TRF_StrCl(floor(prev), 1, 4);
	while t < 4 and sc >= T.str_up_t[t] do t = t + 1; end;
	while t > 1 and sc < T.str_dn_t[t - 1] do t = t - 1; end;
	return t;
end;

-- Commits the clan tier of region slot (TRF_ClanTier, the hysteresis tier of the score and the saved digit) into
-- TRF.clan[slot].tr. A change logs event=tier at level 1, an unchanged tier at level 2. via: "tick" or "event".
-- Returns the tier, nil without a clan record.
function TRF_StrClanSet(slot, via)
	local c = TRF_N("TRF_ClanRec", slot);
	if type(c) ~= "table" or type(c.sc) ~= "number" then return nil; end;
	local t = TRF_N("TRF_ClanTier", slot) or TRF_StrTier(c.sc, c.tr);
	local pv = c.tr;
	c.tr = t;
	local pl = pv;
	if type(pl) ~= "number" then pl = "none"; end;
	if pv ~= t then
		TRF_StrE("tier", "slot", slot, "score", TRF_StrSc(c.sc), "tier", t, "prev", pl, "via", via, "result", "changed");
	else
		TRF_StrDE("tier", "slot", slot, "score", TRF_StrSc(c.sc), "tier", t, "prev", pl, "via", via, "result", "kept");
	end;
	return t;
end;

-- Region tick hook (trf_region TRF_RegionTick, after the phase advances): commits the clan tier of every region slot.
function TRF_Str_RegionTick(L)
	local m = TRF_N("TRF_RgMap");
	if type(m) ~= "table" or type(m.n) ~= "number" then return; end;
	for slot = 1, m.n do TRF_StrClanSet(slot, "tick"); end;
end;

-- Tier table (spec 4.3) -----------------------------------------------------------------

-- One row per tier 1..4. Raid (v02 5.3, v1 6.1; trf_raid TRF_Rd_TierRows returns these rows): row band lo..hi in
-- Pir_Fighters / Pir_Bombers, power band plo..phi and offset off to sys_base, Pir_Pilots index of lead and wings
-- (NORMAL), ships ns and the second flight ns2 (T3, T4). dp: nest power step (nest-spec 5.3; an explicit cfg tune
-- nest_dp wins). cap: rows a wanted captain's hull sits above the band (captain-spec 5.3). cls: stash class
-- (stash-spec 5.3; trf_stash adds the salvage step).
function TRF_StrRows()
	return {
		{lo=1, hi=4, plo=1, phi=6, off=-3, lead=1, wing=1, ns=2, dp=-1, cap=1, cls=1},
		{lo=5, hi=9, plo=4, phi=11, off=0, lead=2, wing=1, ns=4, dp=0, cap=1, cls=1},
		{lo=10, hi=14, plo=8, phi=15, off=2, lead=3, wing=2, ns=4, ns2=3, dp=1, cap=1, cls=2},
		{lo=15, hi=18, plo=11, phi=18, off=3, lead=4, wing=3, ns=4, ns2=4, dp=1, cap=1, cls=3}
	};
end;

-- Row of tier T (clamped 1..4).
function TRF_StrRow(T)
	if type(T) ~= "number" then T = 1; end;
	return TRF_StrRows()[TRF_StrCl(floor(T), 1, 4)];
end;

-- Chance curve (spec 4.4) ---------------------------------------------------------------

-- Base tier b (the plain band of score), chance_up and chance_down in % for score: x = position of the score in its
-- band of width w (band edges 0, str_up_t, 100); up = floor(x * str_up / w), down = floor((w - x) * str_dn / w), at most
-- 100 - up. Integer arithmetic, so the defaults give exactly floor(f * 60) and floor((1 - f) * 20), f = mod(sc, 25) / 25.
function TRF_StrChance(score)
	local T = TRF_StrTune();
	local sc = TRF_StrSc(score);
	local U = T.str_up_t;
	local b = TRF_StrBand(sc, U);
	local e = {0, U[1], U[2], U[3], 100};
	local w = e[b + 1] - e[b];
	local x = sc - e[b];
	local cu = floor(x * T.str_up / w);
	local cd = min(floor((w - x) * T.str_dn / w), 100 - cu);
	return b, cu, cd;
end;

-- One level step for score with roll 0..99 (supplied by the caller): step +1 when roll < chance_up, -1 when roll >=
-- 100 - chance_down, else 0; roll nil: step 0 (the chances only). Returns tier (base + step within 1..4), step,
-- chance_up, chance_down, base tier.
function TRF_StrRoll(score, roll)
	local b, cu, cd = TRF_StrChance(score);
	local st = 0;
	if type(roll) == "number" then
		if roll < cu then st = 1; elseif roll >= 100 - cd then st = -1; end;
	end;
	return TRF_StrCl(b + st, 1, 4), st, cu, cd, b;
end;

-- 1 when a roll can change the tier of score (a non-zero chance in a direction the band allows): callers draw no
-- random number otherwise.
function TRF_StrRollUseful(score)
	local b, cu, cd = TRF_StrChance(score);
	if (cu > 0 and b < 4) or (cd > 0 and b > 1) then return 1; end;
	return nil;
end;

-- Highest tier TRF_StrRoll can give for score (the base tier, one up when a step up has a chance), 1..4; trf_tier's
-- TRF_BandCaps reports it as tmax.
function TRF_StrTierMax(score)
	local b, cu = TRF_StrChance(score);
	if cu > 0 then b = b + 1; end;
	return TRF_StrCl(b, 1, 4);
end;
