-- Repo default; install-test.sh overwrites this file with the selected experiment.
-- exp: 0 = loader only, 1 = E0.1 hooks, 2 = E0.2 state, 3 = E0.3 trader. log: 0 silences TRF_L.
-- autosave: 1 = baseline save kit (exp_saves.script), 2 = the same without the mission 1 guard, 0 = off.
-- Optional keys: big=1 (E0.2 1000-entry table), del_on_jump=1 (E0.3 deletes live flights before a jump).
-- traffic: 1 = load the v0.1 traffic modules when exp is 0 (missing key = 1), 0 = loader and kits only.
-- Further v0.1 keys and their defaults: design/v01-spec.md 9 (TRF_OptDef in trf_state.script).
-- v0.2 keys (design/v02-spec.md 10.4), listed here with their defaults; a missing key reads the default of the
-- module's TRF_<M>_OptDef(). enabled 2 = restore changed station prices (and remove pirate bases) and stop;
-- pro_set is for the test clone. v1 keys (design/v1-spec.md 10.5), defaults of the v1 modules; tier_cap 4.
-- hail_xml: 1 = Data/Scripts/Trade/TRF_Hail.xml is installed (written by install.sh / install-test.sh when they
-- copied it). Tune hail_box (tune={hail_box=N}): 0 = hail answers as radio lines, 1 = ShowMsgBox chain (default),
-- 2 = the hail menu as the trade dialog TRF_Hail (needs hail_xml=1; otherwise the box chain runs), every follow-up as a
-- page of TRF_HailPg (design/hail-spec.md 2). hail_fight (default 1) = 0 turns the combat hail off (hail-spec 3: a
-- trader in a fight answers "busy" or offers help pay); tune hail_fight_r, hail_help_ratio, help_k (trf_hail TuneDef).
-- Worldbuilding plumbing (design/wb-plumbing-spec.md): wb_box_after_fee (default 0) = 1 allows an offer box at the
-- trade dock after a station fee box (set once E0.6 passes); tune help_floor/help_decay (C1) and leg_cap (D1).
-- Survivors and beacons (design/survivors-spec.md 6): enable_survivors (default 1) = 0 turns trf_survive off; the
-- other sv_* keys and the tune keys (k_pod, sv_ttl, ...) read their module defaults when missing.
-- Faction service ladder (design/ladder-spec.md 6): lad_enabled (default 1) = 0 turns trf_ladder off; lad_rankline,
-- lad_permit, lad_settle, lad_handin, lad_gibdd, lad_reset_sync (step 1) and lad_escort, lad_depot, lad_warrant
-- (step 2, read nowhere yet) are the toggles; the tune keys (c_p, permit_legs, ...) read the module TuneDef.
-- Charter goals (design/charter-spec.md 6): charter (default 1) = 0 turns trf_charter off; ch_deny = extra lowercase
-- system names; the tune keys (ch_unlock_ch, ch_pay_gap_rs, ch_dues_k, ...) read the module TuneDef.
-- Battle scars (design/scar-spec.md 6): enable_scars (default 1) = 0 turns trf_scar off; enable_scar_loot (step 1)
-- and enable_scavengers, enable_scar_recorder, enable_salvage_licence (step 2, read nowhere yet) are the toggles; the
-- tune keys (scar_max, scar_ttl, scar_cd, vcap_lw, ...) read the module TuneDef.
-- Wanted captains (design/captain-spec.md 6): cap_enable (default 1) = 0 turns trf_captain off; cap_board, cap_intel,
-- cap_chase (step 1) and cap_capture, cap_force_eject, cap_vendetta (step 2, read nowhere yet, off) are the toggles;
-- cap_regions_off, cap_at and the tune keys (cap_flee_hp, cap_gap_j, cap_k0, ...) read the module defaults.
-- Clan stashes (design/stash-spec.md 6): enable_stashes (default 1) = 0 turns trf_stash off (cache objects deleted at
-- entry); enable_stash_retrieval (treasurer flights) is the step 1 toggle; enable_stash_decoys (dropped, 00 section 8
-- E3) and stash_ret_war (group war while Pirates are not at war with the player, 00 E2) stay 0; stash_at and the tune
-- keys (stash_gap, stash_ttl, stash_intel_k, ...) read the module defaults.
-- Wolves Freight (design/freight-spec.md 6): enable_freight (default 1) = 0 turns trf_freight off (no box, no lines, no
-- ticks, no on-screen ship); fw_onscreen and fw_losses are the step 1 toggles; fw_max_ships stays 1 (slots 2 and 3 are
-- step 2); fw_prize_gap 1 holds a payout in the shared prize gap, fw_marker 1 marks the on-screen ship; the tune keys
-- (fw_k, fw_price_k, fw_tick_real, fw_bank, ...) read the module defaults.
-- Dynamic nests (design/nest-spec.md 6): nest (default 0 until CHECK E16.1-E16.5 pass) = 1 lets the regional clans field
-- the scripted pirate flights; nest_mode 1 the substituting NewPirateFlight wrapper, 2 the fallback (vanilla builds,
-- the mod deletes and replaces); nest_off, nest_trig, nest_lines, nest_mirror, nest_grudge_war (step 2, 0) and the tune
-- keys (nest_f, nest_regen_pct, nest_regen_legs, nest_cache_r, ...) read the module defaults; nest_dp only when set in
-- the cfg tune, else the dp column of the strength table.
-- Strength scale (design/strength-spec.md 6): no toggle (trf_str is always on); tune str_up (60), str_dn (20) and the
-- threshold lists str_up_t ({25, 50, 75}) and str_dn_t ({20, 45, 70}) read the TRF_Str_TuneDef defaults.
-- Pirate fit variety (design/fits-spec.md 6): fits (default 0 until CHECK D-FIT.1-4 pass; install-test.sh FITS=1) = 1 gives
-- every pirate nest, raid and garrison flight one grade roll (elite, scrap, a captured fit); fits_gate 1 keeps quest-gated
-- visits fully vanilla (0: captured fits only there); fits_test (debug, install-test.sh FITS_TEST) a ShipDescription or
-- carcass name spawned as one neutral test ship at every entry (CHECK E-BB1); the tune keys (fits_elite_max, fits_base_a,
-- fits_base_p, fits_cap_pct, fits_scrap_sc, fits_test_mods) read the TRF_Ft_TuneDef defaults.
-- Sealed parcels (design/parcel-spec.md 6): enable_parcels (default 1) = 0 turns trf_parcel off (no offer, no lines;
-- an open job waits); enable_contraband, enable_customs, enable_intercept (step 2, read nowhere yet, off); pcl_prize_gap,
-- pcl_logbook, pcl_probe, pcl_deny, pcl_deny_ch and the tune keys (pcl_k, pcl_gap, pcl_ban, pcl_dep_k, ...) read the
-- module defaults.
-- Demand result page (design/demand-page-spec.md): demand_page (default 1) = 0 says the demand answer as a line (no
-- page, no No witnesses); tune demand_k, witness_t, witness_r, witness_dead read the trf_supply TuneDef. demand_drop
-- (default 0, until E0.4 confirms drops) = 1 leaves the robbed stacks in a cargo01_destroyed_inv container beside the
-- trader instead of the mothership.
-- Named mercenary pilots (design/proposals/merc-pilot-names.md, option B): mc_names (default 0) = 2 means the
-- TRF_McP_ templates are merged into Data/Game/Pilots.xml (written by install.sh --pilots, 0 again when a re-run
-- without --pilots reverts the merge); trf_merc then passes the TRF_McP_ templates to its flights.
-- Mercenary clans, group war against the player (design/merc-spec.md 4, 00 section 8 E2; defaults in TRF_Pl_OptDef):
-- merc_war (betrayal fight-back and a refused payment answered with an attack; 1, the default: the pack fights back;
-- 0: a betrayed pack leaves through its portal), merc_hunt (announced hunters), merc_hostile (rival HOSTILE meetings),
-- merc_legion (the Black Legion's rival entry and HOSTILE variant); the last three 0 until CHECK E0.13 passes.
-- Mercenary clans (design/merc-spec.md 7): merc (default 0 until CHECK E0.13, the release gate, passes; install-test.sh
-- MERCS=1) = 1 runs the clan record (fortune, stages and roles at the region tick) and the hire role (step 3: hire offers
-- from chapter 5, the hired wing across jumps, pages TRF_MercPg with hail_xml 1 and tune hail_box 2); merc_board (the
-- patrol board line and, in chapters 1-4, the Black Legion legend line); merc_book, merc_report, merc_marker,
-- merc_calls, merc_transfer, rv_enabled (rival role, 0: no clan becomes a rival) and mc_launch are the toggles of the
-- later steps; mc_el_c the elite clan (8 Black Legion, 0 off); rv_deny and the tune keys (c_hire, merc_*, mc_*,
-- mc_el_*, rv_*) read the module defaults.
function TRF_Config() return {exp=0, log=1, autosave=0, traffic=1,
	enabled=1, cycle=1, prosperity=1, tier_cap=4, cap_traders=5, cap_ships=20, spawn_scale=1.0, band_half=0,
	parked=1, esc_flight=1, seed=1, queue=1, raids=1, staged=1, contracts=1, esc_speed=0, meet=2, hail_start=2, board=1,
	shop_mode=1, short_price=1, restore=1, news_mode=1, heat_war=0, strict=1, pro_set={},
	track=1, conv=1, demand=1, heat_offer=1, carriers=1, salvage=1, salv_addmod=0, clan_ace=0, sweeps=1,
	sweep_ct=1, po=1, tt4=1, tt4_split=0, feq=1, forced_bust=1, dconv=1, dc_speed=1, bases=1, base_glow=0,
	wreck=0, lang="en", loc_mode=0, hail_xml=0, hail_fight=1, enable_survivors=1,
	lad_enabled=1, lad_rankline=1, lad_permit=1, lad_settle=1, lad_handin=1, lad_gibdd=1, lad_reset_sync=1,
	lad_escort=1, lad_depot=1, lad_warrant=1, charter=1,
	enable_scars=1, enable_scar_loot=1, enable_scavengers=1, enable_scar_recorder=1, enable_salvage_licence=1,
	cap_enable=1, cap_board=1, cap_intel=1, cap_chase=1, cap_capture=0, cap_force_eject=0, cap_vendetta=0,
	enable_stashes=1, enable_stash_retrieval=1, enable_stash_decoys=0, stash_ret_war=0,
	enable_freight=1, fw_max_ships=1, fw_onscreen=1, fw_losses=1, fw_prize_gap=1, fw_marker=1,
	nest=0, nest_mode=1, fits=0, fits_gate=0, fits_test="",
	enable_parcels=1, enable_contraband=0, enable_customs=0, enable_intercept=0,
	demand_page=1, demand_drop=0, mc_names=0,
	merc_war=1, merc_hunt=0, merc_hostile=0, merc_legion=0,
	merc=0, merc_board=1, merc_book=0, merc_report=0, merc_marker=0, merc_calls=0, merc_transfer=0, rv_enabled=0,
	mc_launch=0, mc_el_c=8} end
