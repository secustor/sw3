-- sw3-traffic v0.1 safety module (Lua 4.0.1). Spec: design/v01-spec.md 2.3, 4.2, 5.1, 5.2, 6, 10.2.
-- Rules: R2 flags, R3 extortion debounce, R5 switch and deny list, R10 station by label, R16 starting-region
-- guard (used as a vanilla fallback, spec 11 decision 4), caps, governor and visit kill cap.
-- Layout: accessors (one native or engine global each), pure predicates (*Of, explicit inputs, host-testable),
-- then the contract functions that gather inputs and call the predicates.
-- Top level defines functions only; state lives in TRF.live (plain data), handles in TRF_H().
-- Extra TRF.live fields owned here: pmn (1 once __sys_Pirate_Money was nil this visit), sl (last TRF_Supp
-- level, for logging), sm (last TRF_SysMode result, for logging), gv (1 once the governor ran on this live
-- table), stl (1 when the station was lost this visit), sck (1 once the station was checked). TRF_LiveReset
-- seeds capt/caps from cfg and stok = 0; gv and stl tell those defaults from results. gen may set inval (reason string) when a
-- trader contact fails validation (4.2); TRF_SysMode then returns "vanilla" for the rest of the visit.
-- v0.2 (design/v02-spec.md 8.3, 9.1, 9.5, 10.2): strict gate R4 with the deny list, band caps, spawn gate by
-- kind, enabled 2, entry precedence (design 6.5), TRF_Safety_Dump. Extra live fields: gvn (carcass count of
-- the last governor run), capp (cap_parked), gl (last logged gate denial), gate (gate summary at activate).

-- Helpers --------------------------------------------------------------------------

function TRF_SafeL(s)
	TRF_L("safe: "..s);
end;

-- Debug line (cfg log 2).
function TRF_SafeD(s)
	local lv = TRF_SafeOpt("log", 1);
	if type(lv) == "number" and lv >= 2 then TRF_L("safe: "..s); end;
end;

-- Error handler of protected calls into other modules.
function TRF_SafePErr(m)
	if type(TRF_PErr) == "function" then TRF_PErr("safe: "..tostring(m)); else TRF_Err("safe: "..tostring(m)); end;
end;

-- Config value through trf_state's TRF_Opt, else the raw config, else def.
function TRF_SafeOpt(key, def)
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil then v = TRF_Cfg()[key]; end;
	if v == nil then v = def; end;
	return v;
end;

-- Numeric tune constant (spec 9 `tune`): TRF_Tune(), else cfg tune, else def.
function TRF_SafeTune(key, def)
	local v = nil;
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" then v = t[key]; end;
	end;
	if type(v) ~= "number" then
		local t = TRF_Cfg().tune;
		if type(t) == "table" then v = t[key]; end;
	end;
	if type(v) ~= "number" then v = def; end;
	return v;
end;

function TRF_SafeNum(v, def)
	if type(v) == "number" then return v; end;
	return def;
end;

function TRF_SafeClamp(v, lo, hi)
	if v < lo then return lo; end;
	if v > hi then return hi; end;
	return v;
end;

-- Visit table, or nil before trf_state has built it (nothing is created here).
function TRF_SafeLive()
	if type(TRF) == "table" and type(TRF.live) == "table" then return TRF.live; end;
	return nil;
end;

function TRF_SafeH()
	if type(TRF_H) == "function" then
		local h = TRF_H();
		if type(h) == "table" then return h; end;
	end;
	return nil;
end;

-- Mod game clock (clock.gt; v1 layout clock.game).
function TRF_SafeGt()
	if type(TRF) ~= "table" or type(TRF.clock) ~= "table" then return 0; end;
	if type(TRF.clock.gt) == "number" then return TRF.clock.gt; end;
	return TRF_SafeNum(TRF.clock.game, 0);
end;

function TRF_SafeStat(k)
	local L = TRF_SafeLive();
	if not L then return; end;
	if type(L.stat) ~= "table" then L.stat = {}; end;
	L.stat[k] = TRF_SafeNum(L.stat[k], 0) + 1;
end;

-- name in a list of names ({"elio"}) or a set ({elio=1}); case-insensitive.
function TRF_SafeIn(list, name)
	if type(list) ~= "table" or type(name) ~= "string" then return nil; end;
	name = strlower(name);
	for k, v in list do
		if type(v) == "string" and strlower(v) == name then return 1; end;
		if type(k) == "string" and strlower(k) == name and v and v ~= 0 then return 1; end;
	end;
	return nil;
end;

-- Map: trf_state's cached TRF_Map(), else the generated TRF_MapData().
function TRF_SafeMap()
	if type(TRF_Map) == "function" then
		local m = TRF_Map();
		if type(m) == "table" then return m; end;
	end;
	if type(TRF_MapData) == "function" then return TRF_MapData(); end;
	return nil;
end;

-- Map entry of the current system and its idx, or nil (M13: not in the map).
function TRF_SafeSys()
	local m = TRF_SafeMap();
	if type(m) ~= "table" or type(m.sys) ~= "table" then return nil; end;
	local idx = nil;
	if type(TRF_CurIdx) == "function" then
		idx = TRF_CurIdx();
	else
		local n = TRF_Safe_Loc();
		if type(n) == "string" and type(m.by) == "table" then idx = m.by[strlower(n)]; end;
	end;
	if type(idx) ~= "number" or type(m.sys[idx]) ~= "table" then return nil; end;
	return m.sys[idx], idx;
end;

-- Accessors: one native or engine global each --------------------------------------

function TRF_Safe_Loc()
	return TRF_N("GetCurrentLocation");
end;

-- CurrentQuest label; nil when never set (mission 1).
function TRF_Safe_Quest()
	return TRF_N("GetQuestLabel", "CurrentQuest");
end;

-- 1 while a story mission is active, else nil. Called without arguments as OutOfMission.script 386 does.
-- CHECK: GetPlayerQuestState() is TRUE while a story mission is active (fallback: cfg guard 2).
-- A missing native counts as active, so the guard and the deny list stay on the vanilla side.
function TRF_Safe_QState()
	if type(GetPlayerQuestState) ~= "function" then return 1; end;
	if GetPlayerQuestState() == TRUE then return 1; end;
	return nil;
end;

-- Suppression globals (R2): dis = __disableAction, sos = __sys_SOS, money = __sys_Pirate_Money is a number.
function TRF_Safe_Flags()
	local f = {};
	if __disableAction == TRUE then f.dis = 1; end;
	if __sys_SOS == TRUE then f.sos = 1; end;
	if type(__sys_Pirate_Money) == "number" then f.money = 1; end;
	return f;
end;

-- Extortion flight alive. flight_pir_mon_1 is userdata that survives ClearGlobals and may come from an
-- earlier scene: callers touch it only after ext_seen (spec 6).
function TRF_Safe_ExtAlive()
	local fl = flight_pir_mon_1;
	if fl == nil or type(fl) == "number" or type(fl) == "string" or type(fl) == "function" then return nil; end;
	return TRF_Is(fl:IsAlive());
end;

-- Carcasses in a sphere at the origin (governor, 5.2). CHECK: never used by shipped scripts; nil = unknown.
function TRF_Safe_Count(r)
	if type(Vector3) ~= "function" then return nil; end;
	local n = TRF_N("GetCarcassCountInSphere", Vector3(0, 0, 0), r);
	if type(n) ~= "number" then return nil; end;
	return n;
end;

-- Live object with that label, or nil (R10).
function TRF_Safe_StObj(label)
	if type(label) ~= "string" or label == "" or type(GetObjectByLabel) ~= "function" then return nil; end;
	local o = GetObjectByLabel(label);
	if o and TRF_Is(o:IsAlive()) then return o; end;
	return nil;
end;

-- Pure predicates ------------------------------------------------------------------

-- Chapter from a CurrentQuest label: leading digits ("4_1" -> 4, "12a" -> 12); nil, "" or no digits -> 0 (<= 4).
function TRF_ChapterOf(lbl)
	if type(lbl) == "number" then return lbl; end;
	if type(lbl) ~= "string" then return 0; end;
	local a, b = strfind(lbl, "^%d+");
	if not a then return 0; end;
	return tonumber(strsub(lbl, a, b)) or 0;
end;

-- System mode (2.3). s = {enabled, override, guard, sys (map entry or nil), off, deny, deny2 (name lists),
-- inval (reason or nil), qs (1 = mission active), ch (chapter)}. Returns "mod" or "vanilla", reason.
-- Reasons: off (enabled 0, override 0 or unknown), restore (enabled 2), observe (override 2), nomap, sys_off,
-- inval, deny, guard.
function TRF_SysModeOf(s)
	if s.enabled == 0 then return "vanilla", "off"; end;
	if s.enabled == 2 then return "vanilla", "restore"; end;
	if s.override == 2 then return "vanilla", "observe"; end;
	if s.override ~= 1 then return "vanilla", "off"; end;
	local sy = s.sys;
	if type(sy) ~= "table" or type(sy.name) ~= "string" then return "vanilla", "nomap"; end;
	if TRF_SafeIn(s.off, sy.name) then return "vanilla", "sys_off"; end;
	if s.inval then return "vanilla", "inval"; end;
	if s.qs and (TRF_SafeIn(s.deny, sy.name) or TRF_SafeIn(s.deny2, sy.name)) then return "vanilla", "deny"; end;
	-- R16 as fallback: guard 0 off, 2 start system and chapter <= 4, else (1) also needs an active mission.
	if s.guard ~= 0 and sy.start == 1 and TRF_SafeNum(s.ch, 0) <= 4 then
		if s.guard == 2 or s.qs then return "vanilla", "guard"; end;
	end;
	return "mod", nil;
end;

-- Suppression level (R2, R3): 0 none, 1 pause (no spawn, no line), 2 wind-down.
-- dis/sos: flags (1 or nil); gt: now; sos_t: gt when __sys_SOS was first seen TRUE (nil = not yet sampled);
-- ext: extortion flight alive; db: debounce seconds (30).
function TRF_SuppOf(dis, sos, gt, sos_t, ext, db)
	if dis then return 2; end;
	if not sos then return 0; end;
	if ext or type(sos_t) ~= "number" or gt - sos_t < db then return 1; end;
	return 2;
end;

-- Spawn gate (5.1). s = {supp, ntr, nsh (live traffic flights / ships), n (ships of the planned base row),
-- capt, caps (effective caps), kills, kcap (visit kill cap, <= 0 = off)}.
-- Returns 1, spare ships (room for added escorts) or nil, reason (supp, kills, cap, ships).
function TRF_CanSpawnOf(s)
	if s.supp ~= 0 then return nil, "supp"; end;
	if s.kcap > 0 and s.kills >= s.kcap then return nil, "kills"; end;
	if s.ntr >= s.capt then return nil, "cap"; end;
	if s.nsh + s.n > s.caps then return nil, "ships"; end;
	return 1, s.caps - s.nsh - s.n;
end;

-- Governor (5.2): more than gov carcasses -> one trader fewer (not below 1, never raised) and ships <= 12.
-- n nil (native missing) -> caps unchanged.
function TRF_GovernorOf(n, ct, cs, gov)
	if type(n) == "number" and n > gov then
		if ct > 1 then ct = ct - 1; end;
		if cs > 12 then cs = 12; end;
	end;
	return ct, cs;
end;

-- Live traffic flights and ships from the visit records (st ~= "gone", np = live ships).
function TRF_SafeCountOf(tr)
	local nt, ns = 0, 0;
	if type(tr) ~= "table" then return 0, 0; end;
	for id, r in tr do
		if type(r) == "table" and r.st ~= "gone" then
			nt = nt + 1;
			ns = ns + TRF_SafeNum(r.np, 0);
		end;
	end;
	return nt, ns;
end;

-- Wind-down action for one trader (spec 6, R3 row): "delete" farther than ovd (600) from the mothership or
-- distance unknown; "dock" on path A within np_max (300) of the station; else "portal" (ComeToPortal + exit).
function TRF_WindChoiceOf(path, d_ms, d_st, ovd, npmax)
	if type(d_ms) ~= "number" or d_ms > ovd then return "delete"; end;
	if path == "A" and type(d_st) == "number" and d_st <= npmax then return "dock"; end;
	return "portal";
end;

-- Strict gate R4 (v02 8.3). s = {mode (cfg strict: 0 never, 1 map, 2 every system), qs (1 = mission
-- active), q (1 = system named in Quests.xml), ent (deny entry or nil), f (feature)}. A feature set to 0
-- in the entry is off at any time (staged also by raid = 0). Returns 1 or nil, reason: deny_<f>,
-- mission_all (strict 2), mission_q, mission_deny.
function TRF_StrictOkOf(s)
	local e = s.ent;
	if type(e) == "table" and (e[s.f] == 0 or (s.f == "staged" and e.raid == 0)) then
		return nil, "deny_"..tostring(s.f);
	end;
	if s.mode == 0 or not s.qs then return 1; end;
	if s.mode == 2 then return nil, "mission_all"; end;
	if s.q == 1 then return nil, "mission_q"; end;
	if type(e) == "table" and e.m == 1 then return nil, "mission_deny"; end;
	return 1;
end;

-- Caps before the governor (9.1). b = TRF_BandCaps row {ct, cs, cp, ...} or nil, lt/ls = cfg limits,
-- gate = strict "band" result. No row or a failed gate -> band 0 row (2 / 10, no parked ship), which is
-- v0.1. Returns ct, cs, cp.
function TRF_SafeCapsOf(b, lt, ls, gate)
	local ct, cs, cp = 2, 10, 0;
	if gate and type(b) == "table" and type(b.ct) == "number" and type(b.cs) == "number" then
		ct = b.ct; cs = b.cs; cp = TRF_SafeNum(b.cp, 0);
	end;
	return min(ct, lt), min(cs, ls), cp;
end;

-- Spawn gate by kind (v02 10.2). s = the TRF_CanSpawnOf fields plus kind, gate (strict gate result for the
-- kind), gov (1 = governor active), nrf, nrs (open raid flights and their ships), rf, rs (raid caps 1 / 8),
-- npk (parked ships), cp (cap_parked). trader: v0.1. seed: gate + v0.1. staged: gate, no governor, free
-- raid slot and ship, then v0.1 for the trader (n = trader ships). raid: gate, no governor, raid caps (n = raid
-- ships). parked: gate, kill cap, cap_parked, ship cap. Returns 1, spare ships or nil, reason.
function TRF_CanSpawnKindOf(s)
	local k = s.kind;
	if s.supp ~= 0 then return nil, "supp"; end;
	if k ~= "trader" and not s.gate then return nil, "gate"; end;
	if k == "raid" or k == "staged" then
		if s.gov then return nil, "gov"; end;
		if s.nrf >= s.rf then return nil, "raid_cap"; end;
		local nr = 1;
		if k == "raid" then nr = s.n; end;
		if s.nrs + nr > s.rs then return nil, "raid_ships"; end;
		if k == "raid" then return 1, s.rs - s.nrs - nr; end;
	end;
	if k == "parked" then
		if s.kcap > 0 and s.kills >= s.kcap then return nil, "kills"; end;
		if s.npk >= s.cp then return nil, "parked_cap"; end;
		if s.nsh + s.n > s.caps then return nil, "ships"; end;
		return 1, s.caps - s.nsh - s.n;
	end;
	return TRF_CanSpawnOf(s);
end;

-- Open raid flights and their ships from live.rd (raid records with st ~= "end"; ns = ships spawned).
function TRF_SafeRaidsOf(rd)
	local nf, ns = 0, 0;
	if type(rd) ~= "table" then return 0, 0; end;
	for n, r in rd do
		if type(r) == "table" and r.st ~= "end" then
			nf = nf + 1;
			ns = ns + TRF_SafeNum(r.ns, 0);
		end;
	end;
	return nf, ns;
end;

-- Parked ships from live.pk (one entry per parked ship).
function TRF_SafeParkedOf(pk)
	local n = 0;
	if type(pk) ~= "table" then return 0; end;
	for k, v in pk do n = n + 1; end;
	return n;
end;

-- Entry precedence (design 6.5), evaluated once per entry. c = candidates that passed their own rules
-- (1 or nil), highest first: chase, sweep, convoy, staged, rec, seed (v0.2 has staged and seed only).
-- A chased record suppresses the staged raid; a sweep suppresses staged raid and seed; a convoy, the
-- staged raid and a docked record take the seed's place. Returns ent (highest candidate that runs, else
-- "none") and run = {staged = 1/nil, seed = 1/nil}.
function TRF_EntryPrecOf(c)
	local run = {};
	if c.staged and not (c.chase or c.sweep or c.convoy) then run.staged = 1; end;
	if c.seed and not (c.sweep or c.convoy or run.staged or c.rec) then run.seed = 1; end;
	local order = {"chase", "sweep", "convoy", "staged", "rec", "seed"};
	for i = 1, getn(order) do
		local k = order[i];
		if (k == "staged" or k == "seed") then
			if run[k] then return k, run; end;
		elseif c[k] then
			return k, run;
		end;
	end;
	return "none", run;
end;

-- Contract functions (spec 10.2) -----------------------------------------------------

-- Authored overrides (v02 8.3, design 9.8 S5, 9.9), lowercase system names. m = 1: vanilla generator
-- while a mission is active (R5); <feature> = 0: that feature never runs there. cfg sys_deny names add
-- m = 1 entries (TRF_DenyEntry).
function TRF_DenyList()
	return {
		elio   = {m=1, why="Elio rescue"},
		x297   = {m=1, why="X297 ambush"},
		gefest = {m=1, why="Grid/Hephaestus escape"},
		fronn  = {seed=0, raid=0, why="Triada warehouse exploit"},
	};
end;

-- R5 names: the m = 1 entries of TRF_DenyList, sorted.
function TRF_Deny()
	local out = {};
	for k, e in TRF_DenyList() do
		if type(e) == "table" and e.m == 1 then tinsert(out, k); end;
	end;
	sort(out);
	return out;
end;

-- Deny entry of a system name, or nil; a cfg sys_deny name adds m = 1.
function TRF_DenyEntry(name)
	if type(name) ~= "string" then return nil; end;
	name = strlower(name);
	local e = TRF_DenyList()[name];
	if type(e) ~= "table" then e = nil; end;
	if TRF_SafeIn(TRF_SafeOpt("sys_deny", {}), name) then
		if not e then e = {why="cfg sys_deny"}; end;
		e.m = 1;
	end;
	return e;
end;

-- The 24 systems never named in Game/Quests.xml (design 9.9): the q fallback for a map without q fields.
function TRF_StrictFree()
	return {altair=1, areko=1, b_leftera2=1, b_leftera3=1, callipso=1, egleon=1, escaflon=1, farles=1,
		fiasar=1, fort_russ=1, fronn=1, gaoba=1, golkonda=1, kitaro=1, lasad=1, llanovar1=1, llanovar2=1,
		sunji=1, tarrot=1, x244=1, xb13=1, xb19=1, xt17=1, xt27=1};
end;

-- Inputs of TRF_StrictOkOf for system idx (nil = current) and feature f; nil when idx has no map entry.
function TRF_StrictIn(idx, f)
	local sy = nil;
	if idx == nil then
		sy, idx = TRF_SafeSys();
	else
		local m = TRF_SafeMap();
		if type(m) == "table" and type(m.sys) == "table" and type(idx) == "number" then sy = m.sys[idx]; end;
	end;
	if type(sy) ~= "table" or type(sy.name) ~= "string" then return nil; end;
	local q = sy.q;
	if type(q) ~= "number" then
		q = 1;
		if TRF_StrictFree()[strlower(sy.name)] then q = 0; end;
	end;
	local mode = TRF_SafeOpt("strict", 1);
	if mode ~= 0 and mode ~= 1 and mode ~= 2 then mode = 1; end;
	return {mode=mode, qs=TRF_Safe_QState(), q=q, ent=TRF_DenyEntry(sy.name), f=f, name=sy.name, idx=idx};
end;

-- Strict gate (v02 8.3): 1 or nil, reason for system idx (nil = current) and feature (seed, raid, staged,
-- contract, parked, tt3, band, board). No map entry -> nil, "nomap". A denial counts gate_<feature> and is
-- logged when it differs from the last one logged this visit.
function TRF_StrictOk(idx, feature)
	local s = TRF_StrictIn(idx, feature);
	local ok, why = nil, "nomap";
	if s then ok, why = TRF_StrictOkOf(s); end;
	if ok then return 1, nil; end;
	TRF_SafeStat("gate_"..tostring(feature));
	local L = TRF_SafeLive();
	local nm = "nil";
	if s then nm = s.name; end;
	local k = tostring(feature)..":"..tostring(why)..":"..nm;
	if L and L.gl ~= k then
		L.gl = k;
		TRF_SafeL("gate "..tostring(feature).." denied why="..tostring(why).." sys="..nm);
	end;
	return nil, why;
end;

-- 1 while the governor holds (carcass count above gov): tier <= TT2, raids and staged raids off (9.1).
function TRF_GovActive()
	local L = TRF_SafeLive();
	if not L or type(L.gvn) ~= "number" then return nil; end;
	if L.gvn > TRF_SafeNum(TRF_SafeOpt("gov", 40), 40) then return 1; end;
	return nil;
end;

function TRF_Chapter()
	return TRF_ChapterOf(TRF_Safe_Quest());
end;

-- Caps for the next spawn decision (v02 9.1): band row of the live pro (TRF_BandCaps, trf_tier), cfg limits
-- (cap_traders 0..5, cap_ships 0..20), strict gate "band", then the governor on the carcass count n (nil:
-- the count of the last TRF_Governor run). Writes live.capt/caps/capp. Returns ct, cs, cp.
function TRF_SafeCaps(n)
	local lt = TRF_SafeClamp(floor(TRF_SafeNum(TRF_SafeOpt("cap_traders", 5), 5)), 0, 5);
	local ls = TRF_SafeClamp(floor(TRF_SafeNum(TRF_SafeOpt("cap_ships", 20), 20)), 0, 20);
	local sy, idx = TRF_SafeSys();
	local b, gate = nil, nil;
	if idx then
		gate = TRF_StrictOk(idx, "band");
		if gate and type(TRF_BandCaps) == "function" then b = call(TRF_BandCaps, {idx}, "x", TRF_SafePErr); end;
	end;
	local ct, cs, cp = TRF_SafeCapsOf(b, lt, ls, gate);
	local L = TRF_SafeLive();
	if n == nil and L then n = L.gvn; end;
	ct, cs = TRF_GovernorOf(n, ct, cs, TRF_SafeNum(TRF_SafeOpt("gov", 40), 40));
	if L then L.capt = ct; L.caps = cs; L.capp = cp; end;
	return ct, cs, cp;
end;

-- Inputs of TRF_SysModeOf from the game.
function TRF_SafeModeIn()
	local L = TRF_SafeLive();
	local inval = nil;
	if L then inval = L.inval; end;
	return {
		enabled = TRF_SafeOpt("enabled", 1),
		override = TRF_SafeOpt("override", 1),
		guard = TRF_SafeNum(TRF_SafeOpt("guard", 1), 1),
		sys = TRF_SafeSys(),
		off = TRF_SafeOpt("sys_off", {}),
		deny = TRF_Deny(),
		deny2 = TRF_SafeOpt("sys_deny", {}),
		inval = inval,
		qs = TRF_Safe_QState(),
		ch = TRF_Chapter()
	};
end;

-- "mod" or "vanilla", reason (2.3). Counts van_<reason> in live.stat; logs when the result changes.
function TRF_SysMode()
	local s = TRF_SafeModeIn();
	local m, why = TRF_SysModeOf(s);
	if why then TRF_SafeStat("van_"..why); end;
	local L = TRF_SafeLive();
	local k = m..":"..tostring(why);
	if L and L.sm ~= k then
		L.sm = k;
		local nm = "nil";
		if type(s.sys) == "table" then nm = tostring(s.sys.name); end;
		TRF_SafeL("mode "..m.." why="..tostring(why).." sys="..nm.." ch="..tostring(s.ch).." qs="..tostring(s.qs).." guard="..tostring(s.guard));
	end;
	return m, why;
end;

-- TRF_SysMode without the van_<reason> count and the change log (dump, arrival line).
function TRF_SysModeQuiet()
	return TRF_SysModeOf(TRF_SafeModeIn());
end;

-- 0 none, 1 pause, 2 wind-down (R2, R3). Reads the flags now, so a flag set since the last tick counts.
function TRF_Supp()
	local f = TRF_Safe_Flags();
	local L = TRF_SafeLive();
	local sos_t, ext = nil, nil;
	if L then
		sos_t = L.sos_t;
		if f.sos and not f.dis and L.ext_seen == 1 then ext = TRF_Safe_ExtAlive(); end;
	end;
	return TRF_SuppOf(f.dis, f.sos, TRF_SafeGt(), sos_t, ext, TRF_SafeTune("sos_db", 30));
end;

-- 1 once per suppression onset when a wind-down is due (sets live.wind); nil otherwise. For TRF_WindDown.
function TRF_SafeWindOnset()
	local L = TRF_SafeLive();
	if not L or L.wind == 1 or TRF_Supp() ~= 2 then return nil; end;
	L.wind = 1;
	TRF_SafeL("wind-down onset gt="..TRF_F(TRF_SafeGt()));
	return 1;
end;

-- Wind-down action from distances, with the tune values (see TRF_WindChoiceOf).
function TRF_WindChoice(path, d_ms, d_st)
	return TRF_WindChoiceOf(path, d_ms, d_st, TRF_SafeTune("ovd", 600), TRF_SafeTune("np_max", 300));
end;

-- Extortion tracking (spec 6), every tick. Returns the suppression level.
function TRF_SafetySample()
	local L = TRF_SafeLive();
	if not L then return TRF_Supp(); end;
	local f = TRF_Safe_Flags();
	local gt = TRF_SafeGt();
	if f.sos then
		if type(L.sos_t) ~= "number" then
			L.sos_t = gt;
			TRF_SafeD("sos on gt="..TRF_F(gt));
		end;
	elseif L.sos_t then
		L.sos_t = nil;
		TRF_SafeD("sos off gt="..TRF_F(gt));
	end;
	if f.money then
		if L.pmn == 1 and L.ext_seen ~= 1 then
			L.ext_seen = 1;
			TRF_SafeL("extortion seen gt="..TRF_F(gt));
		end;
	else
		L.pmn = 1;
	end;
	local s = TRF_Supp();
	-- wind is per onset; cleared only when neither flag is set, so a __disableAction wind-down runs once.
	if s == 0 then L.wind = nil; end;
	if s ~= TRF_SafeNum(L.sl, 0) then
		TRF_SafeL("supp "..TRF_SafeNum(L.sl, 0).."->"..s.." dis="..tostring(f.dis).." sos="..tostring(f.sos).." ext_seen="..tostring(L.ext_seen));
	end;
	L.sl = s;
	return s;
end;

-- 1, spare ships or nil, reason (5.1, v02 10.2). nships = ships of the planned base row (raid: raid ships);
-- kind trader (default), seed, staged, raid, parked (TRF_CanSpawnKindOf). Caps are recomputed per decision
-- (band read live); if the visit has no governor count yet (live reset after OnActivate/OnLoad) the
-- governor runs now. Parked ships count against cap_ships.
function TRF_CanSpawn(nships, kind)
	local L = TRF_SafeLive();
	if not L then return nil, "nolive"; end;
	if type(kind) ~= "string" then kind = "trader"; end;
	if L.gv ~= 1 then TRF_Governor(); else TRF_SafeCaps(); end;
	local ntr, nsh = TRF_SafeCountOf(L.tr);
	local npk = TRF_SafeParkedOf(L.pk);
	local nrf, nrs = TRF_SafeRaidsOf(L.rd);
	local gate = 1;
	if kind ~= "trader" then gate = TRF_StrictOk(nil, kind); end;
	local s = {
		kind = kind, supp = TRF_Supp(), ntr = ntr, nsh = nsh + npk, n = TRF_SafeNum(nships, 0),
		capt = TRF_SafeNum(L.capt, 0), caps = TRF_SafeNum(L.caps, 0), cp = TRF_SafeNum(L.capp, 0),
		kills = TRF_SafeNum(L.kills, 0), kcap = TRF_SafeTune("kill_cap", 3),
		gate = gate, gov = TRF_GovActive(), nrf = nrf, nrs = nrs, npk = npk,
		rf = TRF_SafeTune("raid_fl", 1), rs = TRF_SafeTune("raid_sh", 8)
	};
	local ok, r = TRF_CanSpawnKindOf(s);
	if not ok then
		TRF_SafeD("no spawn "..kind.." "..r.." tr="..ntr.."/"..s.capt.." ships="..s.nsh.."+"..s.n.."/"..s.caps
			.." raids="..nrf.."/"..nrs.." parked="..npk.."/"..s.cp.." kills="..s.kills.." supp="..s.supp);
	end;
	return ok, r;
end;

-- Governor (5.2): counts carcasses (live.gvn), then sets live.capt/caps/capp through TRF_SafeCaps.
-- Returns capt, caps, carcass count (nil when unknown).
-- CHECK: one sphere of gov_r (3000) at the origin covers a system.
function TRF_Governor()
	local gr = TRF_SafeNum(TRF_SafeOpt("gov_r", 3000), 3000);
	local n = TRF_Safe_Count(gr);
	local L = TRF_SafeLive();
	if L then L.gvn = n; L.gv = 1; end;
	local capt, caps, capp = TRF_SafeCaps(n);
	TRF_SafeL("governor n="..tostring(n).." r="..gr.." cap="..capt.."/"..caps.."/"..capp);
	return capt, caps, n;
end;

-- Trade station handle or nil (4.2, R10): label of the map's st[1] (kind "trade", top-level docking), then
-- IsAlive. Sets live.stok and H.st. Once lost (stl 1) it stays off for the visit; no such entry, no station.
function TRF_Station()
	local L = TRF_SafeLive();
	local H = TRF_SafeH();
	if L and L.stl == 1 then
		L.stok = 0;
		if H then H.st = nil; end;
		return nil;
	end;
	local sy = TRF_SafeSys();
	local lbl = nil;
	if type(sy) == "table" and type(sy.st) == "table" then
		local e = sy.st[1];
		if type(e) == "table" and e.kind == "trade" and e.cond ~= 1 then lbl = e.label; end;
	end;
	local o = TRF_Safe_StObj(lbl);
	if H then H.st = o; end;
	if not L then return o; end;
	local was = L.stok;
	if o then L.stok = 1; else L.stok = 0; end;
	if was == 1 and not o then
		L.stl = 1;
		TRF_SafeL("station "..tostring(lbl).." lost");
	elseif L.sck ~= 1 then
		TRF_SafeL("station label="..tostring(lbl).." ok="..L.stok);
	end;
	L.sck = 1;
	return o;
end;

-- Per-visit safety fields back to their start values (entry, load).
function TRF_SafeVisitReset()
	local L = TRF_SafeLive();
	if L then
		L.sos_t = nil; L.ext_seen = nil; L.pmn = nil; L.wind = nil; L.sl = nil; L.sm = nil;
		L.gv = nil; L.stl = nil; L.sck = nil; L.gvn = nil; L.gl = nil; L.gate = nil;
	end;
	local H = TRF_SafeH();
	if H then H.st = nil; end;
end;

-- Loader callbacks (10.1) ------------------------------------------------------------

function TRF_Safety_OnEnter()
	TRF_SafeVisitReset();
end;

function TRF_Safety_OnActivate()
	TRF_Governor();
	TRF_Station();
	local s = TRF_SafeModeIn();
	local m, why = TRF_SysModeOf(s);
	local nm = "nil";
	if type(s.sys) == "table" then nm = tostring(s.sys.name); end;
	local L = TRF_SafeLive();
	local g = TRF_SafeGateSum(nil);
	if L then L.gate = g; end;
	TRF_SafeL("activate sys="..nm.." mode="..m.." why="..tostring(why).." ch="..tostring(s.ch).." qs="..tostring(s.qs).." gate="..g);
end;

-- Gate summary of system idx (nil = current) without counters: "ok", or the first denial and the denied
-- features ("mission_q:seed,raid,..."), "nomap" without a map entry.
function TRF_SafeGateSum(idx)
	local s = TRF_StrictIn(idx, "seed");
	if not s then return "nomap"; end;
	local fs = {"seed", "raid", "staged", "contract", "parked", "tt3", "band", "board"};
	local first, list = nil, "";
	for i = 1, getn(fs) do
		s.f = fs[i];
		local ok, why = TRF_StrictOkOf(s);
		if not ok then
			if not first then first = why; end;
			if list ~= "" then list = list..","; end;
			list = list..fs[i];
		end;
	end;
	if not first then return "ok"; end;
	return first..":"..list;
end;

-- Dump line (v02 10.2): gate, strict inputs, caps, governor; called by TRF_DumpState.
function TRF_Safety_Dump()
	local s = TRF_StrictIn(nil, "seed");
	local L = TRF_SafeLive() or {};
	local nm, q, qs, mode, dn = "nil", "?", "?", "?", "none";
	if s then
		nm = s.name; q = tostring(s.q); qs = tostring(s.qs); mode = tostring(s.mode);
		if type(s.ent) == "table" then dn = tostring(s.ent.why); end;
	end;
	TRF_L("dump gate="..TRF_SafeGateSum(nil).." sys="..nm.." strict="..mode.." qs="..qs.." q="..q.." deny="..dn
		.." cap="..tostring(L.capt).."/"..tostring(L.caps).."/"..tostring(L.capp).." gov="..tostring(L.gvn)
		.." gov_on="..tostring(TRF_GovActive()));
end;

-- After a load sos_t restarts at the load time and ext_seen is nil (spec 6). TRF_Gen_OnLoad resets live
-- afterwards (capt/caps back to cfg, stok 0); TRF_CanSpawn reruns the governor (gv nil) and gen's next
-- TRF_Station call finds the station again (stl nil).
function TRF_Safety_OnLoad()
	TRF_SafeVisitReset();
	TRF_Governor();
	TRF_Station();
end;

function TRF_Safety_Tick()
	TRF_SafetySample();
end;
