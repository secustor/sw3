-- sw3-traffic v0.1 safety module (Lua 4.0.1). Spec: design/v01-spec.md 2.3, 4.2, 5.1, 5.2, 6, 10.2.
-- Rules: R2 flags, R3 extortion debounce, R5 switch and deny list, R10 station by label, R16 starting-region
-- guard (used as a vanilla fallback, spec 11 decision 4), caps, governor and visit kill cap.
-- Layout: accessors (one native or engine global each), pure predicates (*Of, explicit inputs, host-testable),
-- then the contract functions that gather inputs and call the predicates.
-- Top level defines functions only; state lives in TRF.live (plain data), handles in TRF_H().
-- Extra TRF.live fields owned here: pmv (__sys_Pirate_Money at the last tick, 0 when not a number; extortion
-- detection), exn (extortions seen this visit), ext (vanilla extortion fix: 1 player side held neutral, 2 war set), sl (last TRF_Supp
-- level, for logging), ss (last __sys_SOS flag 1/0, for logging), sm (last TRF_SysMode result, for logging), gv (1 once the governor ran on this live
-- table), stl (1 when the station was lost this visit), sck (1 once the station was checked). TRF_LiveReset
-- seeds capt/caps from cfg and stok = 0; gv and stl tell those defaults from results. gen may set inval (reason string) when a
-- trader contact fails validation (4.2); TRF_SysMode then returns "vanilla" for the rest of the visit.
-- v0.2 (design/v02-spec.md 8.3, 9.1, 9.5, 10.2): strict gate R4 with the deny list, band caps, spawn gate by
-- kind, enabled 2, entry precedence (design 6.5), TRF_Safety_Dump. Extra live fields: gvn (carcass excess of
-- the last governor run over the visit baseline gvn0; raw count gvr), capp (cap_parked), gl (last logged gate
-- denial), gate (gate summary at activate). H.gvn0 mirrors gvn0 across gen's load-pass live reset.
-- v1 (design/v1-spec.md 10.2, 10.4): deny list merged with trf_loc's TRF_Loc_Deny, the campaign-pass quest
-- ids (option 1 of design 9.9), strict-gate features of the v1 war traffic, spawn kinds with event bounds,
-- bands 3-4. Extra live fields: qa (quest state of the current system: 1, 0, -1 = no ids), qai (its idx).
-- Chunk local SQ caches the generated quest-id table per MapInitialization (never saved).
-- Handle fields owned here (TRF_H, never saved, new on every MapInitialization): st (station), sact (1 once the
-- visit is armed at the end of TRF_Safety_OnActivate or TRF_Safety_OnLoad), sms (mothership handle taken then);
-- intick (1 during the TRF_OnTick dispatch) is set by traffic.script. The combat sample reads game objects only
-- while sact is 1; no tick calls GetPlayerMotherShip (TRF_Safe_Ms, TRF_Ms; mod-research/crash-load-5adc5e.md:
-- that native dereferences the player team without a null check).

local SQ = {};

-- Helpers --------------------------------------------------------------------------

-- Event line of module safety (design/log-format.md): event, then key/value pairs.
function TRF_SafeE(event, ...)
	tinsert(arg, 1, event); tinsert(arg, 1, "safety"); call(TRF_Lf, arg);
end;

-- Debug event line (cfg log 2).
function TRF_SafeDE(event, ...)
	local lv = TRF_SafeOpt("log", 1);
	if type(lv) == "number" and lv >= 2 then tinsert(arg, 1, event); call(TRF_SafeE, arg); end;
end;

-- Error handler of protected calls into other modules: trf_state's TRF_PErr (event=error, stat err), else
-- an event=error line of this module.
function TRF_SafePErr(m)
	if type(TRF_PErr) == "function" then TRF_PErr(m); else TRF_SafeE("error", "message", tostring(m)); end;
end;

-- Config value through trf_state's TRF_Opt, else the raw config, else def.
function TRF_SafeOpt(key, def)
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil then v = TRF_Cfg()[key]; end;
	if v == nil then v = def; end;
	return v;
end;

-- Numeric tune constant (spec 9 `tune`): TRF_Tune(), else cfg tune, else def.
function TRF_SafeTune(key, def)
	local v = nil;
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" then v = t[key]; end;
	end;
	if type(v) ~= "number" then
		local t = TRF_Cfg().tune;
		if type(t) == "table" then v = t[key]; end;
	end;
	if type(v) ~= "number" then v = def; end;
	return v;
end;

function TRF_SafeNum(v, def)
	if type(v) == "number" then return v; end;
	return def;
end;

function TRF_SafeClamp(v, lo, hi)
	if v < lo then return lo; end;
	if v > hi then return hi; end;
	return v;
end;

-- Visit table, or nil before trf_state has built it (nothing is created here).
function TRF_SafeLive()
	if type(TRF) == "table" and type(TRF.live) == "table" then return TRF.live; end;
	return nil;
end;

function TRF_SafeH()
	if type(TRF_H) == "function" then
		local h = TRF_H();
		if type(h) == "table" then return h; end;
	end;
	return nil;
end;

-- Mod game clock (clock.gt; v1 layout clock.game).
function TRF_SafeGt()
	if type(TRF) ~= "table" or type(TRF.clock) ~= "table" then return 0; end;
	if type(TRF.clock.gt) == "number" then return TRF.clock.gt; end;
	return TRF_SafeNum(TRF.clock.game, 0);
end;

function TRF_SafeStat(k)
	local L = TRF_SafeLive();
	if not L then return; end;
	if type(L.stat) ~= "table" then L.stat = {}; end;
	L.stat[k] = TRF_SafeNum(L.stat[k], 0) + 1;
end;

-- name in a list of names ({"elio"}) or a set ({elio=1}); case-insensitive.
function TRF_SafeIn(list, name)
	if type(list) ~= "table" or type(name) ~= "string" then return nil; end;
	name = strlower(name);
	for k, v in list do
		if type(v) == "string" and strlower(v) == name then return 1; end;
		if type(k) == "string" and strlower(k) == name and v and v ~= 0 then return 1; end;
	end;
	return nil;
end;

-- Map: trf_state's cached TRF_Map(), else the generated TRF_MapData().
function TRF_SafeMap()
	if type(TRF_Map) == "function" then
		local m = TRF_Map();
		if type(m) == "table" then return m; end;
	end;
	if type(TRF_MapData) == "function" then return TRF_MapData(); end;
	return nil;
end;

-- Map entry of the current system and its idx, or nil (M13: not in the map).
function TRF_SafeSys()
	local m = TRF_SafeMap();
	if type(m) ~= "table" or type(m.sys) ~= "table" then return nil; end;
	local idx = nil;
	if type(TRF_CurIdx) == "function" then
		idx = TRF_CurIdx();
	else
		local n = TRF_Safe_Loc();
		if type(n) == "string" and type(m.by) == "table" then idx = m.by[strlower(n)]; end;
	end;
	if type(idx) ~= "number" or type(m.sys[idx]) ~= "table" then return nil; end;
	return m.sys[idx], idx;
end;

-- Accessors: one native or engine global each --------------------------------------

function TRF_Safe_Loc()
	return TRF_N("GetCurrentLocation");
end;

-- CurrentQuest label; nil when never set (mission 1).
function TRF_Safe_Quest()
	return TRF_N("GetQuestLabel", "CurrentQuest");
end;

-- 1 while a story mission is active, else nil. Called without arguments as OutOfMission.script 386 does.
-- CHECK: GetPlayerQuestState() is TRUE while a story mission is active. Not reliable (nil during an active
-- mission and for seconds after a jump), so only the deny list reads it. A missing native counts as active.
function TRF_Safe_QState()
	if type(GetPlayerQuestState) ~= "function" then return 1; end;
	if GetPlayerQuestState() == TRUE then return 1; end;
	return nil;
end;

-- Suppression globals (R2): dis = __disableAction, sos = __sys_SOS, scene = TRF_Safe_Scene() (the extortion
-- reads __sys_Pirate_Money in TRF_SafeExtFresh).
function TRF_Safe_Flags()
	local f = {};
	if __disableAction == TRUE then f.dis = 1; end;
	if __sys_SOS == TRUE then f.sos = 1; end;
	f.scene = TRF_Safe_Scene();
	return f;
end;

-- Scripted scene visible (R2): 1 while a mission movie plays (TRF_InMovie() == 1; when that native is missing
-- or returns -1, the game's MovieIsPlaying() == TRUE) or TRF_UiState() reports a flag (> 0: movie, modal
-- window on top, XML dialog open; missing or -1 = unknown, ignored), else nil. Natives: pe/traffic.c.
function TRF_Safe_Scene()
	local m = nil;
	if type(TRF_InMovie) == "function" then m = TRF_InMovie(); end;
	if m == 1 then return 1; end;
	if m ~= 0 and type(MovieIsPlaying) == "function" and MovieIsPlaying() == TRUE then return 1; end;
	if type(TRF_UiState) == "function" then
		local u = TRF_UiState();
		if type(u) == "number" and u > 0 then return 1; end;
	end;
	return nil;
end;

-- Extortion flight alive (IsAlive protected: after a payment vanilla deletes the flight and the handle stays).
-- flight_pir_mon_1 is userdata that survives ClearGlobals and may come from an earlier scene: callers touch it only
-- after ext_seen, or on the edge path once group_Pirate_money exists in this scene and is neutral toward the player
-- (spec 6, extort-fix-spec 3).
function TRF_Safe_ExtAlive()
	return TRF_Safe_Alive(flight_pir_mon_1);
end;

-- Carcasses in a sphere at the origin (governor, 5.2): every carcass, scenery included
-- (mod-research/carcass-count.md); nil = unknown.
function TRF_Safe_Count(r)
	if type(Vector3) ~= "function" then return nil; end;
	local n = TRF_N("GetCarcassCountInSphere", Vector3(0, 0, 0), r);
	if type(n) ~= "number" then return nil; end;
	return n;
end;

-- Live object with that label, or nil (R10).
function TRF_Safe_StObj(label)
	if type(label) ~= "string" or label == "" or type(GetObjectByLabel) ~= "function" then return nil; end;
	local o = GetObjectByLabel(label);
	if o and TRF_Is(o:IsAlive()) then return o; end;
	return nil;
end;

-- Pure predicates ------------------------------------------------------------------

-- Chapter from a CurrentQuest label: leading digits ("4_1" -> 4, "12a" -> 12); nil, "" or no digits -> 0 (<= 4).
function TRF_ChapterOf(lbl)
	if type(lbl) == "number" then return lbl; end;
	if type(lbl) ~= "string" then return 0; end;
	local a, b = strfind(lbl, "^%d+");
	if not a then return 0; end;
	return tonumber(strsub(lbl, a, b)) or 0;
end;

-- System mode (2.3). s = {enabled, override, guard, sys (map entry or nil), off, deny, deny2, denyq (name
-- lists; denyq = the deny names marked tq, teleport targets), inval (reason or nil), qs (1 = mission active),
-- strict (cfg strict, 0 skips the deny list), qa (TRF_SafeQQa: 1 a quest naming the system is in process, 0
-- none, nil unknown), transit (cfg transit), ch (chapter)}. Returns "mod" or "vanilla", reason.
-- Reasons: off (enabled 0, override 0 or unknown), restore (enabled 2), observe (override 2), nomap, sys_off,
-- inval, deny, deny_tq, guard.
function TRF_SysModeOf(s)
	if s.enabled == 0 then return "vanilla", "off"; end;
	if s.enabled == 2 then return "vanilla", "restore"; end;
	if s.override == 2 then return "vanilla", "observe"; end;
	if s.override ~= 1 then return "vanilla", "off"; end;
	local sy = s.sys;
	if type(sy) ~= "table" or type(sy.name) ~= "string" then return "vanilla", "nomap"; end;
	if TRF_SafeIn(s.off, sy.name) then return "vanilla", "sys_off"; end;
	if s.inval then return "vanilla", "inval"; end;
	-- cfg strict 0 (tests only) also ignores the deny list.
	if s.qs and s.strict ~= 0 then
		if TRF_SafeIn(s.deny2, sy.name) then return "vanilla", "deny"; end;
		if TRF_SafeIn(s.deny, sy.name) then
			if not TRF_SafeIn(s.denyq, sy.name) then return "vanilla", "deny"; end;
			-- Transit (cfg transit 1): a teleport target while no quest naming it is in process stays mod.
			if s.transit ~= 1 or s.qa ~= 0 then return "vanilla", "deny_tq"; end;
		end;
	end;
	-- R16: guard 0 off, 1 or 2 (2 kept for compatibility) start system and chapter <= 4, independent of qs.
	if s.guard ~= 0 and sy.start == 1 and TRF_SafeNum(s.ch, 0) <= 4 then return "vanilla", "guard"; end;
	return "mod", nil;
end;

-- Suppression level (R2, R3): 0 none, 1 pause (no spawn, no line), 2 wind-down.
-- dis/sos/scene: flags (1 or nil); gt: now; sos_t: gt when __sys_SOS was first seen TRUE (nil = not yet
-- sampled); ext: extortion flight alive; db: debounce seconds (30); sm: cfg sos_mode (nil = 1).
-- dis -> 2. sos_mode 1: __sys_SOS alone (vanilla _FTrader_exclude around scripted sequences) does not count;
-- a visible scene -> 1. sos_mode 2 (the old rule): sos -> 1, then 2 after db unless the extortion flight lives.
function TRF_SuppOf(dis, sos, gt, sos_t, ext, db, scene, sm)
	if dis then return 2; end;
	if sos and sm == 2 then
		if ext or type(sos_t) ~= "number" or gt - sos_t < db then return 1; end;
		return 2;
	end;
	if scene then return 1; end;
	return 0;
end;

-- Spawn gate (5.1). s = {supp, ntr, nsh (live traffic flights / ships), n (ships of the planned base row),
-- capt, caps (effective caps), kills, kcap (visit kill cap, <= 0 = off)}.
-- Returns 1, spare ships (room for added escorts) or nil, reason (supp, kills, cap, ships).
function TRF_CanSpawnOf(s)
	if s.supp ~= 0 then return nil, "supp"; end;
	if s.kcap > 0 and s.kills >= s.kcap then return nil, "kills"; end;
	if s.ntr >= s.capt then return nil, "cap"; end;
	if s.nsh + s.n > s.caps then return nil, "ships"; end;
	return 1, s.caps - s.nsh - s.n;
end;

-- Governor (5.2): n = carcasses above the visit baseline (TRF_Governor); more than gov -> one trader fewer
-- (not below 1, never raised) and ships <= 12. n nil (native missing) -> caps unchanged.
function TRF_GovernorOf(n, ct, cs, gov)
	if type(n) == "number" and n > gov then
		if ct > 1 then ct = ct - 1; end;
		if cs > 12 then cs = 12; end;
	end;
	return ct, cs;
end;

-- Live traffic flights and ships from the visit records (st ~= "gone", np = live ships). Members of one
-- danger convoy (same cv) count as one flight (v1 8.5).
function TRF_SafeCountOf(tr)
	local nt, ns = 0, 0;
	if type(tr) ~= "table" then return 0, 0; end;
	local cv = {};
	for id, r in tr do
		if type(r) == "table" and r.st ~= "gone" then
			if type(r.cv) == "number" then
				if not cv[r.cv] then cv[r.cv] = 1; nt = nt + 1; end;
			else
				nt = nt + 1;
			end;
			ns = ns + TRF_SafeNum(r.np, 0);
		end;
	end;
	return nt, ns;
end;

-- Wind-down action for one trader (spec 6, R3 row): "delete" farther than ovd (600) from the mothership or
-- distance unknown; "dock" on path A within np_max (300) of the station; else "portal" (ComeToPortal + exit).
function TRF_WindChoiceOf(path, d_ms, d_st, ovd, npmax)
	if type(d_ms) ~= "number" or d_ms > ovd then return "delete"; end;
	if path == "A" and type(d_st) == "number" and d_st <= npmax then return "dock"; end;
	return "portal";
end;

-- Strict gate R4 (v02 8.3, v1 10.4). s = {mode (cfg strict: 0 never, 1 map, 2 every system), qs (1 =
-- mission active), q (1 = system named in Quests.xml), qa (its quest ids: 1 one is QUEST_PROCESS, 0 none,
-- nil no ids or no GetQuestState), ent (deny entry or nil), f (feature), transit (cfg transit)}. A feature
-- set to 0 in the entry is off at any time (staged and carrier also by raid = 0). Option 1 (design 9.9): a q
-- system with ids is denied while one of them is in process and open otherwise; without ids the v0.2 rule
-- holds (denied while a mission is active). An m = 1 entry denies during a mission (mission_deny), except a
-- tq entry (teleport target) with transit 1 and qa 0 (transit rule, as TRF_SysModeOf). Returns 1 or nil,
-- reason: deny_<f>, quest, mission_all (strict 2), mission_q, mission_deny.
function TRF_StrictOkOf(s)
	local e = s.ent;
	if type(e) == "table" and (e[s.f] == 0 or ((s.f == "staged" or s.f == "carrier") and e.raid == 0)) then
		return nil, "deny_"..tostring(s.f);
	end;
	if s.mode == 0 then return 1; end;
	if s.q == 1 and s.qa == 1 then return nil, "quest"; end;
	if not s.qs then return 1; end;
	if s.mode == 2 then return nil, "mission_all"; end;
	if s.q == 1 and s.qa ~= 0 then return nil, "mission_q"; end;
	if type(e) == "table" and e.m == 1 and not (e.tq == 1 and s.transit == 1 and s.qa == 0) then return nil, "mission_deny"; end;
	return 1;
end;

-- Caps before the governor (9.1). b = TRF_BandCaps row {ct, cs, cp, ...} or nil, lt/ls = cfg limits,
-- gate = strict "band" result. No row or a failed gate -> band 0 row (2 / 10, no parked ship), which is
-- v0.1. Returns ct, cs, cp.
function TRF_SafeCapsOf(b, lt, ls, gate)
	local ct, cs, cp = 2, 10, 0;
	if gate and type(b) == "table" and type(b.ct) == "number" and type(b.cs) == "number" then
		ct = b.ct; cs = b.cs; cp = TRF_SafeNum(b.cp, 0);
	end;
	return min(ct, lt), min(cs, ls), cp;
end;

-- Spawn gate by kind (v02 10.2). s = the TRF_CanSpawnOf fields plus kind, gate (strict gate result for the
-- kind), gov (1 = governor active), nrf, nrs (open raid flights and their ships), rf, rs (raid caps 1 / 8),
-- npk (parked ships), cp (cap_parked). trader: v0.1. seed: gate + v0.1. staged: gate, no governor, free
-- raid slot and ship, then v0.1 for the trader (n = trader ships). raid: gate, no governor, raid caps (n = raid
-- ships). parked: gate, kill cap, cap_parked, ship cap. Returns 1, spare ships or nil, reason.
-- v1 (10.2): conv, dconv, tt4: gate, no governor, then v0.1 (one flight; n = transports + escorts). track:
-- gate, then v0.1. Event kinds (s.ecap set: sweep, feq 14, carrier, clan 8 alive, base 16): gate, no
-- governor (base: allowed, the governor counts its ships anyway), ev + n <= ecap (ev = live ships of that
-- event); they are outside the traffic caps and return 1, spare event ships.
-- merc (mercenary clan visits, design/merc-spec.md; s.mcap = tune mc_ships): gate, no governor, ev + n <= mcap (ev =
-- live ships of the clan visit, a big ship included), then the ship cap without the trader count; returns 1, spare
-- ships (the lower of the two rooms).
function TRF_CanSpawnKindOf(s)
	local k = s.kind;
	if s.supp ~= 0 then return nil, "supp"; end;
	if k ~= "trader" and not s.gate then return nil, "gate"; end;
	if k == "merc" then
		if s.gov then return nil, "gov"; end;
		local ev, mc = TRF_SafeNum(s.ev, 0), TRF_SafeNum(s.mcap, 0);
		if ev + s.n > mc then return nil, "merc_cap"; end;
		if s.nsh + s.n > s.caps then return nil, "ships"; end;
		return 1, min(s.caps - s.nsh - s.n, mc - ev - s.n);
	end;
	if type(s.ecap) == "number" then
		if k ~= "base" and s.gov then return nil, "gov"; end;
		local ev = TRF_SafeNum(s.ev, 0);
		if ev + s.n > s.ecap then return nil, "ev_cap"; end;
		return 1, s.ecap - ev - s.n;
	end;
	if (k == "conv" or k == "dconv" or k == "tt4") and s.gov then return nil, "gov"; end;
	if k == "raid" or k == "staged" then
		if s.gov then return nil, "gov"; end;
		if s.nrf >= s.rf then return nil, "raid_cap"; end;
		local nr = 1;
		if k == "raid" then nr = s.n; end;
		if s.nrs + nr > s.rs then return nil, "raid_ships"; end;
		if k == "raid" then return 1, s.rs - s.nrs - nr; end;
	end;
	if k == "parked" then
		if s.kcap > 0 and s.kills >= s.kcap then return nil, "kills"; end;
		if s.npk >= s.cp then return nil, "parked_cap"; end;
		if s.nsh + s.n > s.caps then return nil, "ships"; end;
		return 1, s.caps - s.nsh - s.n;
	end;
	return TRF_CanSpawnOf(s);
end;

-- Open raid flights and their ships from live.rd (raid records with st ~= "end"; ns = ships spawned).
function TRF_SafeRaidsOf(rd)
	local nf, ns = 0, 0;
	if type(rd) ~= "table" then return 0, 0; end;
	for n, r in rd do
		if type(r) == "table" and r.st ~= "end" then
			nf = nf + 1;
			ns = ns + TRF_SafeNum(r.ns, 0);
		end;
	end;
	return nf, ns;
end;

-- Parked ships from live.pk (one entry per parked ship).
function TRF_SafeParkedOf(pk)
	local n = 0;
	if type(pk) ~= "table" then return 0; end;
	for k, v in pk do n = n + 1; end;
	return n;
end;

-- Entry precedence (design 6.5), evaluated once per entry. c = candidates that passed their own rules
-- (1 or nil), highest first: chase, sweep, convoy, staged, rec, seed (v0.2 has staged and seed only).
-- A chased record suppresses the staged raid; a sweep suppresses staged raid and seed; a convoy, the
-- staged raid and a docked record take the seed's place. Returns ent (highest candidate that runs, else
-- "none") and run = {staged = 1/nil, seed = 1/nil}.
function TRF_EntryPrecOf(c)
	local run = {};
	if c.staged and not (c.chase or c.sweep or c.convoy) then run.staged = 1; end;
	if c.seed and not (c.sweep or c.convoy or run.staged or c.rec) then run.seed = 1; end;
	local order = {"chase", "sweep", "convoy", "staged", "rec", "seed"};
	for i = 1, getn(order) do
		local k = order[i];
		if (k == "staged" or k == "seed") then
			if run[k] then return k, run; end;
		elseif c[k] then
			return k, run;
		end;
	end;
	return "none", run;
end;

-- Contract functions (spec 10.2) -----------------------------------------------------

-- Authored overrides (v02 8.3, design 9.8 S5, 9.9, v1 10.4), lowercase system names. m = 1: vanilla
-- generator while a mission is active (R5); <feature> = 0: that feature never runs there (Fronn: no seed,
-- raid, equipment convoy, danger convoy or base). trf_loc's TRF_Loc_Deny() entries are merged over these
-- (their fields replace the authored ones). The campaign-pass teleport targets get m = 1, tq = 1 unless the
-- map carries its own teleport field tq (trf_loc reads that one; its teleport entries, why "teleport
-- target", get tq = 1 here). tq entries are vanilla only while a quest naming the system is in process
-- (TRF_SysModeOf, cfg transit).
-- cfg sys_deny names add m = 1 entries (TRF_DenyEntry). A new table per call (TRF_DenyEntry writes to it).
function TRF_DenyList()
	local t = {
		elio   = {m=1, why="Elio rescue"},
		x297   = {m=1, haunt=0, why="X297 ambush"},
		gefest = {m=1, why="Grid/Hephaestus escape"},
		fronn  = {seed=0, raid=0, feq=0, dconv=0, base=0, why="Triada warehouse exploit"},
		el_ariash = {haunt=0, why="El Ariash quest flights"},
	};
	local ld = nil;
	if type(TRF_Loc_Deny) == "function" then ld = call(TRF_Loc_Deny, {}, "x", TRF_SafePErr); end;
	if type(ld) == "table" then
		for k, e in ld do
			if type(k) == "string" and type(e) == "table" then
				local n = strlower(k);
				if type(t[n]) ~= "table" then t[n] = {}; end;
				for f, v in e do t[n][f] = v; end;
				if t[n].why == "teleport target" and t[n].tq == nil then t[n].tq = 1; end;
			end;
		end;
		if TRF_SafeMapTq() then return t; end;
	end;
	local tq = TRF_SafeTeleports();
	for i = 1, getn(tq) do
		if type(t[tq[i]]) ~= "table" then t[tq[i]] = {m=1, tq=1, why="teleport target"};
		elseif t[tq[i]].m == nil then t[tq[i]].m = 1; t[tq[i]].tq = 1; end;
	end;
	return t;
end;

-- 1 when a map entry has the generated tq field (teleport target), cached per MapInitialization.
function TRF_SafeMapTq()
	local c = %SQ;
	if c.mtq == nil then
		c.mtq = 0;
		local m = TRF_SafeMap();
		if type(m) == "table" and type(m.sys) == "table" then
			for i = 1, getn(m.sys) do
				if type(m.sys[i]) == "table" and m.sys[i].tq ~= nil then c.mtq = 1; end;
			end;
		end;
	end;
	if c.mtq == 1 then return 1; end;
	return nil;
end;

-- Teleport targets of the campaign pass (TRF_SafeQi().teleport) as a list, cached.
function TRF_SafeTeleports()
	local c = %SQ;
	if c.tq then return c.tq; end;
	local out = {};
	local s = TRF_SafeQi().teleport;
	if type(s) == "string" then gsub(s, "(%S+)", function(w) tinsert(%out, w); end); end;
	c.tq = out;
	return out;
end;

-- Quest ids of system idx (map entry sy): trf_loc's TRF_DenyQ, else the map's qi, else TRF_SafeQi.
-- Returns a list of "quest_.." names or nil.
function TRF_SafeQIds(idx, sy)
	if type(TRF_DenyQ) == "function" then
		local t = call(TRF_DenyQ, {idx}, "x", TRF_SafePErr);
		if type(t) == "table" and getn(t) > 0 then return t; end;
	end;
	if type(sy) ~= "table" then return nil; end;
	if type(sy.qi) == "table" and getn(sy.qi) > 0 then return sy.qi; end;
	if type(sy.name) ~= "string" then return nil; end;
	local s = TRF_SafeQi()[strlower(sy.name)];
	if type(s) ~= "string" or strlower(sy.name) == "teleport" then return nil; end;
	local out = {};
	gsub(s, "(%S+)", function(w) tinsert(%out, "quest_"..w); end);
	return out;
end;

function TRF_SafeQErr(m)
	TRF_SafeStat("qstate_err");
end;

-- 1 when GetQuestState of one id is QUEST_PROCESS (the vanilla test), 0 when none, nil without ids or
-- without the native. CHECK V8: GetQuestState on an id never added returns QUEST_NOINIT.
function TRF_SafeQAOf(ids)
	if type(ids) ~= "table" or getn(ids) == 0 then return nil; end;
	if type(GetQuestState) ~= "function" or QUEST_PROCESS == nil then return nil; end;
	for i = 1, getn(ids) do
		if type(ids[i]) == "string" and call(GetQuestState, {ids[i]}, "x", TRF_SafeQErr) == QUEST_PROCESS then return 1; end;
	end;
	return 0;
end;

-- Quest state of system idx (1, 0, nil; TRF_SafeQAOf): trf_loc's TRF_QuestActive, else (also when it
-- has no ids, e.g. a map without qi) here from TRF_SafeQIds. The current system is cached per visit
-- (live.qa, qai).
function TRF_SafeQA(idx, sy)
	if type(TRF_QuestActive) == "function" then
		local v = call(TRF_QuestActive, {idx}, "x", TRF_SafePErr);
		if v == 1 or v == 0 then return v; end;
	end;
	local L = TRF_SafeLive();
	local csy, cur = TRF_SafeSys();
	if L and idx == cur and L.qai == idx and type(L.qa) == "number" then
		if L.qa < 0 then return nil; end;
		return L.qa;
	end;
	local v = TRF_SafeQAOf(TRF_SafeQIds(idx, sy));
	if L and idx == cur then
		L.qai = idx;
		if v then L.qa = v; else L.qa = -1; end;
	end;
	return v;
end;

-- R5 names: the m = 1 entries of dl (nil = TRF_DenyList()), sorted; tq = 1: only those marked tq.
function TRF_Deny(dl, tq)
	local out = {};
	if type(dl) ~= "table" then dl = TRF_DenyList(); end;
	for k, e in dl do
		if type(e) == "table" and e.m == 1 and (tq ~= 1 or e.tq == 1) then tinsert(out, k); end;
	end;
	sort(out);
	return out;
end;

-- Deny entry of a system name, or nil; a cfg sys_deny name adds m = 1 and drops tq (no transit rule).
function TRF_DenyEntry(name)
	if type(name) ~= "string" then return nil; end;
	name = strlower(name);
	local e = TRF_DenyList()[name];
	if type(e) ~= "table" then e = nil; end;
	if TRF_SafeIn(TRF_SafeOpt("sys_deny", {}), name) then
		if not e then e = {why="cfg sys_deny"}; end;
		e.m = 1; e.tq = nil;
	end;
	return e;
end;

-- The 24 systems never named in Game/Quests.xml (design 9.9): the q fallback for a map without q fields.
function TRF_StrictFree()
	return {altair=1, areko=1, b_leftera2=1, b_leftera3=1, callipso=1, egleon=1, escaflon=1, farles=1,
		fiasar=1, fort_russ=1, fronn=1, gaoba=1, golkonda=1, kitaro=1, lasad=1, llanovar1=1, llanovar2=1,
		sunji=1, tarrot=1, x244=1, xb13=1, xb19=1, xt17=1, xt27=1};
end;

