-- q (1 = system named in Quests.xml: map q, else not in TRF_StrictFree) and qa (TRF_SafeQA, nil when q is
-- 0 or strict mode is 0) of system idx with map entry sy. Shared by TRF_StrictIn and TRF_SafeModeIn.
function TRF_SafeQQa(idx, sy, mode)
	if type(sy) ~= "table" or type(sy.name) ~= "string" then return nil, nil; end;
	local q = sy.q;
	if type(q) ~= "number" then
		q = 1;
		if TRF_StrictFree()[strlower(sy.name)] then q = 0; end;
	end;
	local qa = nil;
	if q == 1 and mode ~= 0 then qa = TRF_SafeQA(idx, sy); end;
	return q, qa;
end;

-- Inputs of TRF_StrictOkOf for system idx (nil = current) and feature f; nil when idx has no map entry.
function TRF_StrictIn(idx, f)
	local sy = nil;
	if idx == nil then
		sy, idx = TRF_SafeSys();
	else
		local m = TRF_SafeMap();
		if type(m) == "table" and type(m.sys) == "table" and type(idx) == "number" then sy = m.sys[idx]; end;
	end;
	if type(sy) ~= "table" or type(sy.name) ~= "string" then return nil; end;
	local mode = TRF_SafeOpt("strict", 1);
	if mode ~= 0 and mode ~= 1 and mode ~= 2 then mode = 1; end;
	local q, qa = TRF_SafeQQa(idx, sy, mode);
	return {mode=mode, qs=TRF_Safe_QState(), q=q, qa=qa, ent=TRF_DenyEntry(sy.name), f=f, name=sy.name, idx=idx,
		transit=TRF_SafeNum(TRF_SafeOpt("transit", 1), 1)};
end;

-- Strict gate (v02 8.3, v1 10.2): 1 or nil, reason for system idx (nil = current) and feature (seed, raid,
-- staged, contract, parked, tt3, band, board; v1: track, conv, tt4, sweep, carrier, feq, dconv, offer; freight unlock
-- quest: wq; clan temperaments and the Clan file: temper).
-- No map entry -> nil, "nomap". A denial counts gate_<feature> and is logged when it differs from the
-- last one logged this visit.
function TRF_StrictOk(idx, feature)
	local s = TRF_StrictIn(idx, feature);
	local ok, why = nil, "nomap";
	if s then ok, why = TRF_StrictOkOf(s); end;
	if ok then return 1, nil; end;
	TRF_SafeStat("gate_"..tostring(feature));
	local L = TRF_SafeLive();
	local nm = "nil";
	if s then nm = s.name; end;
	local k = tostring(feature)..":"..tostring(why)..":"..nm;
	if L and L.gl ~= k then
		L.gl = k;
		TRF_SafeE("gate", "feature", feature, "system", nm, "reason", why, "result", "denied");
	end;
	return nil, why;
end;

-- 1 while the governor holds (carcass excess over the baseline above gov): tier <= TT2, raids and staged raids off (9.1).
function TRF_GovActive()
	local L = TRF_SafeLive();
	if not L or type(L.gvn) ~= "number" then return nil; end;
	if L.gvn > TRF_SafeNum(TRF_SafeOpt("gov", 40), 40) then return 1; end;
	return nil;
end;

function TRF_Chapter()
	return TRF_ChapterOf(TRF_Safe_Quest());
end;

-- Carcass excess over the visit baseline from a fresh count (the raid gate asks between governor ticks);
-- nil when the count or the baseline is unknown. The raw count is 36 to 202 of scenery per system.
function TRF_GovExcess()
	local L = TRF_SafeLive();
	if not L or type(L.gvn0) ~= "number" then return nil; end;
	local n = TRF_Safe_Count(TRF_SafeNum(TRF_SafeOpt("gov_r", 3000), 3000));
	if type(n) ~= "number" then return nil; end;
	return max(0, n - L.gvn0);
end;

-- Caps for the next spawn decision (v02 9.1): band row of the live pro (TRF_BandCaps, trf_tier), cfg limits
-- (cap_traders 0..5, cap_ships 0..20), strict gate "band", then the governor on the carcass excess n (nil:
-- the excess of the last TRF_Governor run). Writes live.capt/caps/capp. Returns ct, cs, cp.
function TRF_SafeCaps(n)
	local lt = TRF_SafeClamp(floor(TRF_SafeNum(TRF_SafeOpt("cap_traders", 5), 5)), 0, 5);
	local ls = TRF_SafeClamp(floor(TRF_SafeNum(TRF_SafeOpt("cap_ships", 20), 20)), 0, 20);
	local sy, idx = TRF_SafeSys();
	local b, gate = nil, nil;
	if idx then
		gate = TRF_StrictOk(idx, "band");
		if gate and type(TRF_BandCaps) == "function" then b = call(TRF_BandCaps, {idx}, "x", TRF_SafePErr); end;
		-- Bands 3-4 (pro 8-9, v1 8.1) are a strict-gate feature with TT4: denied -> the band 2 row bounds.
		if type(b) == "table" and TRF_SafeNum(b.band, 0) >= 3 and not TRF_StrictOk(idx, "tt4") then
			b = {ct=min(TRF_SafeNum(b.ct, 2), 4), cs=min(TRF_SafeNum(b.cs, 10), 16), cp=min(TRF_SafeNum(b.cp, 0), 1)};
		end;
	end;
	local ct, cs, cp = TRF_SafeCapsOf(b, lt, ls, gate);
	local L = TRF_SafeLive();
	if n == nil and L then n = L.gvn; end;
	ct, cs = TRF_GovernorOf(n, ct, cs, TRF_SafeNum(TRF_SafeOpt("gov", 40), 40));
	if L then L.capt = ct; L.caps = cs; L.capp = cp; end;
	return ct, cs, cp;
end;

-- Inputs of TRF_SysModeOf from the game.
function TRF_SafeModeIn()
	local L = TRF_SafeLive();
	local inval = nil;
	if L then inval = L.inval; end;
	local sy, idx = TRF_SafeSys();
	local dl = TRF_DenyList();
	local strict = TRF_SafeNum(TRF_SafeOpt("strict", 1), 1);
	local q, qa = TRF_SafeQQa(idx, sy, strict);
	return {
		enabled = TRF_SafeOpt("enabled", 1),
		override = TRF_SafeOpt("override", 1),
		guard = TRF_SafeNum(TRF_SafeOpt("guard", 1), 1),
		sys = sy,
		off = TRF_SafeOpt("sys_off", {}),
		deny = TRF_Deny(dl),
		denyq = TRF_Deny(dl, 1),
		deny2 = TRF_SafeOpt("sys_deny", {}),
		strict = strict,
		qa = qa,
		transit = TRF_SafeNum(TRF_SafeOpt("transit", 1), 1),
		inval = inval,
		qs = TRF_Safe_QState(),
		ch = TRF_Chapter()
	};
end;

-- "mod" or "vanilla", reason (2.3). Counts van_<reason> in live.stat; logs when the result changes.
function TRF_SysMode()
	local s = TRF_SafeModeIn();
	local m, why = TRF_SysModeOf(s);
	if why then TRF_SafeStat("van_"..why); end;
	local L = TRF_SafeLive();
	local k = m..":"..tostring(why);
	if L and L.sm ~= k then
		L.sm = k;
		local nm = "nil";
		if type(s.sys) == "table" then nm = tostring(s.sys.name); end;
		TRF_SafeE("mode", "system", nm, "mode", m, "reason", why, "chapter", s.ch, "quest_state", s.qs, "quest_active", s.qa, "guard", s.guard);
	end;
	return m, why;
end;

-- TRF_SysMode without the van_<reason> count and the change log (dump, arrival line).
function TRF_SysModeQuiet()
	return TRF_SysModeOf(TRF_SafeModeIn());
end;

-- cfg sos_mode: 1 (default) __sys_SOS alone does not suppress, 2 the old debounce rule (R2, R3).
function TRF_SafeSosMode()
	if TRF_SafeOpt("sos_mode", 1) == 2 then return 2; end;
	return 1;
end;

-- 0 none, 1 pause, 2 wind-down (R2, R3). Reads the flags now, so a flag set since the last tick counts.
function TRF_Supp()
	local f = TRF_Safe_Flags();
	local L = TRF_SafeLive();
	local sm = TRF_SafeSosMode();
	local sos_t, ext = nil, nil;
	if L then
		sos_t = L.sos_t;
		if f.sos and not f.dis and sm == 2 and L.ext_seen == 1 then ext = TRF_Safe_ExtAlive(); end;
	end;
	return TRF_SuppOf(f.dis, f.sos, TRF_SafeGt(), sos_t, ext, TRF_SafeTune("sos_db", 30), f.scene, sm);
end;

-- 1 while vanilla suppresses chatter (__sys_SOS == TRUE: _FTrader_exclude blocks the trader and mercenary
-- chat, SOS calls, extortion and the patrol fine) or a scripted scene is visible (TRF_Safe_Scene), else nil.
-- For what talks to the player (lines, greetings, mod boxes); spawning reads TRF_Supp, the gates of new
-- things also TRF_Combat.
function TRF_Quiet()
	if __sys_SOS == TRUE or TRF_Safe_Scene() then return 1; end;
	return nil;
end;

-- Quiet for what the player starts (focus line of a selected trader, the hail armed at the meeting, the hail
-- box and its answers): 1 only while a scripted scene is visible (TRF_Safe_Scene), since __sys_SOS mutes
-- vanilla's trader-initiated chat, not a contact the player asked for. cfg hail_quiet 1: the TRF_Quiet rule.
function TRF_QuietHail()
	if TRF_SafeOpt("hail_quiet", 0) == 1 then return TRF_Quiet(); end;
	return TRF_Safe_Scene();
end;

-- Combat state (design/mod-research/combat-state.md) ------------------------------------------------
-- The engine has no "in battle" query. live.cbt is the game time of the last hostile event: a hull drop of
-- the mothership between two safety ticks (why hp), a player hit on a mod ship through a TRF_Cb shim (why
-- hit, traffic.script), an open raid in demand or fight within combat_r of the mothership (why raid).
-- Live fields: cbt (gt of the last event), cbw (its why), cbh, cbi (mothership HP and id of the last
-- sample), cbs (gt of the last sample with a visible scene), cbl (1 while "combat on" is logged), cbk
-- (whole seconds of recent hits), cbp (second of the last "hit pending" line). Hits start combat only when
-- seen in combat_hit_n distinct seconds within combat_hit_win (TRF_CombatHitOk; one bump or a lone hit is
-- ignored); while in combat every hit refreshes the hold. Tune combat_hold 25, combat_hp 0.5, combat_r
-- 1500 (0 = whole system), combat_scene 3, combat_hit_n 2, combat_hit_win 6. cfg combat 0:
-- TRF_Combat is always nil and nothing is sampled. Source a3 of the design (attack triggers of hostile mod
-- groups on the mothership) is not implemented: shield hits count once the hull drops.

-- Pure: 1 while the last hostile event cbt is younger than hold seconds at gt, else nil.
function TRF_CombatOf(cbt, gt, hold)
	if type(cbt) ~= "number" or type(gt) ~= "number" then return nil; end;
	if gt - cbt < hold then return 1; end;
	return nil;
end;

-- Pure: 1 for a hit-sized hull drop old -> new: more than d and less than half of old (a larger drop in
-- one sample is a quest SetHP restore or a ship swap), else nil.
function TRF_HpDropOf(old, new, d)
	if type(old) ~= "number" or type(new) ~= "number" or old <= 0 then return nil; end;
	local dd = old - new;
	if dd > d and dd < 0.5 * old then return 1; end;
	return nil;
end;

-- 1 unless cfg combat is 0.
function TRF_CombatOn()
	if TRF_SafeOpt("combat", 1) == 0 then return nil; end;
	return 1;
end;

-- 1 while the player or a mod trader near the mothership is in combat (last hostile event younger than
-- tune combat_hold), else nil. Reads TRF.live only. For the gates of new things (raids, carriers, sweeps,
-- supply runs, danger convoys, the hail on focus); running steps never read it.
function TRF_Combat()
	local L = TRF_SafeLive();
	if not L or not TRF_CombatOn() then return nil; end;
	return TRF_CombatOf(L.cbt, TRF_SafeGt(), TRF_SafeTune("combat_hold", 25));
end;

-- Record a hostile event now: why hp, hit or raid, src the detail for the log, hold (nil = tune). Logs the
-- onset only (and the end of the previous combat when the hold ran out between two samples).
function TRF_CombatMark(why, src, hold)
	local L = TRF_SafeLive();
	if not L or not TRF_CombatOn() then return; end;
	local gt = TRF_SafeGt();
	if type(hold) ~= "number" then hold = TRF_SafeTune("combat_hold", 25); end;
	if not TRF_CombatOf(L.cbt, gt, hold) then
		if why == "hit" and not TRF_CombatHitOk(L, gt, src) then return; end;
		if L.cbl == 1 then TRF_CombatOff(L, gt); end;
		L.cbl = 1;
		TRF_SafeE("combat_on", "reason", why, "source", src, "game_time", TRF_F(gt));
		TRF_SafeStat("combat_on");
	end;
	L.cbt = gt;
	L.cbw = why;
end;

-- Debounce of the hit source (live table L, outside combat; traffic.script TRF_HitSecsOf): 1 once hits were seen in tune combat_hit_n
-- (2) distinct whole seconds within combat_hit_win (6) seconds, else nil (one debug line per window).
function TRF_CombatHitOk(L, gt, src)
	local win = TRF_SafeTune("combat_hit_win", 6);
	local need = TRF_SafeTune("combat_hit_n", 2);
	local s = floor(gt);
	L.cbk = TRF_HitSecsOf(L.cbk, s, win);
	local n = getn(L.cbk);
	if n >= need then
		L.cbk = nil; L.cbp = nil;
		return 1;
	end;
	if type(L.cbp) ~= "number" or s - L.cbp >= win then
		L.cbp = s;
		TRF_SafeDE("combat_hit_pending", "hit_count", n, "hits_needed", need, "source", src, "game_time", TRF_F(gt));
	end;
	return nil;
end;

-- Log the end of a combat (live table L).
function TRF_CombatOff(L, gt)
	L.cbl = nil;
	TRF_SafeE("combat_off", "last_reason", L.cbw, "game_time", TRF_F(gt));
end;

-- 1 once this visit is armed (TRF_SafeArm), else nil. Gates the object reads of the combat sample.
function TRF_SafeArmed()
	local H = TRF_SafeH();
	if H and H.sact == 1 then return 1; end;
	return nil;
end;

-- Arm the tick for this visit (end of OnActivate and OnLoad: vanilla functions.script has just called
-- GetPlayerMotherShip, so the player team exists): H.sms = the mothership, H.sact = 1. via: log tag.
function TRF_SafeArm(via)
	local H = TRF_SafeH();
	if not H then return; end;
	H.sms = TRF_N("GetPlayerMotherShip");
	H.sact = 1;
	local id = nil;
	if type(H.sms) == "table" then id = H.sms.id; end;
	TRF_SafeE("armed", "via", via, "mothership_id", id);
end;

function TRF_Safe_IsAlive(o)
	return TRF_Is(o:IsAlive());
end;

-- 1 for a live game handle (table or userdata; IsAlive looks the id up, protected), else nil.
function TRF_Safe_Alive(o)
	if type(o) ~= "table" and type(o) ~= "userdata" then return nil; end;
	return call(TRF_Safe_IsAlive, {o}, "x", TRF_SafePErr);
end;

-- Player mothership for every module (traffic.script TRF_Ms). Armed visit: the vanilla global mothership when
-- alive (functions.script; quest swaps assign mothership = SetPlayerMotherShip(..)), else the handle taken at
-- arming. Otherwise, or when both are dead: nil inside a tick (H.intick), else GetPlayerMotherShip (callbacks
-- and triggers run in a live location; the result refreshes H.sms on an armed visit). A tick can run while a
-- load or a galaxy-map jump has torn the location down, and that native then reads team+0x150 through a null
-- team (0x5adc5e).
function TRF_Safe_Ms()
	local H = TRF_SafeH();
	local armed = TRF_SafeArmed();
	if armed then
		if TRF_Safe_Alive(mothership) then return mothership; end;
		if TRF_Safe_Alive(H.sms) then return H.sms; end;
	end;
	if H and H.intick == 1 then return nil; end;
	local m = TRF_N("GetPlayerMotherShip");
	if armed then H.sms = m; end;
	return m;
end;

function TRF_Safe_HpOf(ms)
	local hp = TRF_N("GetCurHP", ms);
	if type(hp) ~= "number" then return nil; end;
	local id = nil;
	if type(ms) == "table" then id = ms.id; end;
	return hp, id;
end;

-- Hull HP and id of the live mothership handle ms (TRF_Safe_Ms), or nil; GetCurHP runs protected.
function TRF_Safe_MsHp(ms)
	if not ms then return nil; end;
	return call(TRF_Safe_HpOf, {ms}, "x", TRF_SafePErr);
end;

function TRF_Safe_PosOf(o)
	return o:GetPosition();
end;

-- Distance of raid n's first live ship to position mp (trf_raid's handle table and lead), or nil.
function TRF_Safe_RaidDist(n, mp)
	if not mp then return nil; end;
	local H = TRF_N("TRF_Rd_H");
	if type(H) ~= "table" or type(H.rd) ~= "table" or type(H.rd[n]) ~= "table" then return nil; end;
	return TRF_N("TRF_Rd_Dist", TRF_N("TRF_Rd_RaidLeadPos", H.rd[n]), mp);
end;

-- Number of an open raid record in st demand or fight within r of mothership handle ms (nil: no handle;
-- an unknown distance counts as near; r <= 0: any distance), else nil. The mothership position is read once.
function TRF_Safe_RaidHot(rd, r, ms)
	local mp, got = nil, nil;
	for n, x in rd do
		if type(x) == "table" and (x.st == "fight" or x.st == "demand") then
			if r <= 0 then return n; end;
			if not got and ms then mp = call(TRF_Safe_PosOf, {ms}, "x", TRF_SafePErr); end;
			got = 1;
			local d = TRF_Safe_RaidDist(n, mp);
			if type(d) ~= "number" or d <= r then return n; end;
		end;
	end;
	return nil;
end;

-- Combat tune values from one TRF_Tune() call (the sample runs every tick).
function TRF_CombatTune()
	local t = nil;
	if type(TRF_Tune) == "function" then t = TRF_Tune(); end;
	if type(t) ~= "table" then t = {}; end;
	return {hold=TRF_SafeNum(t.combat_hold, 25), hp=TRF_SafeNum(t.combat_hp, 0.5), r=TRF_SafeNum(t.combat_r, 1500),
		scene=TRF_SafeNum(t.combat_scene, 3)};
end;

-- Sources hp and raid, every safety tick (scene: the scene flag of this tick). The hull sample is skipped
-- across a mothership id change and for combat_scene seconds after a visible scene. Both sources wait for
-- the armed visit (TRF_SafeArmed) and use TRF_Safe_Ms, never GetPlayerMotherShip.
function TRF_CombatSample(scene)
	local L = TRF_SafeLive();
	if not L or not TRF_CombatOn() then return; end;
	local T = TRF_CombatTune();
	local gt = TRF_SafeGt();
	if scene then L.cbs = gt; end;
	if TRF_SafeArmed() then
		local ms = TRF_Safe_Ms();
		if not TRF_Safe_Alive(ms) then ms = nil; end;
		local hp, id = TRF_Safe_MsHp(ms);
		local fresh = type(L.cbs) == "number" and gt - L.cbs < T.scene;
		if not fresh and id == L.cbi and TRF_HpDropOf(L.cbh, hp, T.hp) then
			TRF_CombatMark("hp", TRF_F(L.cbh).."->"..TRF_F(hp), T.hold);
		end;
		L.cbh = hp; L.cbi = id;
		if type(L.rd) == "table" then
			local n = TRF_Safe_RaidHot(L.rd, T.r, ms);
			if n then TRF_CombatMark("raid", n, T.hold); end;
		end;
	end;
	if L.cbl == 1 and not TRF_CombatOf(L.cbt, gt, T.hold) then TRF_CombatOff(L, gt); end;
end;

-- 1 once per suppression onset when a wind-down is due (sets live.wind); nil otherwise. For TRF_WindDown.
function TRF_SafeWindOnset()
	local L = TRF_SafeLive();
	if not L or L.wind == 1 or TRF_Supp() ~= 2 then return nil; end;
	L.wind = 1;
	TRF_SafeE("wind_down_onset", "game_time", TRF_F(TRF_SafeGt()));
	return 1;
end;

-- Wind-down action from distances, with the tune values (see TRF_WindChoiceOf).
function TRF_WindChoice(path, d_ms, d_st)
	return TRF_WindChoiceOf(path, d_ms, d_st, TRF_SafeTune("ovd", 600), TRF_SafeTune("np_max", 300));
end;

-- Vanilla fix: the extortion contact (README "Vanilla fixes", design/extort-fix-spec.md) ------------------------
-- Vanilla RandomPiratGetMoney (include/OutOfMission.script 385-455) sets group_Pirate_money neutral toward
-- PLAYER_GROUP one way only (407); the player side keeps the Pirates team war (required at 386), so the turrets and
-- the wing fire at the flight in the 16 s before the box. cfg ext_fix 1: on a fresh extortion PLAYER_GROUP ->
-- group_Pirate_money is set neutral, the vanilla war of a refusal (437, 450) is copied back at the next tick, and a
-- player attack on a ship of the flight sets war both ways. The vanilla contact itself is not touched (R11, M10).

-- Name of the vanilla extortion group: P_Group = team:CreateGroup("group_Pirate_money") (388); vanilla addresses it
-- by this name (407, 437, 450).
function TRF_SafeExtG() return "group_Pirate_money"; end;

-- 1 when group_Pirate_money exists in this scene (GetOwnerTeamOfGroup is nil for an unknown group: vanilla's own probe,
-- DefStation.script 38), read on the edge path before the relation by name and the flight handle, so neither is
-- touched for a group of an earlier scene; 1 when the native is absent.
function TRF_SafeExtGrp()
	if type(GetOwnerTeamOfGroup) ~= "function" then return 1; end;
	if call(GetOwnerTeamOfGroup, {TRF_SafeExtG()}, "x", TRF_SafeNoErr) then return 1; end;
	return nil;
end;

-- 1 when the fix is on: tune ext_fix (install-test.sh TUNE=ext_fix=0) when 0 or 1, else cfg ext_fix (default 1);
-- 0 under cfg enabled 2 (restore-and-stop writes no relation and arms no trigger).
function TRF_SafeExtOn()
	if TRF_SafeOpt("enabled", 1) == 2 then return 0; end;
	local t = TRF_SafeTune("ext_fix", -1);
	if t == 0 or t == 1 then return t; end;
	if TRF_SafeOpt("ext_fix", 1) == 0 then return 0; end;
	return 1;
end;

function TRF_SafeNoErr(m) end;

-- Group relation a -> b (names), protected and silent (a group of an earlier scene may be gone), or nil.
function TRF_SafeRel(a, b)
	if type(GetGroupRelation) ~= "function" then return nil; end;
	return call(GetGroupRelation, {a, b}, "x", TRF_SafeNoErr);
end;

function TRF_SafeSetRel(a, b, r)
	if type(SetGroupRelation) ~= "function" or r == nil then return nil; end;
	call(SetGroupRelation, {a, b, r}, "x", TRF_SafePErr);
	return 1;
end;

-- Ships of flight fl in pilot order, at most 8.
function TRF_SafeShipsOf(fl)
	local sh = {};
	local n = fl:GetPilotCount();
	if type(n) ~= "number" then return sh; end;
	for i = 1, min(n, 8) do
		local p = fl:GetPilotByNumber(i);
		if p and type(p) ~= "number" then
			local s = p:GetShip();
			if s and type(s) ~= "number" then tinsert(sh, s); end;
		end;
	end;
	return sh;
end;

function TRF_SafeExtTrig(cb, s)
	return NewTrigger("attack", nil, cb, PLAYER_GROUP, s);
end;

-- Attack triggers of PLAYER_GROUP on the ships of flight_pir_mon_1 (the TRF_Rd_War1 pattern), callback
-- TRF_OnExtHit(k, gen). Returns the number armed.
function TRF_SafeExtArm(k)
	if type(NewTrigger) ~= "function" or type(TRF) ~= "table" then return 0; end;
	local sh = call(TRF_SafeShipsOf, {flight_pir_mon_1}, "x", TRF_SafePErr);
	if type(sh) ~= "table" then return 0; end;
	local cb = "TRF_OnExtHit("..k..","..TRF.gen..")--";
	local n = 0;
	for i = 1, getn(sh) do
		if call(TRF_SafeExtTrig, {cb, sh[i]}, "x", TRF_SafePErr) then n = n + 1; end;
	end;
	return n;
end;

-- Fresh extortion since the last tick (updates L.pmv): "change" when __sys_Pirate_Money turned into a new non-zero
-- number (vanilla sets 0 when the include loads, OutOfMission.script 13, and the demand at 408); "edge" on the first
-- tick of the visit or a rising __sys_SOS edge when the vanilla marks of a live contact hold (a non-zero demand,
-- group_Pirate_money in this scene and neutral toward PLAYER_GROUP, flight_pir_mon_1 alive): a repeat of the same sum, a load during the
-- contact. Else nil. The marks are read only on an armed visit (TRF_SafeArmed).
function TRF_SafeExtFresh(L, f)
	local m = 0;
	if type(__sys_Pirate_Money) == "number" then m = __sys_Pirate_Money; end;
	local p = L.pmv;
	L.pmv = m;
	if m == 0 then return nil; end;
	if type(p) == "number" and m ~= p then return "change"; end;
	if type(p) == "number" and not (f.sos and L.ss ~= 1) then return nil; end;
	if L.ext == 1 or RELATION_NEUTRAL == nil or not TRF_SafeArmed() then return nil; end;
	if not TRF_SafeExtGrp() or TRF_SafeRel(TRF_SafeExtG(), PLAYER_GROUP) ~= RELATION_NEUTRAL then return nil; end;
	if not TRF_Safe_Alive(flight_pir_mon_1) then return nil; end;
	return "edge";
end;

-- Fresh extortion: player side neutral toward the group, attack triggers armed (ext = 1); else a skip line.
function TRF_SafeExtFix(L)
	L.ext = nil;
	local g = TRF_SafeExtG();
	local why = nil;
	if TRF_SafeOpt("enabled", 1) == 2 then why = "restore";
	elseif TRF_SafeExtOn() ~= 1 then why = "off";
	elseif not TRF_SafeArmed() then why = "unarmed";
	elseif type(SetGroupRelation) ~= "function" or RELATION_NEUTRAL == nil or RELATION_WAR == nil then why = "native";
	elseif TRF_N("GetTeamRelation", "Pirates", PLAYER_TEAM) ~= RELATION_WAR then why = "not_war";
	elseif TRF_SafeRel(g, PLAYER_GROUP) ~= RELATION_NEUTRAL then why = "vanilla_rel";
	elseif not TRF_Safe_Alive(flight_pir_mon_1) then why = "no_flight"; end;
	if why then
		TRF_SafeE("extort", "group", g, "result", "skip", "reason", why);
		return;
	end;
	TRF_SafeSetRel(PLAYER_GROUP, g, RELATION_NEUTRAL);
	L.ext = 1;
	local n = TRF_SafeExtArm(L.exn);
	TRF_SafeStat("ext_fix");
	TRF_SafeE("extort", "group", g, "result", "neutral", "trigger_count", n);
end;

-- While ext = 1 (every tick): vanilla war toward the player (Cancel, too few credits) is copied to the player side;
-- a flight that is gone (paid and deleted, destroyed) ends the tracking.
function TRF_SafeExtPoll(L)
	if not TRF_SafeArmed() then return; end;
	local g = TRF_SafeExtG();
	if TRF_SafeRel(g, PLAYER_GROUP) == RELATION_WAR then
		TRF_SafeSetRel(PLAYER_GROUP, g, RELATION_WAR);
		L.ext = 2;
		TRF_SafeE("extort", "group", g, "result", "war", "reason", "refused");
	elseif not TRF_Safe_Alive(flight_pir_mon_1) then
		L.ext = nil;
		TRF_SafeE("extort", "group", g, "result", "end", "reason", "gone");
	end;
end;

-- Attack trigger of PLAYER_GROUP on a ship of extortion k (TRF_SafeExtArm): war both ways.
function TRF_OnExtHit(k, g)
	if type(TRF_Cb) == "function" then TRF_Cb("TRF_OnExtHit", TRF_SafeExtHit, {k, g}); else call(TRF_SafeExtHit, {k, g}, "x", TRF_SafePErr); end;
end;

function TRF_SafeExtHit(k, g)
	local L = TRF_SafeLive();
	if not L or type(TRF) ~= "table" or g ~= TRF.gen or k ~= L.exn or L.ext ~= 1 then return; end;
	local gn = TRF_SafeExtG();
	TRF_SafeSetRel(gn, PLAYER_GROUP, RELATION_WAR);
	TRF_SafeSetRel(PLAYER_GROUP, gn, RELATION_WAR);
	L.ext = 2;
	TRF_SafeE("extort", "group", gn, "result", "war", "reason", "attacked");
end;

-- Extortion tracking (spec 6), every tick. Returns the suppression level.
function TRF_SafetySample()
	local L = TRF_SafeLive();
	if not L then return TRF_Supp(); end;
	local f = TRF_Safe_Flags();
	local gt = TRF_SafeGt();
	if f.sos then
		if type(L.sos_t) ~= "number" then
			L.sos_t = gt;
			TRF_SafeDE("sos_on", "game_time", TRF_F(gt));
		end;
	elseif L.sos_t then
		L.sos_t = nil;
		TRF_SafeDE("sos_off", "game_time", TRF_F(gt));
	end;
	local via = TRF_SafeExtFresh(L, f);
	if via then
		L.ext_seen = 1;
		L.exn = TRF_SafeNum(L.exn, 0) + 1;
		TRF_SafeE("extortion_seen", "game_time", TRF_F(gt), "via", via, "money", L.pmv, "count", L.exn);
		TRF_SafeExtFix(L);
	elseif L.ext == 1 then
		TRF_SafeExtPoll(L);
	end;
	local s = TRF_Supp();
	-- wind is per onset; cleared only at level 0, so a __disableAction wind-down runs once.
	if s == 0 then L.wind = nil; end;
	-- Logged on a level change and on a __sys_SOS change (sos_mode 1 keeps the level at 0 under __sys_SOS).
	local ss = 0;
	if f.sos then ss = 1; end;
	if s ~= TRF_SafeNum(L.sl, 0) or ss ~= TRF_SafeNum(L.ss, 0) then
		TRF_SafeE("suppression", "old", TRF_SafeNum(L.sl, 0), "new", s, "disable_action", TRF_KvB(f.dis), "sos", TRF_KvB(f.sos),
			"scene", TRF_KvB(f.scene), "sos_mode", TRF_SafeSosMode(), "extortion_seen", TRF_KvB(L.ext_seen));
	end;
	L.sl = s;
	L.ss = ss;
	TRF_CombatSample(f.scene);
	return s;
end;

-- Event bound of a v1 spawn kind (v1 10.2, 10.5), nil for traffic kinds.
function TRF_SafeEvCap(kind)
	if kind == "sweep" then return TRF_SafeTune("cap_sweep", 14); end;
	if kind == "feq" then return TRF_SafeTune("cap_feq", 14); end;
	if kind == "carrier" or kind == "clan" then return TRF_SafeTune("raid_live_cap", 8); end;
	if kind == "base" then return TRF_SafeTune("cap_base", 16); end;
	return nil;
end;

-- 1, spare ships or nil, reason (5.1, v02 10.2). nships = ships of the planned base row (raid: raid ships);
-- kind trader (default), seed, staged, raid, parked; v1: track, conv, dconv, tt4 and the event kinds sweep,
-- feq, carrier, clan, base (TRF_CanSpawnKindOf); merc (the mercenary clan module: its own cap tune mc_ships 14, ev =
-- the live ships of the clan visit). ev: live ships of that event (event kinds; default for
-- carrier and clan: the ships of the open raid records). Caps are recomputed per decision (band read
-- live); if the visit has no governor count yet (live reset after OnActivate/OnLoad) the governor runs
-- now. Parked ships count against cap_ships. Gate feature: the kind, "raid" for clan.
function TRF_CanSpawn(nships, kind, ev)
	local L = TRF_SafeLive();
	if not L then return nil, "nolive"; end;
	if type(kind) ~= "string" then kind = "trader"; end;
	if L.gv ~= 1 then TRF_Governor(); else TRF_SafeCaps(); end;
	local ntr, nsh = TRF_SafeCountOf(L.tr);
	local npk = TRF_SafeParkedOf(L.pk);
	-- Ships of the groups registered with trf_plumb's TRF_CapReg count in cap_ships (00 section 6).
	if type(TRF_CapShips) == "function" then nsh = nsh + TRF_SafeNum(call(TRF_CapShips, {}, "x", TRF_PErr), 0); end;
	local nrf, nrs = TRF_SafeRaidsOf(L.rd);
	local gate = 1;
	if kind == "clan" then gate = TRF_StrictOk(nil, "raid"); elseif kind ~= "trader" then gate = TRF_StrictOk(nil, kind); end;
	local ecap = TRF_SafeEvCap(kind);
	local mcap = nil;
	if kind == "merc" then mcap = TRF_SafeTune("mc_ships", 14); end;
	if type(ev) ~= "number" then
		ev = 0;
		if kind == "carrier" or kind == "clan" then ev = nrs; end;
	end;
	local s = {
		kind = kind, supp = TRF_Supp(), ntr = ntr, nsh = nsh + npk, n = TRF_SafeNum(nships, 0),
		capt = TRF_SafeNum(L.capt, 0), caps = TRF_SafeNum(L.caps, 0), cp = TRF_SafeNum(L.capp, 0),
		kills = TRF_SafeNum(L.kills, 0), kcap = TRF_SafeTune("kill_cap", 3),
		gate = gate, gov = TRF_GovActive(), nrf = nrf, nrs = nrs, npk = npk,
		rf = TRF_SafeTune("raid_fl", 1), rs = TRF_SafeTune("raid_sh", 8), ecap = ecap, ev = ev, mcap = mcap
	};
	local ok, r = TRF_CanSpawnKindOf(s);
	-- Over cap_ships: the registered groups give up ships first (rival, pack, scavenger; trf_plumb
	-- TRF_CapTrimDo), then the spawn is skipped for the ships still over (00 section 6).
	if not ok and r == "ships" and type(TRF_CapTrimDo) == "function" then
		local fr = TRF_SafeNum(call(TRF_CapTrimDo, {s.nsh + s.n - s.caps}, "x", TRF_PErr), 0);
		if fr > 0 then
			s.nsh = s.nsh - fr;
			ok, r = TRF_CanSpawnKindOf(s);
		end;
	end;
	if not ok then
		TRF_SafeDE("no_spawn", "kind", kind, "reason", r, "trader_count", ntr, "trader_cap", s.capt, "ship_count", s.nsh,
			"new_ship_count", s.n, "ship_cap", s.caps, "raid_flight_count", nrf, "raid_ship_count", nrs, "parked_count", npk,
			"parked_cap", s.cp, "kill_count", s.kills, "suppression", s.supp, "event_count", ev, "event_cap", ecap or mcap);
	end;
	return ok, r;
end;

-- Governor (5.2): counts carcasses in a sphere of gov_r (3000) at the origin. The native counts scenery
-- too (36 to 202 per system with no mod ships), so the first count of the visit is its baseline (live.gvn0,
-- mirrored in H.gvn0 because gen's load pass rebuilds live; logged once) and the rule applies to the excess
-- over it (live.gvn, never below 0; raw count live.gvr): wrecks and ships that appeared during the visit.
-- Then sets live.capt/caps/capp through TRF_SafeCaps. Returns capt, caps, excess (nil when unknown).
function TRF_Governor()
	local gr = TRF_SafeNum(TRF_SafeOpt("gov_r", 3000), 3000);
	local n = TRF_Safe_Count(gr);
	local L = TRF_SafeLive();
	local H = TRF_SafeH();
	local x = nil;
	if L then
		if type(L.gvn0) ~= "number" and H and type(H.gvn0) == "number" then L.gvn0 = H.gvn0; end;
		if type(L.gvn0) ~= "number" and type(n) == "number" then
			L.gvn0 = n;
			if H then H.gvn0 = n; end;
			TRF_SafeE("governor_base", "carcass_count", n, "radius", gr);
		end;
		if type(n) == "number" and type(L.gvn0) == "number" then x = max(0, n - L.gvn0); end;
		L.gvn = x; L.gvr = n; L.gv = 1;
	end;
	local capt, caps, capp = TRF_SafeCaps(x);
	TRF_SafeE("governor", "excess_count", x, "carcass_count", n, "radius", gr, "trader_cap", capt, "ship_cap", caps, "parked_cap", capp);
	return capt, caps, x;
end;

-- Trade station handle or nil (4.2, R10): label of the map's st[1] (kind "trade", top-level docking), then
-- IsAlive. Sets live.stok and H.st. Once lost (stl 1) it stays off for the visit; no such entry, no station.
function TRF_Station()
	local L = TRF_SafeLive();
	local H = TRF_SafeH();
	if L and L.stl == 1 then
		L.stok = 0;
		if H then H.st = nil; end;
		return nil;
	end;
	local sy = TRF_SafeSys();
	local lbl = nil;
	if type(sy) == "table" and type(sy.st) == "table" then
		local e = sy.st[1];
		if type(e) == "table" and e.kind == "trade" and e.cond ~= 1 then lbl = e.label; end;
	end;
	local o = TRF_Safe_StObj(lbl);
	if H then H.st = o; end;
	if not L then return o; end;
	local was = L.stok;
	if o then L.stok = 1; else L.stok = 0; end;
	if was == 1 and not o then
		L.stl = 1;
		TRF_SafeE("station", "label", lbl, "result", "lost");
	elseif L.sck ~= 1 then
		TRF_SafeE("station", "label", lbl, "found", TRF_KvB(L.stok));
	end;
	L.sck = 1;
	return o;
end;

-- Per-visit safety fields back to their start values (entry, load).
function TRF_SafeVisitReset()
	local L = TRF_SafeLive();
	if L then
		L.sos_t = nil; L.ext_seen = nil; L.pmv = nil; L.exn = nil; L.ext = nil; L.wind = nil; L.sl = nil; L.ss = nil; L.sm = nil;
		L.gv = nil; L.stl = nil; L.sck = nil; L.gvn = nil; L.gvn0 = nil; L.gvr = nil; L.gl = nil; L.gate = nil;
		L.qa = nil; L.qai = nil;
		L.cbt = nil; L.cbw = nil; L.cbh = nil; L.cbi = nil; L.cbs = nil; L.cbl = nil; L.cbk = nil; L.cbp = nil;
	end;
	local H = TRF_SafeH();
	if H then H.st = nil; H.sact = nil; H.sms = nil; H.gvn0 = nil; end;
end;

-- Loader callbacks (10.1) ------------------------------------------------------------

function TRF_Safety_OnEnter()
	TRF_SafeVisitReset();
end;

function TRF_Safety_OnActivate()
	TRF_Governor();
	TRF_Station();
	local s = TRF_SafeModeIn();
	local m, why = TRF_SysModeOf(s);
	local nm = "nil";
	if type(s.sys) == "table" then nm = tostring(s.sys.name); end;
	local L = TRF_SafeLive();
	local g = TRF_SafeGateSum(nil);
	if L then L.gate = g; end;
	TRF_SafeE("activate", "system", nm, "mode", m, "reason", why, "chapter", s.ch, "quest_state", s.qs, "gate", g);
	TRF_SafeArm("activate");
end;

-- Gate summary of system idx (nil = current) without counters: "ok", or the first denial and the denied
-- features ("mission_q:seed,raid,..."), "nomap" without a map entry.
function TRF_SafeGateSum(idx)
	local s = TRF_StrictIn(idx, "seed");
	if not s then return "nomap"; end;
	local fs = {"seed", "raid", "staged", "contract", "parked", "tt3", "band", "board", "track", "conv", "tt4",
		"sweep", "carrier", "feq", "dconv", "offer"};
	local first, list = nil, "";
	for i = 1, getn(fs) do
		s.f = fs[i];
		local ok, why = TRF_StrictOkOf(s);
		if not ok then
			if not first then first = why; end;
			if list ~= "" then list = list..","; end;
			list = list..fs[i];
		end;
	end;
	if not first then return "ok"; end;
	return first..":"..list;
end;

-- Dump line (v02 10.2): gate, strict inputs, caps, governor, combat (cbt = age of the last hostile event);
-- called by TRF_DumpState.
function TRF_Safety_Dump()
	local s = TRF_StrictIn(nil, "seed");
	local L = TRF_SafeLive() or {};
	local nm, q, qs, mode, dn, qa = "nil", "?", "?", "?", "none", "?";
	if s then
		nm = s.name; q = tostring(s.q); qs = tostring(s.qs); mode = tostring(s.mode); qa = tostring(s.qa);
		if type(s.ent) == "table" then dn = tostring(s.ent.why); end;
	end;
	local cb, ca = 0, "nil";
	if TRF_Combat() then cb = 1; end;
	if type(L.cbt) == "number" then ca = TRF_F(TRF_SafeGt() - L.cbt); end;
	TRF_SafeE("dump", "gate", TRF_SafeGateSum(nil), "system", nm, "strict", mode, "quest_state", qs, "quest", q, "quest_active", qa,
		"deny_reason", dn, "trader_cap", L.capt, "ship_cap", L.caps, "parked_cap", L.capp, "governor_excess", L.gvn,
		"governor_count", L.gvr, "governor_on", TRF_KvB(TRF_GovActive()), "combat", TRF_KvB(cb), "combat_age", ca,
		"combat_reason", L.cbw);
end;

-- After a load sos_t restarts at the load time and ext_seen is nil (spec 6). TRF_Gen_OnLoad resets live
-- afterwards (capt/caps back to cfg, stok 0); TRF_CanSpawn reruns the governor (gv nil) and gen's next
-- TRF_Station call finds the station again (stl nil).
function TRF_Safety_OnLoad()
	TRF_SafeVisitReset();
	TRF_Governor();
	TRF_Station();
	TRF_SafeArm("load");
end;

function TRF_Safety_Tick()
	TRF_SafetySample();
end;
