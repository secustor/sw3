-- Inputs of TRF_StrictOkOf for system idx (nil = current) and feature f; nil when idx has no map entry.
function TRF_StrictIn(idx, f)
	local sy = nil;
	if idx == nil then
		sy, idx = TRF_SafeSys();
	else
		local m = TRF_SafeMap();
		if type(m) == "table" and type(m.sys) == "table" and type(idx) == "number" then sy = m.sys[idx]; end;
	end;
	if type(sy) ~= "table" or type(sy.name) ~= "string" then return nil; end;
	local q = sy.q;
	if type(q) ~= "number" then
		q = 1;
		if TRF_StrictFree()[strlower(sy.name)] then q = 0; end;
	end;
	local mode = TRF_SafeOpt("strict", 1);
	if mode ~= 0 and mode ~= 1 and mode ~= 2 then mode = 1; end;
	local qa = nil;
	if q == 1 and mode ~= 0 then qa = TRF_SafeQA(idx, sy); end;
	return {mode=mode, qs=TRF_Safe_QState(), q=q, qa=qa, ent=TRF_DenyEntry(sy.name), f=f, name=sy.name, idx=idx};
end;

-- Strict gate (v02 8.3, v1 10.2): 1 or nil, reason for system idx (nil = current) and feature (seed, raid,
-- staged, contract, parked, tt3, band, board; v1: track, conv, tt4, sweep, carrier, feq, dconv, offer).
-- No map entry -> nil, "nomap". A denial counts gate_<feature> and is logged when it differs from the
-- last one logged this visit.
function TRF_StrictOk(idx, feature)
	local s = TRF_StrictIn(idx, feature);
	local ok, why = nil, "nomap";
	if s then ok, why = TRF_StrictOkOf(s); end;
	if ok then return 1, nil; end;
	TRF_SafeStat("gate_"..tostring(feature));
	local L = TRF_SafeLive();
	local nm = "nil";
	if s then nm = s.name; end;
	local k = tostring(feature)..":"..tostring(why)..":"..nm;
	if L and L.gl ~= k then
		L.gl = k;
		TRF_SafeL("gate "..tostring(feature).." denied why="..tostring(why).." sys="..nm);
	end;
	return nil, why;
end;

-- 1 while the governor holds (carcass count above gov): tier <= TT2, raids and staged raids off (9.1).
function TRF_GovActive()
	local L = TRF_SafeLive();
	if not L or type(L.gvn) ~= "number" then return nil; end;
	if L.gvn > TRF_SafeNum(TRF_SafeOpt("gov", 40), 40) then return 1; end;
	return nil;
end;

function TRF_Chapter()
	return TRF_ChapterOf(TRF_Safe_Quest());
end;

-- Caps for the next spawn decision (v02 9.1): band row of the live pro (TRF_BandCaps, trf_tier), cfg limits
-- (cap_traders 0..5, cap_ships 0..20), strict gate "band", then the governor on the carcass count n (nil:
-- the count of the last TRF_Governor run). Writes live.capt/caps/capp. Returns ct, cs, cp.
function TRF_SafeCaps(n)
	local lt = TRF_SafeClamp(floor(TRF_SafeNum(TRF_SafeOpt("cap_traders", 5), 5)), 0, 5);
	local ls = TRF_SafeClamp(floor(TRF_SafeNum(TRF_SafeOpt("cap_ships", 20), 20)), 0, 20);
	local sy, idx = TRF_SafeSys();
	local b, gate = nil, nil;
	if idx then
		gate = TRF_StrictOk(idx, "band");
		if gate and type(TRF_BandCaps) == "function" then b = call(TRF_BandCaps, {idx}, "x", TRF_SafePErr); end;
		-- Bands 3-4 (pro 8-9, v1 8.1) are a strict-gate feature with TT4: denied -> the band 2 row bounds.
		if type(b) == "table" and TRF_SafeNum(b.band, 0) >= 3 and not TRF_StrictOk(idx, "tt4") then
			b = {ct=min(TRF_SafeNum(b.ct, 2), 4), cs=min(TRF_SafeNum(b.cs, 10), 16), cp=min(TRF_SafeNum(b.cp, 0), 1)};
		end;
	end;
	local ct, cs, cp = TRF_SafeCapsOf(b, lt, ls, gate);
	local L = TRF_SafeLive();
	if n == nil and L then n = L.gvn; end;
	ct, cs = TRF_GovernorOf(n, ct, cs, TRF_SafeNum(TRF_SafeOpt("gov", 40), 40));
	if L then L.capt = ct; L.caps = cs; L.capp = cp; end;
	return ct, cs, cp;
end;

-- Inputs of TRF_SysModeOf from the game.
function TRF_SafeModeIn()
	local L = TRF_SafeLive();
	local inval = nil;
	if L then inval = L.inval; end;
	return {
		enabled = TRF_SafeOpt("enabled", 1),
		override = TRF_SafeOpt("override", 1),
		guard = TRF_SafeNum(TRF_SafeOpt("guard", 1), 1),
		sys = TRF_SafeSys(),
		off = TRF_SafeOpt("sys_off", {}),
		deny = TRF_Deny(),
		deny2 = TRF_SafeOpt("sys_deny", {}),
		inval = inval,
		qs = TRF_Safe_QState(),
		ch = TRF_Chapter()
	};
end;

-- "mod" or "vanilla", reason (2.3). Counts van_<reason> in live.stat; logs when the result changes.
function TRF_SysMode()
	local s = TRF_SafeModeIn();
	local m, why = TRF_SysModeOf(s);
	if why then TRF_SafeStat("van_"..why); end;
	local L = TRF_SafeLive();
	local k = m..":"..tostring(why);
	if L and L.sm ~= k then
		L.sm = k;
		local nm = "nil";
		if type(s.sys) == "table" then nm = tostring(s.sys.name); end;
		TRF_SafeL("mode "..m.." why="..tostring(why).." sys="..nm.." ch="..tostring(s.ch).." qs="..tostring(s.qs).." guard="..tostring(s.guard));
	end;
	return m, why;
end;

-- TRF_SysMode without the van_<reason> count and the change log (dump, arrival line).
function TRF_SysModeQuiet()
	return TRF_SysModeOf(TRF_SafeModeIn());
end;

-- 0 none, 1 pause, 2 wind-down (R2, R3). Reads the flags now, so a flag set since the last tick counts.
function TRF_Supp()
	local f = TRF_Safe_Flags();
	local L = TRF_SafeLive();
	local sos_t, ext = nil, nil;
	if L then
		sos_t = L.sos_t;
		if f.sos and not f.dis and L.ext_seen == 1 then ext = TRF_Safe_ExtAlive(); end;
	end;
	return TRF_SuppOf(f.dis, f.sos, TRF_SafeGt(), sos_t, ext, TRF_SafeTune("sos_db", 30));
end;

-- 1 once per suppression onset when a wind-down is due (sets live.wind); nil otherwise. For TRF_WindDown.
function TRF_SafeWindOnset()
	local L = TRF_SafeLive();
	if not L or L.wind == 1 or TRF_Supp() ~= 2 then return nil; end;
	L.wind = 1;
	TRF_SafeL("wind-down onset gt="..TRF_F(TRF_SafeGt()));
	return 1;
end;

-- Wind-down action from distances, with the tune values (see TRF_WindChoiceOf).
function TRF_WindChoice(path, d_ms, d_st)
	return TRF_WindChoiceOf(path, d_ms, d_st, TRF_SafeTune("ovd", 600), TRF_SafeTune("np_max", 300));
end;

-- Extortion tracking (spec 6), every tick. Returns the suppression level.
function TRF_SafetySample()
	local L = TRF_SafeLive();
	if not L then return TRF_Supp(); end;
	local f = TRF_Safe_Flags();
	local gt = TRF_SafeGt();
	if f.sos then
		if type(L.sos_t) ~= "number" then
			L.sos_t = gt;
			TRF_SafeD("sos on gt="..TRF_F(gt));
		end;
	elseif L.sos_t then
		L.sos_t = nil;
		TRF_SafeD("sos off gt="..TRF_F(gt));
	end;
	if f.money then
		if L.pmn == 1 and L.ext_seen ~= 1 then
			L.ext_seen = 1;
			TRF_SafeL("extortion seen gt="..TRF_F(gt));
		end;
	else
		L.pmn = 1;
	end;
	local s = TRF_Supp();
	-- wind is per onset; cleared only when neither flag is set, so a __disableAction wind-down runs once.
	if s == 0 then L.wind = nil; end;
	if s ~= TRF_SafeNum(L.sl, 0) then
		TRF_SafeL("supp "..TRF_SafeNum(L.sl, 0).."->"..s.." dis="..tostring(f.dis).." sos="..tostring(f.sos).." ext_seen="..tostring(L.ext_seen));
	end;
	L.sl = s;
	return s;
end;

-- Event bound of a v1 spawn kind (v1 10.2, 10.5), nil for traffic kinds.
function TRF_SafeEvCap(kind)
	if kind == "sweep" then return TRF_SafeTune("cap_sweep", 14); end;
	if kind == "feq" then return TRF_SafeTune("cap_feq", 14); end;
	if kind == "carrier" or kind == "clan" then return TRF_SafeTune("raid_live_cap", 8); end;
	if kind == "base" then return TRF_SafeTune("cap_base", 16); end;
	return nil;
end;

-- 1, spare ships or nil, reason (5.1, v02 10.2). nships = ships of the planned base row (raid: raid ships);
-- kind trader (default), seed, staged, raid, parked; v1: track, conv, dconv, tt4 and the event kinds sweep,
-- feq, carrier, clan, base (TRF_CanSpawnKindOf). ev: live ships of that event (event kinds; default for
-- carrier and clan: the ships of the open raid records). Caps are recomputed per decision (band read
-- live); if the visit has no governor count yet (live reset after OnActivate/OnLoad) the governor runs
-- now. Parked ships count against cap_ships. Gate feature: the kind, "raid" for clan.
function TRF_CanSpawn(nships, kind, ev)
	local L = TRF_SafeLive();
	if not L then return nil, "nolive"; end;
	if type(kind) ~= "string" then kind = "trader"; end;
	if L.gv ~= 1 then TRF_Governor(); else TRF_SafeCaps(); end;
	local ntr, nsh = TRF_SafeCountOf(L.tr);
	local npk = TRF_SafeParkedOf(L.pk);
	local nrf, nrs = TRF_SafeRaidsOf(L.rd);
	local gate = 1;
	if kind == "clan" then gate = TRF_StrictOk(nil, "raid"); elseif kind ~= "trader" then gate = TRF_StrictOk(nil, kind); end;
	local ecap = TRF_SafeEvCap(kind);
	if type(ev) ~= "number" then
		ev = 0;
		if kind == "carrier" or kind == "clan" then ev = nrs; end;
	end;
	local s = {
		kind = kind, supp = TRF_Supp(), ntr = ntr, nsh = nsh + npk, n = TRF_SafeNum(nships, 0),
		capt = TRF_SafeNum(L.capt, 0), caps = TRF_SafeNum(L.caps, 0), cp = TRF_SafeNum(L.capp, 0),
		kills = TRF_SafeNum(L.kills, 0), kcap = TRF_SafeTune("kill_cap", 3),
		gate = gate, gov = TRF_GovActive(), nrf = nrf, nrs = nrs, npk = npk,
		rf = TRF_SafeTune("raid_fl", 1), rs = TRF_SafeTune("raid_sh", 8), ecap = ecap, ev = ev
	};
	local ok, r = TRF_CanSpawnKindOf(s);
	if not ok then
		TRF_SafeD("no spawn "..kind.." "..r.." tr="..ntr.."/"..s.capt.." ships="..s.nsh.."+"..s.n.."/"..s.caps
			.." raids="..nrf.."/"..nrs.." parked="..npk.."/"..s.cp.." kills="..s.kills.." supp="..s.supp
			.." ev="..ev.."/"..tostring(ecap));
	end;
	return ok, r;
end;

-- Governor (5.2): counts carcasses (live.gvn), then sets live.capt/caps/capp through TRF_SafeCaps.
-- Returns capt, caps, carcass count (nil when unknown).
-- CHECK: one sphere of gov_r (3000) at the origin covers a system.
function TRF_Governor()
	local gr = TRF_SafeNum(TRF_SafeOpt("gov_r", 3000), 3000);
	local n = TRF_Safe_Count(gr);
	local L = TRF_SafeLive();
	if L then L.gvn = n; L.gv = 1; end;
	local capt, caps, capp = TRF_SafeCaps(n);
	TRF_SafeL("governor n="..tostring(n).." r="..gr.." cap="..capt.."/"..caps.."/"..capp);
	return capt, caps, n;
end;

-- Trade station handle or nil (4.2, R10): label of the map's st[1] (kind "trade", top-level docking), then
-- IsAlive. Sets live.stok and H.st. Once lost (stl 1) it stays off for the visit; no such entry, no station.
function TRF_Station()
	local L = TRF_SafeLive();
	local H = TRF_SafeH();
	if L and L.stl == 1 then
		L.stok = 0;
		if H then H.st = nil; end;
		return nil;
	end;
	local sy = TRF_SafeSys();
	local lbl = nil;
	if type(sy) == "table" and type(sy.st) == "table" then
		local e = sy.st[1];
		if type(e) == "table" and e.kind == "trade" and e.cond ~= 1 then lbl = e.label; end;
	end;
	local o = TRF_Safe_StObj(lbl);
	if H then H.st = o; end;
	if not L then return o; end;
	local was = L.stok;
	if o then L.stok = 1; else L.stok = 0; end;
	if was == 1 and not o then
		L.stl = 1;
		TRF_SafeL("station "..tostring(lbl).." lost");
	elseif L.sck ~= 1 then
		TRF_SafeL("station label="..tostring(lbl).." ok="..L.stok);
	end;
	L.sck = 1;
	return o;
end;

-- Per-visit safety fields back to their start values (entry, load).
function TRF_SafeVisitReset()
	local L = TRF_SafeLive();
	if L then
		L.sos_t = nil; L.ext_seen = nil; L.pmn = nil; L.wind = nil; L.sl = nil; L.sm = nil;
		L.gv = nil; L.stl = nil; L.sck = nil; L.gvn = nil; L.gl = nil; L.gate = nil; L.qa = nil; L.qai = nil;
	end;
	local H = TRF_SafeH();
	if H then H.st = nil; end;
end;

-- Loader callbacks (10.1) ------------------------------------------------------------

function TRF_Safety_OnEnter()
	TRF_SafeVisitReset();
end;

function TRF_Safety_OnActivate()
	TRF_Governor();
	TRF_Station();
	local s = TRF_SafeModeIn();
	local m, why = TRF_SysModeOf(s);
	local nm = "nil";
	if type(s.sys) == "table" then nm = tostring(s.sys.name); end;
	local L = TRF_SafeLive();
	local g = TRF_SafeGateSum(nil);
	if L then L.gate = g; end;
	TRF_SafeL("activate sys="..nm.." mode="..m.." why="..tostring(why).." ch="..tostring(s.ch).." qs="..tostring(s.qs).." gate="..g);
end;

-- Gate summary of system idx (nil = current) without counters: "ok", or the first denial and the denied
-- features ("mission_q:seed,raid,..."), "nomap" without a map entry.
function TRF_SafeGateSum(idx)
	local s = TRF_StrictIn(idx, "seed");
	if not s then return "nomap"; end;
	local fs = {"seed", "raid", "staged", "contract", "parked", "tt3", "band", "board", "track", "conv", "tt4",
		"sweep", "carrier", "feq", "dconv", "offer"};
	local first, list = nil, "";
	for i = 1, getn(fs) do
		s.f = fs[i];
		local ok, why = TRF_StrictOkOf(s);
		if not ok then
			if not first then first = why; end;
			if list ~= "" then list = list..","; end;
			list = list..fs[i];
		end;
	end;
	if not first then return "ok"; end;
	return first..":"..list;
end;

-- Dump line (v02 10.2): gate, strict inputs, caps, governor; called by TRF_DumpState.
function TRF_Safety_Dump()
	local s = TRF_StrictIn(nil, "seed");
	local L = TRF_SafeLive() or {};
	local nm, q, qs, mode, dn, qa = "nil", "?", "?", "?", "none", "?";
	if s then
		nm = s.name; q = tostring(s.q); qs = tostring(s.qs); mode = tostring(s.mode); qa = tostring(s.qa);
		if type(s.ent) == "table" then dn = tostring(s.ent.why); end;
	end;
	TRF_L("dump gate="..TRF_SafeGateSum(nil).." sys="..nm.." strict="..mode.." qs="..qs.." q="..q.." qa="..qa.." deny="..dn
		.." cap="..tostring(L.capt).."/"..tostring(L.caps).."/"..tostring(L.capp).." gov="..tostring(L.gvn)
		.." gov_on="..tostring(TRF_GovActive()));
end;

-- After a load sos_t restarts at the load time and ext_seen is nil (spec 6). TRF_Gen_OnLoad resets live
-- afterwards (capt/caps back to cfg, stok 0); TRF_CanSpawn reruns the governor (gv nil) and gen's next
-- TRF_Station call finds the station again (stl nil).
function TRF_Safety_OnLoad()
	TRF_SafeVisitReset();
	TRF_Governor();
	TRF_Station();
end;

function TRF_Safety_Tick()
	TRF_SafetySample();
end;
