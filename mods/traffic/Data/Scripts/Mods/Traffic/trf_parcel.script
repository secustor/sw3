-- sw3-traffic sealed parcels (Lua 4.0.1). Spec: design/parcel-spec.md (design worldbuilding/01-sealed-parcels.md, step 1).
-- Prefix Pc (TRF_Pc_* public, TRF_Pc<X> internal), log module=parcel.
-- Step 1, courier: plain and relief parcels (Cargo_crate, Cargo_002) offered by the FTU courier desk at trade docks
-- (trade box 400), deterministic per station and region-tick window, for a trade dock 2-4 jumps away (1-3 between
-- Aurora, Corrino and Pegas while the chapter 4 guard holds); deposit, the job slot TRF.job, the logbook entry trf_pcl,
-- the nav marker at the destination, delivery at the destination dock (trade line 20), expiry and void, help, visit
-- credits, #3 standing and the shortage feeds (TRF.short job), the shared prize gap on the pay, deny lists, toggles, dump.
-- Step 2 (contraband at pirate docks, customs, prototype parcels and interception) is not built: the saved fields cu,
-- cs, hot, fac, TRF.pcl.xl and .cfl, cfg enable_contraband, enable_customs, enable_intercept and the step 2 tune keys
-- are kept by the repair and read nowhere; the hook points say "Step 2 hook".
-- Saved fields: TRF.job = {k (1 plain, 2 relief), r, t0, ml, pd, m, c} (packed, TRF_PcPackOf; at most 6 fields, the
-- plumbing job slot), TRF.pcl = {je, ban, ok, fail, lsys, lleg, lok, lg, lt, pm, pr, ow, pq, ll[, xl, cfl]},
-- TRF.short[i].job. Visit state lives in the chunk local PC (never saved; rebuilt by every MapInitialization).
-- Layout as trf_freight: helpers, static tables, pure functions (*Of), state, gates, plan, logbook, items, job life,
-- docks, loader callbacks, repair, defaults, dump, text. Top level: functions and PC only.

local PC = {v={}};

-- Helpers --------------------------------------------------------------------------

function TRF_PcSH() return %PC; end;

-- logfmt event line, module=parcel (design/log-format.md).
function TRF_PcE(event, ...)
	tinsert(arg, 1, event); tinsert(arg, 1, "parcel"); call(TRF_Lf, arg);
end;

-- Error handler for protected calls: an event=error line, counted in stat err.
function TRF_PcErr(m)
	TRF_PcE("error", "message", tostring(m));
	TRF_N("TRF_Stat", "err");
end;

-- Silent handler (natives that may be missing or answer badly): nil is the answer.
function TRF_PcNoErr(m) end;

function TRF_PcLogLv()
	local v = TRF_N("TRF_Opt", "log");
	if type(v) ~= "number" then v = TRF_Cfg().log or 1; end;
	return v;
end;

-- Debug event line (log 2).
function TRF_PcDE(event, ...)
	if TRF_PcLogLv() < 2 then return; end;
	tinsert(arg, 1, event); call(TRF_PcE, arg);
end;

function TRF_PcStat(k)
	TRF_N("TRF_Stat", k);
end;

function TRF_PcCl(x, lo, hi)
	if x < lo then return lo; end;
	if x > hi then return hi; end;
	return x;
end;

-- x mod m for x >= 0 (Lua 4 has no % operator).
function TRF_PcM(x, m)
	return x - floor(x / m) * m;
end;

-- cfg value: TRF_Opt (merges TRF_Pc_OptDef), else the raw config, else the default; a wrong type reads as the default,
-- and a number outside 0..1 too (every number key is a toggle).
function TRF_PcOpt(key)
	local d = TRF_Pc_OptDef()[key];
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil and type(TRF_CfgGet) == "function" then v = TRF_CfgGet(key, nil); end;
	if v == nil or (d ~= nil and type(v) ~= type(d)) then return d; end;
	if type(v) == "number" and v ~= 0 and v ~= 1 then return d; end;
	return v;
end;

-- Tune values of this module, clamped (TRF_PcClampT: {lo, hi, int}); list keys are copied with each entry clamped.
-- Cached in PC while TRF_Tune returns the same table; callers must not write into it.
function TRF_PcTune()
	local pc = %PC;
	local t = nil;
	if type(TRF_Tune) == "function" then t = call(TRF_Tune, {}, "x", TRF_PcErr); end;
	if type(pc.tc) == "table" and pc.tc.s == t then return pc.tc.t; end;
	local d, cl, o = TRF_Pc_TuneDef(), TRF_PcClampT(), {};
	for k, v in d do
		local x = nil;
		if type(t) == "table" then x = t[k]; end;
		if type(x) ~= type(v) then x = v; end;
		local r = cl[k];
		if type(x) == "table" then
			local w = {};
			for i = 1, getn(v) do
				local e = x[i];
				if type(e) ~= "number" then e = v[i]; end;
				if r[3] == 1 then e = floor(e); end;
				w[i] = TRF_PcCl(e, r[1], r[2]);
			end;
			x = w;
		elseif r then
			if r[3] == 1 then x = floor(x); end;
			x = TRF_PcCl(x, r[1], r[2]);
		end;
		o[k] = x;
	end;
	pc.tc = {s=t, t=o};
	return o;
end;

function TRF_PcT(key)
	return TRF_PcTune()[key];
end;

-- A traffic tune value (pay_cap, rg_tick), else def.
function TRF_PcTv(key, def)
	local t = nil;
	if type(TRF_Tune) == "function" then t = call(TRF_Tune, {}, "x", TRF_PcErr); end;
	if type(t) == "table" and type(t[key]) == "number" then return t[key]; end;
	return def;
end;

-- The traffic pay_cap, at most 30,000 (the bound of the packed pay and of the repair).
function TRF_PcPayCap()
	return min(30000, TRF_PcTv("pay_cap", 30000));
end;

-- Region tick in legs (the offer window, 01 section 6), at least 1.
function TRF_PcRgTick()
	return max(1, floor(TRF_PcTv("rg_tick", 2)));
end;

function TRF_PcLegs()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then return TRF.clock.legs; end;
	return 0;
end;

-- Jumps (00 section 6: the shared TRF.clock.j).
function TRF_PcJumps()
	local v = TRF_N("TRF_Jumps");
	if type(v) == "number" then return v; end;
	return 0;
end;

function TRF_PcGen()
	if type(TRF) == "table" and type(TRF.gen) == "number" then return TRF.gen; end;
	return 0;
end;

function TRF_PcMap()
	local m = TRF_N("TRF_Map");
	if type(m) == "table" and type(m.sys) == "table" then return m; end;
	return nil;
end;

-- Lowercase map name of system idx (log values), or the index.
function TRF_PcName(idx)
	local n = TRF_N("TRF_SysName", idx);
	if type(n) == "string" and n ~= "?" then return strlower(n); end;
	return tostring(idx);
end;

-- Display name of system idx (trf_ui: the location folder), for the lines.
function TRF_PcSys(idx)
	local n = TRF_N("TRF_UI_SysName", idx);
	if type(n) == "string" then return n; end;
	return TRF_PcName(idx);
end;

function TRF_PcTxt(key, a, b, c)
	if type(TRF_Txt) == "function" then return TRF_Txt(key, a, b, c); end;
	return tostring(key);
end;

function TRF_PcCur()
	local i = TRF_N("TRF_CurIdx");
	if type(i) == "number" then return i; end;
	return nil;
end;

-- 1 while GetPlayerQuestState() == TRUE (a story mission runs; LevelUp.script:32).
function TRF_PcQuest()
	if type(GetPlayerQuestState) == "function" and GetPlayerQuestState() == TRUE then return 1; end;
	return nil;
end;

function TRF_PcQsRaw(id)
	return GetQuestState(id);
end;

-- Logbook state of id (GetQuestState), or nil without the native.
function TRF_PcQs(id)
	if type(GetQuestState) ~= "function" then return nil; end;
	return call(TRF_PcQsRaw, {id}, "x", TRF_PcNoErr);
end;

-- Free roam (01 section 3): no mission (GetPlayerQuestState() ~= TRUE), or quest_Help in process (a free-time window,
-- OutOfMission.script:541-546).
function TRF_PcFree()
	if not TRF_PcQuest() then return 1; end;
	local s = TRF_PcQs("quest_Help");
	if s ~= nil and QUEST_PROCESS ~= nil and s == QUEST_PROCESS then return 1; end;
	return nil;
end;

function TRF_PcHeat()
	if type(TRF) == "table" and type(TRF.std) == "table" and type(TRF.std.heat) == "number" then return TRF.std.heat; end;
	return 0;
end;

function TRF_PcHelp()
	if type(TRF) == "table" and type(TRF.std) == "table" and type(TRF.std.help) == "number" then return TRF.std.help; end;
	return 0;
end;

function TRF_PcChapter()
	local c = TRF_N("TRF_Chapter");
	if type(c) == "number" then return c; end;
	return 0;
end;

-- 1 while the starting-region guard holds (chapter <= 4, trf_region TRF_RgGuardOn).
function TRF_PcGuardOn()
	if type(TRF_RgGuardOn) == "function" then return TRF_RgGuardOn(); end;
	if TRF_PcChapter() <= 4 then return 1; end;
	return nil;
end;

function TRF_PcCreditsRaw()
	return GetPlayerCredits();
end;

function TRF_PcCredits()
	if type(GetPlayerCredits) ~= "function" then return nil; end;
	local v = call(TRF_PcCreditsRaw, {}, "x", TRF_PcErr);
	if type(v) == "number" then return v; end;
	return nil;
end;

function TRF_PcSubRaw(n)
	SubPlayerCredits(n);
	return 1;
end;

function TRF_PcSub(n)
	if n <= 0 then return 1; end;
	if type(SubPlayerCredits) ~= "function" then return nil; end;
	return call(TRF_PcSubRaw, {n}, "x", TRF_PcErr);
end;

function TRF_PcAddRaw(n)
	AddPlayerCredits(n);
	return 1;
end;

-- Credits back to the player (deposit refunds; not pay, so no pay_cap and no prize gap). 1 when paid.
function TRF_PcAdd(n)
	if type(n) ~= "number" or n <= 0 then return 1; end;
	if type(AddPlayerCredits) ~= "function" then return nil; end;
	return call(TRF_PcAddRaw, {floor(n)}, "x", TRF_PcErr);
end;

-- "15,400": a whole number with thousands separators (the design's lines).
function TRF_PcNum(n)
	local s = format("%d", floor((n or 0) + 0.5));
	local neg = "";
	if strsub(s, 1, 1) == "-" then neg = "-"; s = strsub(s, 2); end;
	local o = "";
	while strlen(s) > 3 do
		o = ","..strsub(s, -3)..o;
		s = strsub(s, 1, strlen(s) - 3);
	end;
	return neg..s..o;
end;

-- Static tables --------------------------------------------------------------------

-- Constants without a cfg key: first chapter, guard docks (01 section 3, chapter 4), static deny systems (01 section 3),
-- the InoCo core systems (shut without the permit), item names by it (1 Cargo_crate, 2 Cargo_002, 3 Uranium,
-- 4 Cargo_Electronic_2), their fallback costs, units per job, source pro gate, heat gate, thank-you window (legs),
-- line seconds, logbook id, marker label and owner, the Recovery phase.
function TRF_PcK()
	return {ch_min=4, guard={aurora=1, corrino=1, pegas=1},
		deny={fronn=1, nk=1, earth=1, precursors=1, disonsphere=1, x203=1, x213=1, x220=1, x297=1},
		inoco={ashelon=1, danstag=1, hafa=1, xk10=1}, items={"Cargo_crate", "Cargo_002", "Uranium", "Cargo_Electronic_2"},
		cost={1200, 850, 2200, 50000}, n_max=3, pro_min=3, heat_max=2, thx_legs=10, secs=8, qid="trf_pcl", mk="TRF_".."PCL_NP",
		own="parcel", recovery=5};
end;

-- Clamps of the tune keys {lo, hi, int}; list keys clamp each entry.
function TRF_PcClampT()
	return {pcl_k={0, 5, 0}, pcl_relief_k={1, 3, 0}, pcl_x_k={0, 5, 0}, pcl_proto_k={0, 5, 0}, pcl_offer_pct={0, 100, 1},
		pcl_offer_rpct={0, 100, 1}, pcl_plain_pct={0, 100, 1}, pcl_jmax={2, 6, 1}, pcl_jmax_g={1, 4, 1}, pcl_gap={0, 50, 1},
		pcl_ban={0, 200, 1}, pcl_dep_k={0, 5, 0}, pcl_dep_k2={0, 5, 0}, pcl_waive_help={0, 99, 1}, pcl_x_score_legs={0, 200, 1},
		pcl_hot_k={0, 1, 0}, cust_hostile_max={0, 2, 1}, cust_base={0, 100, 1}, cust_wait={5, 600, 1}, cust_radius={5, 500, 1},
		cust_fine_k={0, 10, 0}, cust_flag_legs={0, 200, 1}};
end;

