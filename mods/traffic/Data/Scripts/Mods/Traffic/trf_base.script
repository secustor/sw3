-- sw3-traffic pirate bases (v1 spec 9, M15-M18, S37-S39, R13; design 7.14, 8.12). Lua 4.0.1. Log module=base.
-- Saved state: TRF.base[i] = {s=idx, k=1 P / 2 A / 3 D, h=HP tenths 0..9, t=leg, w, a} (<= 4 records) and
-- TRF.sys[idx].bh (legs in a row at dis >= found_dis). w on a D record: 1 = destroyed off-screen, object still
-- alive (blown on entry); 0 on P and A records. a = 1 on an A record: its radio line was given (trf_ui
-- TRF_BaseRadioLine, first entry after activation, 9.3); absent otherwise.
-- Visit state TRF.live.bs = {s, atk, w, w2, gp, ld, hb}; garrison records in TRF.live.pg (k "g", sv flag).
-- Handles only in the trf_state handle table: H.bs = {b station, nav, wr wreck, fl[j], kd[j], sv[j], svd[j]}.
-- Trigger callbacks are string actions "TRF_OnBaseDied(idx,g)--" whose shims run through TRF_Cb and exit
-- when g is not TRF.gen. Other modules are reached by name with a type check (TRF_N, TRF_P), so a missing
-- module only disables its part. Top level only defines functions.
-- CHECK [PB] E1-E4, E6, E7, E11: runtime station kept in the snapshot with label and damage, died/HP/attack
-- triggers on a Station, dock on a runtime station, Blow() leaves a wreck. Fallbacks: recreate from the
-- record, cfg wreck 1.

-- Defaults ------------------------------------------------------------------------------------------

-- Config keys (10.5). base_at: debug, system name whose founding is forced (10.2 `BASE_AT`, TRF_Ba_Found).
function TRF_Base_OptDef()
	return {bases=1, base_glow=0, wreck=0, base_at=""};
end;

-- Tune keys (10.5, bases row). base_patrols / base_turrets by tier (9.3 table).
function TRF_Base_TuneDef()
	return {base_life=60, found_dis=6, found_hold=2, found_chance=25, found_delay=2, found_keep=4, max_bases=2,
		base_cooldown=20, base_hp=100000, base_wave=2, cap_base=16, base_dis_floor=5, base_nb_floor=2,
		base_raid_cap=1, base_reward_k=2500, base_reward_max=30000, wreck_legs=10};
end;

-- Text table of this module (TRF_Loc_TextFns, TRF_UI_TextFns). The base rumours rgather and rbase are
-- trf_hail's keys (TRF_HlRumour, shared namespace, first definition wins); none of their own here.
function TRF_Base_Text()
	return {};
end;

-- Constants without a tune key: patrol radius and spawn ring, sentry ring, wave ring, records kept, ships per
-- flight scanned, mothership distance for a garrison respawn after load, raid spawn offsets, flight slots.
function TRF_Ba_K()
	return {rec_max=4, pat_r=300, spawn_r=200, sen_lo=50, sen_hi=70, wave_lo=50, wave_hi=150, ships_max=8,
		load_ms=600, raid_lo=60, raid_hi=120, fl_max=12};
end;

-- Station model, nav icon, wreck carcass.
function TRF_Ba_Names()
	return {model="Pirate_station2_Lit", icon="nav_Pirate_station2.dds", wreck="p_station2_destroyed"};
end;

-- Patrol flights and sentries by tier (9.3 table).
function TRF_Ba_Comp()
	return {{p=1, s=2}, {p=2, s=3}, {p=2, s=3}, {p=2, s=4}};
end;

-- Logging, config ------------------------------------------------------------------------------------

-- logfmt event line, module=base (design/log-format.md).
function TRF_BaE(event, ...)
	tinsert(arg, 1, event); tinsert(arg, 1, "base"); call(TRF_Lf, arg);
end;

-- Debug event line (log 2).
function TRF_BaDE(event, ...)
	local v = TRF_Ba_Opt("log", 1);
	if type(v) ~= "number" or v < 2 then return; end;
	tinsert(arg, 1, event); call(TRF_BaE, arg);
end;

function TRF_Ba_Opt(key, def)
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil then v = TRF_Cfg()[key]; end;
	if v == nil then v = TRF_Base_OptDef()[key]; end;
	if v == nil then return def; end;
	return v;
end;

-- TRF_Tune() value, else this module's default, else def.
function TRF_Ba_T(key, def)
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" and type(t[key]) == "number" then return t[key]; end;
	end;
	local d = TRF_Base_TuneDef()[key];
	if type(d) == "number" then return d; end;
	return def;
end;

-- Range tune key: {lo, hi} table, or a number used as lo.
function TRF_Ba_Range(key, lo, hi)
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" then
			local v = t[key];
			if type(v) == "table" and type(v[1]) == "number" and type(v[2]) == "number" then return v[1], v[2]; end;
			if type(v) == "number" then return v, max(v, hi); end;
		end;
	end;
	return lo, hi;
end;

-- Feature on: cfg bases not 0 and not restore-and-stop (enabled 2).
function TRF_Ba_On()
	if TRF_Cfg().enabled == 2 then return nil; end;
	if TRF_Ba_Opt("bases", 1) == 0 then return nil; end;
	return 1;
end;

function TRF_Ba_Stat(k)
	if type(TRF_Stat) == "function" then TRF_Stat(k); end;
end;

function TRF_Ba_Legs()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then return TRF.clock.legs; end;
	return 0;
end;

function TRF_Ba_Gt()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.gt) == "number" then return TRF.clock.gt; end;
	return 0;
end;

function TRF_Ba_Rand(n)
	if type(TRF_Rand) == "function" then return TRF_Rand(n); end;
	if type(RAND) ~= "function" or type(n) ~= "number" or n < 1 then return 0; end;
	local r = RAND(n);
	if type(r) ~= "number" then return 0; end;
	return r;
end;

function TRF_Ba_P(f, args)
	if type(f) ~= "function" then return nil; end;
	return call(f, args, "x", TRF_PErr);
end;

-- Engine objects --------------------------------------------------------------------------------------

-- 1 for an engine object (userdata in the game, table in the host harness).
function TRF_Ba_Obj(o)
	if o == nil or type(o) == "number" or type(o) == "string" or type(o) == "function" then return nil; end;
	return 1;
end;

function TRF_Ba_Alive(o)
	if not TRF_Ba_Obj(o) then return nil; end;
	return TRF_Is(o:IsAlive());
end;

function TRF_Ba_Del(o)
	if TRF_Ba_Obj(o) then TRF_Ba_P(function(x) x:Delete(); end, {o}); end;
end;

function TRF_Ba_Dist(a, b)
	if (type(a) ~= "table" and type(a) ~= "userdata") or (type(b) ~= "table" and type(b) ~= "userdata") then return nil; end;
	if type(a.x) ~= "number" or type(b.x) ~= "number" then return nil; end;
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z;
	return sqrt(dx * dx + dy * dy + dz * dz);
end;

-- Point at distance d on bearing a (degrees) in the plane of p.
function TRF_Ba_Ring(p, d, a)
	return Vector3(p.x + d * cos(a), p.y, p.z + d * sin(a));
end;

function TRF_Ba_Ms()
	local m = TRF_Ms();
	if TRF_Ba_Alive(m) then return m; end;
	return nil;
end;

function TRF_Ba_Trig(kind, cb, a, b)
	if type(NewTrigger) ~= "function" then return nil; end;
	return NewTrigger(kind, nil, cb, a, b);
end;

-- Ships of a flight in pilot order (at most ships_max).
function TRF_Ba_Ships(fl)
	local sh = {};
	if not TRF_Ba_Alive(fl) then return sh; end;
	local n = fl:GetPilotCount();
	if type(n) ~= "number" then return sh; end;
	for i = 1, min(n, TRF_Ba_K().ships_max) do
		local p = fl:GetPilotByNumber(i);
		if TRF_Ba_Obj(p) then
			local s = p:GetShip();
			if TRF_Ba_Alive(s) then tinsert(sh, s); end;
		end;
	end;
	return sh;
end;

-- No builder globals stay for the save (flight_/ship_/pilot_ of NewAllFlight and NewFlight).
function TRF_Ba_ClearSign(sign)
	setglobal("flight_"..sign, nil);
	setglobal("ship_"..sign, nil);
	setglobal("pilot_"..sign, nil);
	for i = 1, TRF_Ba_K().ships_max do
		setglobal("ship_"..sign.."_"..i, nil);
		setglobal("pilot_"..sign.."_"..i, nil);
	end;
end;

-- Map, records -----------------------------------------------------------------------------------------

function TRF_Ba_Map()
	local m = TRF_N("TRF_Map");
	if type(m) ~= "table" or type(m.sys) ~= "table" or type(m.by) ~= "table" then return nil; end;
	return m;
end;

function TRF_Ba_Sys(idx)
	local m = TRF_Ba_Map();
	if not m or type(idx) ~= "number" or type(m.sys[idx]) ~= "table" then return nil; end;
	return m.sys[idx];
end;

function TRF_Ba_Cur()
	local i = TRF_N("TRF_CurIdx");
	if type(i) == "number" then return i; end;
	return nil;
end;

function TRF_Ba_Name(idx)
	local s = TRF_Ba_Sys(idx);
	if s and type(s.name) == "string" then return s.name; end;
	return "?";
end;

-- Site Vector3 of an allow-list system (map ba = 1 and bs = {x, y, z}, 9.1), else nil.
function TRF_Ba_Site(idx)
	local s = TRF_Ba_Sys(idx);
	if not s or s.ba ~= 1 or type(s.bs) ~= "table" then return nil; end;
	local b = s.bs;
	local x, y, z = b.x or b[1], b.y or b[2], b.z or b[3];
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then return nil; end;
	return Vector3(x, y, z);
end;

-- Allow-list systems with a site, sorted by idx.
function TRF_Ba_Allow()
	local m = TRF_Ba_Map();
	local l = {};
	if not m then return l; end;
	for i = 1, getn(m.sys) do
		if type(m.sys[i]) == "table" and m.sys[i].ba == 1 and TRF_Ba_Site(i) then tinsert(l, i); end;
	end;
	return l;
end;

-- "Portal" neighbours of idx in both directions (the region adjacency rule of v02 4.1), sorted by idx.
function TRF_Ba_Nb(idx)
	local m = TRF_Ba_Map();
	local out = {};
	if not m or type(idx) ~= "number" or not m.sys[idx] then return out; end;
	local np = {};
	if type(TRF_Rg_NonPortal) == "function" then np = TRF_Rg_NonPortal(); end;
	local set = {};
	for i = 1, getn(m.sys) do
		local s = m.sys[i];
		local ps = s.portals;
		if type(ps) ~= "table" then ps = {}; end;
		for j = 1, getn(ps) do
			local p = ps[j];
			local ok = type(p) == "table" and type(p.to) == "string";
			if ok and p.t ~= nil and p.t ~= "Portal" then ok = nil; end;
			if ok and p.t == nil and np[s.name] == p.name then ok = nil; end;
			if ok then
				local k = m.by[strlower(p.to)];
				if i == idx and k and k ~= idx then set[k] = 1; end;
				if k == idx and i ~= idx then set[i] = 1; end;
			end;
		end;
	end;
	for k, v in set do tinsert(out, k); end;
	sort(out);
	return out;
end;

-- Deny entry de of system idx under the transit rule (trf_safety TRF_SysModeOf, TRF_StrictOkOf): "deny"
-- for an authored m = 1 entry (elio, x297, gefest, cfg sys_deny), "deny_tq" for a campaign teleport target
-- (tq = 1) the strict gate for feature f denies (a quest naming the system in process, cfg transit 0 during
-- a mission), else nil (also for an entry without m = 1).
function TRF_Ba_DenyM(idx, de, f)
	if type(de) ~= "table" or de.m ~= 1 then return nil; end;
	if de.tq ~= 1 then return "deny"; end;
	if type(TRF_StrictOk) ~= "function" or not TRF_StrictOk(idx, f) then return "deny_tq"; end;
	return nil;
end;

-- 1 when idx has a deny entry that keeps bases out: a feature entry without m = 1 (Fronn), an authored
-- m = 1 entry, or a teleport target the transit rule closes for feature base (TRF_Ba_DenyM).
function TRF_Ba_Denied(idx, nm)
	if type(TRF_DenyEntry) ~= "function" then return nil; end;
	local de = TRF_DenyEntry(nm);
	if type(de) ~= "table" then return nil; end;
	if de.m ~= 1 or TRF_Ba_DenyM(idx, de, "base") then return 1; end;
	return nil;
end;

-- 1 when a neighbour effect skips idx: guard system while the guard is active (R16), or a deny entry
-- (TRF_Ba_Denied).
function TRF_Ba_Skip(idx)
	local s = TRF_Ba_Sys(idx);
	if not s then return 1; end;
	if s.start == 1 then
		local g = 1;
		if type(TRF_RgGuardOn) == "function" then g = TRF_Ba_P(TRF_RgGuardOn, {}); end;
		if g then return 1; end;
	end;
	if TRF_Ba_Denied(idx, s.name) then return 1; end;
	return nil;
end;

-- The record list, entries of the wrong shape dropped (TRF_Repair does the same, 3.3).
function TRF_Ba_Recs()
	if type(TRF) ~= "table" then return {}; end;
	local o = TRF.base;
	if type(o) ~= "table" then TRF.base = {}; return TRF.base; end;
	local bad = nil;
	for i = 1, getn(o) do
		local r = o[i];
		if type(r) ~= "table" or type(r.s) ~= "number" or type(r.k) ~= "number" or r.k < 1 or r.k > 3 then bad = 1; end;
	end;
	if not bad and getn(o) <= TRF_Ba_K().rec_max then return o; end;
	local l = {};
	for i = 1, getn(o) do
		local r = o[i];
		if type(r) == "table" and type(r.s) == "number" and type(r.k) == "number" and r.k >= 1 and r.k <= 3 then tinsert(l, r); end;
	end;
	TRF.base = l;
	return l;
end;

-- Record of system idx (any kind), or nil. Founding keeps one record per system.
function TRF_BaseOf(idx)
	if type(idx) ~= "number" then return nil; end;
	local l = TRF_Ba_Recs();
	for i = 1, getn(l) do
		if l[i].s == idx then return l[i]; end;
	end;
	return nil;
end;

-- 1 when idx has an active (A) base.
function TRF_BaseActive(idx)
	local r = TRF_BaseOf(idx);
	if r and r.k == 2 then return 1; end;
	return nil;
end;

-- idx of an A base in idx or a "Portal" neighbour of it, else nil (pro_cap, raids, danger).
function TRF_BaseNear(idx)
	if type(idx) ~= "number" then return nil; end;
	if TRF_BaseActive(idx) then return idx; end;
	local l = TRF_Ba_Recs();
	local any = nil;
	for i = 1, getn(l) do if l[i].k == 2 then any = 1; end; end;
	if not any then return nil; end;
	local nb = TRF_Ba_Nb(idx);
	for i = 1, getn(nb) do
		if TRF_BaseActive(nb[i]) then return nb[i]; end;
	end;
	return nil;
end;

-- Live (P + A) records.
function TRF_Ba_NLive()
	local l = TRF_Ba_Recs();
	local n = 0;
	for i = 1, getn(l) do if l[i].k == 1 or l[i].k == 2 then n = n + 1; end; end;
	return n;
end;

function TRF_Ba_Drop(r, why, dis, keep)
	local l = TRF_Ba_Recs();
	local k = {};
	for i = 1, getn(l) do if l[i] ~= r then tinsert(k, l[i]); end; end;
	TRF.base = k;
	TRF_BaE("drop", "system", TRF_Ba_Name(r.s), "system_index", r.s, "stage", r.k, "reason", tostring(why), "disruption", dis,
		"disruption_keep", keep);
end;

-- Region slot and phase of idx.
function TRF_Ba_Slot(idx)
	local s = TRF_N("TRF_RgOf", idx);
	if type(s) == "number" then return s; end;
	return nil;
end;

function TRF_Ba_Phase(slot)
	local p = TRF_N("TRF_Phase", slot);
	if type(p) == "number" then return p; end;
	return 0;
end;

function TRF_Ba_Tier(idx)
	local t = TRF_N("TRF_EffTier", idx);
	if type(t) ~= "number" then t = 1; end;
	return TRF_Clamp(floor(t), 1, 4);
end;

-- Garrison power (9.3 table): trf_raid's TRF_Rd_Power (sb + offset in the tier band; without sb the level
-- of the system's first registered contact), else sb 5.
function TRF_Ba_Power(tier, idx)
	local p = TRF_N("TRF_Rd_Power", tier, idx, 1);
	if type(p) == "number" then return p; end;
	local b = {{-3, 1, 6}, {0, 4, 11}, {2, 8, 15}, {3, 11, 18}};
	local e = b[tier];
	return TRF_Clamp(5 + e[1], e[2], e[3]);
end;

function TRF_Ba_Dis(idx)
	if type(TRF_Dis) ~= "function" then return 0; end;
	local d = TRF_Dis(idx);
	if type(d) ~= "number" then return 0; end;
	return d;
end;

function TRF_Ba_AddDis(idx, d, why)
	if d ~= 0 and type(TRF_AddDis) == "function" then TRF_AddDis(idx, d, why); end;
end;

-- Founding, activation, caps (9.2) ---------------------------------------------------------------------

-- Called by TRF_AddLeg after decay and region catch-up, once per leg.
function TRF_Base_Leg(L)
	call(TRF_Ba_LegBody, {L}, "x", TRF_PErr);
end;

function TRF_Ba_LegBody(L)
	if not TRF_Ba_On() or type(TRF) ~= "table" then return; end;
	if type(L) ~= "number" then L = TRF_Ba_Legs(); end;
	local al = TRF_Ba_Allow();
	if getn(al) == 0 then return; end;
	local cur = TRF_Ba_Cur();
	TRF_Ba_Hold(al);
	TRF_Ba_Life(L, cur);
	TRF_Ba_Found(L, cur, al);
end;

-- bh = dis >= found_dis and min(bh + 1, 3) or 0, allow-list systems only (absent = 0).
function TRF_Ba_Hold(al)
	local fd = TRF_Ba_T("found_dis", 6);
	if type(TRF.sys) ~= "table" then return; end;
	for i = 1, getn(al) do
		local idx = al[i];
		local e = TRF.sys[idx];
		if TRF_Ba_Dis(idx) >= fd and type(e) == "table" then
			e.bh = min((e.bh or 0) + 1, 3);
		elseif type(e) == "table" then
			e.bh = nil;
		end;
	end;
end;

-- D drop at cooldown end, A abandonment after base_life, P activation or drop; > 4 records: oldest D.
function TRF_Ba_Life(L, cur)
	local l = TRF_Ba_Recs();
	local cd, life = TRF_Ba_T("base_cooldown", 20), TRF_Ba_T("base_life", 60);
	local dl, keep = TRF_Ba_T("found_delay", 2), TRF_Ba_T("found_keep", 4);
	local rs = {};
	for i = 1, getn(l) do tinsert(rs, l[i]); end;
	for i = 1, getn(rs) do
		local r = rs[i];
		local t = r.t or L;
		if r.k == 3 then
			if L >= t + cd then TRF_Ba_Drop(r, "cooldown"); end;
		elseif r.k == 2 then
			local slot = TRF_Ba_Slot(r.s);
			local ph = TRF_Ba_Phase(slot);
			if L >= t + life and (ph == 4 or ph == 5) and cur ~= r.s then TRF_BaseDestroyed(r.s, "abandon"); end;
		elseif r.k == 1 and L >= t + dl then
			if cur ~= r.s then
				if TRF_Ba_Dis(r.s) >= keep then
					r.k = 2; r.t = L; r.w = 0; r.h = 9;
					TRF_Ba_Stat("base_act");
					TRF_BaE("active", "system", TRF_Ba_Name(r.s), "system_index", r.s, "leg", L, "disruption", TRF_Ba_Dis(r.s));
					local slot = TRF_Ba_Slot(r.s);
					if slot then TRF_P("TRF_NewsPost", "war", "base", slot); end;
				else
					TRF_Ba_Drop(r, "low_disruption", TRF_Ba_Dis(r.s), keep);
				end;
			elseif L >= t + dl + 6 then
				TRF_Ba_Drop(r, "player_stayed");
			end;
		end;
	end;
	l = TRF_Ba_Recs();
	while getn(l) > TRF_Ba_K().rec_max do
		local old = nil;
		for i = 1, getn(l) do
			if l[i].k == 3 and (not old or (l[i].t or 0) < (old.t or 0)) then old = l[i]; end;
		end;
		if not old then break; end;
		TRF_Ba_Drop(old, "records");
		l = TRF_Ba_Recs();
	end;
end;

-- Founding (9.2): no record, no cooldown, no open sweep of the clan, P + A < max_bases, no "Portal" neighbour
-- with a P or A record, bh >= found_hold + 1, not in front of the player, roll found_chance (halved with a
-- patrol station). cfg base_at (debug, env BASE_AT): only that allow-list system is considered, and it skips
-- the bh, open sweep, neighbour and roll tests; record, caps, deny entries and the player rule still apply.
function TRF_Ba_Found(L, cur, al)
	local mx = TRF_Ba_T("max_bases", 2);
	local need = TRF_Ba_T("found_hold", 2) + 1;
	local ch = TRF_Ba_T("found_chance", 25);
	local force = TRF_Ba_Opt("base_at", "");
	if type(force) ~= "string" or force == "" then force = nil; else force = strlower(force); end;
	for i = 1, getn(al) do
		if TRF_Ba_NLive() >= mx or getn(TRF_Ba_Recs()) >= TRF_Ba_K().rec_max then return; end;
		local idx = al[i];
		local e = TRF.sys[idx];
		local bh = 0;
		if type(e) == "table" and type(e.bh) == "number" then bh = e.bh; end;
		local slot = TRF_Ba_Slot(idx);
		local fc = force and strlower(TRF_Ba_Name(idx)) == force;
		local ok = (bh >= need or fc) and idx ~= cur and slot and not TRF_BaseOf(idx);
		if ok and force and not fc then ok = nil; end;
		if ok and not fc and TRF_N("TRF_SweepOpen", slot) then ok = nil; end;
		if ok and TRF_Ba_Denied(idx, TRF_Ba_Name(idx)) then ok = nil; end;
		if ok and not fc then
			local nb = TRF_Ba_Nb(idx);
			for j = 1, getn(nb) do
				local o = TRF_BaseOf(nb[j]);
				if o and o.k ~= 3 then ok = nil; end;
			end;
		end;
		if ok then
			local p = ch;
			local s = TRF_Ba_Sys(idx);
			if type(s.st) == "table" then
				for j = 1, getn(s.st) do
					if type(s.st[j]) == "table" and s.st[j].kind == "patrol" then p = floor(ch / 2); end;
				end;
			end;
			local roll = TRF_Ba_Rand(100);
			if fc then p = 100; end;
			if roll < p then
				tinsert(TRF.base, {s=idx, k=1, h=9, t=L, w=0});
				TRF_Ba_Stat("base_found");
				TRF_BaE("found", "system", TRF_Ba_Name(idx), "system_index", idx, "slot", slot, "leg", L, "chance", p, "roll", roll,
					"forced", TRF_KvB(fc), "result", "founded");
			else
				TRF_BaDE("found", "system", TRF_Ba_Name(idx), "system_index", idx, "chance", p, "roll", roll, "result", "missed");
			end;
		end;
	end;
end;

-- Floors (9.4), called by TRF_Decay after the decay step: dis(base) >= 5, each neighbour >= 2 (guard and deny
-- systems skipped). cfg dis 0 freezes dis (TRF_AddDis).
function TRF_Base_Floors()
	call(TRF_Ba_FloorBody, {}, "x", TRF_PErr);
end;

function TRF_Ba_FloorBody()
	if not TRF_Ba_On() or type(TRF) ~= "table" or type(TRF.base) ~= "table" then return; end;
	local fb, fn = TRF_Ba_T("base_dis_floor", 5), TRF_Ba_T("base_nb_floor", 2);
	local l = TRF_Ba_Recs();
	for i = 1, getn(l) do
		local r = l[i];
		if r.k == 2 then
			local d = TRF_Ba_Dis(r.s);
			if d < fb then TRF_Ba_AddDis(r.s, fb - d, "base floor"); end;
			local nb = TRF_Ba_Nb(r.s);
			for j = 1, getn(nb) do
				if not TRF_Ba_Skip(nb[j]) then
					d = TRF_Ba_Dis(nb[j]);
					if d < fn then TRF_Ba_AddDis(nb[j], fn - d, "base nb floor"); end;
				end;
			end;
		end;
	end;
end;

-- Destruction (9.6) -------------------------------------------------------------------------------------

-- dis(base) := 0, each portal neighbour dis - 2 (outside the per-visit limit).
function TRF_Ba_DisFx(idx)
	TRF_Ba_AddDis(idx, -TRF_Ba_Dis(idx), "base gone");
	local nb = TRF_Ba_Nb(idx);
	for j = 1, getn(nb) do
		local d = TRF_Ba_Dis(nb[j]);
		if d > 0 then TRF_Ba_AddDis(nb[j], -min(2, d), "base gone nb"); end;
	end;
end;

function TRF_Ba_Bit(v, b)
	if type(v) ~= "number" then return 0; end;
	return mod(floor(v / b), 2);
end;

-- Pay through trf_region's TRF_Pay, else capped AddPlayerCredits.
function TRF_Ba_Pay(n, why)
	n = floor(min(n, TRF_Ba_T("pay_cap", 30000)));
	if n <= 0 then return 0; end;
	if type(TRF_Pay) == "function" then TRF_Pay(n, why); return n; end;
	TRF_N("AddPlayerCredits", n);
	TRF_Ba_Stat("pay_"..why);
	TRF_BaE("pay", "reason", why, "amount", n);
	return n;
end;

-- Player row of 9.6: help +2, heat -1; FTU payment, or the faction bounty (ct bit 2) at 1.5 x with fs +1 and
-- fst +1 (7.4). tk: tier_k of the tier before the loss.
function TRF_Ba_PlayerFx(idx, slot, tk)
	TRF_N("TRF_AddHelp", 2, "base");
	TRF_N("TRF_AddHeat", -1, "base");
	local lp = TRF_N("TRF_LPayK", idx);
	if type(lp) ~= "number" then lp = 8; end;
	local n = min(TRF_Ba_T("base_reward_k", 2500) * lp * tk, TRF_Ba_T("base_reward_max", 30000));
	local rg = nil;
	if slot then rg = TRF_N("TRF_RgRec", slot); end;
	local f = 0;
	if slot then f = TRF_N("TRF_SweepOwner", slot) or 0; end;
	if type(rg) == "table" and TRF_Ba_Bit(rg.ct, 2) == 1 and type(f) == "number" and f >= 1 and f <= 5 then
		TRF_Ba_Pay(1.5 * n, "bounty");
		TRF_N("TRF_FsAdd", slot, f, 1, "bounty");
		TRF_N("TRF_FstAdd", f, 1, "bounty");
	else
		TRF_Ba_Pay(n, "base");
	end;
end;

-- The A base of idx is gone. by: "player" (attack event on it in the visit it died), "sweep" (won attempt),
-- "blow" (scripted), "dead" (found dead on entry), "abandon" (base_life, 9.2: no score change, sv kept).
-- Returns 1 when a record changed.
function TRF_BaseDestroyed(idx, by)
	local r = TRF_BaseOf(idx);
	if not r or r.k ~= 2 then return nil; end;
	local slot = TRF_Ba_Slot(idx);
	local tks = {0.75, 1.0, 1.5, 2.0};
	local tk = tks[TRF_Ba_Tier(idx)];
	local cur = TRF_Ba_Cur();
	r.k = 3;
	r.t = TRF_Ba_Legs();
	r.h = 0;
	r.w = 0;
	if (by == "sweep" or by == "abandon") and cur ~= idx then r.w = 1; end;
	TRF_Ba_DisFx(idx);
	if by == "player" then TRF_Ba_P(TRF_Ba_PlayerFx, {idx, slot, tk}); end;
	if by == "player" then TRF_N("TRF_Ch_Note", 6, idx, 0); end;
	if slot and by ~= "abandon" then
		local c = TRF_N("TRF_ClanRec", slot);
		if type(c) == "table" then
			if type(c.sc) == "number" then
				local old = c.sc;
				c.sc = TRF_Clamp(floor(old - 25), 0, 99);
				TRF_BaE("clan_score", "slot", slot, "reason", "base_gone", "clan_score_before", old, "clan_score_after", c.sc);
			end;
			c.sv = 0;
			c.sf = 0;
		end;
		local rg = TRF_N("TRF_RgRec", slot);
		if type(rg) == "table" and rg.ph == 3 then rg.sw = 1; end;
	end;
	if slot then
		local rg = TRF_N("TRF_RgRec", slot);
		if type(rg) == "table" and TRF_Ba_Bit(rg.ct, 2) == 1 then rg.ct = rg.ct - 2; end;
		TRF_P("TRF_NewsPost", "war", "basex", slot);
	end;
	if cur == idx then TRF_Ba_P(TRF_Ba_RaidsOff, {}); end;
	TRF_Ba_Stat("base_kill");
	TRF_BaE("destroyed", "system", TRF_Ba_Name(idx), "system_index", idx, "slot", slot, "by", tostring(by),
		"off_screen", TRF_KvB(r.w));
	return 1;
end;

-- Live base raids (trf_raid marks them rd.bs = 1) break off to a portal (9.6).
function TRF_Ba_RaidsOff()
	if type(TRF.live) ~= "table" or type(TRF.live.rd) ~= "table" or type(TRF_RaidLeave) ~= "function" then return; end;
	local ns = {};
	for n, rd in TRF.live.rd do
		if type(rd) == "table" and rd.bs == 1 and rd.st ~= "end" then tinsert(ns, n); end;
	end;
	for i = 1, getn(ns) do TRF_P("TRF_RaidLeave", ns[i], "base"); end;
end;

-- Scene: object, triggers, dock, nav point (9.3, 9.7) -----------------------------------------------------

function TRF_Ba_Label(idx) return "TRF_PBASE_"..idx; end;

function TRF_Ba_Live()
	if type(TRF) ~= "table" or type(TRF.live) ~= "table" then return nil; end;
	if type(TRF_LiveOk) == "function" and not TRF_LiveOk() then return nil; end;
	return TRF.live;
end;

-- Visit record of the base in this system (created on demand).
function TRF_Ba_Bs(idx)
	local L = TRF_Ba_Live();
	if not L then return nil; end;
	if type(L.bs) ~= "table" or L.bs.s ~= idx then L.bs = {s=idx, w=0, w2=0}; end;
	return L.bs;
end;

function TRF_Ba_H()
	if type(TRF_H) ~= "function" then return nil; end;
	local H = TRF_H();
	if type(H) ~= "table" then return nil; end;
	if type(H.bs) ~= "table" then H.bs = {fl={}, kd={}, sv={}, svd={}}; end;
	return H.bs;
end;

-- Station of idx: object, "alive" | "dead" | nil (missing). CHECK: GetObjectByLabel of a dead station
-- returns the object with IsAlive nil ([PB] E2).
function TRF_Ba_Find(idx)
	local o = TRF_N("GetObjectByLabel", TRF_Ba_Label(idx));
	if not TRF_Ba_Obj(o) then return nil, nil; end;
	if TRF_Ba_Alive(o) then return o, "alive"; end;
	return o, "dead";
end;

-- HP tenths 0..9 of the station (GetCurHP, base_hp), or nil.
function TRF_Ba_Band(b)
	local hp = TRF_N("GetCurHP", b);
	if type(hp) ~= "number" then return nil; end;
	local full = TRF_Ba_T("base_hp", 100000);
	return TRF_Clamp(floor(hp * 10 / full), 0, 9);
end;

-- Creates the station at the site (9.3); SetHP from the saved band. Returns the station or nil.
function TRF_Ba_Create(idx, r)
	local p = TRF_Ba_Site(idx);
	if not p or type(CreateStation) ~= "function" then return nil; end;
	local nm = TRF_Ba_Names();
	local b = TRF_Ba_P(CreateStation, {nm.model, p, Vector3(0, 0, 1)});
	if not TRF_Ba_Obj(b) then
		TRF_Ba_Stat("base_create_fail");
		TRF_BaE("create", "system", TRF_Ba_Name(idx), "result", "failed");
		return nil;
	end;
	TRF_N("SetObjectLabel", b, TRF_Ba_Label(idx));
	local h = r.h;
	if type(h) ~= "number" then h = 9; end;
	if h < 9 then
		-- CHECK: SetHP on a Station right after CreateStation ([PB] E1); h 0 keeps a sliver.
		local full = TRF_Ba_T("base_hp", 100000);
		TRF_Ba_P(function(o, v) o:SetHP(v); end, {b, max(h * full / 10, full / 20)});
	end;
	TRF_BaE("create", "system", TRF_Ba_Name(idx), "hull_band", h, "result", "created");
	return b;
end;

-- died, attack (PLAYER_GROUP) and HP (next band) triggers with the current generation.
function TRF_Ba_Arm(idx, b, bs)
	local g = TRF.gen;
	TRF_Ba_Trig("died", "TRF_OnBaseDied("..idx..","..g..")--", b);
	if not bs.atk then TRF_Ba_Trig("attack", "TRF_OnBaseHit("..idx..","..g..")--", PLAYER_GROUP, b); end;
	TRF_Ba_ArmHP(idx, b, bs);
end;

-- HP trigger below the current band (fires at 90 %, 80 %, ... of base_hp).
function TRF_Ba_ArmHP(idx, b, bs)
	local h = TRF_Ba_Band(b);
	if not h then h = 9; end;
	if h < 1 or bs.hb == h then return; end;
	bs.hb = h;
	local full = TRF_Ba_T("base_hp", 100000);
	TRF_Ba_Trig("HP", "TRF_OnBaseHP("..idx..","..h..","..TRF.gen..")--", b, h * full / 10);
end;

-- 1 when __system_Dock_array has a row for station b (vanilla compares .id).
function TRF_Ba_DockRow(b)
	if type(__system_Dock_array) ~= "table" then return nil; end;
	local hit = nil;
	for i, v in __system_Dock_array do
		if type(v) == "table" and v[5] ~= nil then
			if v[5] == b then hit = 1; end;
			local same = TRF_Ba_P(function(x, y) if x.id ~= nil and x.id == y.id then return 1; end; return nil; end, {v[5], b});
			if same then hit = 1; end;
		end;
	end;
	return hit;
end;

-- Pirate dock on the runtime station (M18: shop untouched, no DefStation). CHECK [PB] E3/E4.
function TRF_Ba_Dock(idx, b)
	if type(CreatePirateStationDocking) ~= "function" or TRF_Ba_DockRow(b) then return; end;
	local ms = TRF_Ba_Ms();
	if not ms then return; end;
	local shop = "";
	if type(ShopList_Kontraband) == "table" and type(ShopList_Kontraband[mod(idx, 7) + 1]) == "string" then
		shop = ShopList_Kontraband[mod(idx, 7) + 1];
	end;
	TRF_Ba_P(CreatePirateStationDocking, {b, ms, 60, shop, TRUE});
	TRF_BaDE("dock", "system", TRF_Ba_Name(idx), "shop", shop);
end;

-- Nav point on the station, label TRF_PBASE_NP_<idx> (reused when found).
function TRF_Ba_Nav(idx, b)
	local hb = TRF_Ba_H();
	if not hb then return; end;
	local lb = "TRF_PBASE_NP_"..idx;
	local nav = TRF_N("GetNavPointByLabel", lb);
	if not TRF_Ba_Obj(nav) and type(CreateNavPoint) == "function" then
		local col = TRF_N("RGB", 255, 80, 80);
		nav = TRF_Ba_P(CreateNavPoint, {"", b:GetPosition(), TRF_Ba_Names().icon, col, b});
		if TRF_Ba_Obj(nav) then TRF_N("SetNavPointLabel", nav, lb); end;
	end;
	if TRF_Ba_Obj(nav) then hb.nav = nav; end;
end;

function TRF_Ba_NavDel(idx)
	local hb = TRF_Ba_H();
	local nav = TRF_N("GetNavPointByLabel", "TRF_PBASE_NP_"..idx);
	if TRF_Ba_Obj(nav) then TRF_Ba_Del(nav); end;
	if hb and TRF_Ba_Obj(hb.nav) and hb.nav ~= nav then TRF_Ba_Del(hb.nav); end;
	if hb then hb.nav = nil; end;
end;

-- Garrison (9.3) -----------------------------------------------------------------------------------------

function TRF_Ba_GName(idx) return "TRF_PBase_"..idx; end;

-- Group TRF_PBase_<idx> on the Pirates team, seeded from GetTeamRelation("Pirates", PLAYER_TEAM); kept in H
-- for the visit. CHECK: CreateGroup with a name already used before a load.
function TRF_Ba_Group(idx, bs)
	local hb = TRF_Ba_H();
	if not hb then return nil; end;
	if TRF_Ba_Obj(hb.grp) then return hb.grp; end;
	local tm = TRF_N("CreateTeam", "Pirates");
	if not TRF_Ba_Obj(tm) then return nil; end;
	local grp = TRF_Ba_P(function(t, n) return t:CreateGroup(n); end, {tm, TRF_Ba_GName(idx)});
	if not TRF_Ba_Obj(grp) then return nil; end;
	hb.grp = grp;
	local rel = TRF_N("GetTeamRelation", "Pirates", PLAYER_TEAM);
	if bs.atk and RELATION_WAR ~= nil then rel = RELATION_WAR; end;
	if rel ~= nil and type(SetGroupRelation) == "function" then
		TRF_Ba_P(SetGroupRelation, {TRF_Ba_GName(idx), PLAYER_GROUP, rel});
	end;
	return grp;
end;

-- Live garrison ships (all base flights of the visit).
function TRF_Ba_NShips()
	local hb = TRF_Ba_H();
	if not hb then return 0; end;
	local n = 0;
	for j, fl in hb.fl do n = n + getn(TRF_Ba_Ships(fl)); end;
	return n;
end;

-- Registers flight j of kind kd ("g" patrol, "s" sentry, "w" wave): ships over cap_base are deleted, ships
-- labelled trf_pb_<idx>_<j>_<s>. Returns the flight or nil.
function TRF_Ba_Reg(idx, j, fl, kd, sv)
	local hb = TRF_Ba_H();
	if not hb or not TRF_Ba_Alive(fl) then return nil; end;
	local sh = TRF_Ba_Ships(fl);
	local room = TRF_Ba_T("cap_base", 16) - TRF_Ba_NShips();
	if room <= 0 then
		TRF_Ba_Del(fl);
		TRF_BaDE("flight", "flight", j, "reason", "cap_base", "result", "deleted");
		return nil;
	end;
	for s = 1, getn(sh) do
		if s > room then TRF_Ba_Del(sh[s]); else TRF_N("SetObjectLabel", sh[s], "trf_pb_"..idx.."_"..j.."_"..s); end;
	end;
	hb.fl[j] = fl;
	hb.kd[j] = kd;
	if sv then hb.sv[j] = 1; end;
	if kd ~= "s" then TRF_Ba_Pg(idx, j, kd, sv); end;
	return fl;
end;

-- Garrison record in live.pg (<= 8, shared with the sweep's clan flights): {n=j, k="g", sv, st, i=idx}.
function TRF_Ba_Pg(idx, j, kd, sv)
	local L = TRF_Ba_Live();
	if not L then return; end;
	if type(L.pg) ~= "table" then L.pg = {}; end;
	if getn(L.pg) >= 8 then return; end;
	local v = 0;
	if sv then v = 1; end;
	tinsert(L.pg, {n=j, k="g", sv=v, st="live", i=idx});
end;

-- One clan flight at the clan's tier: TRF_SalvFlight when salvaged gear is wanted (sv >= 1), else
-- TRF_PirFlight with the garrison slot's trf_fits grade (design/fits-spec.md 5.6, decision D4: a normal flight with
-- the same roll). Returns flight, salvaged flag.
function TRF_Ba_ClanFlight(idx, tier, pw, j, pos, dir, salv)
	local gname = "TRF_GPBase_"..idx;
	local sign = "trf_pb_"..idx.."_"..j;
	local hb = TRF_Ba_H();
	if not hb or not TRF_Ba_Obj(hb.grp) then return nil; end;
	local slot = TRF_Ba_Slot(idx);
	-- Only protected calls between setglobal and its clear (v1 spec 13.4 O5).
	setglobal(gname, hb.grp);
	local fl, sv = nil, nil;
	if salv and slot and type(TRF_SalvFlight) == "function" then
		fl = TRF_Ba_P(TRF_SalvFlight, {slot, gname, sign, pos, dir, pw, tier});
		if TRF_Ba_Obj(fl) then sv = 1; end;
	end;
	if not TRF_Ba_Obj(fl) and type(TRF_PirFlight) == "function" then
		local gr = TRF_P("TRF_Ft_Grade", idx, j, "base", sign, tier);
		fl = TRF_Ba_P(TRF_PirFlight, {tier, pw, gname, sign, pos, dir, nil, nil, nil, gr});
	end;
	setglobal(gname, nil);
	TRF_Ba_ClearSign(sign);
	if not TRF_Ba_Obj(fl) then return nil; end;
	return fl, sv;
end;

-- Sentry: NewRobotFlight type 1 (include/Create_flight_2.script 1803; group by global name, FALSE on failure).
function TRF_Ba_Sentry(idx, pw, j, pos, dir)
	local hb = TRF_Ba_H();
	if not hb or not TRF_Ba_Obj(hb.grp) or type(NewRobotFlight) ~= "function" or type(Robot_Fighters) ~= "table" then return nil; end;
	local gname = "TRF_GPBase_"..idx;
	local sign = "trf_pb_"..idx.."_"..j;
	setglobal(gname, hb.grp);
	local fl = TRF_Ba_P(NewRobotFlight, {gname, sign, pos, 1, pw, dir});
	setglobal(gname, nil);
	TRF_Ba_ClearSign(sign);
	if not TRF_Ba_Obj(fl) then return nil; end;
	return fl;
end;

-- Patrol of 4 points within pat_r of the base, looped (Patrol(points, TRUE) as the location scripts).
function TRF_Ba_Patrol(fl, p, a0)
	local r = TRF_Ba_K().pat_r;
	local pts = {};
	for k = 0, 3 do tinsert(pts, TRF_Ba_Ring(p, r, a0 + 90 * k)); end;
	TRF_Ba_P(function(f, x) f:Patrol(x, TRUE); end, {fl, pts});
end;

-- Spawns the garrison (only: set of j to build, nil = all). Patrol flights j = 1..np, sentries np+1..np+ns.
-- Returns the number of flights built.
function TRF_Ba_Garrison(idx, b, bs, only)
	if not TRF_Ba_Group(idx, bs) then return 0; end;
	local tier = TRF_Ba_Tier(idx);
	local pw = TRF_Ba_Power(tier, idx);
	local c = TRF_Ba_Comp()[tier];
	local p = b:GetPosition();
	local K = TRF_Ba_K();
	local slot = TRF_Ba_Slot(idx);
	local sv = 0;
	local cl = nil;
	if slot then cl = TRF_N("TRF_ClanRec", slot); end;
	if type(cl) == "table" and type(cl.sv) == "number" then sv = cl.sv; end;
	local n = 0;
	local salvd = nil;
	for k = 1, c.p do
		if not only or only[k] then
			local a = 90 * k + TRF_Ba_Rand(30);
			local pos = TRF_Ba_Ring(p, K.spawn_r, a);
			local fl, s = TRF_Ba_ClanFlight(idx, tier, pw, k, pos, Vector3(0, 0, 1), sv >= 1 and not salvd);
			if s then salvd = 1; end;
			if TRF_Ba_Reg(idx, k, fl, "g", s) then
				TRF_Ba_Patrol(fl, p, a);
				n = n + 1;
			end;
		end;
	end;
	for k = 1, c.s do
		local j = c.p + k;
		if not only or only[j] then
			local a = 360 * k / c.s;
			local pos = TRF_Ba_Ring(p, K.sen_lo + TRF_Ba_Rand(K.sen_hi - K.sen_lo + 1), a);
			if TRF_Ba_Reg(idx, j, TRF_Ba_Sentry(idx, pw, j, pos, Vector3(cos(a), 0, sin(a))), "s") then n = n + 1; end;
		end;
	end;
	bs.gp = 1;
	TRF_BaE("garrison", "system", TRF_Ba_Name(idx), "tier", tier, "power", pw, "salvage", sv, "flight_count", n,
		"ship_count", TRF_Ba_NShips());
	return n;
end;

-- Defence wave (9.3): base_wave flights at the clan's tier 50-150 from the base, portal glow and cloak FX
-- per ship (DefStation.script 295-301 presentation); they attack the mothership when the player attacked.
function TRF_Ba_Wave(idx, which)
	local L = TRF_Ba_Live();
	local hb = TRF_Ba_H();
	local b = nil;
	if hb then b = hb.b; end;
	if not L or not TRF_Ba_Alive(b) then return 0; end;
	local bs = TRF_Ba_Bs(idx);
	if type(TRF_Supp) == "function" and TRF_Supp() ~= 0 then return 0; end;
	if not TRF_Ba_Group(idx, bs) then return 0; end;
	local tier = TRF_Ba_Tier(idx);
	local pw = TRF_Ba_Power(tier, idx);
	local p = b:GetPosition();
	local K = TRF_Ba_K();
	local ms = TRF_Ba_Ms();
	local n = 0;
	for k = 1, TRF_Ba_T("base_wave", 2) do
		local j = 0;
		for x, f in hb.fl do if x > j then j = x; end; end;
		j = max(j + 1, 10);
		if j > K.fl_max + 10 then break; end;
		local a = TRF_Ba_Rand(360);
		local pos = TRF_Ba_Ring(p, K.wave_lo + TRF_Ba_Rand(K.wave_hi - K.wave_lo + 1), a);
		local dir = Vector3(cos(a), 0, sin(a));
		if type(CreatePortalGlow) == "function" then TRF_Ba_P(CreatePortalGlow, {pos, dir, 7}); end;
		local fl = TRF_Ba_ClanFlight(idx, tier, pw, j, pos, dir, nil);
		if TRF_Ba_Reg(idx, j, fl, "w") then
			local sh = TRF_Ba_Ships(fl);
			for s = 1, getn(sh) do TRF_Ba_P(function(o) o:PlayFX("Cloak Out.shfx"); end, {sh[s]}); end;
			if bs.atk and ms then
				TRF_Ba_P(function(f, m) f:Attack(m); end, {fl, ms});
			else
				TRF_Ba_Patrol(fl, p, a);
			end;
			n = n + 1;
		end;
	end;
	TRF_BaE("wave", "system", TRF_Ba_Name(idx), "wave", which, "flight_count", n, "ship_count", TRF_Ba_NShips());
	return n;
end;

-- Live garrison flights of the current system (for the sweep's clan side, 7.3).
function TRF_BaseGarrison()
	local hb = TRF_Ba_H();
	local l = {};
	if not hb then return l; end;
	for j, fl in hb.fl do
		if TRF_Ba_Alive(fl) then tinsert(l, fl); end;
	end;
	return l;
end;

-- After a load: garrison flights by ship label trf_pb_<idx>_<j>_<s>; returns the set of j not found.
function TRF_Ba_FindFlights(idx)
	local hb = TRF_Ba_H();
	local miss = {};
	if not hb then return miss; end;
	local c = TRF_Ba_Comp()[TRF_Ba_Tier(idx)];
	local K = TRF_Ba_K();
	for j = 1, K.fl_max + 10 do
		local fl = nil;
		for s = 1, K.ships_max do
			local sh = TRF_N("GetObjectByLabel", "trf_pb_"..idx.."_"..j.."_"..s);
			if not fl and TRF_Ba_Alive(sh) then
				fl = TRF_Ba_P(function(x) local p = x:GetPilot(); if p then return p:GetFlight(); end; return nil; end, {sh});
			end;
		end;
		if TRF_Ba_Obj(fl) then
			hb.fl[j] = fl;
			if j <= c.p then hb.kd[j] = "g"; elseif j <= c.p + c.s then hb.kd[j] = "s"; else hb.kd[j] = "w"; end;
		elseif j <= c.p + c.s then
			miss[j] = 1;
		end;
	end;
	return miss;
end;

-- Reconciliation (9.7) ------------------------------------------------------------------------------------

-- Orphan: the object and its nav point are deleted (no record, or a P record).
function TRF_Ba_Orphan(idx, b)
	TRF_Ba_Del(b);
	TRF_Ba_NavDel(idx);
	TRF_Ba_Stat("base_orphan");
	TRF_BaE("orphan", "system", TRF_Ba_Name(idx), "result", "deleted");
end;

-- Wreck carcass for a missing D object (cfg wreck 1, legs < t + wreck_legs).
function TRF_Ba_Wreck(idx, r)
	if TRF_Ba_Opt("wreck", 0) ~= 1 or TRF_Ba_Legs() >= (r.t or 0) + TRF_Ba_T("wreck_legs", 10) then return; end;
	local lb = "TRF_PWRECK_"..idx;
	if TRF_Ba_Obj(TRF_N("GetObjectByLabel", lb)) or type(CreateCarcass) ~= "function" then return; end;
	local p = TRF_Ba_Site(idx);
	if not p then return; end;
	local w = TRF_Ba_P(CreateCarcass, {TRF_Ba_Names().wreck, p, Vector3(0, 0, 1)});
	if TRF_Ba_Obj(w) then
		TRF_N("SetObjectLabel", w, lb);
		TRF_BaE("wreck", "system", TRF_Ba_Name(idx));
	end;
end;

-- Current system only (labels are per location). mode "enter" | "load".
function TRF_Ba_Reconcile(mode)
	local idx = TRF_Ba_Cur();
	if not idx or not TRF_Ba_Sys(idx) then return; end;
	if TRF_Cfg().enabled == 2 then TRF_Base_Remove(); return; end;
	local r = TRF_BaseOf(idx);
	-- Also without a site and a record: a base object left by a map regeneration that removed bs is deleted.
	local b, st = TRF_Ba_Find(idx);
	local L = TRF_Ba_Live();
	if not L then return; end;
	if not r or r.k == 1 then
		if st then TRF_Ba_Orphan(idx, b); end;
		return;
	end;
	if r.k == 3 then
		-- w = 1: destroyed off-screen; an alive object with w = 0 (a scripted end left it standing) goes the same way.
		if st == "alive" then
			local ok = TRF_Ba_P(function(o) o:Blow(); return 1; end, {b});
			if not ok then TRF_Ba_Del(b); end;
			TRF_BaE("blown", "system", TRF_Ba_Name(idx), "stage", 3, "off_screen", TRF_KvB(r.w), "result", TRF_Ba_BlownOf(ok));
		elseif not st then
			TRF_Ba_Wreck(idx, r);
		end;
		r.w = 0;
		TRF_Ba_NavDel(idx);
		return;
	end;
	-- A record.
	if st == "dead" then
		TRF_Ba_NavDel(idx);
		TRF_BaseDestroyed(idx, "dead");
		return;
	end;
	if not TRF_Ba_On() then return; end;
	if not st then
		b = TRF_Ba_Create(idx, r);
		if not b then return; end;
	else
		local h = TRF_Ba_Band(b);
		if h then r.h = h; end;
	end;
	local hb = TRF_Ba_H();
	local bs = TRF_Ba_Bs(idx);
	if not hb or not bs then return; end;
	hb.b = b;
	TRF_Ba_Arm(idx, b, bs);
	TRF_Ba_Dock(idx, b);
	TRF_Ba_Nav(idx, b);
	bs.ld = nil;
	if mode == "load" then
		local miss = TRF_Ba_FindFlights(idx);
		local mp = nil;
		local ms = TRF_Ba_Ms();
		if ms then mp = ms:GetPosition(); end;
		local d = TRF_Ba_Dist(mp, b:GetPosition());
		bs.gp = 1;
		if not d or d > TRF_Ba_K().load_ms then
			local any = nil;
			for j, v in miss do any = 1; end;
			if any then TRF_Ba_Garrison(idx, b, bs, miss); end;
		end;
	elseif type(TRF_Supp) ~= "function" or TRF_Supp() == 0 then
		TRF_Ba_Garrison(idx, b, bs, nil);
	end;
	TRF_BaE("reconcile", "source", mode, "system", TRF_Ba_Name(idx), "object", st or "created", "hull_band", r.h);
end;

-- Loader OnActivate, after the state and safety steps.
function TRF_Base_OnActivate()
	call(TRF_Ba_Reconcile, {"enter"}, "x", TRF_PErr);
end;

-- Loader OnLoad: activate.script did not run; restored triggers carry the old generation.
function TRF_Base_OnLoad()
	call(TRF_Ba_Reconcile, {"load"}, "x", TRF_PErr);
end;

-- Triggers (shims run the bodies through TRF_Cb) -------------------------------------------------------------

function TRF_OnBaseDied(idx, g) TRF_Cb("TRF_OnBaseDied", TRF_Ba_DiedBody, {idx, g}); end;

function TRF_Ba_DiedBody(idx, g)
	if type(TRF) ~= "table" or g ~= TRF.gen then return; end;
	local L = TRF_Ba_Live();
	local by = "other";
	if L and type(L.bs) == "table" and L.bs.s == idx and L.bs.atk then by = "player"; end;
	TRF_Ba_NavDel(idx);
	local hb = TRF_Ba_H();
	-- Battle scars source 7 (design/scar-spec.md 5.3): the base died in view; the map's base site is the fallback
	-- position when the destroyed station no longer answers GetPosition.
	local smine = nil;
	if by == "player" then smine = 1; end;
	local site, bsy = nil, TRF_Ba_Sys(idx);
	if bsy and type(bsy.bs) == "table" then site = bsy.bs; end;
	local bo = nil;
	if hb then bo = hb.b; end;
	TRF_P("TRF_Sc_Dead", 4, 0, bo, smine, site and site.x, site and site.y, site and site.z);
	TRF_P("TRF_Sc_Fight", "base", smine);
	if hb then hb.b = nil; end;
	TRF_BaseDestroyed(idx, by);
end;

-- First player-group attack: base group at war with PLAYER_GROUP (group level, one way), wave 1.
function TRF_OnBaseHit(idx, g) TRF_Cb("TRF_OnBaseHit", TRF_Ba_HitBody, {idx, g}); end;

function TRF_Ba_HitBody(idx, g)
	if type(TRF) ~= "table" or g ~= TRF.gen or not TRF_BaseActive(idx) then return; end;
	local bs = TRF_Ba_Bs(idx);
	if not bs or bs.atk then return; end;
	bs.atk = TRF_Ba_Gt();
	if RELATION_WAR ~= nil and type(SetGroupRelation) == "function" then
		TRF_Ba_P(SetGroupRelation, {TRF_Ba_GName(idx), PLAYER_GROUP, RELATION_WAR});
	end;
	TRF_BaE("attacked", "system", TRF_Ba_Name(idx), "game_time", TRF_F(bs.atk));
	if bs.w ~= 1 then
		bs.w = 1;
		TRF_Ba_Wave(idx, 1);
	end;
end;

-- HP band p reached: the band is saved, the next one armed; below 50 % the second wave (once per visit).
function TRF_OnBaseHP(idx, p, g) TRF_Cb("TRF_OnBaseHP", TRF_Ba_HPBody, {idx, p, g}); end;

function TRF_Ba_HPBody(idx, p, g)
	if type(TRF) ~= "table" or g ~= TRF.gen then return; end;
	local r = TRF_BaseOf(idx);
	local hb = TRF_Ba_H();
	if not r or r.k ~= 2 or not hb or not TRF_Ba_Alive(hb.b) then return; end;
	local bs = TRF_Ba_Bs(idx);
	local h = TRF_Ba_Band(hb.b);
	if not h then h = max(0, (tonumber(p) or 1) - 1); end;
	r.h = h;
	TRF_BaDE("hp", "system", TRF_Ba_Name(idx), "hull_band", h);
	if h < 5 and bs.w2 ~= 1 then
		bs.w2 = 1;
		TRF_Ba_Wave(idx, 2);
	end;
	TRF_Ba_ArmHP(idx, hb.b, bs);
end;

-- Step, jump, removal -----------------------------------------------------------------------------------------

-- Manager step: deferred garrison (suppression over), HP band, salvaged garrison flights killed (TRF_SalvUse).
function TRF_Base_Step()
	call(TRF_Ba_StepBody, {}, "x", TRF_PErr);
end;

function TRF_Ba_StepBody()
	local L = TRF_Ba_Live();
	if not L or type(L.bs) ~= "table" or not TRF_Ba_On() then return; end;
	local bs = L.bs;
	local hb = TRF_Ba_H();
	local r = TRF_BaseOf(bs.s);
	if not hb or not r or r.k ~= 2 or not TRF_Ba_Alive(hb.b) then return; end;
	local h = TRF_Ba_Band(hb.b);
	if h then r.h = h; end;
	if bs.gp ~= 1 and (type(TRF_Supp) ~= "function" or TRF_Supp() == 0) then TRF_Ba_Garrison(bs.s, hb.b, bs, nil); end;
	for j, v in hb.sv do
		if not hb.svd[j] and not TRF_Ba_Alive(hb.fl[j]) then
			hb.svd[j] = 1;
			local slot = TRF_Ba_Slot(bs.s);
			if slot then TRF_N("TRF_SalvUse", slot, "base"); end;
			if type(L.pg) == "table" then
				for i = 1, getn(L.pg) do
					local e = L.pg[i];
					if type(e) == "table" and e.k == "g" and e.n == j and e.i == bs.s then e.st = "dead"; end;
				end;
			end;
		end;
	end;
end;

-- Before a jump: HP band saved, garrison flights deleted (flights are not in the snapshot).
function TRF_Base_BeforeJump()
	call(TRF_Ba_JumpBody, {}, "x", TRF_PErr);
end;

function TRF_Ba_JumpBody()
	local hb = TRF_Ba_H();
	if not hb then return; end;
	local L = TRF_Ba_Live();
	if L and type(L.bs) == "table" and TRF_Ba_Alive(hb.b) then
		local r = TRF_BaseOf(L.bs.s);
		local h = TRF_Ba_Band(hb.b);
		if r and r.k == 2 and h then r.h = h; end;
	end;
	local n = 0;
	for j, fl in hb.fl do
		if TRF_Ba_Alive(fl) then TRF_Ba_Del(fl); n = n + 1; end;
	end;
	if TRF_H then TRF_H().bs = nil; end;
	if n > 0 then TRF_BaE("jump", "deleted_count", n); end;
end;

-- cfg enabled 2 (restore-and-stop): the base object of this system (and its nav point and wreck) is deleted
-- and the record cleared; "bases removed" once TRF.base is empty.
function TRF_Base_Remove()
	local idx = TRF_Ba_Cur();
	if not idx or type(TRF) ~= "table" then return; end;
	local b = TRF_N("GetObjectByLabel", TRF_Ba_Label(idx));
	if TRF_Ba_Obj(b) then TRF_Ba_Del(b); end;
	local w = TRF_N("GetObjectByLabel", "TRF_PWRECK_"..idx);
	if TRF_Ba_Obj(w) then TRF_Ba_Del(w); end;
	TRF_Ba_NavDel(idx);
	local r = TRF_BaseOf(idx);
	if r then TRF_Ba_Drop(r, "removed"); end;
	if getn(TRF_Ba_Recs()) == 0 and (r or TRF_Ba_Obj(b)) then TRF_BaE("bases_removed"); end;
end;

-- Raid spawn point (9.4): base_spawn_offset 60-120 from the base on the side facing toward (Vector3), else a
-- random bearing. nil without a site.
function TRF_BaseRaidPos(idx, toward)
	local p = TRF_Ba_Site(idx);
	local hb = TRF_Ba_H();
	if hb and TRF_Ba_Alive(hb.b) and TRF_Ba_Cur() == idx then p = hb.b:GetPosition(); end;
	if not p then return nil; end;
	local K = TRF_Ba_K();
	local lo, hi = TRF_Ba_Range("base_spawn_offset", K.raid_lo, K.raid_hi);
	local d = lo + TRF_Ba_Rand(floor(hi - lo) + 1);
	local dd = TRF_Ba_Dist(p, toward);
	if dd and dd > 1 then
		return Vector3(p.x + (toward.x - p.x) * d / dd, p.y + (toward.y - p.y) * d / dd, p.z + (toward.z - p.z) * d / dd);
	end;
	return TRF_Ba_Ring(p, d, TRF_Ba_Rand(360));
end;

-- "blown" when the Blow call answered, else "deleted" (the object was deleted instead).
function TRF_Ba_BlownOf(ok)
	if ok then return "blown"; end;
	return "deleted";
end;

-- Dump: the records as one list value (<system>:<P|A|D>/h<hull band>/t<leg>/w<off-screen>/bh<legs>) and the
-- visit state (nil keys without a base visit).
function TRF_Base_Dump()
	local l = TRF_Ba_Recs();
	local kn = {"P", "A", "D"};
	local s = nil;
	for i = 1, getn(l) do
		local r = l[i];
		local e = TRF.sys and TRF.sys[r.s];
		local bh = 0;
		if type(e) == "table" and type(e.bh) == "number" then bh = e.bh; end;
		local c = TRF_Ba_Name(r.s)..":"..kn[r.k].."/h"..tostring(r.h).."/t"..tostring(r.t).."/w"..tostring(r.w).."/bh"..bh;
		if s then s = s..","..c; else s = c; end;
	end;
	local L = TRF_Ba_Live();
	local vs, va, vw, vw2, vn = nil, nil, nil, nil, nil;
	if L and type(L.bs) == "table" then
		vs = TRF_Ba_Name(L.bs.s); va = TRF_F(L.bs.atk); vw = TRF_KvB(L.bs.w); vw2 = TRF_KvB(L.bs.w2); vn = TRF_Ba_NShips();
	end;
	TRF_BaE("dump", "record_count", getn(l), "allow_count", getn(TRF_Ba_Allow()), "enabled", TRF_KvB(TRF_Ba_On()),
		"records", s, "visit_system", vs, "attacked_time", va, "wave_1", vw, "wave_2", vw2, "ship_count", vn);
end;
