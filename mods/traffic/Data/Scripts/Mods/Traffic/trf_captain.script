		capq17 = "Wanted: Marek 'Gutter'", capq18 = "Wanted: Neve Sallow", capq19 = "Wanted: Corran 'Lockjaw'", capq20 = "Wanted: Petra Dusk",
		capq21 = "Wanted: Ivo 'Cinder'", capq22 = "Wanted: Halla Rook", capq23 = "Wanted: Teodor 'Sparrow'", capq24 = "Wanted: Yarra Venn",
		capqd = "A pirate captain with a patrol price on his head. Kill him and collect the bounty at any patrol station.",
		caphead = "WANTED BY THE PATROL",
		capbrd = "$1, captain of the $2 ($3).",                                       -- name, clan, tier word
		capesc = "Escaped $1 times.",                                                  -- escapes
		capraids = "Raids the lanes of $1.",                                           -- system
		capseen = "Last seen: $1. Dead or alive: $2 cr.",                              -- system, price
