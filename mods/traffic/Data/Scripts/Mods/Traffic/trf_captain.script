		capnm13 = "Rusk 'Halfmoon'", capnm14 = "Ilse Kord", capnm15 = "Fenn 'Tallow'", capnm16 = "Zora Pike",
		capnm17 = "Marek 'Gutter'", capnm18 = "Neve Sallow", capnm19 = "Corran 'Lockjaw'", capnm20 = "Petra Dusk",
		capnm21 = "Ivo 'Cinder'", capnm22 = "Halla Rook", capnm23 = "Teodor 'Sparrow'", capnm24 = "Yarra Venn",
