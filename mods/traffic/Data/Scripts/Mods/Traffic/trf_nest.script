-- sw3-traffic dynamic nests (Lua 4.0.1). Spec: design/nest-spec.md (design worldbuilding/16-dynamic-nests.md, step 1).
-- Public TRF_Nest_* (module name Nest in the loader lists), internal TRF_Ne<X>, log module=nest through TRF_NeE / TRF_NeDE.
-- Step 1: the scripted pirate flights of the 58 systems in TRF_NestData (tools/gen_nest.py) become the nest of the
-- region's clan. A wrapper of the global NewPirateFlight (installed once per MapInitialization, TRF_InstallNest) is armed
-- only between TRF_OnEnter and TRF_OnActivate (nest_mode 1): a listed sign that the plan fields is built by the vanilla
-- builder in group TRF_Nest_1 of team Pirates at the nest power (flight_/ship_/pilot_<sign> are real objects, the
-- following Patrol line runs unchanged); a listed sign the plan skips gets a stub object until TRF_OnActivate. Pinned
-- signs are always fielded. nest_mode 2: vanilla builds every flight, TRF_OnActivate deletes the unpinned ones and builds
-- the plan with the static routes. The plan is a pure function of saved state: phase count factor nest_f (nest_f_swept
-- in the sweep target during Bust), tier power delta nest_dp, kill memory TRF.nest[idx] (refilled nest_regen_pct of the
-- vanilla count per nest_regen_legs legs, applied at entry), never more flights than vanilla, no flight near an unopened
-- clan stash cache. Replacement only in a non-excluded system (deny entries nest = 0: X297, El Ariash; cfg nest_off),
-- from chapter 5, in mod mode (trf_safety TRF_SysMode) and through the strict gate (TRF_StrictOk feature nest).
-- Feeds: a destroyed flight writes the kill memory and costs the clan 2 score (with player fire through trf_events'
-- TRF_Ev_Recover: dis -1 inside its visit cap, clan nk + 1); every destroyed ship feeds battle scars source 7.
-- Relations: the nest group copies the vanilla group's relation to the player after activate.script and mirrors later
-- changes one way (nest_mirror). Jump: every live nest flight is deleted. Load: the saved flights are adopted by their
-- globals (TRF.nv) and re-armed. Saved: TRF.nest[idx] = {k, l, c}, TRF.nv = {i, b}, TRF.nst = {n, k, p},
-- TRF.clan[slot].nk, .nl, .ns. Visit state lives in the chunk local NE (never saved; rebuilt by every MapInitialization).
-- Layout as trf_stash: helpers, static tables, pure functions (*Of), state, gates, install and wrapper, entry,
-- activation, callbacks, step, jump, load, contract functions. Top level: functions and NE only.

local NE = {v={}};

-- Helpers --------------------------------------------------------------------------

function TRF_NeNE() return %NE; end;

-- logfmt event line, module=nest (design/log-format.md).
function TRF_NeE(event, ...)
	tinsert(arg, 1, event); tinsert(arg, 1, "nest"); call(TRF_Lf, arg);
end;

-- Error handler for protected calls: an event=error line, counted in stat err.
function TRF_NeErr(m)
	TRF_NeE("error", "message", tostring(m));
	TRF_N("TRF_Stat", "err");
end;

-- Silent handler (handles that may be stale, a builder that may fail): nil is the answer.
function TRF_NeNoErr(m) end;

function TRF_NeLog()
	local v = TRF_N("TRF_Opt", "log");
	if type(v) ~= "number" and type(TRF_Cfg) == "function" then v = TRF_Cfg().log; end;
	if type(v) ~= "number" then v = 1; end;
	return v;
end;

-- Debug event line (log 2).
function TRF_NeDE(event, ...)
	if TRF_NeLog() < 2 then return; end;
	tinsert(arg, 1, event); call(TRF_NeE, arg);
end;

function TRF_NeStat(k)
	TRF_N("TRF_Stat", k);
end;

function TRF_NeCl(x, lo, hi)
	if x < lo then return lo; end;
	if x > hi then return hi; end;
	return x;
end;

function TRF_NeNum(x, lo, hi)
	return type(x) == "number" and x >= lo and x <= hi;
end;

-- Enumerated cfg keys of this module: {lo, hi}; other number keys are 0..1.
function TRF_NeEnum()
	return {nest_mode={1, 2}, nest_trig={1, 2}};
end;

-- cfg value: TRF_Opt (merges TRF_Nest_OptDef), else the raw config, else the default; a wrong type or a number
-- outside its range reads as the default.
function TRF_NeOpt(key)
	local d = TRF_Nest_OptDef()[key];
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil and type(TRF_CfgGet) == "function" then v = TRF_CfgGet(key, nil); end;
	if v == nil or (d ~= nil and type(v) ~= type(d)) then return d; end;
	if type(v) == "number" then
		local e = TRF_NeEnum()[key] or {0, 1};
		if v ~= floor(v) or v < e[1] or v > e[2] then return d; end;
	end;
	return v;
end;

-- Clamp ranges of the tune keys (lists: every entry).
function TRF_NeClampT()
	return {nest_f={0, 100}, nest_f_swept={0, 100}, nest_dp={-5, 5}, nest_regen_pct={0, 100}, nest_regen_legs={1, 100},
		nest_cache_r={0, 5000}, nest_grudge_nk={1, 99}, nest_cap={0, 1}};
end;

-- Tune values of this module, clamped; list keys copied with each entry clamped. Cached in NE while TRF_Tune returns
-- the same table; callers must not write into it.
function TRF_NeTune()
	local ne = %NE;
	local t = nil;
	if type(TRF_Tune) == "function" then t = call(TRF_Tune, {}, "x", TRF_NeErr); end;
	if type(ne.tc) == "table" and ne.tc.s == t then return ne.tc.t; end;
	local d, cl, o = TRF_Nest_TuneDef(), TRF_NeClampT(), {};
	for k, v in d do
		local x = nil;
		if type(t) == "table" then x = t[k]; end;
		if type(x) ~= type(v) then x = v; end;
		local r = cl[k];
		if type(x) == "table" then
			local w = {};
			for i = 1, getn(v) do
				local e = x[i];
				if type(e) ~= "number" then e = v[i]; end;
				w[i] = TRF_NeCl(floor(e), r[1], r[2]);
			end;
			x = w;
		elseif r then
			x = TRF_NeCl(floor(x), r[1], r[2]);
		end;
		o[k] = x;
	end;
	ne.tc = {s=t, t=o};
	return o;
end;

function TRF_NeT(key)
	return TRF_NeTune()[key];
end;

function TRF_NeLegs()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then return TRF.clock.legs; end;
	return 0;
end;

function TRF_NeGen()
	if type(TRF) == "table" and type(TRF.gen) == "number" then return TRF.gen; end;
	return 0;
end;

-- Lowercase map name of system idx (data key, log values), or the index.
function TRF_NeName(idx)
	local n = TRF_N("TRF_SysName", idx);
	if type(n) == "string" and n ~= "?" then return strlower(n); end;
	return tostring(idx);
end;

function TRF_NeCur()
	local i = TRF_N("TRF_CurIdx");
	if type(i) == "number" then return i; end;
	return nil;
end;

function TRF_NeTxt(key, a)
	if type(TRF_Txt) == "function" then return TRF_Txt(key, a); end;
	return tostring(key);
end;

-- Screen line (pilot nil) or radio line of pilot (cfg ui_out 2), through trf_ui's TRF_Say.
function TRF_NeSay(text, secs, pilot)
	if type(text) ~= "string" or text == "" then return nil; end;
	return TRF_N("TRF_Say", text, secs or TRF_NeK().secs, pilot);
end;

-- 1 while a story mission runs (GetPlayerQuestState() == TRUE).
function TRF_NeQuest()
	if type(GetPlayerQuestState) ~= "function" then return nil; end;
	if GetPlayerQuestState() == TRUE then return 1; end;
	return nil;
end;

function TRF_NeClanName(slot)
	local n = TRF_N("TRF_ClanName", slot);
	if type(n) == "string" then return n; end;
	return "pirates";
end;

function TRF_NeDist(a, b)
	if type(a) ~= "table" or type(b) ~= "table" or type(a.x) ~= "number" or type(b.x) ~= "number" then return nil; end;
	local dx, dy, dz = a.x - b.x, (a.y or 0) - (b.y or 0), (a.z or 0) - (b.z or 0);
	return sqrt(dx * dx + dy * dy + dz * dz);
end;

-- Accessors (one native each, protected) -----------------------------------------------

function TRF_NeObj(o)
	if o == nil or type(o) == "number" or type(o) == "string" or type(o) == "function" then return nil; end;
	return 1;
end;

function TRF_NeAliveRaw(o)
	return o:IsAlive();
end;

-- 1 when o is a live engine object (IsAlive answers true; the stub answers nil).
function TRF_NeAlive(o)
	if not TRF_NeObj(o) then return nil; end;
	local v = call(TRF_NeAliveRaw, {o}, "x", TRF_NeNoErr);
	if v == nil or v == 0 or (FALSE ~= nil and v == FALSE) then return nil; end;
	return 1;
end;

function TRF_NeDelRaw(o)
	o:Delete();
	return 1;
end;

function TRF_NeDel(o)
	if not TRF_NeObj(o) then return nil; end;
	return call(TRF_NeDelRaw, {o}, "x", TRF_NeNoErr);
end;

function TRF_NeTrig(kind, cb, a, b)
	if type(NewTrigger) ~= "function" then return nil; end;
	return call(NewTrigger, {kind, nil, cb, a, b}, "x", TRF_NeErr);
end;

-- Callback string with the table index and the current TRF.gen last (traffic's rule, T_BadCallbacks):
-- TRF_NeCb("TRF_Nest_Died", 3) -> "TRF_Nest_Died(3,<gen>)--"; with j: "TRF_NeShipDied(3,2,<gen>)--".
function TRF_NeCb(name, i, j)
	if j then return name.."("..i..","..j..","..TRF_NeGen()..")--"; end;
	return name.."("..i..","..TRF_NeGen()..")--";
end;

function TRF_NeShipsRaw(fl, jmax)
	local out = {};
	local n = fl:GetPilotCount();
	if type(n) ~= "number" then return out; end;
	for j = 1, min(n, jmax) do
		local p = fl:GetPilotByNumber(j);
		local s = nil;
		if p then s = p:GetShip(); end;
		out[j] = s;
	end;
	return out;
end;

-- Ships of flight fl (at most K.j_max), index j as the builder numbered them; the ship_<sign>_<j> globals fill gaps.
function TRF_NeShips(fl, sign)
	local K = TRF_NeK();
	local out = call(TRF_NeShipsRaw, {fl, K.j_max}, "x", TRF_NeNoErr);
	if type(out) ~= "table" then out = {}; end;
	for j = 1, K.j_max do
		if not TRF_NeObj(out[j]) and type(sign) == "string" then
			local s = getglobal("ship_"..sign.."_"..j);
			if TRF_NeObj(s) then out[j] = s; end;
		end;
	end;
	return out;
end;

function TRF_NeLeaderRaw(fl)
	return fl:GetLeader();
end;

-- Group relation a -> b (objects or names), or nil.
function TRF_NeGetRel(a, b)
	if type(GetGroupRelation) ~= "function" or a == nil or b == nil then return nil; end;
	local v = call(GetGroupRelation, {a, b}, "x", TRF_NeNoErr);
	if type(v) == "number" then return v; end;
	return nil;
end;

function TRF_NeSetRelRaw(a, b, r)
	SetGroupRelation(a, b, r);
	return 1;
end;

function TRF_NeSetRel(a, b, r)
	if type(SetGroupRelation) ~= "function" or type(r) ~= "number" then return nil; end;
	return call(TRF_NeSetRelRaw, {a, b, r}, "x", TRF_NeErr);
end;

-- Relation name for the log.
function TRF_NeRelName(r)
	if RELATION_WAR ~= nil and r == RELATION_WAR then return "war"; end;
	if RELATION_FRIEND ~= nil and r == RELATION_FRIEND then return "friend"; end;
	if RELATION_NEUTRAL ~= nil and r == RELATION_NEUTRAL then return "neutral"; end;
	return tostring(r);
end;

-- Static tables --------------------------------------------------------------------

-- Constants without a cfg key: flights per system at most (the TRF.nv bit string), ships per flight (labels
-- trf_nest_<i>_<j>), the nest group and its build global, line seconds, clan score per destroyed flight, counter and
-- nk bounds, the phase line keys (index phase + 1), the vanilla group spellings (appendix A).
function TRF_NeK()
	return {f_max=31, j_max=6, grp="TRF_Nest_".."1", gg="TRF_GNest_".."1", secs=8, hit_secs=6, score=-2, cnt_max=99999, nk_max=99,
		lines={"nestquiet", nil, "nestfull", "nestraid", "nestbust", nil}, swept_nl=7};
end;

-- The five vanilla pirate group spellings of the nest systems (appendix A; gen_nest.py GROUPS).
function TRF_Nest_VanGroups()
	return {"PiratesGroup_1", "Pirate_Group_1", "Pirates_Group_1", "PirateGroup_1", "Pirate_Group_1_1"};
end;

-- Entry of system name nm in TRF_NestData (cached per MapInitialization), or nil.
function TRF_NeData(nm)
	local ne = %NE;
	if type(ne.data) ~= "table" then
		ne.data = {};
		if type(TRF_NestData) == "function" then
			local d = call(TRF_NestData, {}, "x", TRF_NeErr);
			if type(d) == "table" then ne.data = d; end;
		end;
	end;
	local e = ne.data[nm];
	if type(e) == "table" and type(e.f) == "table" and getn(e.f) > 0 then return e; end;
	return nil;
end;

