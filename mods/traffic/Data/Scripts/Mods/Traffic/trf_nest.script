-- Pure functions (*Of) ----------------------------------------------------------------

-- Count factor in percent of phase ph (0 Quiet .. 5 Recovery): nest_f[ph + 1]; the swept factor fs in Bust (ph 4)
-- when the system is the target of the region's won sweep.
function TRF_NeFOf(ph, swept, F, fs)
	if ph == 4 and swept then return fs; end;
	return F[ph + 1] or 100;
end;

-- Kill memory refill (design 6 entry step 2): t whole steps of rl legs since stamp l; each takes ceil(pct x nv / 100)
-- killed flights back. Returns k', l', t.
function TRF_NeRefillOf(k, l, legs, nv, pct, rl)
	if rl < 1 then rl = 1; end;
	local t = floor((legs - l) / rl);
	if t <= 0 then return k, l, 0; end;
	local dk = ceil(pct * nv / 100);
	return max(0, k - t * dk), l + t * rl, t;
end;

-- Plan of one entry (design 4 scaling, 6 entry step 3), pure. rows: the system's static flights; f: count factor %;
-- k: kill memory; dp: power delta; caches: list of {x, y, z} of unopened cache slots; cr: nest_cache_r.
-- n = clamp(round(f x nv / 100) - k, pins, nv); pinned signs first, then the ranks ascending; a sign within cr + rr of a
-- cache is not fielded unless pinned. Returns {n (target), nv, pins, fl[i] = 1 fielded, sk[i] = "count" | "cache",
-- pw[i] = power of the static row}, never more fielded flights than nv.
function TRF_NestPlanOf(rows, f, k, dp, caches, cr)
	local nv = getn(rows);
	local P = {nv=nv, pins=0, fl={}, sk={}, pw={}, nf=0};
	for i = 1, nv do
		if rows[i].pin == 1 then P.pins = P.pins + 1; end;
		P.pw[i] = TRF_NeCl(floor((rows[i].p or 1) + dp), 1, 20);
	end;
	P.n = TRF_NeCl(floor(f * nv / 100 + 0.5) - (k or 0), P.pins, nv);
	local cand = {};
	for i = 1, nv do
		local r = rows[i];
		if r.pin == 1 then
			P.fl[i] = 1; P.nf = P.nf + 1;
		else
			local near = nil;
			for c = 1, getn(caches or {}) do
				local d = TRF_NeDist({x=r.x, y=r.y, z=r.z}, caches[c]);
				if d and d <= cr + (r.rr or 0) then near = 1; end;
			end;
			if near then P.sk[i] = "cache"; else tinsert(cand, i); end;
		end;
	end;
	sort(cand, function(a, b) return (%rows[a].rk or a) < (%rows[b].rk or b); end);
	for c = 1, getn(cand) do
		local i = cand[c];
		if P.nf < P.n then P.fl[i] = 1; P.nf = P.nf + 1; else P.sk[i] = "count"; end;
	end;
	return P;
end;

-- Arrival line of an entry (design 6 activation): with a memory record "nesthurt" ("nestclear" when the last fielded
-- flight died with player fire and nothing is fielded); else the phase line once per phase (nl = phase + 1; the swept
-- target's line uses K.swept_nl). Returns key or nil, and the nl value to store (nil: unchanged).
function TRF_NeLineOf(rec, nf, ph, nl, swept, K)
	if type(rec) == "table" then
		if rec.c == 1 and nf == 0 then return "nestclear", nil; end;
		return "nesthurt", nil;
	end;
	if ph == 4 and swept then
		if nl == K.swept_nl then return nil, nil; end;
		return "nestswept", K.swept_nl;
	end;
	local key = K.lines[ph + 1];
	if not key or nl == ph + 1 or (ph == 4 and nl == K.swept_nl) then return nil, nil; end;
	return key, ph + 1;
end;

-- Bit string of n flags (1 or nil) as "1"/"0" characters.
function TRF_NeBitsOf(t, n)
	local s = "";
	for i = 1, n do if t[i] then s = s.."1"; else s = s.."0"; end; end;
	return s;
end;

-- State --------------------------------------------------------------------------------

function TRF_NeRec(idx)
	if type(TRF) ~= "table" or type(TRF.nest) ~= "table" or type(idx) ~= "number" then return nil; end;
	local r = TRF.nest[idx];
	if type(r) == "table" then return r; end;
	return nil;
end;

-- Counters TRF.nst {n fielded, k killed, p killed with player fire}.
function TRF_NeCount(k)
	if type(TRF) ~= "table" then return; end;
	if type(TRF.nst) ~= "table" then TRF.nst = {n=0, k=0, p=0}; end;
	TRF.nst[k] = min(TRF_NeK().cnt_max, (TRF.nst[k] or 0) + 1);
end;

function TRF_NeClan(slot)
	local c = TRF_N("TRF_ClanRec", slot);
	if type(c) == "table" then return c; end;
	return nil;
end;

-- Region slot of idx, its phase and the effective tier, and 1 when idx is the region's won-sweep target (clan ns).
function TRF_NeRegion(idx)
	local slot = TRF_N("TRF_RgOf", idx);
	if type(slot) ~= "number" then return nil; end;
	local ph = TRF_N("TRF_Phase", slot) or 0;
	local T = TRF_N("TRF_EffTier", idx) or 1;
	local c = TRF_NeClan(slot);
	local sw = nil;
	if c and c.ns == idx then sw = 1; end;
	return slot, ph, T, sw;
end;

-- Unopened cache slots of system idx (trf_stash records with st 0 or 1): list of {x, y, z}.
function TRF_NeCaches(idx)
	local out = {};
	if type(TRF) ~= "table" or type(TRF.stash) ~= "table" then return out; end;
	for i, r in TRF.stash do
		if type(r) == "table" and r.sys == idx and type(r.st) == "number" and r.st < 2 then
			local p = TRF_N("TRF_ShSlotPos", r);
			if type(p) == "table" and type(p.x) == "number" then tinsert(out, p); end;
		end;
	end;
	return out;
end;

-- Gates --------------------------------------------------------------------------------

-- 1 when the module runs: TRF, the traffic modules, cfg nest 1.
function TRF_NeOn()
	if type(TRF) ~= "table" or not (type(TRF_Traffic) == "function" and TRF_Traffic()) then return nil; end;
	return TRF_NeOpt("nest") == 1;
end;

-- 1 when system name nm is excluded: a deny entry with nest = 0 (X297, El Ariash) or a cfg nest_off name.
function TRF_NeExcluded(nm)
	local e = TRF_N("TRF_DenyEntry", nm);
	if type(e) == "table" and e.nest == 0 then return 1; end;
	local off = TRF_NeOpt("nest_off");
	if type(off) == "table" then
		for k, v in off do if type(v) == "string" and strlower(v) == nm then return 1; end; end;
	end;
	return nil;
end;

-- Visit mode (design 6 entry step 1): "nest", nil or "vanilla", reason (off, no_data, excluded, guard, sysmode,
-- gate_<strict reason>, no_region, supp).
function TRF_NeMode(cur, nm, d)
	if not TRF_NeOn() then return "vanilla", "off"; end;
	if not d then return "vanilla", "no_data"; end;
	if TRF_NeExcluded(nm) then return "vanilla", "excluded"; end;
	if type(TRF_RgGuardOn) ~= "function" or TRF_RgGuardOn() then return "vanilla", "guard"; end;
	if type(TRF_SysMode) == "function" and TRF_SysMode() ~= "mod" then return "vanilla", "sysmode"; end;
	if type(TRF_StrictOk) == "function" then
		local ok, w = TRF_StrictOk(cur, "nest");
		if not ok then return "vanilla", "gate_"..tostring(w); end;
	end;
	if not TRF_N("TRF_RgOf", cur) then return "vanilla", "no_region"; end;
	if __disableAction == TRUE then return "vanilla", "supp"; end;
	local sp = TRF_N("TRF_Supp");
	if type(sp) == "number" and sp >= 2 then return "vanilla", "supp"; end;
	return "nest", nil;
end;

-- Install and wrapper ------------------------------------------------------------------------

-- 1 when f is this module's NewPirateFlight wrapper (thunk identity of an earlier run, or a Mods/Traffic chunk).
function TRF_NeIsMine(f)
	if type(f) ~= "function" then return nil; end;
	if type(TRF_NeThunk) == "function" and f == TRF_NeThunk() then return 1; end;
	if type(TRF_IsMine) == "function" and TRF_IsMine(f) then return 1; end;
	return nil;
end;

-- Called from TRF_Main on every MapInitialization after TRF_InstallPlumb: the vanilla includes have just redefined
-- NewPirateFlight (system.lst, Create_flight_2.script), so the original saved here is this run's. TRF_orig_NewPirateFlight
-- and the thunk are function globals: they survive ClearGlobals and are never saved. NewPiratesFlight and the "Pirate"
-- branch of the side dispatcher look NewPirateFlight up at call time and need no wrap. Returns 1 when wrapped now.
function TRF_InstallNest()
	local w = 0;
	if type(NewPirateFlight) == "function" and not TRF_NeIsMine(NewPirateFlight) then
		TRF_orig_NewPirateFlight = NewPirateFlight;
		local t = function(g, s, l, ty, p, o)
			if type(TRF_Nest_NPF) == "function" then return TRF_Nest_NPF(g, s, l, ty, p, o); end;
			if type(TRF_orig_NewPirateFlight) == "function" then return TRF_orig_NewPirateFlight(g, s, l, ty, p, o); end;
			return FALSE;
		end;
		NewPirateFlight = t;
		TRF_NeThunk = function() return %t; end;
		w = 1;
	end;
	TRF_NeDE("install", "installed", TRF_KvB(w), "wrapped", TRF_KvB(TRF_NeIsMine(NewPirateFlight)));
	return w;
end;

function TRF_NeNoop() end;
function TRF_NeNil() return nil; end;

-- Stub flight of a skipped sign (design 6): the methods activate.script uses on placed flights as no-ops, IsAlive nil.
-- Only between the wrapper call and TRF_OnActivate (cleared there), so no table with functions reaches a save.
function TRF_NeStub(sign)
	return {trf_nest_stub=sign, Patrol=TRF_NeNoop, Move=TRF_NeNoop, Escort=TRF_NeNoop, Attack=TRF_NeNoop, Delete=TRF_NeNoop,
		SetFormation=TRF_NeNoop, SetOrientation=TRF_NeNoop, IsAlive=TRF_NeNil};
end;

-- The vanilla call with the caller's arguments (unprotected: its errors are vanilla's), the pass logged at level 2.
function TRF_NeOrig(why, g, s, l, ty, p, o)
	TRF_NeDE("call", "sign", tostring(s), "result", "pass", "reason", why);
	if type(TRF_orig_NewPirateFlight) ~= "function" then return FALSE; end;
	return TRF_orig_NewPirateFlight(g, s, l, ty, p, o);
end;

function TRF_NeGroupRaw(gn)
	return CreateTeam("Pirates"):CreateGroup(gn);
end;

-- The nest group of armed visit a (created on the first fielded call; its build global set), or nil.
function TRF_NeGroup(a)
	if TRF_NeObj(a.grp) then return a.grp; end;
	if type(CreateTeam) ~= "function" then return nil; end;
	local K = TRF_NeK();
	local g = call(TRF_NeGroupRaw, {K.grp}, "x", TRF_NeErr);
	if not TRF_NeObj(g) then return nil; end;
	a.grp = g;
	setglobal(K.gg, g);
	return g;
end;

-- NewPirateFlight while installed (design 6). Not armed, a sign not in the system's table, a group other than the
-- system's vanilla group or a second call of a sign: the vanilla call. nest_mode 2: the vanilla call, its flight
-- recorded. Planned and fielded: the vanilla builder with group TRF_GNest_1 and the nest power, protected; any error
-- or a non-object result: the vanilla call (result=failed reason=build). Planned and skipped: the stub.
function TRF_Nest_NPF(group, sign, location, ty, power, orient)
	local a = %NE.a;
	if type(a) ~= "table" or a.on ~= 1 or a.gen ~= TRF_NeGen() then return TRF_NeOrig("unarmed", group, sign, location, ty, power, orient); end;
	local i = a.by[sign];
	if not i then return TRF_NeOrig("unlisted", group, sign, location, ty, power, orient); end;
	if group ~= a.d.g then
		a.unk = a.unk + 1;
		return TRF_NeOrig("group", group, sign, location, ty, power, orient);
	end;
	if a.st[i] then return TRF_NeOrig("repeat", group, sign, location, ty, power, orient); end;
	if a.mode == 2 then
		local fl = TRF_orig_NewPirateFlight(group, sign, location, ty, power, orient);
		a.st[i] = "rec";
		if TRF_NeObj(fl) then a.van[i] = fl; end;
		TRF_NeDE("call", "sign", sign, "result", "recorded");
		return fl;
	end;
	local pin = nil;
	if a.d.f[i].pin == 1 then pin = 1; end;
	if a.plan.fl[i] then
		local g = TRF_NeGroup(a);
		local pw = nil;
		if type(power) == "number" then pw = TRF_NeCl(floor(power + a.dp), 1, 20); end;
		local fl = nil;
		if g and pw then fl = call(TRF_orig_NewPirateFlight, {TRF_NeK().gg, sign, location, ty, pw, orient}, "x", TRF_NeNoErr); end;
		if TRF_NeObj(fl) then
			a.st[i] = "sub";
			a.fl[i] = fl;
			TRF_NeDE("call", "sign", sign, "result", "substituted", "power", pw, "vanilla_power", power, "pinned", TRF_KvB(pin));
			return fl;
		end;
		a.st[i] = "van";
		a.fail = a.fail + 1;
		TRF_NeE("call", "sign", sign, "result", "failed", "reason", "build");
		return TRF_orig_NewPirateFlight(group, sign, location, ty, power, orient);
	end;
	local sb = TRF_NeStub(sign);
	setglobal("flight_"..sign, sb);
	a.st[i] = "stub";
	a.sb[sign] = sb;
	TRF_NeDE("call", "sign", sign, "result", "stub", "reason", a.plan.sk[i] or "count");
	return sb;
end;

-- Entry (TRF_OnEnter, after trf_safety) --------------------------------------------------------------

-- Visit state reset (entry, load, jump).
function TRF_NeReset()
	local ne = %NE;
	ne.a = nil;
	ne.v = {fl={}, sh={}, hit={}, dead={}, sd={}, gone={}};
end;

-- Orphan delete (design 6 jumps, E16.2): live ships labelled trf_nest_<i>_<j> found at an entry (a location snapshot
-- that kept the mod's ships) are deleted before activate.script runs. Returns the count.
function TRF_NeOrphans(nv)
	local K = TRF_NeK();
	local n = 0;
	for i = 1, min(nv, K.f_max) do
		for j = 1, K.j_max do
			local lb = "trf_nest_"..i.."_"..j;
			local o = TRF_N("GetObjectByLabel", lb);
			if TRF_NeAlive(o) and TRF_NeDel(o) then
				n = n + 1;
				TRF_NeE("orphan", "label", lb);
			end;
		end;
	end;
	return n;
end;

-- Refill of the memory record of system idx at entry (applied only here, never during a visit): the record goes when
-- k reaches 0; c is cleared once a step refilled.
function TRF_NeRefill(idx, nv)
	local r = TRF_NeRec(idx);
	if not r then return; end;
	local k, l, t = TRF_NeRefillOf(r.k, r.l, TRF_NeLegs(), nv, TRF_NeT("nest_regen_pct"), TRF_NeT("nest_regen_legs"));
	if t <= 0 then return; end;
	TRF_NeE("regen", "system", TRF_NeName(idx), "memory_before", r.k, "memory_after", k, "ticks", t);
	if k <= 0 then TRF.nest[idx] = nil; return; end;
	r.k = k; r.l = l; r.c = nil;
end;

-- E16.2 probe: live ships of team Pirates in the location (TRF_Near, cls 3..7), level 2; nothing without the native.
function TRF_NeProbe(at)
	if TRF_NeLog() < 2 or type(TRF_Near) ~= "function" then return; end;
	local l, via = TRF_Near(nil, nil, {cls={3, 4, 5, 6, 7}, alive=1});
	if type(l) ~= "table" then return; end;
	local n = 0;
	for i = 1, getn(l) do if l[i].team == "Pirates" then n = n + 1; end; end;
	TRF_NeDE("probe", "at", at, "pirates", n);
end;

function TRF_Nest_OnEnter()
	TRF_NeReset();
	if type(TRF) ~= "table" or not (type(TRF_Traffic) == "function" and TRF_Traffic()) then return; end;
	call(TRF_NeEnterBody, {}, "x", TRF_NeErr);
end;

-- Mode, refill, plan, arm (design 6 TRF_Nest_OnEnter). TRF.nv is rewritten at every entry (nil outside a nest visit).
function TRF_NeEnterBody()
	local ne = %NE;
	TRF.nv = nil;
	local cur = TRF_NeCur();
	if type(cur) ~= "number" then return; end;
	local nm = TRF_NeName(cur);
	local d = TRF_NeData(nm);
	if not d then
		TRF_NeDE("mode", "system", nm, "mode", "vanilla", "reason", "no_data");
		return;
	end;
	local nv = getn(d.f);
	TRF_NeOrphans(nv);
	TRF_NeRefill(cur, nv);
	local mode, why = TRF_NeMode(cur, nm, d);
	local slot, ph, T, sw = TRF_NeRegion(cur);
	local tn = TRF_NeTune();
	local f = TRF_NeFOf(ph or 0, sw, tn.nest_f, tn.nest_f_swept);
	local dp = tn.nest_dp[T or 1] or 0;
	local r = TRF_NeRec(cur);
	local k = 0;
	if r then k = r.k; end;
	local pins = 0;
	for i = 1, nv do if d.f[i].pin == 1 then pins = pins + 1; end; end;
	ne.v.info = {mode=mode, why=why or "ok", f=f, dp=dp, nv=nv, k=k};
	local lf = TRF_NeE;
	if why == "off" then lf = TRF_NeDE; end;
	lf("mode", "system", nm, "mode", mode, "reason", why or "ok", "phase", ph, "tier", T, "f", f, "dp", dp, "vanilla_count", nv,
		"memory", k, "pins", pins);
	if mode ~= "nest" then return; end;
	local P = TRF_NestPlanOf(d.f, f, k, dp, TRF_NeCaches(cur), tn.nest_cache_r);
	local by = {};
	for i = 1, nv do by[d.f[i].s] = i; end;
	ne.a = {on=1, gen=TRF_NeGen(), idx=cur, nm=nm, d=d, plan=P, by=by, dp=dp, st={}, fl={}, sb={}, van={}, unk=0, fail=0,
		mode=TRF_NeOpt("nest_mode"), slot=slot, ph=ph, sw=sw};
	TRF.nv = {i=cur, b=""};
	TRF_NeE("plan", "system", nm, "target", P.n, "fielded", P.nf, "skipped", nv - P.nf, "pins", P.pins, "mode", ne.a.mode,
		"plan", TRF_NeBitsOf(P.fl, nv));
	TRF_NeProbe("enter");
end;

-- Activation (TRF_OnActivate, after trf_safety) -------------------------------------------------------

-- Vanilla group of the visit (its global, else its name) and the relation toward the player both ways (after
-- activate.script, so system rules such as Golkonda's neutral-with-Triada carry over); the Pirates team relation
-- when the group has none.
function TRF_NeVanRel(g)
	local vg = getglobal(g);
	if not TRF_NeObj(vg) then vg = g; end;
	local to = TRF_NeGetRel(vg, PLAYER_GROUP);
	local from = TRF_NeGetRel(PLAYER_GROUP, vg);
	local tr = nil;
	if type(GetTeamRelation) == "function" then tr = call(GetTeamRelation, {"Pirates", PLAYER_TEAM}, "x", TRF_NeNoErr); end;
	if to == nil then to = tr; end;
	if from == nil then from = to; end;
	return to, from;
end;

-- Writes relations to and from to the nest group toward the player (the group handle of this visit, else its name).
function TRF_NeRelSet(v, to, from)
	local g = v.grp or TRF_NeK().grp;
	TRF_NeSetRel(g, PLAYER_GROUP, to);
	TRF_NeSetRel(PLAYER_GROUP, g, from);
	v.rel = to; v.relf = from;
end;

-- Labels, triggers (design 6): per flight one f_died; with nest_trig 2 per ship one died (scars, the flight-level
-- fallback) and one attack with PLAYER_GROUP (the mine flag). Ships labelled trf_nest_<i>_<j>.
function TRF_NeArm(v, i, fl, sign)
	local sh = TRF_NeShips(fl, sign);
	v.fl[i] = fl; v.sh[i] = sh; v.sd[i] = {};
	for j = 1, TRF_NeK().j_max do
		if TRF_NeObj(sh[j]) then TRF_N("SetObjectLabel", sh[j], "trf_nest_"..i.."_"..j); end;
	end;
	TRF_NeTrig("f_died", TRF_NeCb("TRF_Nest_Died", i), fl);
	if TRF_NeOpt("nest_trig") == 2 then
		for j = 1, TRF_NeK().j_max do
			if TRF_NeAlive(sh[j]) then
				TRF_NeTrig("died", TRF_NeCb("TRF_NeShipDied", i, j), sh[j]);
				TRF_NeTrig("attack", TRF_NeCb("TRF_NeHit", i), PLAYER_GROUP, sh[j]);
			end;
		end;
	end;
end;

-- Route of row r for Patrol: its static points, else the spawn point.
function TRF_NeRoute(r)
	local pts = {};
	if type(r.r) == "table" then
		for k = 1, getn(r.r) do local q = r.r[k]; tinsert(pts, Vector3(q[1], q[2], q[3])); end;
	end;
	if getn(pts) == 0 then tinsert(pts, Vector3(r.x, r.y, r.z)); end;
	return pts;
end;

function TRF_NePatrolRaw(fl, pts)
	fl:Patrol(pts, TRUE);
	return 1;
end;

-- nest_mode 2 (design 6 mechanism b): every recorded vanilla flight of an unpinned sign is deleted; the plan's
-- fielded unpinned signs are built again with the same sign in the nest group at the nest power from the static row
-- and patrol its static route. Pinned signs stay vanilla flights. Returns deleted, spawned.
function TRF_NeReplace(a)
	local nd, ns = 0, 0;
	local K = TRF_NeK();
	for i = 1, getn(a.d.f) do
		local r = a.d.f[i];
		if r.pin ~= 1 and a.van[i] then
			if TRF_NeAlive(a.van[i]) and TRF_NeDel(a.van[i]) then nd = nd + 1; end;
			if a.plan.fl[i] and TRF_NeGroup(a) then
				local fl = call(TRF_orig_NewPirateFlight, {K.gg, r.s, Vector3(r.x, r.y, r.z), r.t, a.plan.pw[i], Vector3(0, 0, 1)}, "x", TRF_NeNoErr);
				if TRF_NeObj(fl) then
					call(TRF_NePatrolRaw, {fl, TRF_NeRoute(r)}, "x", TRF_NeNoErr);
					a.fl[i] = fl; a.st[i] = "sub"; ns = ns + 1;
				else
					a.fail = a.fail + 1;
				end;
			end;
		end;
	end;
	TRF_NeE("replace", "system", a.nm, "deleted", nd, "spawned", ns);
	return nd, ns;
end;

-- Clears the stubs and the build global of visit a (every entry, also when the body failed). Returns the stubs left.
function TRF_NeClear(a)
	local left = 0;
	for s, sb in a.sb do
		if getglobal("flight_"..s) == sb then setglobal("flight_"..s, nil); end;
		if getglobal("flight_"..s) == sb then left = left + 1; end;
	end;
	setglobal(TRF_NeK().gg, nil);
	return left;
end;

function TRF_Nest_OnActivate()
	local ne = %NE;
	local a = ne.a;
	if type(a) ~= "table" then setglobal(TRF_NeK().gg, nil); return; end;
	a.on = nil;
	call(TRF_NeActBody, {a}, "x", TRF_NeErr);
	local left = TRF_NeClear(a);
	TRF_NeE("activate", "system", a.nm, "fielded", ne.v.nf or 0, "stub", ne.v.ns or 0, "gone", ne.v.ng or 0, "unknown", a.unk,
		"missing", ne.v.nmis or 0, "failed", a.fail, "relation", TRF_NeRelName(ne.v.rel), "stub_left", left, "mode", a.mode);
	TRF_NeProbe("activate");
	ne.a = nil;
end;

-- Disarm, replace (mode 2), gone flights, labels and triggers, relations, TRF.nv, counters, the arrival line.
function TRF_NeActBody(a)
	local v = %NE.v;
	if a.mode == 2 then TRF_NeReplace(a); end;
	v.idx = a.idx; v.nm = a.nm; v.d = a.d; v.slot = a.slot; v.grp = a.grp;
	local nv = getn(a.d.f);
	local nf, ng, nmiss, ns = 0, 0, 0, 0;
	local bits = {};
	for i = 1, nv do
		if a.st[i] == "stub" then ns = ns + 1; end;
		if a.plan.fl[i] and not a.st[i] and a.mode ~= 2 then nmiss = nmiss + 1; end;
		local fl = a.fl[i];
		if fl then
			if TRF_NeAlive(fl) then
				TRF_NeArm(v, i, fl, a.d.f[i].s);
				bits[i] = 1;
				nf = nf + 1;
				TRF_NeCount("n");
			else
				-- Removed by the location script (Pandora after mission 8a): gone, no kill.
				v.gone[i] = 1;
				ng = ng + 1;
			end;
		end;
	end;
	v.nf = nf; v.ns = ns; v.ng = ng; v.nmis = nmiss;
	TRF.nv = {i=a.idx, b=TRF_NeBitsOf(bits, nv)};
	local to, from = TRF_NeVanRel(a.d.g);
	TRF_NeRelSet(v, to, from);
	v.arr = {idx=a.idx, nm=a.nm, slot=a.slot, ph=a.ph, sw=a.sw, nf=nf};
end;

-- Arrival line of this entry (traffic.script, after trf_freight's activate hook: the nest line is the last mod line of
-- the 00 order, wb-plumbing-spec 5), once.
function TRF_Nest_Arrival()
	local v = %NE.v;
	local a = v.arr;
	v.arr = nil;
	if type(a) == "table" then call(TRF_NeArrival, {a, a.nf}, "x", TRF_NeErr); end;
end;

-- At most one arrival line (design 6): the memory line, else the phase line once per phase; never during a mission,
-- cfg nest_lines 0 none.
function TRF_NeArrival(a, nf)
	if TRF_NeOpt("nest_lines") ~= 1 or TRF_NeQuest() then return; end;
	local c = TRF_NeClan(a.slot);
	local nl = nil;
	if c then nl = c.nl; end;
	local key, set = TRF_NeLineOf(TRF_NeRec(a.idx), nf, a.ph or 0, nl, a.sw, TRF_NeK());
	if not key then return; end;
	local text = TRF_NeTxt(key, TRF_NeClanName(a.slot));
	local ok = nil;
	if type(TRF_ArrivalLine) == "function" then ok = TRF_ArrivalLine("nest", text); else ok = TRF_NeSay(text); end;
	if ok and set and c then c.nl = set; end;
	TRF_NeDE("arrival", "system", a.nm, "line", key, "result", ok and "queued" or "dropped");
end;

-- Callbacks ------------------------------------------------------------------------------------

function TRF_Nest_Died(i, g)
	if type(TRF_Cb) == "function" then TRF_Cb("TRF_Nest_Died", TRF_NeDiedBody, {i, g}); else TRF_NeDiedBody(i, g); end;
end;

function TRF_NeDiedBody(i, g)
	if g ~= TRF_NeGen() then TRF_NeE("stale", "index", i, "generation", g, "current", TRF_NeGen()); return; end;
	TRF_NeFlightDead(i, "died");
end;

function TRF_NeShipDied(i, j, g)
	if type(TRF_Cb) == "function" then TRF_Cb("TRF_NeShipDied", TRF_NeShipDiedBody, {i, j, g}); else TRF_NeShipDiedBody(i, j, g); end;
end;

-- A nest ship died: battle scars source 7 with the mine flag of its flight; the last ship of a flight whose f_died
-- did not fire yet ends the flight (flight-level fallback).
function TRF_NeShipDiedBody(i, j, g)
	if g ~= TRF_NeGen() then return; end;
	local v = %NE.v;
	if v.del == 1 or type(v.sd[i]) ~= "table" or v.sd[i][j] then return; end;
	v.sd[i][j] = 1;
	local mine = nil;
	if v.hit[i] then mine = 1; end;
	TRF_P("TRF_Sc_Dead", 3, 0, v.sh[i][j], mine);
	local all = 1;
	for k = 1, TRF_NeK().j_max do
		if TRF_NeObj(v.sh[i][k]) and not v.sd[i][k] and TRF_NeAlive(v.sh[i][k]) then all = nil; end;
	end;
	if all then TRF_NeFlightDead(i, "ships"); end;
end;

function TRF_NeHit(i, g)
	if type(TRF_Cb) == "function" then TRF_Cb("TRF_NeHit", TRF_NeHitBody, {i, g}); else TRF_NeHitBody(i, g); end;
end;

-- Player-group fire on a ship of flight i (the attack trigger): the mine flag; the first hit of the visit gives the
-- leader's radio line (#TRF_Nest_Hit).
function TRF_NeHitBody(i, g)
	if g ~= TRF_NeGen() then return; end;
	local v = %NE.v;
	if not v.fl[i] or v.hit[i] then return; end;
	v.hit[i] = 1;
	TRF_NeDE("hit", "index", i);
	if v.said == 1 or TRF_NeOpt("nest_lines") ~= 1 or TRF_NeQuest() then return; end;
	v.said = 1;
	local p = call(TRF_NeLeaderRaw, {v.fl[i]}, "x", TRF_NeNoErr);
	if not TRF_NeObj(p) then p = nil; end;
	TRF_NeSay(TRF_NeTxt("nesthit", TRF_NeClanName(v.slot)), TRF_NeK().hit_secs, p);
end;

-- Flight i destroyed (f_died, or every ship dead): kill memory + 1 (at most the vanilla count), clan score -2 inside the
-- visit cap (with player fire through trf_events' TRF_Ev_Recover: also dis -1 inside its visit cap and clan nk + 1),
-- the counters, TRF.nv bit cleared; the last fielded flight gives the screen line and c (player fire). Ignored after the
-- jump delete and for a flight already counted.
function TRF_NeFlightDead(i, why)
	local v = %NE.v;
	if v.del == 1 or not v.fl[i] or v.dead[i] or type(v.d) ~= "table" then return; end;
	v.dead[i] = 1;
	local idx, nv = v.idx, getn(v.d.f);
	if type(TRF.nest) ~= "table" then TRF.nest = {}; end;
	local r = TRF_NeRec(idx);
	if not r then r = {k=0, l=TRF_NeLegs()}; TRF.nest[idx] = r; end;
	r.k = min(nv, r.k + 1);
	local mine = v.hit[i];
	local K = TRF_NeK();
	if mine and type(TRF_Ev_Recover) == "function" then
		TRF_Ev_Recover("nest", 0);
	elseif type(v.slot) == "number" then
		TRF_N("TRF_ClanAdd", v.slot, K.score, "nest kill");
	end;
	if mine then
		local c = TRF_NeClan(v.slot);
		if c then c.nk = min(K.nk_max, (c.nk or 0) + 1); end;
		TRF_NeCount("p");
	end;
	TRF_NeCount("k");
	if type(TRF.nv) == "table" and TRF.nv.i == idx and type(TRF.nv.b) == "string" and strlen(TRF.nv.b) >= i then
		TRF.nv.b = strsub(TRF.nv.b, 1, i - 1).."0"..strsub(TRF.nv.b, i + 1);
	end;
	local left = 0;
	for k, f in v.fl do if type(k) == "number" and not v.dead[k] and not v.gone[k] then left = left + 1; end; end;
	if left == 0 then
		if mine then r.c = 1; else r.c = nil; end;
		if mine and TRF_NeOpt("nest_lines") == 1 and not TRF_NeQuest() then TRF_NeSay(TRF_NeTxt("nestlast", TRF_NeClanName(v.slot))); end;
	end;
	local c = TRF_NeClan(v.slot);
	TRF_NeE("died", "index", i, "sign", v.d.f[i].s, "mine", TRF_KvB(mine), "memory", r.k, "left", left, "clan_score", c and c.sc,
		"generation", TRF_NeGen(), "reason", why);
end;

-- 1 s step, jump, load --------------------------------------------------------------------------

-- Every 1 s (traffic.script): the relation mirror (nest_mirror 1): a change of the vanilla group's relation to the
-- player is copied to the nest group, one way; nothing while __disableAction is set.
function TRF_Nest_Step()
	local v = %NE.v;
	if type(v.d) ~= "table" or v.del == 1 or __disableAction == TRUE or TRF_NeOpt("nest_mirror") ~= 1 then return; end;
	call(TRF_NeStepBody, {v}, "x", TRF_NeErr);
end;

function TRF_NeStepBody(v)
	local to, from = TRF_NeVanRel(v.d.g);
	if to == v.vto and from == v.vfrom then return; end;
	local first = v.vto == nil;
	v.vto = to; v.vfrom = from;
	if first and to == v.rel and from == v.relf then return; end;
	local old = v.rel;
	TRF_NeRelSet(v, to, from);
	TRF_NeE("relation", "system", v.nm, "from", TRF_NeRelName(old), "to", TRF_NeRelName(to));
end;

-- Before every jump: every live nest flight is deleted (no death event, the del flag), the visit state and TRF.nv go
-- (debug cfg nest_keep_on_jump 1 keeps the ships, E16.2).
function TRF_Nest_BeforeJump()
	local v = %NE.v;
	if type(v.d) == "table" then
		v.del = 1;
		local n = 0;
		if TRF_NeOpt("nest_keep_on_jump") ~= 1 then
			for i, fl in v.fl do
				if type(i) == "number" and not v.dead[i] and TRF_NeAlive(fl) and TRF_NeDel(fl) then n = n + 1; end;
			end;
		end;
		TRF_NeE("jump", "system", v.nm, "deleted", n);
	end;
	setglobal(TRF_NeK().gg, nil);
	if type(TRF) == "table" then TRF.nv = nil; end;
	TRF_NeReset();
end;

-- Load inside a system (activate.script does not run): the flights of TRF.nv are adopted by their saved globals
-- (flight_<sign>, ship_<sign>_<j>), labels and triggers re-armed with the new gen, the relation mirror resumed;
-- nothing is spawned or refilled.
function TRF_Nest_OnLoad()
	TRF_NeReset();
	setglobal(TRF_NeK().gg, nil);
	if not TRF_NeOn() or type(TRF.nv) ~= "table" then return; end;
	call(TRF_NeLoadBody, {}, "x", TRF_NeErr);
end;

function TRF_NeLoadBody()
	local v = %NE.v;
	local nv = TRF.nv;
	local cur = TRF_NeCur();
	if nv.i ~= cur or type(nv.b) ~= "string" then TRF.nv = nil; return; end;
	local nm = TRF_NeName(cur);
	local d = TRF_NeData(nm);
	if not d then TRF.nv = nil; return; end;
	local slot = TRF_NeRegion(cur);
	v.idx = cur; v.nm = nm; v.d = d; v.slot = slot;
	local n = 0;
	local bits = {};
	for i = 1, min(strlen(nv.b), getn(d.f)) do
		if strsub(nv.b, i, i) == "1" then
			local fl = getglobal("flight_"..d.f[i].s);
			if TRF_NeAlive(fl) then
				TRF_NeArm(v, i, fl, d.f[i].s);
				bits[i] = 1;
				n = n + 1;
			end;
		end;
	end;
	nv.b = TRF_NeBitsOf(bits, getn(d.f));
	v.nf = n;
	v.rel, v.relf = TRF_NeVanRel(d.g);
	v.vto = v.rel; v.vfrom = v.relf;
	TRF_NeE("load", "system", nm, "rearmed", n);
end;

-- Phase entry of region slot (trf_region TRF_RgEnter): nk cleared at Quiet, the won-sweep target cleared once the
-- region leaves Bust (Recovery and later).
function TRF_Nest_Phase(slot, ph)
	local c = TRF_NeClan(slot);
	if not c then return; end;
	if ph == 0 then c.nk = nil; end;
	if ph ~= 3 and ph ~= 4 then c.ns = nil; end;
end;

-- Sweep outcome of slot (trf_region TRF_RgSweepOut): a success marks the sweep target (trf_faction TRF_SweepTarget)
-- for the Bust count nest_f_swept.
function TRF_Nest_Sweep(slot, L, won)
	if not won then return; end;
	local c = TRF_NeClan(slot);
	local t = TRF_N("TRF_SweepTarget", slot);
	if c and type(t) == "number" then
		c.ns = t;
		TRF_NeDE("sweep", "region", slot, "target", TRF_NeName(t));
	end;
end;

-- Contract: plumbing, other modules, repair, defaults, dump, text -----------------------------------------

-- trf_plumb TRF_InstallPlumb: the ship-cap group (never trimmed; counted only with tune nest_cap 1, V3).
function TRF_Nest_Plumb()
	TRF_CapReg("nest", "TRF_Nest_Ships");
end;

-- Live fielded ships of this visit.
function TRF_Nest_Alive()
	local v = %NE.v;
	if type(v.d) ~= "table" or v.del == 1 then return 0; end;
	local n = 0;
	for i, sh in v.sh do
		if type(i) == "number" and not v.dead[i] then
			for j = 1, TRF_NeK().j_max do if TRF_NeAlive(sh[j]) then n = n + 1; end; end;
		end;
	end;
	return n;
end;

-- Ship-cap count (trf_plumb TRF_CapShips): 0 with tune nest_cap 0 (default; nest ships replace vanilla ships, which
-- never counted, design 6 spawn rules), else the live nest ships.
function TRF_Nest_Ships(g)
	if TRF_NeT("nest_cap") ~= 1 then return 0; end;
	return TRF_Nest_Alive();
end;

-- 1 when fl is a fielded flight of this visit (trf_events' pirate watch leaves it out: the nest counts its kills).
function TRF_Nest_Owns(fl)
	local v = %NE.v;
	if fl == nil or type(v.fl) ~= "table" then return nil; end;
	for i, f in v.fl do if f == fl then return 1; end; end;
	return nil;
end;

-- The nest group of this visit for the sweep and Triada wave relations (trf_faction, trf_convoy): the handle while
-- held, else the name; nil without fielded flights.
function TRF_Nest_Grp()
	local v = %NE.v;
	if type(v.d) ~= "table" or v.del == 1 or (v.nf or 0) == 0 then return nil; end;
	if TRF_NeObj(v.grp) then return v.grp; end;
	return TRF_NeK().grp;
end;

-- Repair (TRF_Repair, every entry and load): TRF.nest a table of records {k 1..nv, l <= now, c 1 or nil} keyed by the
-- index of a system with static data; TRF.nv {i, b} with a 0/1 string of at most nv characters; TRF.nst {n, k, p}
-- 0..99999; clan nk 0..99, nl 0..7, ns a system index.
function TRF_Nest_Fix()
	if type(TRF) ~= "table" then return; end;
	local legs = TRF_NeLegs();
	local K = TRF_NeK();
	if TRF.nest ~= nil then
		local out = {};
		if type(TRF.nest) == "table" then
			for idx, e in TRF.nest do
				if type(idx) == "number" and type(e) == "table" then
					local d = TRF_NeData(TRF_NeName(idx));
					if d and TRF_NeNum(e.k, 1, getn(d.f)) then
						local r = {k=floor(e.k), l=legs};
						if TRF_NeNum(e.l, -99999, legs) then r.l = floor(e.l); end;
						if e.c == 1 then r.c = 1; end;
						out[idx] = r;
					end;
				end;
			end;
		end;
		TRF.nest = out;
	end;
	if TRF.nv ~= nil then
		local x = TRF.nv;
		local ok = nil;
		if type(x) == "table" and type(x.i) == "number" and type(x.b) == "string" then
			local d = TRF_NeData(TRF_NeName(x.i));
			if d and strlen(x.b) <= getn(d.f) and not strfind(x.b, "[^01]") then ok = 1; end;
		end;
		if not ok then TRF.nv = nil; end;
	end;
	if TRF.nst ~= nil then
		local x = TRF.nst;
		if type(x) ~= "table" then x = {}; end;
		local o = {};
		for i, k in {"n", "k", "p"} do
			if TRF_NeNum(x[k], 0, K.cnt_max) then o[k] = floor(x[k]); else o[k] = 0; end;
		end;
		TRF.nst = o;
	end;
	if type(TRF.clan) == "table" then
		for k, c in TRF.clan do
			if type(c) == "table" then
				if c.nk ~= nil and not TRF_NeNum(c.nk, 0, K.nk_max) then c.nk = nil; end;
				if c.nl ~= nil and not TRF_NeNum(c.nl, 0, K.swept_nl) then c.nl = nil; end;
				if c.ns ~= nil and not TRF_NeNum(c.ns, 1, 999) then c.ns = nil; end;
			end;
		end;
	end;
end;

-- Config keys (design 6 config). nest 0 until E16.1-E16.5 pass; nest_mode 1 the substituting wrapper, 2 the fallback;
-- nest_off system names kept vanilla; nest_trig 2 per ship died and attack triggers, 1 the flight-level f_died only
-- (E16.8); nest_lines the arrival, radio and screen lines; nest_mirror the 1 s relation mirror; nest_grudge_war step 2
-- (00 E2) and read nowhere; nest_keep_on_jump debug (E16.2).
function TRF_Nest_OptDef()
	return {nest=0, nest_mode=1, nest_off={}, nest_trig=2, nest_lines=1, nest_mirror=1, nest_grudge_war=0, nest_keep_on_jump=0};
end;

-- Tune keys (design 6 config): nest_f % per phase (Quiet, Boom, Build-up, Raids, Bust, Recovery), nest_f_swept % in the
-- sweep target during Bust, nest_dp power per tier T1..T4, nest_regen_pct % of the vanilla count back per
-- nest_regen_legs legs, nest_cache_r (plus the route radius) from an unopened cache, nest_grudge_nk step 2 (read nowhere),
-- nest_cap 1 counts the nest ships in cap_ships (V3).
function TRF_Nest_TuneDef()
	return {nest_f={70, 100, 100, 100, 50, 70}, nest_f_swept=0, nest_dp={-1, 0, 1, 1}, nest_regen_pct=15, nest_regen_legs=2,
		nest_cache_r=600, nest_grudge_nk=5, nest_cap=0};
end;

-- Debug dump (design 6): records idx:k/l, the visit idx:bits, nk per clan slot, the counters, this visit's mode.
function TRF_Nest_Dump()
	if type(TRF) ~= "table" then return; end;
	local rs, n = nil, 0;
	if type(TRF.nest) == "table" then
		local ks = {};
		for idx, r in TRF.nest do if type(idx) == "number" then tinsert(ks, idx); end; end;
		sort(ks);
		for q = 1, getn(ks) do
			local r = TRF.nest[ks[q]];
			n = n + 1;
			local s = ks[q]..":"..tostring(r.k).."/"..tostring(r.l);
			if rs then rs = rs..","..s; else rs = s; end;
		end;
	end;
	local vs = nil;
	if type(TRF.nv) == "table" then vs = tostring(TRF.nv.i)..":"..tostring(TRF.nv.b); end;
	local cs = "";
	if type(TRF.clan) == "table" then
		for s = 1, 11 do
			local c = TRF.clan[s];
			if type(c) == "table" then
				if cs ~= "" then cs = cs..","; end;
				cs = cs..tostring(c.nk or 0);
			end;
		end;
	end;
	local x = TRF.nst or {};
	local info = %NE.v.info or {};
	TRF_NeE("dump", "record_count", n, "records", rs, "visit", vs, "clans", "nk:"..cs, "counters",
		"n:"..(x.n or 0)..",k:"..(x.k or 0)..",p:"..(x.p or 0), "mode", info.mode, "reason", info.why, "alive", TRF_Nest_Alive());
end;

-- Texts (design 2, 6 text keys), EN; keys in TRF_UI_Key form (#TRF_nest<name> in loc/trf_en.loc). $1 the clan name, in
-- parentheses so the loc_mode 1 scaffold reads without it (TDR 13.5 CombineStr fallback). Step 2 keys (Board, Cap) are
-- not defined yet.
function TRF_Nest_Text()
	return {
		nestfull = "The pirate nest here ($1) is crowded. Ships are gathering.",
		nestraid = "The pirate nest here ($1) is armed and restless.",
		nesthurt = "The pirate nest here ($1) is still licking its wounds.",
		nestclear = "The pirate nest here is empty. Someone cleared it out.",
		nestbust = "Pirate wrecks on the scanner. The nest here ($1) took a beating.",
		nestswept = "The patrol swept the pirate nest here ($1) clean.",
		nestquiet = "Only a few pirate ships ($1) at the nest here.",
		nesthit = "We ($1) don't forget a face, Wolf.",
		nestlast = "The pirate nest here ($1) is broken. They will be back.",
	};
end;

