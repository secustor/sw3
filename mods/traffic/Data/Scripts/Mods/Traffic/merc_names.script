-- Generated by tools/gen_pilots.py from merge/pilot_names.json; do not edit (rerun the tool). Placeholder names
-- (design/proposals/merc-pilot-names.md 5). The template names exist only with the Pilots.xml merge of
-- install.sh --pilots (cfg mc_names 2); without it CreatePilot of a TRF_McP_ name returns no pilot and
-- TRF_BuildFlight's ov argument falls back to the row's template (trf_tier.script). Static data: the function
-- returns a new table on each call, so nothing of it is in the save.

-- Names per clan key (RecruitAce_<clan>): slot 0 the leader, slots 1-4 the aces; entry 2 x slot + gen + 1.
function TRF_Mc_Names()
	return {
		angelrevenge = {"Rafe", "Jonah", "Mika", "Tobin", "Elan", "Noor", "Dario", "Sami", "Lev", "Ilan"},
		apocalypserider = {"Pale Rider", "Gravedigger", "Widowmaker", "Carrion", "Dirge", "Shroud", "Tombstone", "Last Rites", "Hearse", "Buzzard"},
		blacklegion = {"Legate Varro", "Legate Cassius", "Corvus", "Sabinus", "Drusus", "Marcellus", "Scaevola", "Nerva", "Galba", "Tullus"},
		fireaxe = {"Cleaver", "Firebrand", "Flint", "Clinker", "Splitter", "Sledge", "Scorch", "Ashfall", "Crusher", "Kindling"},
		goldgrifon = {"Argent", "Sable", "Vert", "Gules", "Saltire", "Chevron", "Pennant", "Tressure", "Mantling", "Fess"},
		kimmeria = {"Brann", "Gorm", "Vark", "Ulfar", "Skarn", "Hrok", "Bodvar", "Ketil", "Torvik", "Drak"},
		kismet = {"Lucky Seven", "Windfall", "Clover", "Horseshoe", "Wildcard", "Snake Eyes", "Royal Flush", "Long Odds", "Lodestar", "Fortuna"},
		morgenstern = {"Kessler", "Wendt", "Falk", "Lorenz", "Hager", "Rauch", "Seidel", "Ebert", "Kranz", "Vogt"},
		nomads = {"Idris", "Malik", "Tamir", "Yusuf", "Oren", "Kasim", "Anwar", "Zaid", "Rafiq", "Hamid"},
		shinegard = {"Aldous Vane", "Edmund Royce", "Cedric Ashby", "Julian Pell", "Lionel Crewe", "Rowan Ellery", "Ambrose Marsh", "Percival Lund", "Oswin Pryce", "Tristan Hale"},
		stardragoon = {"Major Osten", "Major Calder", "Harlan", "Reyes", "Keel", "Lindqvist", "Voss", "Halloran", "Brandt", "Okafor"},
		stardust = {"Hippolyta", "Otrera", "Antiope", "Thalestris", "Melanippe", "Myrina", "Lysippe", "Areto", "Penthesilea", "Klonie"},
	};
end;

-- Template of a clan slot in the Pilots.xml merge and its plain-text name, for example
-- TRF_McName("blacklegion", 0, 1) = "TRF_McP_blacklegion_0_1", "Legate Cassius". clan = the key of RecruitAce_<clan>,
-- slot 0..4, gen 0 or 1 (the slot's death count mod 2, proposal 5.1). nil for anything else.
function TRF_McName(clan, slot, gen)
	if type(clan) ~= "string" or type(slot) ~= "number" or type(gen) ~= "number" then return nil; end;
	if slot < 0 or slot > 4 or floor(slot) ~= slot or (gen ~= 0 and gen ~= 1) then return nil; end;
	local t = TRF_Mc_Names()[clan];
	if type(t) ~= "table" then return nil; end;
	return format("TRF_McP_%s_%d_%d", clan, slot, gen), t[2 * slot + gen + 1];
end;
