-- sw3-traffic v0.1 player-facing text (v01-spec 8): output (8.1), templates (8.2), focus line with
-- proximity fallback (8.3), arrival line (8.4, S20). v0.2 (v02-spec 6.1, 8.2, 9.6): meet 2 announce and hail
-- arm, text lookup in every module's TRF_<M>_Text(), tier, sweep and prosperity arrival lines, news state and
-- bulletin. Top level only defines functions; state is in TRF.live (met per trader, line, arr, nbs) and in
-- TRF.news / TRF.newsx (saved). Log prefix "ui".
-- v1 (v1-spec 6.2, 6.3, 9.3, 10.2, 10.4): TRF_Txt asks the loc layer first (trf_loc TRF_LocTxt, cfg loc_mode),
-- arrival line with T3/T4 words, carrier line, base radio line and the base as sweep target; focus line with
-- faction convoys, danger convoy members, the tracked "seen in" suffix and salvaged pirate ships; news topics
-- war (regional) and feq (global). v1 state is read from TRF.base, TRF.lr, TRF.clan[slot].sv/sf and TRF.feq.
-- Other modules are reached by name and type-checked, so a missing one only disables a feature.

-- Strings ---------------------------------------------------------------------------

-- English strings; a localisation file replaces only this function. Keys are looked up after
-- TRF_UI_Key (lowercase, letters and digits only), so "dir_a", "dirA" and "DIR A" are the same key.
-- $1..$3 are the arguments a, b, c of TRF_Txt.
function TRF_UI_Text()
	return {
		owner = "FTU",
		hull1 = "freighter",
		hull2 = "freighters",
		who = "$1 $2 $3",                       -- owner, hull word, name
		whononame = "$1 $2",                    -- owner, hull word
		station = "trade station",
		unknown = "unknown space",
		cls0 = "cargo",
		cls1 = "machinery",
		cls2 = "spare parts",
		cls3 = "ore and uranium",
		cls4 = "fuel",
		cls5 = "perishables",
		cls6 = "general freight",
		dira = "$1 -> trade station",           -- path A: origin system
		dirb = "trade station -> $1",           -- path B: destination system
		dirc = "$1 -> $2",                      -- path C: origin, destination
		dirret = "returning to $1",             -- path C, same system at both ends
		focus = "$1: $2, $3",                   -- who, cargo, direction
		arr1 = "FTU reports raids on the lanes in this system",
		arr2 = "FTU reports heavy raids on the lanes in this system",
		arr3 = "FTU reports severe raids in this system; traders fly only under escort",
		cease = "Cease fire! This is a civilian freighter.",
		ceasefire = "Cease fire! This is a civilian freighter.",
		-- v0.2 arrival lines (v02-spec 9.6): band templates with the effective-tier word, sweep, prosperity.
		arrt1 = "FTU reports $1 on the lanes in this system",
		arrt2 = "FTU reports heavy raids by $1 in this system",
		arrt3 = "FTU reports severe raids by $1 in this system; traders fly only under escort",
		pirw1 = "scavengers",
		pirw2 = "pirate gangs",
		pirw3 = "pirate packs",
		pirw4 = "raiders",
		arrsweep = "$1 fleet expected; pirates dug in here",   -- faction
		arrpro1 = "FTU: busy lanes in this system",
		arrpro2 = "FTU: trade hub, convoys run here",
		facvks = "MSF",
		fackfni = "New Empire",
		factriada = "Triada",
		facuss = "USS",
		facinoco = "InoCo",
		facmerc = "FTU mercenaries",
		-- Raid lines (copies of TRF_Raid_Text): TRF_Rd_Txt routes keys found here through TRF_Txt, so the loc
		-- layer covers them.
		sos = "FTU $1: pirates on us, any ship assist!",
		demand = "$1: Cut your engines and drop cargo, trader.",
		comply = "FTU $1: Cargo released. Don't shoot.",
		flee = "FTU $1: Breaking off, heading for $2.",
		thanks = "FTU $1: Thank you, Wolves. We owe you.",
		fleegate = "the jump gate",
		clan0 = "Pirates",
		noname = "freighter",
		-- v1 arrival lines (v1-spec 6.1, 6.2, 9.3): tier words, carrier target, base radio.
		packs = "pirate packs",
		raiders = "raiders",
		arrivecarrier = "FTU reports $1 carriers raiding in this system",   -- clan
		baseradiowar = "Pirate base: Wolves on scope. Burn them!",
		baseradiotrade = "Pirate base: trade or move on, Wolves.",
		-- v1 focus line (4.3, 5.1, 6.3, 8.5).
		hullconv = "supply transport",
		inconvoy = "$1, in convoy",                     -- focus text
		seenin = "seen in $1",                          -- system
		seenline = "$1 ($2)",                           -- focus text, seenin
		metagain = "Wolves again. We remember you.",
		salvcap = "Pirate in a captured $1 $2",         -- faction, salvfighter / salvcorvette
		salvgear = "Pirate fighter with $1 gear",       -- faction
		salvfighter = "fighter",
		salvcorvette = "corvette",
		-- News (v02-spec 8.2): key n<topic><variant>; $1 home display name, $2 clan, $3 faction.
		nbull = "FTU bulletin: $1",
		nheat5 = "FTU warns captains about the Wolves",
		nheat7 = "FTU blacklists the Wolves",
		nhelp5 = "FTU thanks the Wolves",
		nhelp15 = "FTU names the Wolves friends of the union",
		nshorton = "Shortages reported at trade stations",
		nlaneraid = "Raids on trade lanes rising near $1",
		nlanequiet = "Lanes quiet again near $1",
		ntradeboom = "Trade booming near $1",
		ntradebust = "Trade collapsing near $1",
		npirmass = "$2 massing near $1",
		npirback = "$2 driven back near $1",
		nsweepgather = "$3 gathers a fleet against pirates near $1",
		nsweepfail = "$3 sweep near $1 beaten back",
		nsweepwin = "$3 clears pirates near $1",
		-- Wanted captains (captain-spec 5.2): regional cap/<variant>, $4 the captain's name (TRF_Cap_NameOf). EN only.
		ncaphide = "$2 captain $4 has gone to ground near $1",
		ncapout = "$2 captain $4 is back on the lanes near $1",
		ncapsucc = "$4 now leads the $2 near $1",
		-- Wolves Freight (freight-spec 5.8): global fw/reg at the first charter, regional fw/lost on a loss. EN only.
		nfwreg = "FTU registers Wolves Freight",
		nfwlost = "Wolves Freight hull lost near $1",
		-- v1 news (v1-spec 3.1): regional war/<variant>[_<f>], global feq/<variant>_<f>. Regional $1 home,
		-- $2 clan, $3 faction of the variant; global $1 faction.
		nwarsalv2 = "Pirates near $1 fly captured $3 fighters",
		nwarsalv3 = "Pirates near $1 fly captured $3 corvettes",
		nwarbase = "$2 set up a pirate base near $1",
		nwarbasex = "Lanes around $1 are safe again",
		nwarcar = "$2 carriers raid the lanes near $1",
		nfeqkill = "$1 equipment convoy destroyed; FTU blames the Wolves",
		nfeqlost = "$1 equipment convoy lost to pirates",
		-- cfg ui_keys = 1: pre-authored loc keys (design 8.1) instead of plain strings.
		keyarr = "#TRF_ArriveDis_$1",           -- band
		keyfocus = "#TRF_Focus_$1_$2",          -- cargo class 0..6, path A/B/C
	};
end;

function TRF_UI_Key(key)
	local k = gsub(strlower(tostring(key)), "[^%w]", "");
	return k;
end;

-- Escape % in a replacement string for gsub.
function TRF_UI_Esc(s)
	local r = gsub(s, "%%", "%%%%");
	return r;
end;

-- Text tables searched after TRF_UI_Text when trf_loc is not loaded (v02-spec 6.2, 10.2; v1 modules as in
-- TRF_Loc_TextFns); missing modules are skipped.
function TRF_UI_TextFns()
	return {"TRF_Hail_Text", "TRF_Raid_Text", "TRF_Rg_Text", "TRF_Tier_Text", "TRF_Shop_Text", "TRF_Track_Text",
		"TRF_Supply_Text", "TRF_Clan_Text", "TRF_Faction_Text", "TRF_Convoy_Text", "TRF_Danger_Text", "TRF_Base_Text",
		"TRF_Stn_Text", "TRF_Sv_Text", "TRF_Lad_Text", "TRF_Ch_Text", "TRF_Sc_Text", "TRF_Cap_Text", "TRF_Sh_Text", "TRF_Fr_Text",
		"TRF_Haunt_Text", "TRF_Pc_Text", "TRF_Mc_Text", "TRF_Wq_Text", "TRF_Wn_Text"};
end;

-- One logfmt event line of module ui (design/log-format.md 5).
function TRF_UiE(event, ...) tinsert(arg, 1, event); tinsert(arg, 1, "ui"); call(TRF_Lf, arg); end;

function TRF_UI_TxtErr(m) TRF_UiE("text_table_error", "message", tostring(m)); end;

-- String of a normalised key, or nil: the loc layer (trf_loc, language and merged tables), else the
-- tables here. A table function that fails is skipped.
function TRF_UI_Find(k)
	if type(TRF_LocTxt) == "function" then
		local l = call(TRF_LocTxt, {k}, "x", TRF_UI_TxtErr);
		if type(l) == "string" then return l; end;
	end;
	local s = TRF_UI_Text()[k];
	if type(s) == "string" then return s; end;
	local fs = TRF_UI_TextFns();
	for i = 1, getn(fs) do
		local f = getglobal(fs[i]);
		if type(f) == "function" then
			local t = call(f, {}, "x", TRF_UI_TxtErr);
			if type(t) == "table" and type(t[k]) == "string" then return t[k]; end;
		end;
	end;
	return nil;
end;

-- Template key -> string with $1..$4 replaced. An unknown key returns the key itself (logged).
-- cfg loc_mode 1 (trf_loc): the scaffold key "#TRF_<key>" instead, arguments dropped (CHECK E0.6; lines
-- joined from several keys then show several keys).
function TRF_Txt(key, a, b, c, d)
	if type(TRF_Loc_Mode) == "function" and TRF_Loc_Mode() == 1 and type(TRF_LocKeyOf) == "function" then
		local lk = TRF_LocKeyOf(key);
		if lk then return lk; end;
	end;
	local s = TRF_UI_Find(TRF_UI_Key(key));
	if type(s) ~= "string" then
		TRF_UiE("text", "key", key, "result", "unknown_key");
		return tostring(key);
	end;
	local v = {a, b, c, d};
	for i = 1, 4 do
		if strfind(s, "$"..i, 1, 1) then
			s = gsub(s, "%$"..i, TRF_UI_Esc(tostring(v[i] or "")));
		end;
	end;
	return s;
end;

-- Helpers ---------------------------------------------------------------------------

-- Display constants without a cfg key: focus line 6 s and 6 s apart (8.3); arrival line length.
function TRF_UI_Const()
	return {secs=6, gap=6, arr_secs=8};
end;

-- cfg value through TRF_Opt (trf_state), else the raw config, else def.
function TRF_UI_Opt(key, def)
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil then v = TRF_Cfg()[key]; end;
	if v == nil then v = def; end;
	return v;
end;

-- Tune value: TRF_Tune, else the v1 table (trf_loc), else def.
function TRF_UI_Tune(key, def)
	if type(TRF_Tune) == "function" then
		local t = TRF_Tune();
		if type(t) == "table" and type(t[key]) == "number" then return t[key]; end;
	end;
	if type(TRF_V1_TuneDef) == "function" then
		local v = TRF_V1_TuneDef()[key];
		if type(v) == "number" then return v; end;
	end;
	return def;
end;

-- Line break for text shown in a message box or dialog. The engine's ShowMsgBox has no glyph for the byte
-- "\n": the renderer draws the whole font atlas in its place (playtest 2026-10-25, ladder permit box). Vanilla
-- texts use "|", which the exe turns into a line break in the widgets that split lines and into a space elsewhere
-- (ship-asset-pipeline.md 4.5). Never join "\n" into player-visible text; modules join TRF_Br() (traffic.script, a
-- space without trf_ui). Tune ui_br (number, trf_loc TRF_V1_TuneDef): 1 = "|" (default), 0 = " " (safe fallback
-- when "|" shows up literally).
function TRF_UI_Br()
	if TRF_UI_Tune("ui_br", 1) == 0 then return " "; end;
	return "|";
end;

function TRF_UI_Live()
	if type(TRF) == "table" and type(TRF.live) == "table" then return TRF.live; end;
	return nil;
end;

function TRF_UI_Gt()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.gt) == "number" then
		return TRF.clock.gt;
	end;
	return 0;
end;

function TRF_UI_GenOk(g)
	if type(TRF) == "table" and type(g) == "number" and g == TRF.gen then return 1; end;
	return nil;
end;

function TRF_UI_Rec(id)
	if type(TRF_Rec) == "function" and type(id) == "number" then return TRF_Rec(id); end;
	return nil;
end;

-- R2: no line while a mission has disabled random contacts (__disableAction) or vanilla suppresses chatter
-- (trf_safety TRF_Quiet: __sys_SOS or a visible scripted scene; without trf_safety, not quiet).
-- Returns "flag" (__disableAction), "quiet" or nil; the skip lines log it. For what the mod starts (arrival,
-- news, announce and salvage lines).
function TRF_UI_Supp()
	if __disableAction == TRUE then return "flag"; end;
	if TRF_N("TRF_Quiet") then return "quiet"; end;
	return nil;
end;

-- TRF_UI_Supp for what the player starts (focus line, hail arming, hail answers): "quiet" through trf_safety
-- TRF_QuietHail (a visible scene; also __sys_SOS with cfg hail_quiet 1).
function TRF_UI_SuppHail()
	if __disableAction == TRUE then return "flag"; end;
	if TRF_N("TRF_QuietHail") then return "quiet"; end;
	return nil;
end;

function TRF_UI_Stat(name)
	local L = TRF_UI_Live();
	if not L or type(L.stat) ~= "table" then return; end;
	if type(L.stat[name]) ~= "number" then L.stat[name] = 0; end;
	L.stat[name] = L.stat[name] + 1;
end;

function TRF_UI_Hnd(id)
	if type(TRF_H) ~= "function" then return nil; end;
	local H = TRF_H();
	if type(H) == "table" and type(H.tr) == "table" then return H.tr[id]; end;
	return nil;
end;

function TRF_UI_GetLeader(fl)
	if not TRF_Is(fl:IsAlive()) then return nil; end;
	return fl:GetLeader();
end;

-- Leader pilot of trader id (for ui_out 2), or nil.
function TRF_UI_Leader(id)
	local h = TRF_UI_Hnd(id);
	if type(h) ~= "table" or not h.fl then return nil; end;
	return call(TRF_UI_GetLeader, {h.fl}, "x", TRF_PErr);
end;

-- System display name ("Gredos"); idx 0 is the trade station.
function TRF_UI_SysName(idx)
	if idx == 0 then return TRF_Txt("station"); end;
	local m = nil;
	if type(TRF_Map) == "function" then
		m = TRF_Map();
	elseif type(TRF_MapData) == "function" then
		m = TRF_MapData();
	end;
	if type(idx) == "number" and type(m) == "table" and type(m.sys) == "table" and type(m.sys[idx]) == "table" then
		local s = m.sys[idx];
		if type(s.dir) == "string" then return s.dir; end;
		if type(s.name) == "string" then return s.name; end;
	end;
	return TRF_Txt("unknown");
end;

function TRF_UI_Name(nm)
	if type(TRF_Names) ~= "function" or type(nm) ~= "number" then return nil; end;
	local l = TRF_Names();
	if type(l) == "table" and type(l[nm]) == "string" then return l[nm]; end;
	return nil;
end;

-- Path from the record; derived from from/to (0 = station) when missing.
function TRF_UI_Path(r)
	local p = r.path;
	if p == "A" or p == "B" or p == "C" then return p; end;
	if r.to == 0 then return "A"; end;
	if r.from == 0 then return "B"; end;
	return "C";
end;

-- Live transports: record nt, else the handle list, else 1.
function TRF_UI_Transports(r, id)
	if type(r.nt) == "number" then return r.nt; end;
	local h = TRF_UI_Hnd(id);
	if type(h) == "table" and type(h.tp) == "table" then return getn(h.tp); end;
	return 1;
end;

-- "FTU freighter Kestrel" (8.2 who part; also the hail box, v02-spec 6.1). A supply convoy (r.own = f,
-- v1-spec 5.1) is "<faction> supply transport Kestrel"; the player's freighter (r.fw, trf_freight) "Wolves Freight Kestrel";
-- the Kestrel of the freight unlock quest (r.wq, trf_wq) "FTU transport Kestrel".
function TRF_UI_Who(r, id)
	if r.fw then return TRF_Txt("fwwho", TRF_UI_Name(r.nm) or ""); end;
	if r.wq then return TRF_Txt("wqwho"); end;
	local hull = TRF_Txt("hull1");
	if TRF_UI_Transports(r, id) >= 2 then hull = TRF_Txt("hull2"); end;
	local own = TRF_Txt("owner");
	if type(r.own) == "number" and r.own >= 1 and r.own <= 5 then
		own = TRF_UI_FacOf(r.own);
		hull = TRF_Txt("hullconv");
	end;
	local nm = TRF_UI_Name(r.nm);
	if nm then return TRF_Txt("who", own, hull, nm); end;
	return TRF_Txt("who_noname", own, hull);
end;

-- Bit b (1, 2, 4, ...) of a bit field (v1-spec 3.1 TRF_Bit rule); 1 or nil.
function TRF_UI_Bit(v, b)
	if type(v) ~= "number" or type(b) ~= "number" or b < 1 then return nil; end;
	if mod(floor(v / b), 2) == 1 then return 1; end;
	return nil;
end;

-- 8.2: "FTU freighter Kestrel: machinery, Aurora -> trade station". v1: ", in convoy" for a danger convoy
-- member (r.cv); " (seen in Gredos)" for a trader that was tracked before this line (tb bit 1, v1-spec 4.3)
-- and came from another system.
function TRF_UI_FocusText(r, id)
	local p = TRF_UI_Path(r);
	local cls = r.cls;
	if type(cls) ~= "number" or cls < 1 or cls > 6 then cls = 0; end;
	if TRF_UI_Opt("ui_keys", 0) == 1 then return TRF_Txt("key_focus", cls, p); end;
	local s = TRF_Txt("focus", TRF_UI_Who(r, id), TRF_Txt("cls"..cls), TRF_UI_DirText(r));
	if r.cv ~= nil then s = TRF_Txt("inconvoy", s); end;
	local cur = nil;
	if type(TRF_CurIdx) == "function" then cur = TRF_CurIdx(); end;
	-- trf_track's memo when loaded (TRF_TrackSeen), else the origin of a trader tracked before this line.
	local fr = nil;
	if type(TRF_TrackSeen) == "function" then
		fr = call(TRF_TrackSeen, {id}, "x", TRF_PErr);
	elseif TRF_UI_Bit(r.tb, 1) then
		fr = r.from;
	end;
	if type(fr) == "number" and fr >= 1 and fr ~= cur then
		s = TRF_Txt("seenline", s, TRF_Txt("seenin", TRF_UI_SysName(fr)));
	end;
	return s;
end;

-- Direction part of the focus line ("Aurora -> trade station"; also "Where are you headed?", v02-spec 6.3).
function TRF_UI_DirText(r)
	local p = TRF_UI_Path(r);
	local dir;
	if p == "A" then
		dir = TRF_Txt("dir_a", TRF_UI_SysName(r.from));
	elseif p == "B" then
		dir = TRF_Txt("dir_b", TRF_UI_SysName(r.to));
	elseif r.from == r.to then
		dir = TRF_Txt("dir_ret", TRF_UI_SysName(r.from));
	else
		dir = TRF_Txt("dir_c", TRF_UI_SysName(r.from), TRF_UI_SysName(r.to));
	end;
	return dir;
end;

-- Output (8.1) ----------------------------------------------------------------------

function TRF_UI_Msg(p, text, secs)
	p:Message(text, secs);
	return 1;
end;

function TRF_UI_Out(text, secs)
	OutputToScreenLog(text, secs);
	return 1;
end;

-- Show one line. cfg ui_out 1: OutputToScreenLog; 2: pilot:Message when a pilot is given, else 1.
-- Returns 1 if shown. CHECK (E0.6): a plain string in OutputToScreenLog is readable on screen
-- (shipped scripts pass only # keys); if not, set ui_out 2. The log line records what was sent.
-- hq 1: a line the player asked for (focus line, hail answer), muted by TRF_UI_SuppHail instead of TRF_UI_Supp.
function TRF_Say(text, secs, pilot, hq)
	if TRF_UI_Opt("ui", 1) == 0 then return nil; end;
	if type(text) ~= "string" or text == "" then return nil; end;
	local q = nil;
	if hq == 1 then q = TRF_UI_SuppHail(); else q = TRF_UI_Supp(); end;
	if q then
		TRF_UiE("say", "result", "skipped", "reason", q, "message", text);
		return nil;
	end;
	if type(secs) ~= "number" then secs = TRF_UI_Const().secs; end;
	if TRF_UI_Opt("ui_out", 1) == 2 and pilot then
		if call(TRF_UI_Msg, {pilot, text, secs}, "x", TRF_PErr) then
			TRF_UiE("say", "output", 2, "seconds", secs, "message", text);
			return 1;
		end;
		TRF_UiE("say", "output", 2, "result", "fallback", "reason", "pilot_message_failed");
	end;
	if type(OutputToScreenLog) ~= "function" then
		TRF_UiE("say", "result", "failed", "reason", "no_output_to_screen_log", "message", text);
		return nil;
	end;
	if call(TRF_UI_Out, {text, secs}, "x", TRF_PErr) then
		TRF_UiE("say", "output", 1, "seconds", secs, "message", text);
		return 1;
	end;
	TRF_UiE("say", "output", 1, "result", "failed", "message", text);
	return nil;
end;

-- Focus line (8.3) ------------------------------------------------------------------

-- Once per trader (met). Lines are at least gap seconds apart: a line due earlier is scheduled at
-- line + gap through TRF_Due and dropped if the trader is gone by then (TRF_Rec). Called by the
-- triggers below and by TRF_DueRun (id only). Returns 1 if shown.
function TRF_FocusLine(id, via)
	local r = TRF_UI_Rec(id);
	local L = TRF_UI_Live();
	if type(r) ~= "table" or not L or r.met then return nil; end;
	if TRF_UI_Opt("ui", 1) == 0 then return nil; end;
	local q = TRF_UI_SuppHail();
	if q then
		TRF_UiE("focus", "trader_id", id, "result", "skipped", "reason", q);
		return nil;
	end;
	local c = TRF_UI_Const();
	local gt = TRF_UI_Gt();
	if type(L.line) == "number" and gt >= L.line and gt - L.line < c.gap then
		if type(TRF_Due) == "function" then
			TRF_Due(L.line + c.gap - gt, "TRF_FocusLine", id);
			TRF_UiE("focus", "trader_id", id, "delay", TRF_F(L.line + c.gap - gt), "result", "due");
		else
			TRF_UiE("focus", "trader_id", id, "result", "dropped", "reason", "no_due");
		end;
		return nil;
	end;
	local pilot = nil;
	if TRF_UI_Opt("ui_out", 1) == 2 then pilot = TRF_UI_Leader(id); end;
	if TRF_Say(TRF_UI_FocusText(r, id), c.secs, pilot, 1) then
		-- met 2: tracked before this line (rebuilt from the pool), read by the announce (metagain).
		r.met = 1;
		if TRF_UI_Bit(r.tb, 1) then r.met = 2; end;
		L.line = gt;
		TRF_UiE("focus", "trader_id", id, "via", via or "due", "result", "shown");
		-- v1-spec 4.2: the focus line tracks the trader (decision 11.1 #2), after the text read tb.
		TRF_P("TRF_TrackMark", id, "focus");
		return 1;
	end;
	return nil;
end;

-- Trigger "focus" on the leader ship (cfg ui_focus 1 or 3).
-- CHECK (design 13.2): _EVENT_ONFOCUS fires when the player selects an NPC ship; the log line and
-- the ui_focus counter show it. TRF_OnNear covers the case where it never fires.
-- Trigger entry point (review O1): runs TRF_OnFocus_Body protected.
function TRF_OnFocus(id, g) TRF_Cb("TRF_OnFocus", TRF_OnFocus_Body, {id, g}); end;

function TRF_OnFocus_Body(id, g)
	if not TRF_UI_GenOk(g) or not TRF_UI_Rec(id) then return; end;
	TRF_UI_Stat("ui_focus");
	TRF_UiE("on_focus", "trader_id", id, "game_time", TRF_F(TRF_UI_Gt()));
	local m = TRF_UI_Opt("ui_focus", 3);
	if m ~= 1 and m ~= 3 then return; end;
	TRF_FocusLine(id, "focus");
end;

-- Trigger f_object_inside(fl, mothership, info_r) (cfg ui_focus 2 or 3).
-- Trigger entry point (review O1): runs TRF_OnNear_Body protected.
function TRF_OnNear(id, g) TRF_Cb("TRF_OnNear", TRF_OnNear_Body, {id, g}); end;

function TRF_OnNear_Body(id, g)
	if not TRF_UI_GenOk(g) or not TRF_UI_Rec(id) then return; end;
	TRF_UI_Stat("ui_near");
	TRF_UiE("on_near", "trader_id", id, "game_time", TRF_F(TRF_UI_Gt()));
	local m = TRF_UI_Opt("ui_focus", 3);
	if m ~= 2 and m ~= 3 then return; end;
	TRF_FocusLine(id, "near");
end;

-- Trigger f_object_inside(fl, mothership, 70): the vanilla meeting (8.3), or with cfg meet 2 the v0.2
-- announce (v02-spec 6.1); meet 2 acts as 1 when trf_hail (TRF_OnHail) is not loaded.
-- _FTrader_Action reads GetTriggerContext():GetFlight(), still valid inside this action, and
-- compares __sys_FTrader_1..3 with RAND (a script error if _Trader_Init did not run here).
-- Trigger entry point (review O1): runs TRF_OnMeet_Body protected; on 1 it calls the vanilla meeting
-- outside TRF_Cb, so an error there keeps the default handler (spec 13, fix 1).
function TRF_OnMeet(id, g)
	if TRF_Cb("TRF_OnMeet", TRF_OnMeet_Body, {id, g}) == 1 then call(_FTrader_Action, {}, "x"); end;
end;

function TRF_OnMeet_Body(id, g)
	if not TRF_UI_GenOk(g) or not TRF_UI_Rec(id) then return; end;
	if TRF_UI_Opt("meet", 1) == 0 then return; end;
	local hl = nil;
	if TRF_UI_Opt("meet", 1) == 2 and type(TRF_OnHail) == "function" then hl = 1; end;
	-- meet 2: the hail is player-initiated (TRF_UI_SuppHail); only the announce line follows TRF_UI_Supp.
	local q = TRF_UI_Supp();
	if hl then q = TRF_UI_SuppHail(); end;
	if q then
		TRF_UiE("meet", "trader_id", id, "result", "skipped", "reason", q);
		return;
	end;
	if hl then
		local m = TRF_UI_Supp();
		if TRF_UI_Announce(id) and m then TRF_UiE("meet", "trader_id", id, "hail_armed", "true", "result", "line_muted", "reason", m); end;
		return;
	end;
	if type(_FTrader_Action) ~= "function" then
		TRF_UiE("meet", "trader_id", id, "result", "skipped", "reason", "no_ftrader_action");
		return;
	end;
	if type(__sys_FTrader_1) ~= "number" or type(__sys_FTrader_2) ~= "number" or type(__sys_FTrader_3) ~= "number" then
		TRF_UiE("meet", "trader_id", id, "result", "skipped", "reason", "no_trader_init_chances");
		return;
	end;
	TRF_UiE("meet", "trader_id", id, "result", "vanilla");
	return 1;
end;

-- Band remark of the announce (design 7.11): pro 0-2 / 3-5 / 6-9; nil without trf_region.
function TRF_UI_ProBand(idx)
	if type(TRF_Pro) ~= "function" or type(idx) ~= "number" then return nil; end;
	local p = call(TRF_Pro, {idx}, "x", TRF_PErr);
	if type(p) ~= "number" then return nil; end;
	if p <= 2 then return 1; end;
	if p <= 5 then return 2; end;
	return 3;
end;

-- meet 2 (v02-spec 6.1 announce): line "FTU <name>, open for trade" + band remark, once per trader;
-- the hail is armed for hail_arm seconds (r.ha): a focus within hail_r opens it (trf_hail), or with
-- cfg hail_start 2 the menu opens at once.
function TRF_UI_Announce(id)
	local r = TRF_UI_Rec(id);
	if type(r) ~= "table" or r.ha then return nil; end;
	r.ha = TRF_UI_Gt() + TRF_UI_Tune("hail_arm", 60);
	local s = TRF_Txt("open", TRF_UI_Name(r.nm) or TRF_Txt("hull1"));
	local b = TRF_UI_ProBand(TRF_CurIdx());
	if b then s = s..". "..TRF_Txt("rem"..b); end;
	-- v1-spec 4.3: a trader met before says so once: trf_track's TRF_TrackMetAgain when loaded (once per
	-- visit), else tracked before its focus line (met 2).
	if type(TRF_TrackMetAgain) == "function" then
		local m = call(TRF_TrackMetAgain, {id}, "x", TRF_PErr);
		if type(m) == "string" then s = s..". "..m; end;
	elseif r.met == 2 or (not r.met and TRF_UI_Bit(r.tb, 1)) then
		s = s..". "..TRF_Txt("metagain");
	end;
	local pilot = nil;
	if TRF_UI_Opt("ui_out", 1) == 2 then pilot = TRF_UI_Leader(id); end;
	TRF_Say(s, TRF_UI_Const().secs, pilot);
	TRF_UI_Stat("ui_announce");
	TRF_UiE("announce", "trader_id", id, "band", b);
	if TRF_UI_Opt("hail_start", 2) == 2 and type(TRF_HailOpen) == "function" then
		call(TRF_HailOpen, {id, "meet"}, "x", TRF_PErr);
	elseif type(TRF_HailArm) == "function" then
		call(TRF_HailArm, {id}, "x", TRF_PErr);
	end;
	return 1;
end;

-- Region helpers (trf_region, v02-spec 4.1, 10.1); nil or defaults when it is not loaded --------

function TRF_UI_RgMap()
	if type(TRF_RgMap) ~= "function" then return nil; end;
	local m = call(TRF_RgMap, {}, "x", TRF_PErr);
	if type(m) == "table" then return m; end;
	return nil;
end;

-- Home idx of region slot (home given as idx or system name), or nil.
function TRF_UI_HomeIdx(slot)
	local rm = TRF_UI_RgMap();
	if not rm or type(slot) ~= "number" or type(rm[slot]) ~= "table" then return nil; end;
	local h = rm[slot].home;
	if type(h) == "number" then return h; end;
	local m = TRF_Map();
	if type(h) == "string" and m then return m.by[strlower(h)]; end;
	return nil;
end;

-- Region systems (idx list) of slot: TRF_RgMap sys, else map entries with rg == slot.
function TRF_UI_RgSys(slot)
	local rm = TRF_UI_RgMap();
	if rm and type(rm[slot]) == "table" and type(rm[slot].sys) == "table" then return rm[slot].sys; end;
	local o = {};
	local m = TRF_Map();
	if m then
		for i = 1, getn(m.sys) do
			if m.sys[i].rg == slot then tinsert(o, i); end;
		end;
	end;
	return o;
end;

function TRF_UI_RgN()
	local rm = TRF_UI_RgMap();
	if rm and type(rm.n) == "number" then return rm.n; end;
	return 0;
end;

function TRF_UI_RgOf(idx)
	if type(TRF_RgOf) ~= "function" or type(idx) ~= "number" then return nil; end;
	local s = call(TRF_RgOf, {idx}, "x", TRF_PErr);
	if type(s) == "number" then return s; end;
	return nil;
end;

-- Sweep owner display name: a vanilla team name (Vks, Kfni, ...) or an already readable name.
function TRF_UI_FacName(fac)
	if type(fac) ~= "string" or fac == "" then return TRF_Txt("facmerc"); end;
	local s = TRF_UI_Find(TRF_UI_Key("fac"..fac));
	if s then return s; end;
	return fac;
end;

function TRF_UI_ClanName(slot)
	if type(TRF_ClanName) == "function" then
		local s = call(TRF_ClanName, {slot}, "x", TRF_PErr);
		if type(s) == "string" then return s; end;
	end;
	return TRF_Txt("pirw2");
end;

function TRF_UI_Pro(idx)
	if type(TRF_Pro) ~= "function" then return nil; end;
	local p = call(TRF_Pro, {idx}, "x", TRF_PErr);
	if type(p) == "number" then return p; end;
	return nil;
end;

-- Faction name when idx is the target of its region's open sweep attempt, else nil. Target (v1-spec 7.3):
-- the system of an active base of the region's clan, else the home.
function TRF_UI_SweepHome(idx)
	local s = TRF_UI_RgOf(idx);
	if not s or type(TRF_SweepOpen) ~= "function" then return nil; end;
	local tgt = TRF_UI_BaseOfRg(s) or TRF_UI_HomeIdx(s);
	if tgt ~= idx then return nil; end;
	if not call(TRF_SweepOpen, {s}, "x", TRF_PErr) then return nil; end;
	local w = nil;
	if type(TRF_SweepInfo) == "function" then w = call(TRF_SweepInfo, {s}, "x", TRF_PErr); end;
	if type(w) ~= "table" then w = {}; end;
	return TRF_UI_FacName(w.fac);
end;

-- v1 state readers (v1-spec 3.1); nil or 0 when the v1 fields are absent -------------------------

function TRF_UI_Legs()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then return TRF.clock.legs; end;
	return 0;
end;

-- Kind of the base record at idx: 1 P (gathering), 2 A (active), or nil (none or destroyed).
function TRF_UI_BaseAt(idx)
	local b = TRF_UI_BaseRec(idx);
	if b then return b.k; end;
	return nil;
end;

-- P or A base record of system idx (TRF.base), or nil.
function TRF_UI_BaseRec(idx)
	if type(TRF) ~= "table" or type(TRF.base) ~= "table" or type(idx) ~= "number" then return nil; end;
	for i = 1, getn(TRF.base) do
		local b = TRF.base[i];
		if type(b) == "table" and b.s == idx and (b.k == 1 or b.k == 2) then return b; end;
	end;
	return nil;
end;

-- A base record of idx whose radio line has not been given yet (a ~= 1), or nil.
function TRF_UI_BaseRadioDue(idx)
	local b = TRF_UI_BaseRec(idx);
	if b and b.k == 2 and b.a ~= 1 then return b; end;
	return nil;
end;

-- System idx of an active base in region slot, or nil.
function TRF_UI_BaseOfRg(slot)
	if type(TRF) ~= "table" or type(TRF.base) ~= "table" or type(slot) ~= "number" then return nil; end;
	for i = 1, getn(TRF.base) do
		local b = TRF.base[i];
		if type(b) == "table" and b.k == 2 and type(b.s) == "number" and TRF_UI_RgOf(b.s) == slot then return b.s; end;
	end;
	return nil;
end;

-- Running carrier raid record {s, t, e} targeting idx, or nil.
function TRF_UI_CarAt(idx)
	if type(TRF) ~= "table" or type(TRF.lr) ~= "table" or type(idx) ~= "number" then return nil; end;
	local L = TRF_UI_Legs();
	for i = 1, getn(TRF.lr) do
		local r = TRF.lr[i];
		if type(r) == "table" and r.t == idx and type(r.e) == "number" and L < r.e then return r; end;
	end;
	return nil;
end;

-- Salvage stage 0..3 and last losing faction 0..5 of region slot (6.3).
function TRF_UI_Salv(slot)
	local sv, sf = 0, 0;
	if type(TRF) == "table" and type(TRF.clan) == "table" and type(slot) == "number" and type(TRF.clan[slot]) == "table" then
		local c = TRF.clan[slot];
		if type(c.sv) == "number" then sv = c.sv; end;
		if type(c.sf) == "number" then sf = c.sf; end;
	end;
	local st = nil;
	if type(TRF_SalvStage) == "function" then st = call(TRF_SalvStage, {slot}, "x", TRF_PErr); end;
	if type(st) ~= "number" then
		st = 0;
		if sv >= 7 then st = 3; elseif sv >= 4 then st = 2; elseif sv >= 1 then st = 1; end;
	end;
	return st, sf;
end;

-- Display name of faction index f (1..5: Vks, Kfni, Triada, Uss, Inoco).
function TRF_UI_FacOf(f)
	local team = nil;
	if type(TRF_FacTeam) == "function" then team = call(TRF_FacTeam, {f}, "x", TRF_PErr); end;
	if type(team) ~= "string" then
		local l = {"Vks", "Kfni", "Triada", "Uss", "Inoco"};
		team = l[f];
	end;
	return TRF_UI_FacName(team);
end;

-- Equipment convoy record while scheduled (k 1), or nil.
function TRF_UI_Feq()
	if type(TRF) == "table" and type(TRF.feq) == "table" and TRF.feq.k == 1 and type(TRF.feq.s) == "number" then return TRF.feq; end;
	return nil;
end;

-- Salvaged pirate ships (6.3 signals) ------------------------------------------------------

-- Focus line of a salvaged ship: stage 1 "<faction> gear", 2 captured fighter, 3 captured corvette.
function TRF_SalvLine(f, st)
	if type(f) ~= "number" or f < 1 or f > 5 or type(st) ~= "number" then return nil; end;
	local fac = TRF_UI_FacOf(f);
	local text;
	if st >= 3 then
		text = TRF_Txt("salvcap", fac, TRF_Txt("salvcorvette"));
	elseif st == 2 then
		text = TRF_Txt("salvcap", fac, TRF_Txt("salvfighter"));
	else
		text = TRF_Txt("salvgear", fac);
	end;
	TRF_UI_Stat("ui_salv");
	return TRF_Say(text, TRF_UI_Const().secs);
end;

-- Arm the focus line on a salvaged ship (for trf_clan's TRF_SalvFlight). CHECK (design 13.2): focus on
-- pirate ships fires as on traders.
function TRF_UI_ArmSalv(ship, f, st)
	if not ship or type(NewTrigger) ~= "function" or type(TRF) ~= "table" then return nil; end;
	if type(f) ~= "number" or type(st) ~= "number" then return nil; end;
	call(NewTrigger, {"focus", nil, "TRF_OnSalvFocus("..floor(f)..","..floor(st)..","..TRF.gen..")--", ship}, "x", TRF_PErr);
	return 1;
end;

-- Trigger entry point: runs TRF_OnSalvFocus_Body protected.
function TRF_OnSalvFocus(f, st, g) TRF_Cb("TRF_OnSalvFocus", TRF_OnSalvFocus_Body, {f, st, g}); end;

function TRF_OnSalvFocus_Body(f, st, g)
	if not TRF_UI_GenOk(g) or TRF_UI_Opt("ui", 1) == 0 or TRF_UI_Supp() then return; end;
	TRF_SalvLine(f, st);
end;

-- Arrival line (8.4, S20) -----------------------------------------------------------

function TRF_UI_Dis(idx)
	local d = nil;
	if type(TRF_Dis) == "function" then
		d = TRF_Dis(idx);
	elseif type(TRF) == "table" and type(TRF.sys) == "table" and type(TRF.sys[idx]) == "table" then
		d = TRF.sys[idx].dis;
	end;
	if type(d) ~= "number" then return 0; end;
	return d;
end;

-- Severity band of design 11: 3-4 -> 1, 5-6 -> 2, 7-9 -> 3.
function TRF_UI_Band(d)
	if d <= 4 then return 1; end;
	if d <= 6 then return 2; end;
	return 3;
end;

-- Due call from TRF_UI_OnActivate: once per entry (arr), also when not shown (no retry, design 8.1).
-- Returns 1 if shown. (Named TRF_ArrivalLine before trf_plumb: that name is now the mod line queue,
-- design/wb-plumbing-spec.md 5.4, whose lines follow this one at 3 s steps.)
function TRF_UI_ArrivalLine()
	local L = TRF_UI_Live();
	if not L or L.arr then return nil; end;
	L.arr = 1;
	if TRF_UI_Opt("arrival_line", 1) == 0 or TRF_UI_Opt("ui", 1) == 0 then return nil; end;
	local idx = nil;
	if type(TRF_CurIdx) == "function" then idx = TRF_CurIdx(); end;
	if not idx then
		TRF_UiE("arrival", "result", "skipped", "reason", "system_not_in_map");
		return nil;
	end;
	-- Vanilla systems (guard, deny list, sys_off, override 0/2) get no mod text.
	if type(TRF_SysModeQuiet) == "function" then
		local m = call(TRF_SysModeQuiet, {}, "x", TRF_PErr);
		if m ~= "mod" then
			TRF_UiE("arrival", "mode", m, "result", "skipped", "reason", "system_mode");
			return nil;
		end;
	end;
	-- v1-spec 9.3: pirate radio line of an active base, after the arrival line, on the first entry after
	-- activation only (record flag a).
	if TRF_UI_BaseRadioDue(idx) and type(TRF_Due) == "function" then
		TRF_Due(TRF_UI_Const().arr_secs, "TRF_BaseRadioLine", idx);
	end;
	local d = TRF_UI_Dis(idx);
	local keys = TRF_UI_Opt("ui_keys", 0) == 1;
	local text = nil;
	local car = TRF_UI_CarAt(idx);
	if car and not keys then
		-- v1-spec 6.2: the carrier line replaces the tier line; the sweep sentence still follows.
		text = TRF_Txt("arrivecarrier", TRF_UI_ClanName(car.s));
		local f = TRF_UI_SweepHome(idx);
		if f then text = text..". "..TRF_Txt("arrsweep", f); end;
		TRF_UiE("arrival", "disruption", d, "carrier_slot", car.s, "result", "carrier");
	elseif d >= TRF_UI_Tune("arr_dis", 3) then
		local band = TRF_UI_Band(d);
		if keys then
			text = TRF_Txt("key_arr", band);
		else
			text = TRF_UI_ArrDis(idx, band);
		end;
		TRF_UiE("arrival", "disruption", d, "band", band, "result", "disruption");
	elseif not keys then
		text = TRF_UI_ArrQuiet(idx);
		if text then TRF_UiE("arrival", "disruption", d, "result", "quiet"); end;
	end;
	if not text then return nil; end;
	local q = TRF_UI_Supp();
	if q then
		TRF_UiE("arrival", "disruption", d, "result", "skipped", "reason", q);
		return nil;
	end;
	return TRF_Say(text, TRF_UI_Const().arr_secs);
end;

-- Disruption line (v02-spec 9.6): v0.1 text without trf_region, else the band template with the
-- effective-tier word; the sweep sentence follows in a home system with an open sweep.
function TRF_UI_ArrDis(idx, band)
	local text;
	if type(TRF_EffTier) == "function" then
		local t = call(TRF_EffTier, {idx}, "x", TRF_PErr);
		if type(t) ~= "number" or t < 1 then t = 1; end;
		t = min(floor(t), 4);
		-- v1-spec 6.1: T3 packs, T4 raiders.
		local w = {"pirw1", "pirw2", "packs", "raiders"};
		text = TRF_Txt("arrt"..band, TRF_Txt(w[t]));
	else
		text = TRF_Txt("arr"..band);
	end;
	local f = TRF_UI_SweepHome(idx);
	if f then text = text..". "..TRF_Txt("arrsweep", f); end;
	return text;
end;

-- Due call from TRF_UI_ArrivalLine: one pirate radio line in a system with an active base (v1-spec 9.3):
-- "trade or move on" while Pirates and the player are not at war, else the war line. Once per activation:
-- the saved base record gets a = 1 when the line is shown.
function TRF_BaseRadioLine(idx)
	if TRF_UI_Opt("ui", 1) == 0 or TRF_UI_Supp() then return nil; end;
	if type(TRF_CurIdx) ~= "function" or TRF_CurIdx() ~= idx then return nil; end;
	local br = TRF_UI_BaseRadioDue(idx);
	if not br then return nil; end;
	local key = "baseradiotrade";
	if type(GetTeamRelation) == "function" and RELATION_WAR ~= nil then
		local v = call(GetTeamRelation, {"Pirates", PLAYER_TEAM}, "x", TRF_PErr);
		if v ~= nil and v == RELATION_WAR then key = "baseradiowar"; end;
	end;
	TRF_UI_Stat("ui_baseradio");
	TRF_UiE("base_radio", "system_index", idx, "key", key);
	local shown = TRF_Say(TRF_Txt(key), TRF_UI_Const().arr_secs);
	if shown then br.a = 1; end;
	return shown;
end;

-- Line below the disruption threshold: the sweep sentence, else the prosperity line (pro 6-7, 8-9).
function TRF_UI_ArrQuiet(idx)
	local f = TRF_UI_SweepHome(idx);
	if f then return TRF_Txt("arrsweep", f); end;
	local p = TRF_UI_Pro(idx);
	if not p then return nil; end;
	if p >= 8 then return TRF_Txt("arrpro2"); end;
	if p >= 6 then return TRF_Txt("arrpro1"); end;
	return nil;
end;

-- Loader OnActivate (entry only, never on load): schedule the arrival line arr_delay seconds after
-- entry and the news bulletin (cfg news_mode 1) 12 s after entry. TRF_DueRun checks the generation, so a
-- restored or stale entry does nothing.
function TRF_UI_OnActivate()
	local L = TRF_UI_Live();
	if not L or TRF_UI_Opt("ui", 1) == 0 then return; end;
	if type(TRF_Due) ~= "function" then
		TRF_UiE("arrival", "result", "not_scheduled", "reason", "no_due");
		return;
	end;
	if not L.nbs and TRF_UI_Opt("news_mode", 1) == 1 then
		L.nbs = 1;
		TRF_Due(TRF_UI_Tune("news_delay", 12), "TRF_NewsShow");
	end;
	if L.arr or TRF_UI_Opt("arrival_line", 1) == 0 then return; end;
	TRF_Due(TRF_UI_Tune("arr_delay", 5), "TRF_UI_ArrivalLine");
end;

-- News (v02-spec 8.2) ----------------------------------------------------------------
-- TRF.news[topic] (global) and TRF.newsx[slot][topic] (regional) hold one entry per topic:
-- {v=variant, n=1 unseen / 0 shown, l=leg of the post}; short also keeps e (latest end leg seen).
-- The owners of the events post (TRF_NewsPost) or ask for a check (TRF_NewsCheck); display is here.

function TRF_UI_NewsMode()
	local m = TRF_UI_Opt("news_mode", 1);
	if m ~= 0 and m ~= 1 and m ~= 2 then return 1; end;
	return m;
end;

-- Post record name for cfg news_mode 2 (records added by install-test.sh NEWS=1).
function TRF_UI_NewsRec(topic, v, slot)
	if type(slot) == "number" then return "trf_r"..slot.."_"..topic.."_"..v; end;
	return "trf_"..topic.."_"..v;
end;

-- Topic table of slot (nil = global), created on demand.
function TRF_UI_NewsTab(slot)
	if type(slot) == "number" then
		if type(TRF.newsx) ~= "table" then TRF.newsx = {}; end;
		if type(TRF.newsx[slot]) ~= "table" then TRF.newsx[slot] = {}; end;
		return TRF.newsx[slot];
	end;
	if type(TRF.news) ~= "table" then TRF.news = {}; end;
	return TRF.news;
end;

-- Post variant v of topic (slot nil = global); v nil removes the topic. A new post replaces the old one
-- (news_mode 2: RemovePost then AddPost). news_mode 0: nothing. Returns 1 when stored.
-- CHECK (E0.6): the trf_* records exist only in the test clone's Game/News.xml.
function TRF_NewsPost(topic, v, slot)
	if type(TRF) ~= "table" or type(topic) ~= "string" then return nil; end;
	local mode = TRF_UI_NewsMode();
	if mode == 0 then return nil; end;
	local tab = TRF_UI_NewsTab(slot);
	local old = tab[topic];
	if mode == 2 and type(old) == "table" and old.v ~= nil then TRF_N("RemovePost", TRF_UI_NewsRec(topic, old.v, slot)); end;
	if v == nil then
		tab[topic] = nil;
		TRF_UiE("news", "topic", topic, "slot", slot, "result", "removed");
		return 1;
	end;
	v = tostring(v);
	local legs = 0;
	if type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then legs = TRF.clock.legs; end;
	tab[topic] = {v=v, n=1, l=legs};
	if mode == 2 then
		TRF_N("AddPost", TRF_UI_NewsRec(topic, v, slot));
		tab[topic].n = 0;
	end;
	TRF_UI_Stat("news_post");
	TRF_UiE("news", "topic", topic, "variant", v, "slot", slot, "mode", mode, "result", "posted");
	return 1;
end;

-- Threshold topic (heat, help): post the highest level reached when it is above the posted one;
-- value 0 removes the topic.
function TRF_UI_NewsLevel(topic, val, lv)
	local cur = TRF_UI_NewsTab(nil)[topic];
	if type(val) ~= "number" then return; end;
	if val <= 0 then
		if cur then TRF_NewsPost(topic, nil); end;
		return;
	end;
	local cv = 0;
	if type(cur) == "table" then cv = tonumber(cur.v) or 0; end;
	for i = 1, getn(lv) do
		if val >= lv[i] then
			if cv < lv[i] then TRF_NewsPost(topic, lv[i]); end;
			return;
		end;
	end;
end;

-- short "on": first active shortage after none for >= 6 legs (L_short). e tracks the latest end leg seen.
function TRF_UI_NewsShort()
	if type(TRF.short) ~= "table" or type(TRF.clock) ~= "table" then return; end;
	local legs = TRF.clock.legs or 0;
	local mx = nil;
	for i = 1, getn(TRF.short) do
		local e = TRF.short[i];
		if type(e) == "table" and type(e.t) == "number" and e.t > legs and (not mx or e.t > mx) then mx = e.t; end;
	end;
	if not mx then return; end;
	local cur = TRF_UI_NewsTab(nil).short;
	if type(cur) ~= "table" or type(cur.e) ~= "number" or legs - cur.e >= TRF_UI_Tune("L_short", 6) then
		TRF_NewsPost("short", nil);
		if TRF_NewsPost("short", "on") then TRF.news.short.e = mx; end;
	elseif mx > cur.e then
		cur.e = mx;
	end;
end;

-- Region topics of slot: lane (raid at dis 5, quiet when all < 3 after raid), trade (boom at pro 7,
-- bust when the highest pro <= 2 after boom).
function TRF_UI_NewsRegion(slot, topic)
	local ss = TRF_UI_RgSys(slot);
	local dmax, pmax = 0, 0;
	for i = 1, getn(ss) do
		local d = TRF_UI_Dis(ss[i]);
		if d > dmax then dmax = d; end;
		local p = TRF_UI_Pro(ss[i]) or 0;
		if p > pmax then pmax = p; end;
	end;
	local t = TRF_UI_NewsTab(slot);
	if not topic or topic == "lane" then
		local c = t.lane;
		if dmax >= 5 and (type(c) ~= "table" or c.v ~= "raid") then
			TRF_NewsPost("lane", "raid", slot);
		elseif type(c) == "table" and c.v == "raid" and dmax < 3 then
			TRF_NewsPost("lane", "quiet", slot);
		end;
	end;
	if (not topic or topic == "trade") and type(TRF_Pro) == "function" then
		local c = t.trade;
		if pmax >= 7 and (type(c) ~= "table" or c.v ~= "boom") then
			TRF_NewsPost("trade", "boom", slot);
		elseif type(c) == "table" and c.v == "boom" and pmax <= 2 then
			TRF_NewsPost("trade", "bust", slot);
		end;
	end;
end;

-- Variant "salv2_3" -> "salv2", 3 (faction suffix of the v1 topics war and feq); else v, nil.
function TRF_UI_NewsVar(v)
	v = tostring(v);
	local a, b, base, f = strfind(v, "^(.-)_(%d)$");
	if a and base ~= "" then return base, tonumber(f); end;
	return v, nil;
end;

-- v1 topic war of slot from the clan's salvage (6.3): post salv2_<f> / salv3_<f> when the stage reaches 2 / 3
-- with faction f and the entry does not already show that faction at that stage or higher. Base and carrier
-- posts (trf_base, trf_clan) are not replaced by a salvage post.
function TRF_UI_NewsWar(slot)
	if type(slot) ~= "number" then return; end;
	local st, f = TRF_UI_Salv(slot);
	if st < 2 or type(f) ~= "number" or f < 1 or f > 5 then return; end;
	local c = TRF_UI_NewsTab(slot).war;
	if type(c) == "table" and c.v ~= nil then
		local base, cf = TRF_UI_NewsVar(c.v);
		if base ~= "salv2" and base ~= "salv3" then return; end;
		if cf == f and tonumber(strsub(base, 5)) >= min(st, 3) then return; end;
	end;
	TRF_NewsPost("war", "salv"..min(st, 3).."_"..f, slot);
end;

-- State-driven topics: "heat", "help", "short" (global); "lane", "trade" for region slot (nil = every
-- region); topic nil = both region topics. TRF_NewsCheck(slot) with a number is the same as (nil, slot).
-- v1: "war" (salvage stage, region slot or every region). Event topics (pir, sweep; v1 war base / basex /
-- car, feq kill_<f> / lost_<f>) are posted by their owners with TRF_NewsPost.
function TRF_NewsCheck(topic, slot)
	if type(TRF) ~= "table" then return; end;
	if type(topic) == "number" and slot == nil then slot = topic; topic = nil; end;
	if topic == "war" then
		if type(slot) == "number" then TRF_UI_NewsWar(slot); return; end;
		for s = 1, TRF_UI_RgN() do TRF_UI_NewsWar(s); end;
		return;
	end;
	if topic == "feq" then return; end;
	if topic == "heat" then
		local h = nil;
		if type(TRF.std) == "table" then h = TRF.std.heat; end;
		TRF_UI_NewsLevel("heat", h, {7, 5});
		return;
	end;
	if topic == "help" then
		local h = nil;
		if type(TRF.std) == "table" then h = TRF.std.help; end;
		TRF_UI_NewsLevel("help", h, {15, 5});
		return;
	end;
	if topic == "short" then TRF_UI_NewsShort(); return; end;
	if topic ~= nil and topic ~= "lane" and topic ~= "trade" then return; end;
	if type(slot) == "number" then
		TRF_UI_NewsRegion(slot, topic);
		return;
	end;
	for s = 1, TRF_UI_RgN() do TRF_UI_NewsRegion(s, topic); end;
end;

-- Display text of an entry (region topics name the home system, clan and sweep faction). A v1 variant with
-- a faction suffix ("salv2_3", "kill_1") names that faction: $3 in region topics, $1 in global ones. Topic cap
-- also names the region's captain ($4, trf_captain TRF_Cap_NameOf); nil when he has no name (gone).
function TRF_UI_NewsText(topic, v, slot)
	local base, vf = TRF_UI_NewsVar(v);
	local key = TRF_UI_Key("n"..topic..base);
	local fn = nil;
	if vf and vf >= 1 and vf <= 5 then fn = TRF_UI_FacOf(vf); end;
	if type(slot) ~= "number" then
		if fn then return TRF_Txt(key, fn); end;
		return TRF_Txt(key);
	end;
	local h = TRF_UI_HomeIdx(slot);
	local home = TRF_Txt("unknown");
	if h then home = TRF_UI_SysName(h); end;
	local fac = nil;
	if type(TRF_SweepInfo) == "function" then
		local w = call(TRF_SweepInfo, {slot}, "x", TRF_PErr);
		if type(w) == "table" then fac = w.fac; end;
	end;
	if fn then return TRF_Txt(key, home, TRF_UI_ClanName(slot), fn); end;
	local cn = nil;
	if topic == "cap" then
		cn = TRF_N("TRF_Cap_NameOf", slot);
		if type(cn) ~= "string" then return nil; end;
	end;
	return TRF_Txt(key, home, TRF_UI_ClanName(slot), TRF_UI_FacName(fac), cn);
end;

-- 1 when entry a (slot sa, topic ta) is newer than b: leg desc, then global before regional, lower slot,
-- topic name.
function TRF_UI_NewsNewer(a, sa, ta, b, sb, tb)
	if not b then return 1; end;
	if a.l ~= b.l then return a.l > b.l; end;
	if sa ~= sb then return sa < sb; end;
	return ta < tb;
end;

-- Newest unseen entry: text, entry (set entry.n = 0 once shown), or nil. An entry without a text (a cap
-- bulletin whose captain is gone) is marked seen and the next one is taken.
function TRF_NewsNext()
	if type(TRF) ~= "table" then return nil; end;
	local be, bs, bt = nil, 0, "";
	if type(TRF.news) == "table" then
		for k, e in TRF.news do
			if type(k) == "string" and type(e) == "table" and e.n == 1 and type(e.l) == "number"
				and TRF_UI_NewsNewer(e, 0, k, be, bs, bt) then be = e; bs = 0; bt = k; end;
		end;
	end;
	if type(TRF.newsx) == "table" then
		for s, t in TRF.newsx do
			if type(s) == "number" and type(t) == "table" then
				for k, e in t do
					if type(k) == "string" and type(e) == "table" and e.n == 1 and type(e.l) == "number"
						and TRF_UI_NewsNewer(e, s, k, be, bs, bt) then be = e; bs = s; bt = k; end;
				end;
			end;
		end;
	end;
	if not be then return nil; end;
	local slot = nil;
	if bs > 0 then slot = bs; end;
	local text = TRF_UI_NewsText(bt, be.v, slot);
	if not text then
		be.n = 0;
		TRF_UiE("news", "topic", bt, "variant", be.v, "slot", slot, "result", "dropped", "reason", "no_text");
		return TRF_NewsNext();
	end;
	return text, be;
end;

-- Due call 12 s after entry (news_mode 1): the newest unseen entry once as "FTU bulletin: ...".
-- Not in a vanilla-mode system or under a flag; it then stays unseen for a later entry or the board.
function TRF_NewsShow()
	if TRF_UI_NewsMode() ~= 1 or TRF_UI_Opt("ui", 1) == 0 or TRF_UI_Supp() then return nil; end;
	if type(TRF_SysModeQuiet) == "function" and call(TRF_SysModeQuiet, {}, "x", TRF_PErr) ~= "mod" then return nil; end;
	local text, e = TRF_NewsNext();
	if not text then return nil; end;
	if TRF_Say(TRF_Txt("nbull", text), 10) then
		e.n = 0;
		return 1;
	end;
	return nil;
end;
