-- sw3-traffic survey layer and the intro quest "Chart the frontier" (Lua 4.0.1). Spec: design/survey-spec.md (A12 step 2,
-- roadmap wave 3 row 12; owner decisions 1-15 of spec 2.1 taken 2026-11-07 as recommended). Prefix Sy (TRF_Sy_* public,
-- TRF_Sy<X> internal; no internal name starts with TRF_Sys, the family of TRF_SysEn), log module=survey, cfg survey.
-- Host-tested only, not run in the game (W-A12.9-18 open).
-- Owns: the landmark table TRF_SyData (tools/gen_survey.py: 46 rows from static location.script objects, 8 regions) and the
-- readings: the mothership within sy_read_r of a row's reading point while sy_hold seconds of game time add up (a random
-- portal row only sy_rp_min..sy_read_r from the portal and only while OnRandomPortal_all is "yes"); leaving resets the
-- hold, a hold flag pauses it. Every reading pays the survey fee (TRF_Pay, sy_fee_k % of TRF_PayN per weight point) and
-- shows one information line: the A07 trail hook, the chart completion, a lit A08 signal, a pirate base's system or a
-- route note to the region's next landmark; never a stash. A complete region chart sells once, automatically, at the first
-- trade dock outside the region (trade line 75), its value falling with the source region's phase; the sale pushes ring
-- kind 14 (trf_tips). 30 and 60 survey points add sy_thr_k % each to fees and chart values.
-- Quest "Chart the frontier" (spec 7): quest id 4 of the shared intro-quest record TRF.iq (trf_plumb TRF_Iq*): the offer at
-- a trade dock's charter office (box 410 or the Office row 410) names three landmarks of the dock's region (job markers in
-- their systems); three readings (step 10 -> 20); the hand-in at any trade dock (line 75) sets the done bit, which opens the
-- survey for every region and the chart sale (cfg sy_gate 1). The logbook entry trf_sy (the quest, then the Survey log) is
-- written only at the accept and at trade docks: the Job log (trf_plumb TRF_JbLog) with plain text, else AddQuest with
-- fixed keys.
-- Gates: strict gate (feature survey), system mode, the visit latch on TRF_Safe_QState, the hold flags and the scene; dock
-- parts TRF_PlQuest and TRF_Quiet; never GetPlayerQuestState (trf_plumb refuses markers while it is TRUE).
-- Saved field (version 4, created at the first reading, repaired by TRF_Sy_Fix):
--   TRF.sy = "<bits>/<block 1>/.../<block n>", n = TRF_RgMap().n; bits ceil(N / 4) hex characters (row id read: bit
--   mod(id - 1, 4) of character floor((id - 1) / 4) + 1); block b "" (no chart), "<phase><leg mod 1000>" (complete, not
--   sold) or "s" (sold); nil when no bit is set and every block is empty. 73 bytes worst case with its key (spec 3.5).
-- Visit state in the chunk local SY (never saved, rebuilt by every MapInitialization); the logbook text on screen in the
-- function global TRF_SyKeepThunk (dropped at a load). No handle anywhere.
-- Layout as trf_signal: helpers, accessors (one native each, protected), static tables, the generated block, pure
-- functions (*Of, explicit inputs, host-testable), contract functions. Top level: functions and SY only.

local SY = {pr={}, v={}, h={}, nr={}, hs={}, lm={}};

-- Helpers --------------------------------------------------------------------------

function TRF_SyCV() return %SY; end;

-- logfmt event line, module=survey (design/log-format.md).
function TRF_SyE(event, ...)
	tinsert(arg, 1, event); tinsert(arg, 1, "survey"); call(TRF_Lf, arg);
end;

-- Error handler for protected calls: an event=error line, counted in stat err.
function TRF_SyErr(m)
	TRF_SyE("error", "message", tostring(m));
	TRF_N("TRF_Stat", "err");
end;

-- Silent handler (natives that may be missing or answer badly): nil is the answer.
function TRF_SyNoErr(m) end;

function TRF_SyLog()
	local v = TRF_N("TRF_Opt", "log");
	if type(v) ~= "number" then v = TRF_Cfg().log or 1; end;
	return v;
end;

-- Debug event line (log 2).
function TRF_SyDE(event, ...)
	if TRF_SyLog() < 2 then return; end;
	tinsert(arg, 1, event); call(TRF_SyE, arg);
end;

function TRF_SyCl(x, lo, hi)
	if x < lo then return lo; end;
	if x > hi then return hi; end;
	return x;
end;

-- a mod m, never negative (Lua 4 mod() keeps the sign of a).
function TRF_SyMod(a, m)
	return a - floor(a / m) * m;
end;

-- Fixed hash 0..10008 of three integers (no RAND draw: a reload replays the same answer).
function TRF_SyHashOf(a, b, c)
	local x = TRF_SyMod(floor((a or 0) * 131 + (b or 0) * 157 + (c or 0) * 41 + 6151), 10000);
	x = TRF_SyMod(x * 47 + 19, 10007);
	return TRF_SyMod(x * 59 + 31, 10009);
end;

-- Ranges of the cfg keys (outside -> default) and clamps of the tune keys (spec 10): {lo, hi}. sy_rp_min is clamped to
-- 60..sy_read_r, sy_near_r to sy_read_r..2000 and sy_thr2 to sy_thr1..200 after the others.
function TRF_SyClampT()
	return {survey={0, 1}, sy_quest={0, 1}, sy_gate={0, 1}, sy_ch={0, 20}, sy_ch_end={0, 20}, sy_read_r={100, 400},
		sy_rp_min={60, 400}, sy_hold={5, 120}, sy_near_r={100, 2000}, sy_fee_k={0, 50}, sy_chart_k={0, 50}, sy_chart_drop={0, 50},
		sy_chart_lo={0, 100}, sy_chart_old={1, 200}, sy_thr1={1, 200}, sy_thr2={1, 200}, sy_thr_k={0, 50}, sy_sell_max={1, 8},
		sy_dc={0, 50}, sy_secs={3, 20}};
end;

-- cfg value: TRF_Opt (merges TRF_Sy_OptDef), else the raw config, else the default; a wrong type or a number outside its
-- range reads as the default.
function TRF_SyOpt(key)
	local d = TRF_Sy_OptDef()[key];
	local v = nil;
	if type(TRF_Opt) == "function" then v = TRF_Opt(key); end;
	if v == nil and type(TRF_CfgGet) == "function" then v = TRF_CfgGet(key, nil); end;
	if v == nil or (d ~= nil and type(v) ~= type(d)) then return d; end;
	local r = TRF_SyClampT()[key];
	if type(v) == "number" and r and (v ~= floor(v) or v < r[1] or v > r[2]) then return d; end;
	return v;
end;

-- Tune values of this module, whole and clamped (TRF_SyClampT). Cached in SY while TRF_Tune returns the same table;
-- callers must not write into it.
function TRF_SyTune()
	local sy = %SY;
	local t = nil;
	if type(TRF_Tune) == "function" then t = call(TRF_Tune, {}, "x", TRF_SyErr); end;
	if type(sy.tc) == "table" and sy.tc.s == t then return sy.tc.t; end;
	local d, cl, o = TRF_Sy_TuneDef(), TRF_SyClampT(), {};
	for k, v in d do
		local x = nil;
		if type(t) == "table" then x = t[k]; end;
		if type(x) ~= "number" then x = v; end;
		x = floor(x);
		local c = cl[k];
		if c then x = TRF_SyCl(x, c[1], c[2]); end;
		o[k] = x;
	end;
	o.sy_rp_min = TRF_SyCl(o.sy_rp_min, 60, o.sy_read_r);
	o.sy_near_r = TRF_SyCl(o.sy_near_r, o.sy_read_r, 2000);
	o.sy_thr2 = TRF_SyCl(o.sy_thr2, o.sy_thr1, 200);
	sy.tc = {s=t, t=o};
	return o;
end;

function TRF_SyLegs()
	if type(TRF) == "table" and type(TRF.clock) == "table" and type(TRF.clock.legs) == "number" then return TRF.clock.legs; end;
	return 0;
end;

function TRF_SyGen()
	if type(TRF) == "table" and type(TRF.gen) == "number" then return TRF.gen; end;
	return 0;
end;

function TRF_SyCh()
	local c = TRF_N("TRF_Chapter");
	if type(c) == "number" then return c; end;
	return 0;
end;

function TRF_SyCur()
	local i = TRF_N("TRF_CurIdx");
	if type(i) == "number" then return i; end;
	return nil;
end;

function TRF_SyTxt(key, a, b, c, d)
	if type(TRF_Txt) == "function" then return TRF_Txt(key, a, b, c, d); end;
	return tostring(key);
end;

-- Lowercase map name of system idx (log values), or the index.
function TRF_SyName(idx)
	local n = TRF_N("TRF_SysName", idx);
	if type(n) == "string" and n ~= "?" then return strlower(n); end;
	return tostring(idx);
end;

-- Display name of system idx: the English map name (trf_loc TRF_SysEn).
function TRF_SySysTxt(idx)
	local s = TRF_N("TRF_SysEn", idx);
	if type(s) == "string" then return s; end;
	return TRF_SyName(idx);
end;

-- Map data (TRF_Map), or nil.
function TRF_SyMap()
	local m = TRF_N("TRF_Map");
	if type(m) == "table" and type(m.sys) == "table" and type(m.by) == "table" then return m; end;
	return nil;
end;

-- The map entry of system idx, or nil.
function TRF_SyMapSys(idx)
	local m = TRF_SyMap();
	if m and type(idx) == "number" and type(m.sys[idx]) == "table" then return m.sys[idx]; end;
	return nil;
end;

-- Region table of trf_region (TRF_RgMap), or nil.
function TRF_SyRgMap()
	local r = TRF_N("TRF_RgMap");
	if type(r) == "table" and type(r.n) == "number" and r.n > 0 then return r; end;
	return nil;
end;

-- Number of region blocks, 0 without the region map.
function TRF_SyNRg()
	local r = TRF_SyRgMap();
	if r then return r.n; end;
	return 0;
end;

function TRF_SySlot(idx)
	if type(idx) ~= "number" then return nil; end;
	local s = TRF_N("TRF_RgOf", idx);
	if type(s) == "number" then return s; end;
	return nil;
end;

-- Phase 0..5 of region slot (trf_region TRF_Phase), 0 without it.
function TRF_SySlotPh(slot)
	local p = TRF_N("TRF_Phase", slot);
	if type(p) == "number" then return p; end;
	return 0;
end;

-- Display name of region slot: the English map name of its home (Dosis, Elinor, Hephaestus, ...).
function TRF_SyRgTxt(slot)
	local r = TRF_SyRgMap();
	if r and type(r[slot]) == "table" and type(r[slot].home) == "number" then return TRF_SySysTxt(r[slot].home); end;
	return tostring(slot);
end;

-- Pay basis of system idx (trf_region TRF_PayN), 0 without it.
function TRF_SyPayN(idx)
	local n = TRF_N("TRF_PayN", idx);
	if type(n) == "number" then return n; end;
	return 0;
end;

function TRF_SyDist(a, b)
	if type(a) ~= "table" or type(b) ~= "table" then return nil; end;
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z;
	return sqrt(dx * dx + dy * dy + dz * dz);
end;

function TRF_SySay(text, secs)
	return TRF_N("TRF_Say", text, secs or 8);
end;

-- Number of set bits of mask c (0..7).
function TRF_SyCnt(c)
	local n = 0;
	for i = 1, 3 do
		if TRF_SyMod(c, 2) == 1 then n = n + 1; end;
		c = floor(c / 2);
	end;
	return n;
end;

-- 1 when bit b (1, 2 or 4) is set in mask c.
function TRF_SyMaskHas(c, b)
	if type(c) ~= "number" or type(b) ~= "number" then return nil; end;
	if TRF_SyMod(floor(c / b), 2) == 1 then return 1; end;
	return nil;
end;

-- Accessors (one native each, protected) ----------------------------------------------------

function TRF_SyPosRaw(o)
	local p = o:GetPosition();
	return {x=p.x, y=p.y, z=p.z};
end;

-- Position of o as {x, y, z}, or nil.
function TRF_SyPos(o)
	if type(o) ~= "table" and type(o) ~= "userdata" then return nil; end;
	local p = call(TRF_SyPosRaw, {o}, "x", TRF_SyNoErr);
	if type(p) == "table" and type(p.x) == "number" then return p; end;
	return nil;
end;

-- Mothership position (TRF_Ms: no GetPlayerMotherShip from a tick), or nil.
function TRF_SyMsPos()
	return TRF_SyPos(TRF_N("TRF_Ms"));
end;

function TRF_SyLabRaw(n) return {v=GetQuestLabel(n)}; end;

-- Quest label n, or nil (missing native, error).
function TRF_SyLab(n)
	if type(GetQuestLabel) ~= "function" then return nil; end;
	local r = call(TRF_SyLabRaw, {n}, "x", TRF_SyNoErr);
	if type(r) == "table" then return r.v; end;
	return nil;
end;

function TRF_SyJAddRaw(id, t, d) return TRF_JobAdd(id, t, d, QUEST_PROCESS); end;
function TRF_SyJRemRaw(id) return TRF_JobRemove(id); end;
function TRF_SyJGetRaw(id) return TRF_JobLogGet(id); end;
function TRF_SyQsRaw(id) return GetQuestState(id); end;

function TRF_SyQAddRaw(id, t, d)
	AddQuest(id, t, d, QUEST_PROCESS);
	return 1;
end;

function TRF_SyQRemRaw(id)
	RemoveQuest(id);
	return 1;
end;

-- Job log entry id with title t and text d (plain): 1, or nil and the reason.
function TRF_SyJAdd(id, t, d)
	if type(TRF_JobAdd) ~= "function" or QUEST_PROCESS == nil then return nil, "native"; end;
	return call(TRF_SyJAddRaw, {id, t, d}, "x", TRF_SyErr);
end;

function TRF_SyJRem(id)
	if type(TRF_JobRemove) ~= "function" then return nil, "native"; end;
	return call(TRF_SyJRemRaw, {id}, "x", TRF_SyErr);
end;

-- Job log state of id, nil when absent or without the native.
function TRF_SyJGet(id)
	if type(TRF_JobLogGet) ~= "function" then return nil; end;
	local s = call(TRF_SyJGetRaw, {id}, "x", TRF_SyNoErr);
	if type(s) == "number" then return s; end;
	return nil;
end;

-- Mission-list entry id with the title and description keys t, d: 1 or nil.
function TRF_SyQAdd(id, t, d)
	if type(AddQuest) ~= "function" or QUEST_PROCESS == nil then return nil, "native"; end;
	return call(TRF_SyQAddRaw, {id, t, d}, "x", TRF_SyErr);
end;

function TRF_SyQRem(id)
	if type(RemoveQuest) ~= "function" then return nil, "native"; end;
	return call(TRF_SyQRemRaw, {id}, "x", TRF_SyErr);
end;

-- Mission-list state of id, nil without the native or for QUEST_NOINIT (no entry).
function TRF_SyQs(id)
	if type(GetQuestState) ~= "function" then return nil; end;
	local s = call(TRF_SyQsRaw, {id}, "x", TRF_SyNoErr);
	if s == nil or (QUEST_NOINIT ~= nil and s == QUEST_NOINIT) then return nil; end;
	return s;
end;

-- Static tables ---------------------------------------------------------------------------

-- Constants (spec 10).
function TRF_SyK()
	return {q=4, qid="trf_sy", jid="sy", box=410, row=410, line=75, hex="0123456789abcdef", nmax=60, icon="nav_target.dds",
		kinds={"rp", "gr", "sr", "hk", "wf", "cs"}, rp_label="OnRandomPortal_all", pow={1, 2, 4, 8}, mbit={1, 2, 4}};
end;

-- BEGIN gen_survey.py (do not edit by hand)
