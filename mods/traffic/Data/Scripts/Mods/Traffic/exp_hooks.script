-- E0.1 hooks and natives alive (mod-options section 7, experiment 1).
-- Logs from top level, from every callback with counters, and once per real second from OnTick.
-- State: TRF.exp.hooks (numbers only).

function TRF_H_Natives()
	return "TRF_Version="..tostring(TRF_N("TRF_Version"))
		.." TRF_GameTime="..TRF_F(TRF_N("TRF_GameTime"))
		.." TRF_RealTime="..TRF_F(TRF_N("TRF_RealTime"))
		.." types Log/Version/GameTime/RealTime="..type(TRF_Log).."/"..type(TRF_Version).."/"..type(TRF_GameTime).."/"..type(TRF_RealTime);
end;

-- x87 precision control. 2^24 + 1 needs 25 mantissa bits: 16777217.0 at 53/64-bit precision,
-- 16777216.0 at 24-bit. 1/3 shows 0.33333333333333331 at 53/64-bit, 0.3333333432674408 at 24-bit.
-- (The 16777217 + 1 of mod-options 7.1 cannot tell them apart: 16777218 = 2^24 + 2 fits in 24 bits.)
-- The operands come from locals so the sum is computed when this runs, not when the chunk is parsed.
function TRF_H_Precision(where)
	local a = 16777216;
	local b = 1;
	local c = 3;
	TRF_L("x87 "..where..": 16777216 + 1 = "..format("%.1f", a + b).." 1/3 = "..format("%.17g", b / c));
end;

function TRF_H_Where()
	return "loc="..tostring(TRF_N("GetCurrentLocation")).." last="..tostring(TRF_N("GetLastLocation"));
end;

function TRF_H_Cnt()
	local c = TRF.exp.cnt or {};
	return "enter="..(c.enter or 0).." activate="..(c.activate or 0).." load="..(c.load or 0).." jump="..(c.jump or 0);
end;

function TRF_H_State()
	if type(TRF.exp.hooks) ~= "table" then
		TRF.exp.hooks = {acc=0, ticks=0, sum_game=0, sum_real=0, prec=0};
	end;
	return TRF.exp.hooks;
end;

function TRF_Exp_Init(w, map_ok)
	TRF_L("init TeleportToLocation before="..w.tp_before.." after="..w.tp_after.." new_wrap="..w.tp_new.." wrapped="..w.tp_wrapped);
	TRF_L("init CustomTeleportate before="..w.ct_before.." after="..w.ct_after.." new_wrap="..w.ct_new.." wrapped="..w.ct_wrapped);
	TRF_L("init "..TRF_H_Natives().." map="..tostring(map_ok));
	TRF_H_Precision("load");
end;

function TRF_Exp_OnEnter(fresh)
	local h = TRF_H_State();
	TRF_L("OnEnter "..TRF_H_Cnt().." fresh="..tostring(fresh).." gen="..TRF.gen.." "..TRF_H_Where());
	TRF_L("OnEnter "..TRF_H_Natives());
	if h.prec == 0 then
		h.prec = 1;
		TRF_H_Precision("first OnEnter");
	end;
end;

function TRF_Exp_OnActivate(fresh)
	TRF_L("OnActivate "..TRF_H_Cnt().." fresh="..tostring(fresh).." "..TRF_H_Where());
end;

function TRF_Exp_OnLoad(fresh)
	TRF_L("OnLoad "..TRF_H_Cnt().." fresh="..tostring(fresh).." gen="..TRF.gen.." "..TRF_H_Where());
	TRF_L("OnLoad "..TRF_H_Natives());
end;

-- Logs once per real second: the last deltas, their sums over that second, and the native clocks.
-- Pass: sum_game reads 0 while the game is paused.
function TRF_Exp_OnTick(dg, dr)
	local h = TRF_H_State();
	h.ticks = h.ticks + 1;
	h.sum_game = h.sum_game + dg;
	h.sum_real = h.sum_real + dr;
	h.acc = h.acc + dr;
	if h.acc < 1 then return; end;
	TRF_L("tick #"..h.ticks.." dt_game="..TRF_F(dg).." dt_real="..TRF_F(dr)
		.." sum_game="..TRF_F(h.sum_game).." sum_real="..TRF_F(h.sum_real)
		.." TRF_GameTime="..TRF_F(TRF_N("TRF_GameTime")).." TRF_RealTime="..TRF_F(TRF_N("TRF_RealTime"))
		.." clock.game="..TRF_F(TRF.clock.game));
	h.acc = 0;
	h.sum_game = 0;
	h.sum_real = 0;
end;

function TRF_Exp_BeforeJump(dest)
	TRF_L("BeforeJump dest="..tostring(dest).." "..TRF_H_Cnt().." "..TRF_H_Where());
end;

TRF_L("top-level load");
