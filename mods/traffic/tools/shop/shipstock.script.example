-- Prototype (not installed): idempotent shop stock for mod ships, Lua 4.0.1.
-- Called before every trade-station dialog. ShipGoodsState sets the row's base count and prices
-- (0x4ec3e0 mode 0); the vanilla dock handler's UpdateTradeSystem(FALSE) then rolls the visible stock.
-- No RAND: the same call on every dock writes the same row, so no once-per-save guard is needed.
MS_Ships = {
	-- ship template, shop list global, base count, {sell,buy} per difficulty 1..3 (vanilla AddAllToShops values)
	{"ModX_Excalibur_pl0", "ShopList_SI", 1, {{1.2,0.8},{1.35,0.6},{1.5,0.4}}},
};
MS_Off = nil;  -- set to 1 for an uninstall pass: base count 0 (stock reaches 0 at the next refresh)

function MS_Diff()
	local d = GetLevelDifficult();
	if d == EASY then return 1; elseif d == NORMAL then return 2; end;
	return 3;
end;

-- Deterministic subset: about half of the list, chosen by a hash of shop and ship names.
function MS_Pick(shop, ship)
	local h = 0;
	local s = shop..ship;
	for i = 1, strlen(s) do h = mod(h * 31 + strbyte(s, i), 65521); end;
	return mod(h, 2) == 0;
end;

function MS_StockShips()
	local k = MS_Diff();
	local n = 0;
	for i = 1, getn(MS_Ships) do
		local e = MS_Ships[i];
		local list = getglobal(e[2]);
		if type(list) == "table" then
			for j = 1, getn(list) do
				if MS_Pick(list[j], e[1]) then
					local c = e[3];
					if MS_Off then c = 0; end;
					GetWhiteMarket(list[j]):ShipGoodsState(e[1], c, e[4][k][1], e[4][k][2]);
					n = n + 1;
				end;
			end;
		end;
	end;
	return n;
end;
